# ============================================================
# 1. ROS2 ublox1/fix or /odom Recorder
# ============================================================

class OdomLineRecorder:
    """
    ROS2 live recorder.

    source_type='fix':
        sensor_msgs/msg/NavSatFix를 구독하고
        lat/lon을 autocarz local XY로 변환해 기록한다.

    source_type='odom':
        nav_msgs/msg/Odometry의 pose.position.x/y를 기록한다.
    """

    def __init__(
        self,
        line_name: str,
        output_path: str,
        topic: str,
        min_distance: float,
        source_type: str = "fix",
        map_offset_x: float = -125320.0,
        map_offset_y: float = 136746.0,
    ):
        self.line_name = str(line_name)
        self.output_path = os.path.abspath(output_path)
        self.topic = str(topic)
        self.min_distance = float(min_distance)
        self.source_type = str(source_type).lower().strip()
        self.map_offset_x = float(map_offset_x)
        self.map_offset_y = float(map_offset_y)

        if self.min_distance < 0.0:
            raise ValueError("--min-distance는 0 이상이어야 합니다.")

        if self.source_type not in ("fix", "odom"):
            raise ValueError("--source는 fix 또는 odom이어야 합니다.")

        self.last_xy = None
        self.count = 0
        self.closed_file = False
        self.fp = None
        self.writer = None
        self.node = None
        self.subscription = None

    @staticmethod
    def latlong2xy(
        latitude: float,
        longitude: float,
        map_offset_x: float,
        map_offset_y: float,
    ) -> Tuple[float, float]:
        """
        autocarz sensor_data_isro.py에서 사용하던 형식의
        위도/경도 -> local x/y 변환.
        """
        RE = 6371.00877
        GRID = 5.0e-7
        SLAT1 = 30.0
        SLAT2 = 60.0
        OLON = 126.0
        OLAT = 38.0
        XO = 43.0
        YO = 136.0
        DEGRAD = math.pi / 180.0

        re = RE / GRID
        slat1 = SLAT1 * DEGRAD
        slat2 = SLAT2 * DEGRAD
        olon = OLON * DEGRAD
        olat = OLAT * DEGRAD

        sn = (
            math.tan(math.pi * 0.25 + slat2 * 0.5)
            /
            math.tan(math.pi * 0.25 + slat1 * 0.5)
        )
        sn = (
            math.log(math.cos(slat1) / math.cos(slat2))
            /
            math.log(sn)
        )

        sf = math.tan(math.pi * 0.25 + slat1 * 0.5)
        sf = math.pow(sf, sn) * math.cos(slat1) / sn

        ro = math.tan(math.pi * 0.25 + olat * 0.5)
        ro = re * sf / math.pow(ro, sn)

        ra = math.tan(
            math.pi * 0.25 + latitude * DEGRAD * 0.5
        )
        ra = re * sf / math.pow(ra, sn)

        theta = longitude * DEGRAD - olon
        if theta > math.pi:
            theta -= 2.0 * math.pi
        if theta < -math.pi:
            theta += 2.0 * math.pi
        theta *= sn

        rs_x = math.floor(
            ra * math.sin(theta) + XO + 0.5
        )
        rs_y = math.floor(
            ro - ra * math.cos(theta) + YO + 0.5
        )

        rs_x = rs_x / 2000.0 + map_offset_x
        rs_y = rs_y / 2000.0 + map_offset_y

        return float(rs_x), float(rs_y)

    def open_output_file(self):
        os.makedirs(
            os.path.dirname(self.output_path),
            exist_ok=True,
        )

        self.fp = open(
            self.output_path,
            "w",
            newline="",
            buffering=1,
            encoding="utf-8",
        )

        self.writer = csv.writer(self.fp)
        self.writer.writerow(
            ["x", "y", "z", "stamp", "frame_id"]
        )
        self.fp.flush()

    def write_record(
        self,
        x: float,
        y: float,
        z: float,
        stamp: float,
        frame_id: str,
        first_log: str,
    ):
        if not (
            np.isfinite(x)
            and np.isfinite(y)
            and np.isfinite(z)
        ):
            return

        xy = np.asarray([x, y], dtype=float)

        if self.last_xy is not None:
            distance = float(
                np.linalg.norm(xy - self.last_xy)
            )

            if distance < self.min_distance:
                return

        self.writer.writerow(
            [x, y, z, stamp, frame_id]
        )
        self.fp.flush()

        self.last_xy = xy
        self.count += 1

        if self.count == 1 and self.node is not None:
            self.node.get_logger().info(
                f"[{self.line_name}] 첫 {self.topic} 수신: {first_log}"
            )

        if self.count % 100 == 0 and self.node is not None:
            self.node.get_logger().info(
                f"[{self.line_name}] {self.count} points recorded -> "
                f"{self.output_path}"
            )

    def odom_callback(self, msg):
        p = msg.pose.pose.position

        x = float(p.x)
        y = float(p.y)
        z = float(p.z)

        stamp = (
            float(msg.header.stamp.sec)
            + float(msg.header.stamp.nanosec) * 1.0e-9
        )

        frame_id = str(msg.header.frame_id)

        self.write_record(
            x=x,
            y=y,
            z=z,
            stamp=stamp,
            frame_id=frame_id,
            first_log=(
                f"x={x:.6f}, y={y:.6f}, frame_id={frame_id}"
            ),
        )

    def fix_callback(self, msg):
        latitude = float(msg.latitude)
        longitude = float(msg.longitude)

        if not (
            np.isfinite(latitude)
            and np.isfinite(longitude)
        ):
            return

        altitude = (
            float(msg.altitude)
            if np.isfinite(msg.altitude)
            else 0.0
        )

        x, y = self.latlong2xy(
            latitude,
            longitude,
            self.map_offset_x,
            self.map_offset_y,
        )

        stamp = (
            float(msg.header.stamp.sec)
            + float(msg.header.stamp.nanosec) * 1.0e-9
        )

        frame_id = str(msg.header.frame_id)

        self.write_record(
            x=x,
            y=y,
            z=altitude,
            stamp=stamp,
            frame_id=frame_id,
            first_log=(
                f"lat={latitude:.10f}, lon={longitude:.10f} -> "
                f"x={x:.6f}, y={y:.6f}"
            ),
        )

    def close(self):
        if self.closed_file:
            return

        self.closed_file = True

        if self.fp is not None:
            self.fp.flush()
            self.fp.close()

    def run(self, stop_with_escape: bool = False):
        try:
            import rclpy
            from nav_msgs.msg import Odometry
            from sensor_msgs.msg import NavSatFix
            from rclpy.qos import qos_profile_sensor_data
            from rclpy.executors import ExternalShutdownException
        except ImportError as exc:
            raise RuntimeError(
                "record 모드는 ROS2 Python 환경(rclpy, nav_msgs, sensor_msgs)이 필요합니다. "
                "차량 Ubuntu에서 /opt/ros/jazzy/setup.bash와 workspace install/setup.bash를 "
                "source한 뒤 실행하십시오. Windows에 ROS2가 설치되어 있지 않으면 live record는 사용할 수 없습니다."
            ) from exc

        rclpy.init(args=None)

        try:
            self.node = rclpy.create_node(
                f"track_{self.line_name}_line_recorder"
            )

            if self.source_type == "fix":
                self.subscription = self.node.create_subscription(
                    NavSatFix,
                    self.topic,
                    self.fix_callback,
                    qos_profile_sensor_data,
                )
            else:
                self.subscription = self.node.create_subscription(
                    Odometry,
                    self.topic,
                    self.odom_callback,
                    qos_profile_sensor_data,
                )

            self.open_output_file()

            logger = self.node.get_logger()
            logger.info("============================================")
            logger.info("ROS2 Track Line Recorder")
            logger.info(f"Recording line : {self.line_name.upper()}")
            logger.info(f"Source         : {self.source_type}")
            logger.info(f"Topic          : {self.topic}")

            if self.source_type == "fix":
                logger.info(f"Map offset X   : {self.map_offset_x:.3f}")
                logger.info(f"Map offset Y   : {self.map_offset_y:.3f}")

            logger.info(f"Output         : {self.output_path}")
            logger.info(f"Min distance   : {self.min_distance:.3f} m")
            if stop_with_escape:
                logger.info("Esc to stop this line and continue")
            else:
                logger.info("Ctrl+C to stop and continue preprocessing")
            logger.info("============================================")

            try:
                if stop_with_escape and sys.stdin.isatty():
                    import select
                    import termios
                    import tty

                    stdin_fd = sys.stdin.fileno()
                    old_term_settings = termios.tcgetattr(stdin_fd)

                    try:
                        tty.setcbreak(stdin_fd)

                        while rclpy.ok():
                            rclpy.spin_once(
                                self.node,
                                timeout_sec=0.05,
                            )

                            readable, _, _ = select.select(
                                [sys.stdin],
                                [],
                                [],
                                0.0,
                            )

                            if readable:
                                key = sys.stdin.read(1)

                                if key == "\x1b":
                                    logger.info(
                                        "Esc 입력 감지 -> 현재 라인 기록 종료"
                                    )
                                    break
                    finally:
                        termios.tcsetattr(
                            stdin_fd,
                            termios.TCSADRAIN,
                            old_term_settings,
                        )
                else:
                    if stop_with_escape:
                        logger.warning(
                            "현재 표준입력이 TTY가 아니어서 Esc 감지를 사용할 수 없습니다. "
                            "Ctrl+C로 기록을 종료하십시오."
                        )

                    rclpy.spin(self.node)

            except KeyboardInterrupt:
                pass
            except ExternalShutdownException:
                pass

        finally:
            self.close()

            if self.node is not None:
                try:
                    self.node.destroy_node()
                except Exception:
                    pass

            if rclpy.ok():
                rclpy.shutdown()

            print()
            print("============================================")
            print(f"[{self.line_name.upper()}] 기록 종료")
            print(f"기록점 : {self.count}")
            print(f"파일   : {self.output_path}")
            print("============================================")


# ============================================================
# 2. Geometry Utilities
# ============================================================

def cross2(
    a: np.ndarray,
    b: np.ndarray,
) -> float:
    return float(
        a[0] * b[1]
        -
        a[1] * b[0]
    )


def remove_consecutive_duplicates(
    points: np.ndarray,
    tol: float = 1.0e-8,
) -> np.ndarray:
    points = np.asarray(
        points,
        dtype=float,
    )

    if len(points) < 2:
        return points.copy()

    kept = [
        points[0]
    ]

    for p in points[1:]:
        if np.linalg.norm(
            p - kept[-1]
        ) > tol:
            kept.append(p)

    result = np.asarray(
        kept,
        dtype=float,
    )

    if len(result) < 2:
        raise ValueError(
            "서로 다른 라인 좌표가 2개 미만입니다."
        )

    return result


def prepare_polyline(
    points: np.ndarray,
    closed: bool,
) -> np.ndarray:
    pts = remove_consecutive_duplicates(
        points
    )

    if closed:
        if np.linalg.norm(
            pts[-1] - pts[0]
        ) <= 1.0e-8:
            pts[-1] = pts[0]
        else:
            pts = np.vstack(
                [pts, pts[0]]
            )

    return pts


def cumulative_lengths(
    points: np.ndarray,
) -> np.ndarray:
    segment_lengths = np.linalg.norm(
        np.diff(
            points,
            axis=0,
        ),
        axis=1,
    )

    return np.concatenate(
        [
            [0.0],
            np.cumsum(
                segment_lengths
            ),
        ]
    )


def point_at_s(
    points: np.ndarray,
    s: float,
    closed: bool,
) -> np.ndarray:
    cum = cumulative_lengths(
        points
    )

    total = float(
        cum[-1]
    )

    if total <= EPS:
        raise ValueError(
            "Polyline 전체 길이가 0입니다."
        )

    if closed:
        s = float(s) % total

    else:
        s = min(
            max(
                float(s),
                0.0,
            ),
            total,
        )

    if (
        not closed
        and
        abs(s - total) <= EPS
    ):
        return points[-1].copy()

    idx = int(
        np.searchsorted(
            cum,
            s,
            side="right",
        )
        - 1
    )

    idx = max(
        0,
        min(
            idx,
            len(points) - 2,
        ),
    )

    segment_length = (
        cum[idx + 1]
        -
        cum[idx]
    )

    if segment_length <= EPS:
        return points[idx].copy()

    t = (
        s - cum[idx]
    ) / segment_length

    return (
        points[idx]
        +
        t
        *
        (
            points[idx + 1]
            -
            points[idx]
        )
    )


def tangent_at_s(
    points: np.ndarray,
    s: float,
    closed: bool,
    window: float,
) -> np.ndarray:
    total = float(
        cumulative_lengths(
            points
        )[-1]
    )

    if total <= EPS:
        raise ValueError(
            "Polyline 전체 길이가 0입니다."
        )

    half = max(
        float(window) * 0.5,
        1.0e-3,
    )

    if closed:
        p0 = point_at_s(
            points,
            s - half,
            True,
        )

        p1 = point_at_s(
            points,
            s + half,
            True,
        )

    else:
        s0 = max(
            0.0,
            s - half,
        )

        s1 = min(
            total,
            s + half,
        )

        p0 = point_at_s(
            points,
            s0,
            False,
        )

        p1 = point_at_s(
            points,
            s1,
            False,
        )

    vec = p1 - p0
    norm = float(
        np.linalg.norm(vec)
    )

    if norm <= EPS:
        raise ValueError(
            "접선 방향을 계산할 수 없습니다."
        )

    return vec / norm


def project_point_to_polyline(
    query: np.ndarray,
    points: np.ndarray,
) -> Tuple[
    np.ndarray,
    float,
    int,
    float,
]:
    query = np.asarray(
        query,
        dtype=float,
    )

    cum = cumulative_lengths(
        points
    )

    best_dist2 = float("inf")
    best_point = None
    best_s = 0.0
    best_idx = 0
    best_t = 0.0

    for i in range(
        len(points) - 1
    ):
        a = points[i]
        b = points[i + 1]

        ab = b - a

        denominator = float(
            np.dot(
                ab,
                ab,
            )
        )

        if denominator <= EPS:
            continue

        t = float(
            np.dot(
                query - a,
                ab,
            )
            /
            denominator
        )

        t = min(
            max(
                t,
                0.0,
            ),
            1.0,
        )

        projection = (
            a
            +
            t * ab
        )

        dist2 = float(
            np.dot(
                query - projection,
                query - projection,
            )
        )

        if dist2 < best_dist2:
            best_dist2 = dist2
            best_point = projection

            segment_length = float(
                np.linalg.norm(ab)
            )

            best_s = float(
                cum[i]
                +
                t
                *
                segment_length
            )

            best_idx = i
            best_t = t

    if best_point is None:
        raise ValueError(
            "클릭 위치를 기준 라인에 투영할 수 없습니다."
        )

    return (
        best_point,
        best_s,
        best_idx,
        best_t,
    )


def intersect_infinite_line_with_polyline(
    origin: np.ndarray,
    direction: np.ndarray,
    polyline: np.ndarray,
) -> Tuple[
    np.ndarray,
    float,
    float,
]:
    origin = np.asarray(
        origin,
        dtype=float,
    )

    direction = np.asarray(
        direction,
        dtype=float,
    )

    direction_norm = float(
        np.linalg.norm(direction)
    )

    if direction_norm <= EPS:
        raise ValueError(
            "법선 방향 벡터가 0입니다."
        )

    direction = (
        direction
        /
        direction_norm
    )

    cum = cumulative_lengths(
        polyline
    )

    candidates = []

    for i in range(
        len(polyline) - 1
    ):
        a = polyline[i]
        b = polyline[i + 1]

        segment = b - a

        segment_length = float(
            np.linalg.norm(segment)
        )

        if segment_length <= EPS:
            continue

        denominator = cross2(
            direction,
            segment,
        )

        if abs(
            denominator
        ) <= 1.0e-12:
            continue

        qmp = a - origin

        t_line = (
            cross2(
                qmp,
                segment,
            )
            /
            denominator
        )

        u_segment = (
            cross2(
                qmp,
                direction,
            )
            /
            denominator
        )

        if (
            -1.0e-9
            <= u_segment
            <= 1.0 + 1.0e-9
        ):
            u_segment = min(
                max(
                    u_segment,
                    0.0,
                ),
                1.0,
            )

            point = (
                a
                +
                u_segment
                *
                segment
            )

            s = float(
                cum[i]
                +
                u_segment
                *
                segment_length
            )

            candidates.append(
                (
                    abs(
                        float(t_line)
                    ),
                    point,
                    s,
                )
            )

    if not candidates:
        raise ValueError(
            "기준선의 법선과 대상 라인의 교점을 찾지 못했습니다."
        )

    candidates.sort(
        key=lambda item: item[0]
    )

    distance, point, s = (
        candidates[0]
    )

    return (
        point,
        s,
        distance,
    )


def reverse_polyline(
    points: np.ndarray,
    closed: bool,
) -> np.ndarray:
    if closed:
        core = points[:-1]
        reversed_points = (
            core[::-1].copy()
        )

        return np.vstack(
            [
                reversed_points,
                reversed_points[0],
            ]
        )

    return points[::-1].copy()


def resample_with_mandatory_s(
    points: np.ndarray,
    spacing: float,
    mandatory_s: List[float],
    closed: bool,
) -> Tuple[
    np.ndarray,
    np.ndarray,
]:
    if spacing <= 0.0:
        raise ValueError(
            "spacing은 0보다 커야 합니다."
        )

    cum = cumulative_lengths(
        points
    )

    total = float(
        cum[-1]
    )

    if closed:
        base_s = list(
            np.arange(
                0.0,
                total,
                spacing,
            )
        )

        mandatory = [
            float(s % total)
            for s
            in mandatory_s
        ]

    else:
        base_s = list(
            np.arange(
                0.0,
                total,
                spacing,
            )
        )

        if (
            not base_s
            or
            abs(
                base_s[-1] - total
            ) > 1.0e-8
        ):
            base_s.append(
                total
            )

        mandatory = [
            min(
                max(
                    float(s),
                    0.0,
                ),
                total,
            )
            for s
            in mandatory_s
        ]

    all_s = sorted(
        base_s + mandatory
    )

    unique_s = []

    for s in all_s:
        if (
            not unique_s
            or
            abs(
                s - unique_s[-1]
            ) > 1.0e-7
        ):
            unique_s.append(s)

    s_array = np.asarray(
        unique_s,
        dtype=float,
    )

    points_resampled = np.vstack(
        [
            point_at_s(
                points,
                s,
                closed,
            )
            for s
            in s_array
        ]
    )

    return (
        s_array,
        points_resampled,
    )


def extract_section_from_resampled(
    sample_s: np.ndarray,
    sample_points: np.ndarray,
    start_s: float,
    end_s: float,
    total: float,
    closed: bool,
) -> np.ndarray:
    tolerance = 1.0e-7

    if not closed:
        if (
            end_s
            <
            start_s - tolerance
        ):
            raise ValueError(
                "구간 경계 순서가 라인 진행방향과 반대입니다. "
                "트랙 진행순서대로 클릭했는지 확인하십시오."
            )

        mask = (
            (sample_s >= start_s - tolerance)
            &
            (sample_s <= end_s + tolerance)
        )

        section = (
            sample_points[mask]
        )

        if len(section) < 2:
            raise ValueError(
                "구간 내부 재샘플링 점이 부족합니다."
            )

        return section

    start_s = (
        start_s % total
    )

    end_s = (
        end_s % total
    )

    if (
        end_s
        >
        start_s + tolerance
    ):
        mask = (
            (sample_s >= start_s - tolerance)
            &
            (sample_s <= end_s + tolerance)
        )

        section = (
            sample_points[mask]
        )

        if len(section) < 2:
            raise ValueError(
                "구간 내부 재샘플링 점이 부족합니다."
            )

        return section

    part1 = (
        sample_points[
            sample_s
            >= start_s - tolerance
        ]
    )

    part2 = (
        sample_points[
            sample_s
            <= end_s + tolerance
        ]
    )

    section = np.vstack(
        [
            part1,
            part2,
        ]
    )

    if len(section) < 2:
        raise ValueError(
            "폐곡선 구간 재샘플링 점이 부족합니다."
        )

    return section


def close_polygon(
    vertices: np.ndarray,
) -> np.ndarray:
    vertices = np.asarray(
        vertices,
        dtype=float,
    )

    if len(vertices) < 3:
        raise ValueError(
            "Polygon은 최소 3개의 꼭짓점이 필요합니다."
        )

    if np.linalg.norm(
        vertices[0] - vertices[-1]
    ) > 1.0e-8:
        vertices = np.vstack(
            [
                vertices,
                vertices[0],
            ]
        )

    return vertices


def polygon_centroid(
    vertices: np.ndarray,
) -> np.ndarray:
    points = np.asarray(
        vertices,
        dtype=float,
    )

    if np.linalg.norm(
        points[0] - points[-1]
    ) <= 1.0e-8:
        points = points[:-1]

    return np.mean(
        points,
        axis=0,
    )


# ============================================================
# 3. File I/O
# ============================================================

def load_line_csv(
    path: str,
) -> Tuple[
    np.ndarray,
    str,
]:
    if not os.path.exists(
        path
    ):
        raise FileNotFoundError(
            f"파일을 찾을 수 없습니다: {path}"
        )

    points = []
    frame_ids = []

    with open(
        path,
        "r",
        newline="",
        encoding="utf-8-sig",
    ) as fp:
        reader = csv.DictReader(
            fp
        )

        required = {
            "x",
            "y",
        }

        if not required.issubset(
            set(
                reader.fieldnames
                or
                []
            )
        ):
            raise ValueError(
                f"{path}: CSV header에 x, y가 필요합니다."
            )

        for row in reader:
            points.append(
                [
                    float(
                        row["x"]
                    ),
                    float(
                        row["y"]
                    ),
                ]
            )

            if (
                "frame_id" in row
                and
                row["frame_id"]
            ):
                frame_ids.append(
                    row["frame_id"]
                )

    if len(points) < 2:
        raise ValueError(
            f"{path}: 유효한 좌표가 2개 미만입니다."
        )

    frame_id = (
        frame_ids[0]
        if frame_ids
        else ""
    )

    return (
        np.asarray(
            points,
            dtype=float,
        ),
        frame_id,
    )


def save_json(
    data: Dict,
    path: str,
):
    os.makedirs(
        os.path.dirname(
            os.path.abspath(path)
        ),
        exist_ok=True,
    )

    with open(
        path,
        "w",
        encoding="utf-8",
    ) as fp:
        json.dump(
            data,
            fp,
            ensure_ascii=False,
            indent=2,
        )


def points_to_list(
    points: np.ndarray,
) -> List[
    List[float]
]:
    return [
        [
            float(p[0]),
            float(p[1]),
        ]
        for p
        in np.asarray(points)
    ]




def polyline_length(
    points: np.ndarray,
) -> float:
    """
    Open polyline 길이 계산.
    """
    pts = np.asarray(
        points,
        dtype=float,
    )

    if len(pts) < 2:
        return 0.0

    return float(
        np.sum(
            np.linalg.norm(
                np.diff(
                    pts,
                    axis=0,
                ),
                axis=1,
            )
        )
    )


def sample_open_polyline_at_s(
    points: np.ndarray,
    s: float,
) -> np.ndarray:
    """
    Open polyline의 누적거리 s 위치를 선형보간한다.
    """
    pts = np.asarray(
        points,
        dtype=float,
    )

    if len(pts) == 0:
        raise ValueError(
            "빈 polyline입니다."
        )

    if len(pts) == 1:
        return pts[0].copy()

    cum = cumulative_lengths(
        pts
    )

    total = float(
        cum[-1]
    )

    if total <= EPS:
        return pts[0].copy()

    s = min(
        max(
            float(s),
            0.0,
        ),
        total,
    )

    if abs(
        s - total
    ) <= EPS:
        return pts[-1].copy()

    index = int(
        np.searchsorted(
            cum,
            s,
            side="right",
        )
        -
        1
    )

    index = max(
        0,
        min(
            index,
            len(pts) - 2,
        ),
    )

    segment_length = float(
        cum[index + 1]
        -
        cum[index]
    )

    if segment_length <= EPS:
        return pts[index].copy()

    ratio = (
        s
        -
        float(
            cum[index]
        )
    ) / segment_length

    return (
        pts[index]
        +
        ratio
        *
        (
            pts[index + 1]
            -
            pts[index]
        )
    )


def resample_boundary_pair_for_cells(
    boundary_a: np.ndarray,
    boundary_b: np.ndarray,
    spacing: float,
) -> Tuple[
    np.ndarray,
    np.ndarray,
]:
    """
    한 ROI section의 양쪽 경계선을 동일한 개수로 재샘플링한다.

    두 경계선의 전체 길이는 서로 다를 수 있으므로
    각 경계의 동일 진행률(0~1)을 서로 대응시킨다.
    """
    a = remove_consecutive_duplicates(
        np.asarray(
            boundary_a,
            dtype=float,
        )
    )

    b = remove_consecutive_duplicates(
        np.asarray(
            boundary_b,
            dtype=float,
        )
    )

    if len(a) < 2 or len(b) < 2:
        raise ValueError(
            "Cell 생성용 section 경계점이 2개 미만입니다."
        )

    length_a = polyline_length(
        a
    )

    length_b = polyline_length(
        b
    )

    max_length = max(
        length_a,
        length_b,
    )

    if max_length <= EPS:
        raise ValueError(
            "Cell 생성용 section 길이가 0입니다."
        )

    interval_count = max(
        1,
        int(
            np.ceil(
                max_length
                /
                float(spacing)
            )
        ),
    )

    ratios = np.linspace(
        0.0,
        1.0,
        interval_count + 1,
    )

    sampled_a = []
    sampled_b = []

    for ratio in ratios:
        sampled_a.append(
            sample_open_polyline_at_s(
                a,
                ratio * length_a,
            )
        )

        sampled_b.append(
            sample_open_polyline_at_s(
                b,
                ratio * length_b,
            )
        )

    return (
        np.asarray(
            sampled_a,
            dtype=float,
        ),
        np.asarray(
            sampled_b,
            dtype=float,
        ),
    )


def extract_section_boundaries_for_cells(
    section: Dict,
) -> Tuple[
    np.ndarray,
    np.ndarray,
]:
    """
    3-Line / 4-Line section 저장 구조를 모두 지원한다.

    3-Line:
        outer_points / inner_points

    4-Line:
        other_points / reference_points
    """
    if (
        "outer_points" in section
        and
        "inner_points" in section
    ):
        return (
            np.asarray(
                section["outer_points"],
                dtype=float,
            ),
            np.asarray(
                section["inner_points"],
                dtype=float,
            ),
        )

    if (
        "other_points" in section
        and
        "reference_points" in section
    ):
        return (
            np.asarray(
                section["other_points"],
                dtype=float,
            ),
            np.asarray(
                section["reference_points"],
                dtype=float,
            ),
        )

    raise ValueError(
        "Cell 생성에 필요한 section 경계선 데이터를 찾지 못했습니다."
    )


def build_cells_from_sections(
    sections: List[Dict],
    spacing: float,
) -> List[
    List[
        List[float]
    ]
]:
    """
    ROI section들을 트랙 진행 순서대로 4점 Cell로 분할한다.

    각 Cell 꼭짓점:
        boundary A[i]
        boundary A[i+1]
        boundary B[i+1]
        boundary B[i]

    Cell 번호는 save_roi_cells_txt()에서
    IN / OUT 각각 0부터 연속 부여한다.
    """
    cells = []

    for section in sections:
        boundary_a, boundary_b = (
            extract_section_boundaries_for_cells(
                section
            )
        )

        sampled_a, sampled_b = (
            resample_boundary_pair_for_cells(
                boundary_a,
                boundary_b,
                spacing,
            )
        )

        for index in range(
            len(sampled_a) - 1
        ):
            vertices = np.asarray(
                [
                    sampled_a[index],
                    sampled_a[index + 1],
                    sampled_b[index + 1],
                    sampled_b[index],
                ],
                dtype=float,
            )

            unique_points = []

            for point in vertices:
                if not any(
                    np.linalg.norm(
                        point - existing
                    )
                    <=
                    1.0e-8
                    for existing
                    in unique_points
                ):
                    unique_points.append(
                        point
                    )

            if len(unique_points) < 3:
                continue

            cells.append(
                points_to_list(
                    vertices
                )
            )

    return cells


def save_roi_cells_txt(
    data: Dict,
    path: str,
    spacing: float,
) -> None:
    """
    LiDAR ROI filtering용 Cell TXT.

    한 파일 안에서 CELLS_IN / CELLS_OUT을 분리한다.

    형식:
        TRACK_ROI_CELLS_V1

        CELLS_IN N
        CELL 0
        x1 y1
        x2 y2
        x3 y3
        x4 y4
        END_CELL
        ...
        END_CELLS_IN

        CELLS_OUT M
        CELL 0
        ...
        END_CELL
        ...
        END_CELLS_OUT

        END_TRACK_ROI_CELLS
    """
    os.makedirs(
        os.path.dirname(
            os.path.abspath(
                path
            )
        ),
        exist_ok=True,
    )

    roi_sections = data.get(
        "roi_sections",
        {},
    )

    in_cells = build_cells_from_sections(
        roi_sections.get(
            "IN",
            [],
        ),
        spacing,
    )

    out_cells = build_cells_from_sections(
        roi_sections.get(
            "OUT",
            [],
        ),
        spacing,
    )

    with open(
        path,
        "w",
        encoding="utf-8",
    ) as fp:
        fp.write(
            "TRACK_ROI_CELLS_V1\n\n"
        )

        fp.write(
            f"CELLS_IN {len(in_cells)}\n"
        )

        for cell_index, vertices in enumerate(
            in_cells
        ):
            fp.write(
                f"CELL {cell_index}\n"
            )

            for x, y in vertices:
                fp.write(
                    f"{float(x):.12f} "
                    f"{float(y):.12f}\n"
                )

            fp.write(
                "END_CELL\n"
            )

        fp.write(
            "END_CELLS_IN\n\n"
        )

        fp.write(
            f"CELLS_OUT {len(out_cells)}\n"
        )

        for cell_index, vertices in enumerate(
            out_cells
        ):
            fp.write(
                f"CELL {cell_index}\n"
            )

            for x, y in vertices:
                fp.write(
                    f"{float(x):.12f} "
                    f"{float(y):.12f}\n"
                )

            fp.write(
                "END_CELL\n"
            )

        fp.write(
            "END_CELLS_OUT\n\n"
        )

        fp.write(
            "END_TRACK_ROI_CELLS\n"
        )

    print(
        f"[OK] IN Cells : {len(in_cells)}"
    )

    print(
        f"[OK] OUT Cells: {len(out_cells)}"
    )


def save_roi_txt(
    data: Dict,
    path: str,
) -> None:
    """
    C++ ROI node에서 std::ifstream으로 읽기 쉬운 단순 TXT 형식.

    형식:
        TRACK_ROI_V1
        LINE_COUNT 3 또는 4
        POLYGON_COUNT N

        POLYGON <id> <roi> <section_type> <track_order> <vertex_count>
        x1 y1
        x2 y2
        ...
        END_POLYGON

        ...
        END_TRACK_ROI

    예:
        POLYGON IN1 IN STRAIGHT 1 85
        ...
        END_POLYGON

        POLYGON OUT1 OUT STRAIGHT 1 82
        ...
        END_POLYGON

    close_polygon() 때문에 마지막 점이 첫 점과 같으면
    TXT 저장 시 마지막 중복점은 제거한다.
    """

    os.makedirs(
        os.path.dirname(
            os.path.abspath(path)
        ),
        exist_ok=True,
    )

    polygons = data.get(
        "polygons",
        [],
    )

    metadata = data.get(
        "metadata",
        {},
    )

    line_count = int(
        metadata.get(
            "line_count",
            0,
        )
    )

    with open(
        path,
        "w",
        encoding="utf-8",
    ) as fp:
        fp.write(
            "TRACK_ROI_V1\n"
        )

        fp.write(
            f"LINE_COUNT {line_count}\n"
        )

        fp.write(
            f"POLYGON_COUNT {len(polygons)}\n"
        )

        for polygon in polygons:
            vertices = np.asarray(
                polygon["vertices"],
                dtype=np.float64,
            )

            # Polygon 닫기용 마지막 중복점 제거
            if (
                len(vertices) >= 2
                and
                np.linalg.norm(
                    vertices[0]
                    -
                    vertices[-1]
                )
                <= 1.0e-8
            ):
                vertices = (
                    vertices[:-1]
                )

            polygon_id = str(
                polygon["id"]
            )

            roi = str(
                polygon["roi"]
            )

            section_type = str(
                polygon[
                    "section_type"
                ]
            )

            track_order = int(
                polygon[
                    "track_order"
                ]
            )

            fp.write(
                "\n"
                f"POLYGON "
                f"{polygon_id} "
                f"{roi} "
                f"{section_type} "
                f"{track_order} "
                f"{len(vertices)}\n"
            )

            for x, y in vertices:
                fp.write(
                    f"{float(x):.12f} "
                    f"{float(y):.12f}\n"
                )

            fp.write(
                "END_POLYGON\n"
            )

        fp.write(
            "\nEND_TRACK_ROI\n"
        )


def ask_line_count() -> int:
    """
    build 시작 시 실제 차선 경계 데이터 개수를 묻는다.

    3개:
      LEFT / MIDDLE / RIGHT

    4개:
      LEFT / MIDDLE1 / MIDDLE2 / RIGHT
    """

    while True:
        raw = input(
            "\n차선 경계 데이터가 몇 개인가요? [3/4]: "
        ).strip()

        if raw == "3":
            return 3

        if raw == "4":
            return 4

        print(
            "3 또는 4를 입력하십시오."
        )


# ============================================================
# 4. Visualization Helpers
# ============================================================

LANE_COLORS = {
    "left": "royalblue",
    "middle": "darkorange",
    "middle1": "darkorange",
    "middle2": "darkorange",
    "right": "seagreen",
    "path_yeah": "black",
    "path_in": "crimson",
    "path_out": "purple",
}


def lane_base_name(
    line_name: str,
) -> str:
    name = str(line_name).lower()

    if "path_yeah" in name:
        return "path_yeah"
    if "path_in" in name:
        return "path_in"
    if "path_out" in name:
        return "path_out"
    if "in_dense" in name:
        return "path_in"
    if "out_dense" in name:
        return "path_out"
    if "middle1" in name:
        return "middle1"
    if "middle2" in name:
        return "middle2"
    if "middle" in name:
        return "middle"
    if "left" in name:
        return "left"
    if "right" in name:
        return "right"

    return name


def line_color(
    line_name: str,
) -> str:
    return LANE_COLORS.get(
        lane_base_name(line_name),
        "dimgray",
    )


def line_visual_style(
    line_name: str,
    active: bool = False,
    initial: bool = False,
) -> Dict[str, object]:
    """
    Common visualization rule used across all editor/preview windows.

    LEFT   : royal blue
    MIDDLE : dark orange
    RIGHT  : sea green

    OFFSET : dashed
    TRACK / modified : solid
    Initial/reference : thin and translucent
    Active editing line : thick solid
    """
    name = str(line_name).lower()

    if "offset" in name:
        linestyle = "--"
    elif initial:
        linestyle = ":"
    else:
        linestyle = "-"

    if active:
        linewidth = 3.2
        alpha = 1.0
        linestyle = "-"
    elif "track" in name or "modified" in name:
        linewidth = 2.1
        alpha = 0.92
    elif "offset" in name:
        linewidth = 1.8
        alpha = 0.88
    elif initial:
        linewidth = 1.1
        alpha = 0.42
    else:
        linewidth = 1.35
        alpha = 0.72

    return {
        "color": line_color(line_name),
        "linestyle": linestyle,
        "linewidth": linewidth,
        "alpha": alpha,
    }


def line_label(
    line_name: str,
) -> str:
    labels = {
        "left": "LEFT white line",
        "middle": "MIDDLE orange line",
        "middle1": "MIDDLE1 orange line",
        "middle2": "MIDDLE2 orange line",
        "right": "RIGHT white line",
    }

    return labels.get(
        line_name,
        line_name.upper(),
    )


def draw_track_lines(
    ax,
    lines: Dict[
        str,
        np.ndarray,
    ],
    scatter: bool = False,
):
    for name, points in lines.items():
        points = np.asarray(
            points,
            dtype=float,
        )

        color = line_color(
            name
        )

        style = line_visual_style(
            name
        )

        ax.plot(
            points[:, 0],
            points[:, 1],
            color=style["color"],
            linestyle=style["linestyle"],
            linewidth=style["linewidth"],
            alpha=style["alpha"],
            label=line_label(
                name
            ),
        )

        if scatter:
            ax.scatter(
                points[:, 0],
                points[:, 1],
                s=7,
                color=color,
            )


def draw_polygon_list(
    ax,
    polygons: List[Dict],
    show_label: bool = True,
):
    for polygon in polygons:
        vertices = np.asarray(
            polygon["vertices"],
            dtype=float,
        )

        roi = str(
            polygon.get(
                "roi",
                "",
            )
        ).upper()

        section_type = str(
            polygon.get(
                "section_type",
                "",
            )
        ).upper()

        color_map = {
            ("IN", "STRAIGHT"): "green",
            ("IN", "CURVE"): "red",
            ("OUT", "STRAIGHT"): "blue",
            ("OUT", "CURVE"): "yellow",
        }

        color = color_map.get(
            (
                roi,
                section_type,
            ),
            "gray",
        )

        patch = MplPolygon(
            vertices,
            closed=True,
            facecolor=color,
            edgecolor=color,
            alpha=0.20,
            linewidth=1.4,
        )

        ax.add_patch(
            patch
        )

        if show_label:
            center = polygon_centroid(
                vertices
            )

            ax.text(
                center[0],
                center[1],
                (
                    f"{polygon['id']}\n"
                    f"{polygon['section_name'].upper()}"
                ),
                ha="center",
                va="center",
                fontsize=8,
            )


# ============================================================
# 5. Section Type
# ============================================================

def make_section_types(
    section_count: int,
) -> List[str]:
    """
    첫 번째 클릭점 -> 두 번째 클릭점은 무조건 STRAIGHT.

    이후:
      CURVE -> STRAIGHT -> CURVE -> STRAIGHT ...
    """

    result = []

    for i in range(
        section_count
    ):
        if i % 2 == 0:
            result.append(
                "STRAIGHT"
            )

        else:
            result.append(
                "CURVE"
            )

    return result


# ============================================================
# 6. Three-Line Boundary Model
# ============================================================

@dataclass
class ThreeLineBoundary:
    middle_point: np.ndarray
    middle_s: float
    tangent: np.ndarray
    normal: np.ndarray

    left_point: Optional[np.ndarray] = None
    left_s: Optional[float] = None

    right_point: Optional[np.ndarray] = None
    right_s: Optional[float] = None

    kind: str = "transition"


def make_three_boundary_at_s(
    middle: np.ndarray,
    s: float,
    closed: bool,
    tangent_window: float,
    kind: str,
) -> ThreeLineBoundary:
    point = point_at_s(
        middle,
        s,
        closed,
    )

    tangent = tangent_at_s(
        middle,
        s,
        closed,
        tangent_window,
    )

    normal = np.array(
        [
            -tangent[1],
            tangent[0],
        ],
        dtype=float,
    )

    return ThreeLineBoundary(
        middle_point=point,
        middle_s=float(s),
        tangent=tangent,
        normal=normal,
        kind=kind,
    )


def select_three_line_boundaries(
    left: np.ndarray,
    middle: np.ndarray,
    right: np.ndarray,
    closed: bool,
    tangent_window: float,
) -> List[
    ThreeLineBoundary
]:
    fig, ax = plt.subplots(
        figsize=(12, 8)
    )

    draw_track_lines(
        ax,
        {
            "left": left,
            "middle": middle,
            "right": right,
        },
        scatter=False,
    )

    ax.scatter(
        middle[:, 0],
        middle[:, 1],
        s=7,
        color="darkorange",
    )

    ax.set_aspect(
        "equal",
        adjustable="box",
    )

    ax.grid(
        True
    )

    ax.legend()

    ax.set_title(
        "Click transition points on MIDDLE line in track order\n"
        "Left click: Add | Right click: Undo last | "
        "Enter/Middle click: Finish"
    )

    ax.set_xlabel(
        "x [m]"
    )

    ax.set_ylabel(
        "y [m]"
    )

    print(
        "\n============================================"
    )
    print(
        "3-Line 모드: 공통 구간 경계 선택"
    )
    print(
        "============================================"
    )
    print(
        "MIDDLE line 위에서 트랙 진행순서대로 클릭"
    )
    print(
        "P1 -> P2 = STRAIGHT1"
    )
    print(
        "P2 -> P3 = CURVE1"
    )
    print(
        "이후 STRAIGHT / CURVE 반복"
    )
    print(
        "Enter 또는 가운데 클릭으로 완료"
    )
    print(
        "============================================"
    )

    clicked = plt.ginput(
        n=-1,
        timeout=0,
        show_clicks=True,
    )

    plt.close(
        fig
    )

    if (
        closed
        and
        len(clicked) < 2
    ):
        raise ValueError(
            "폐곡선 트랙은 최소 2개의 경계점이 필요합니다."
        )

    result = []

    for x, y in clicked:
        projection, s, _, _ = (
            project_point_to_polyline(
                np.array(
                    [x, y],
                    dtype=float,
                ),
                middle,
            )
        )

        tangent = tangent_at_s(
            middle,
            s,
            closed,
            tangent_window,
        )

        normal = np.array(
            [
                -tangent[1],
                tangent[0],
            ],
            dtype=float,
        )

        result.append(
            ThreeLineBoundary(
                middle_point=projection,
                middle_s=float(s),
                tangent=tangent,
                normal=normal,
                kind="transition",
            )
        )

    return remove_duplicate_three_boundaries(
        result,
        closed,
    )


def remove_duplicate_three_boundaries(
    boundaries: List[
        ThreeLineBoundary
    ],
    closed: bool,
) -> List[
    ThreeLineBoundary
]:
    filtered = []

    for boundary in boundaries:
        duplicate = any(
            abs(
                boundary.middle_s
                -
                previous.middle_s
            )
            <
            1.0e-4

            for previous
            in filtered
        )

        if not duplicate:
            filtered.append(
                boundary
            )

    if (
        len(filtered)
        !=
        len(boundaries)
    ):
        print(
            "[WARN] 중복으로 판단된 경계점은 제거했습니다."
        )

    if (
        closed
        and
        len(filtered) < 2
    ):
        raise ValueError(
            "중복 제거 후 유효 경계점이 2개 미만입니다."
        )

    return filtered


def populate_three_line_intersections(
    boundaries: List[
        ThreeLineBoundary
    ],
    left: np.ndarray,
    right: np.ndarray,
):
    for boundary in boundaries:
        left_point, left_s, _ = (
            intersect_infinite_line_with_polyline(
                boundary.middle_point,
                boundary.normal,
                left,
            )
        )

        right_point, right_s, _ = (
            intersect_infinite_line_with_polyline(
                boundary.middle_point,
                boundary.normal,
                right,
            )
        )

        boundary.left_point = (
            left_point
        )

        boundary.left_s = float(
            left_s
        )

        boundary.right_point = (
            right_point
        )

        boundary.right_s = float(
            right_s
        )


def three_side_orientation_score(
    boundaries: List[
        ThreeLineBoundary
    ],
    side_points: np.ndarray,
    side_key: str,
    closed: bool,
    tangent_window: float,
) -> float:
    values = []

    for boundary in boundaries:
        if side_key == "left":
            side_s = boundary.left_s

        else:
            side_s = boundary.right_s

        side_tangent = tangent_at_s(
            side_points,
            side_s,
            closed,
            tangent_window,
        )

        values.append(
            float(
                np.dot(
                    side_tangent,
                    boundary.tangent,
                )
            )
        )

    if not values:
        return 1.0

    return float(
        np.mean(values)
    )


# ============================================================
# 7. Four-Line Pair Boundary Model
# ============================================================

@dataclass
class PairBoundary:
    reference_point: np.ndarray
    reference_s: float
    tangent: np.ndarray
    normal: np.ndarray

    other_point: Optional[np.ndarray] = None
    other_s: Optional[float] = None

    kind: str = "transition"


def make_pair_boundary_at_s(
    reference: np.ndarray,
    s: float,
    closed: bool,
    tangent_window: float,
    kind: str,
) -> PairBoundary:
    point = point_at_s(
        reference,
        s,
        closed,
    )

    tangent = tangent_at_s(
        reference,
        s,
        closed,
        tangent_window,
    )

    normal = np.array(
        [
            -tangent[1],
            tangent[0],
        ],
        dtype=float,
    )

    return PairBoundary(
        reference_point=point,
        reference_s=float(s),
        tangent=tangent,
        normal=normal,
        kind=kind,
    )


def select_pair_boundaries(
    roi_name: str,
    reference_name: str,
    reference: np.ndarray,
    other: np.ndarray,
    all_lines: Dict[
        str,
        np.ndarray,
    ],
    closed: bool,
    tangent_window: float,
    background_polygons: Optional[
        List[Dict]
    ] = None,
) -> List[
    PairBoundary
]:
    fig, ax = plt.subplots(
        figsize=(12, 8)
    )

    if background_polygons:
        draw_polygon_list(
            ax,
            background_polygons,
            show_label=True,
        )

    draw_track_lines(
        ax,
        all_lines,
        scatter=False,
    )

    ax.scatter(
        reference[:, 0],
        reference[:, 1],
        s=8,
        color=line_color(
            reference_name
        ),
    )

    ax.set_aspect(
        "equal",
        adjustable="box",
    )

    ax.grid(
        True
    )

    ax.legend()

    if (
        roi_name
        ==
        "IN"
    ):
        title = (
            "Select IN section boundaries on MIDDLE1 for one lap\n"
            "Left click: Add | Right click: Undo last | "
            "Enter/Middle click: Generate IN"
        )

    else:
        title = (
            "Check IN polygons, then select OUT section boundaries\n"
            "Click one lap on MIDDLE2 | "
            "Enter/Middle click: Generate OUT"
        )

    ax.set_title(
        title
    )

    ax.set_xlabel(
        "x [m]"
    )

    ax.set_ylabel(
        "y [m]"
    )

    print(
        "\n============================================"
    )
    print(
        f"4-Line 모드: {roi_name} 경계 선택"
    )
    print(
        "============================================"
    )
    print(
        f"기준선: {reference_name.upper()}"
    )
    print(
        "트랙 진행순서대로 한 바퀴 클릭"
    )
    print(
        "첫 번째 구간은 STRAIGHT"
    )
    print(
        "이후 CURVE / STRAIGHT 자동 반복"
    )
    print(
        "Enter 또는 가운데 클릭으로 완료"
    )
    print(
        "============================================"
    )

    clicked = plt.ginput(
        n=-1,
        timeout=0,
        show_clicks=True,
    )

    plt.close(
        fig
    )

    if (
        closed
        and
        len(clicked) < 2
    ):
        raise ValueError(
            f"{roi_name} 폐곡선 구간은 최소 2개의 경계점이 필요합니다."
        )

    result = []

    for x, y in clicked:
        projection, s, _, _ = (
            project_point_to_polyline(
                np.array(
                    [x, y],
                    dtype=float,
                ),
                reference,
            )
        )

        tangent = tangent_at_s(
            reference,
            s,
            closed,
            tangent_window,
        )

        normal = np.array(
            [
                -tangent[1],
                tangent[0],
            ],
            dtype=float,
        )

        result.append(
            PairBoundary(
                reference_point=projection,
                reference_s=float(s),
                tangent=tangent,
                normal=normal,
                kind="transition",
            )
        )

    return remove_duplicate_pair_boundaries(
        result,
        closed,
        roi_name,
    )


def remove_duplicate_pair_boundaries(
    boundaries: List[
        PairBoundary
    ],
    closed: bool,
    roi_name: str,
) -> List[
    PairBoundary
]:
    filtered = []

    for boundary in boundaries:
        duplicate = any(
            abs(
                boundary.reference_s
                -
                previous.reference_s
            )
            <
            1.0e-4

            for previous
            in filtered
        )

        if not duplicate:
            filtered.append(
                boundary
            )

    if (
        len(filtered)
        !=
        len(boundaries)
    ):
        print(
            f"[WARN] {roi_name}: 중복으로 판단된 경계점은 제거했습니다."
        )

    if (
        closed
        and
        len(filtered) < 2
    ):
        raise ValueError(
            f"{roi_name}: 중복 제거 후 유효 경계점이 2개 미만입니다."
        )

    return filtered


def populate_pair_intersections(
    boundaries: List[
        PairBoundary
    ],
    other: np.ndarray,
):
    for boundary in boundaries:
        point, s, _ = (
            intersect_infinite_line_with_polyline(
                boundary.reference_point,
                boundary.normal,
                other,
            )
        )

        boundary.other_point = (
            point
        )

        boundary.other_s = float(
            s
        )


def pair_orientation_score(
    boundaries: List[
        PairBoundary
    ],
    other: np.ndarray,
    closed: bool,
    tangent_window: float,
) -> float:
    values = []

    for boundary in boundaries:
        other_tangent = tangent_at_s(
            other,
            boundary.other_s,
            closed,
            tangent_window,
        )

        values.append(
            float(
                np.dot(
                    other_tangent,
                    boundary.tangent,
                )
            )
        )

    if not values:
        return 1.0

    return float(
        np.mean(values)
    )



def pair_boundary_candidate_is_valid(
    boundaries: List[PairBoundary],
    index: int,
    candidate_s: float,
    reference_total: float,
    closed: bool,
    margin: float = 1.0e-3,
) -> bool:
    count = len(boundaries)

    if count <= 1:
        return True

    if not closed:
        lower = 0.0
        upper = reference_total

        if index > 0:
            lower = boundaries[index - 1].reference_s + margin

        if index < count - 1:
            upper = boundaries[index + 1].reference_s - margin

        return lower < candidate_s < upper

    if count == 2:
        other_index = 1 - index

        d1 = (
            float(boundaries[other_index].reference_s)
            -
            float(candidate_s)
        ) % reference_total

        d2 = (
            float(candidate_s)
            -
            float(boundaries[other_index].reference_s)
        ) % reference_total

        return min(d1, d2) > margin

    previous_s = boundaries[(index - 1) % count].reference_s
    next_s = boundaries[(index + 1) % count].reference_s

    whole_interval = (
        float(next_s)
        -
        float(previous_s)
    ) % reference_total

    candidate_interval = (
        float(candidate_s)
        -
        float(previous_s)
    ) % reference_total

    return (
        candidate_interval > margin
        and candidate_interval < whole_interval - margin
    )


def replace_pair_boundary_at_s(
    boundaries: List[PairBoundary],
    index: int,
    new_s: float,
    reference: np.ndarray,
    other: np.ndarray,
    args,
):
    old_kind = boundaries[index].kind

    new_boundary = make_pair_boundary_at_s(
        reference,
        new_s,
        args.closed,
        args.tangent_window,
        old_kind,
    )

    point, s, _ = intersect_infinite_line_with_polyline(
        new_boundary.reference_point,
        new_boundary.normal,
        other,
    )

    new_boundary.other_point = point
    new_boundary.other_s = float(s)

    boundaries[index] = new_boundary


def restore_pair_boundaries_from_s(
    boundaries: List[PairBoundary],
    original_s_values: List[float],
    reference: np.ndarray,
    other: np.ndarray,
    args,
):
    for index, original_s in enumerate(original_s_values):
        replace_pair_boundary_at_s(
            boundaries,
            index,
            original_s,
            reference,
            other,
            args,
        )


def assemble_pair_roi_from_boundaries(
    roi_name: str,
    reference_name: str,
    reference: np.ndarray,
    other_name: str,
    other: np.ndarray,
    boundaries: List[PairBoundary],
    args,
) -> Tuple[
    np.ndarray,
    np.ndarray,
    List[Dict],
    List[Dict],
    List[Dict],
]:
    reference_total = float(cumulative_lengths(reference)[-1])
    other_total = float(cumulative_lengths(other)[-1])

    section_pairs = make_section_pairs(
        boundaries,
        args.closed,
    )

    section_types = make_section_types(
        len(section_pairs)
    )

    reference_s, reference_resampled = resample_with_mandatory_s(
        reference,
        args.spacing,
        [boundary.reference_s for boundary in boundaries],
        args.closed,
    )

    other_s, other_resampled = resample_with_mandatory_s(
        other,
        args.spacing,
        [boundary.other_s for boundary in boundaries],
        args.closed,
    )

    polygons = []
    sections = []

    straight_number = 0
    curve_number = 0

    for order_index, (boundary_pair, section_type) in enumerate(
        zip(section_pairs, section_types),
        start=1,
    ):
        start_boundary, end_boundary = boundary_pair

        if section_type == "STRAIGHT":
            straight_number += 1
            section_type_index = straight_number
            section_name = f"straight{section_type_index}"
        else:
            curve_number += 1
            section_type_index = curve_number
            section_name = f"curve{section_type_index}"

        reference_section = extract_section_from_resampled(
            reference_s,
            reference_resampled,
            start_boundary.reference_s,
            end_boundary.reference_s,
            reference_total,
            args.closed,
        )

        other_section = extract_section_from_resampled(
            other_s,
            other_resampled,
            start_boundary.other_s,
            end_boundary.other_s,
            other_total,
            args.closed,
        )

        vertices = close_polygon(
            np.vstack([
                other_section,
                reference_section[::-1],
            ])
        )

        polygon_id = f"{roi_name}{order_index}"

        sections.append(
            {
                "roi": roi_name,
                "track_order": order_index,
                "section_type": section_type,
                "section_type_index": section_type_index,
                "section_name": section_name,
                "reference_line": reference_name,
                "other_line": other_name,
                "reference_points": points_to_list(reference_section),
                "other_points": points_to_list(other_section),
                "polygon_id": polygon_id,
            }
        )

        polygons.append(
            {
                "id": polygon_id,
                "roi": roi_name,
                "track_order": order_index,
                "section_type": section_type,
                "section_type_index": section_type_index,
                "section_name": section_name,
                "vertices": points_to_list(vertices),
            }
        )

    boundary_data = []

    for index, boundary in enumerate(boundaries, start=1):
        boundary_data.append(
            {
                "roi": roi_name,
                "id": index,
                "kind": boundary.kind,
                "reference_line": reference_name,
                "other_line": other_name,
                "reference_s": float(boundary.reference_s),
                "other_s": float(boundary.other_s),
                "points": [
                    points_to_list([boundary.other_point])[0],
                    points_to_list([boundary.reference_point])[0],
                ],
            }
        )

    return (
        reference_resampled,
        other_resampled,
        sections,
        polygons,
        boundary_data,
    )


def edit_pair_boundaries_interactive(
    roi_name: str,
    reference_name: str,
    reference: np.ndarray,
    other_name: str,
    other: np.ndarray,
    all_lines: Dict[str, np.ndarray],
    boundaries: List[PairBoundary],
    args,
    background_polygons: Optional[List[Dict]] = None,
) -> Tuple[
    np.ndarray,
    np.ndarray,
    List[Dict],
    List[Dict],
    List[Dict],
]:
    """
    4-Line IN/OUT Polygon 경계 드래그 수정기.

    빨간 기준선 handle을 드래그하면 reference(MIDDLE1 또는 MIDDLE2)
    위로 projection되고, 반대쪽 차선과의 교점을 다시 계산한다.

    Enter: 확정
    Esc: 수정 취소
    """
    current = assemble_pair_roi_from_boundaries(
        roi_name,
        reference_name,
        reference,
        other_name,
        other,
        boundaries,
        args,
    )

    if args.no_show:
        return current

    original_s_values = [
        float(boundary.reference_s)
        for boundary in boundaries
    ]

    reference_total = float(
        cumulative_lengths(reference)[-1]
    )

    state = {
        "drag_index": None,
        "drag_start_s": None,
        "committed": False,
        "cancelled": False,
        "current": current,
        "line_artists": [],
        "handle_scatter": None,
    }

    fig, ax = plt.subplots(
        figsize=(14, 10)
    )

    def redraw():
        ax.clear()

        if background_polygons:
            draw_polygon_list(
                ax,
                background_polygons,
                show_label=True,
            )

        draw_polygon_list(
            ax,
            state["current"][3],
            show_label=True,
        )

        draw_track_lines(
            ax,
            all_lines,
            scatter=False,
        )

        state["line_artists"] = []
        handles = []

        for boundary_index, boundary in enumerate(boundaries):
            points = np.asarray(
                [
                    boundary.other_point,
                    boundary.reference_point,
                ],
                dtype=float,
            )

            artist, = ax.plot(
                points[:, 0],
                points[:, 1],
                "--",
                color="crimson",
                linewidth=1.4,
                zorder=8,
                label=(
                    f"{roi_name} draggable boundary"
                    if boundary_index == 0
                    else None
                ),
            )

            state["line_artists"].append(
                artist
            )

            handles.append(
                boundary.reference_point
            )

            ax.text(
                boundary.reference_point[0],
                boundary.reference_point[1],
                f"{roi_name}-B{boundary_index + 1}",
                fontsize=8,
                ha="left",
                va="bottom",
                zorder=10,
            )

        handles = np.asarray(
            handles,
            dtype=float,
        )

        state["handle_scatter"] = ax.scatter(
            handles[:, 0],
            handles[:, 1],
            s=70,
            color="crimson",
            edgecolors="black",
            linewidths=0.6,
            zorder=11,
            label="Drag handle",
        )

        ax.set_aspect(
            "equal",
            adjustable="box",
        )
        ax.grid(True)
        ax.legend(loc="best")
        ax.set_xlabel("x [m]")
        ax.set_ylabel("y [m]")
        ax.set_title(
            f"4-Line {roi_name} Polygon Boundary Editor\n"
            f"Drag red handle on {reference_name.upper()} | "
            "Enter: confirm | Esc: cancel"
        )

        fig.tight_layout()
        fig.canvas.draw_idle()

    def update_drag_artist(boundary_index: int):
        boundary = boundaries[boundary_index]

        points = np.asarray(
            [
                boundary.other_point,
                boundary.reference_point,
            ],
            dtype=float,
        )

        state["line_artists"][boundary_index].set_data(
            points[:, 0],
            points[:, 1],
        )

        offsets = np.asarray(
            [
                boundary.reference_point
                for boundary in boundaries
            ],
            dtype=float,
        )

        state["handle_scatter"].set_offsets(
            offsets
        )

        fig.canvas.draw_idle()

    def pick_boundary_index(event):
        if (
            event.xdata is None
            or event.ydata is None
        ):
            return None

        cursor = np.asarray(
            [event.xdata, event.ydata],
            dtype=float,
        )

        handles = np.asarray(
            [
                boundary.reference_point
                for boundary in boundaries
            ],
            dtype=float,
        )

        distances = np.linalg.norm(
            handles - cursor,
            axis=1,
        )

        index = int(
            np.argmin(distances)
        )

        xlim = ax.get_xlim()
        ylim = ax.get_ylim()

        diagonal = float(
            np.hypot(
                xlim[1] - xlim[0],
                ylim[1] - ylim[0],
            )
        )

        pick_radius = max(
            diagonal * 0.02,
            0.5,
        )

        if distances[index] <= pick_radius:
            return index

        return None

    def on_press(event):
        if (
            event.inaxes is not ax
            or event.button != 1
        ):
            return

        boundary_index = pick_boundary_index(
            event
        )

        if boundary_index is None:
            return

        state["drag_index"] = boundary_index
        state["drag_start_s"] = float(
            boundaries[boundary_index].reference_s
        )

    def on_motion(event):
        boundary_index = state["drag_index"]

        if boundary_index is None:
            return

        if (
            event.inaxes is not ax
            or event.xdata is None
            or event.ydata is None
        ):
            return

        try:
            _, candidate_s, _, _ = project_point_to_polyline(
                np.asarray(
                    [event.xdata, event.ydata],
                    dtype=float,
                ),
                reference,
            )

            candidate_s = float(
                candidate_s
            )

            if not pair_boundary_candidate_is_valid(
                boundaries,
                boundary_index,
                candidate_s,
                reference_total,
                args.closed,
            ):
                return

            replace_pair_boundary_at_s(
                boundaries,
                boundary_index,
                candidate_s,
                reference,
                other,
                args,
            )

            update_drag_artist(
                boundary_index
            )

        except Exception:
            return

    def on_release(event):
        boundary_index = state["drag_index"]

        if boundary_index is None:
            return

        try:
            state["current"] = assemble_pair_roi_from_boundaries(
                roi_name,
                reference_name,
                reference,
                other_name,
                other,
                boundaries,
                args,
            )

        except Exception as exc:
            print(
                f"[WARN] {roi_name} 경계 수정 실패 -> 이전 위치 복구: {exc}"
            )

            replace_pair_boundary_at_s(
                boundaries,
                boundary_index,
                state["drag_start_s"],
                reference,
                other,
                args,
            )

            state["current"] = assemble_pair_roi_from_boundaries(
                roi_name,
                reference_name,
                reference,
                other_name,
                other,
                boundaries,
                args,
            )

        state["drag_index"] = None
        state["drag_start_s"] = None

        redraw()

    def on_key(event):
        key = (event.key or "").lower()

        if key in ("enter", "return"):
            state["committed"] = True
            plt.close(fig)

        elif key in ("escape", "esc"):
            state["cancelled"] = True

            restore_pair_boundaries_from_s(
                boundaries,
                original_s_values,
                reference,
                other,
                args,
            )

            state["current"] = assemble_pair_roi_from_boundaries(
                roi_name,
                reference_name,
                reference,
                other_name,
                other,
                boundaries,
                args,
            )

            plt.close(fig)

    fig.canvas.mpl_connect(
        "button_press_event",
        on_press,
    )
    fig.canvas.mpl_connect(
        "motion_notify_event",
        on_motion,
    )
    fig.canvas.mpl_connect(
        "button_release_event",
        on_release,
    )
    fig.canvas.mpl_connect(
        "key_press_event",
        on_key,
    )

    redraw()

    print()
    print("============================================")
    print(f"4-Line {roi_name} Polygon Boundary Editor")
    print("============================================")
    print(
        f"빨간 handle을 {reference_name.upper()} 위에서 드래그"
    )
    print("Enter : 수정 확정")
    print("Esc   : 수정 취소")
    print("============================================")

    plt.show()

    if not state["committed"]:
        if not state["cancelled"]:
            restore_pair_boundaries_from_s(
                boundaries,
                original_s_values,
                reference,
                other,
                args,
            )

            state["current"] = assemble_pair_roi_from_boundaries(
                roi_name,
                reference_name,
                reference,
                other_name,
                other,
                boundaries,
                args,
            )

    return state["current"]


def rebuild_pair_boundaries_from_saved_result(
    args,
    saved_result: Dict,
    roi_name: str,
    reference_name: str,
    reference: np.ndarray,
    other: np.ndarray,
) -> List[PairBoundary]:
    """
    4-Line JSON의 IN 또는 OUT boundary를 복원한다.
    저장 points 형식:
      [other point, reference point]
    """
    saved_boundaries = [
        boundary
        for boundary in saved_result.get(
            "boundaries",
            [],
        )
        if str(
            boundary.get(
                "roi",
                "",
            )
        ).upper()
        ==
        roi_name.upper()
    ]

    if len(saved_boundaries) < 2:
        raise ValueError(
            f"기존 JSON에서 {roi_name} boundary를 2개 이상 찾지 못했습니다."
        )

    try:
        saved_boundaries = sorted(
            saved_boundaries,
            key=lambda item: int(
                item.get(
                    "id",
                    0,
                )
            ),
        )
    except Exception:
        pass

    result = []

    for saved in saved_boundaries:
        points = np.asarray(
            saved.get(
                "points",
                [],
            ),
            dtype=float,
        )

        if (
            points.ndim != 2
            or points.shape[1] != 2
            or len(points) < 2
        ):
            raise ValueError(
                f"{roi_name} boundary points 형식이 올바르지 않습니다."
            )

        saved_reference_point = points[-1]

        _, reference_s, _, _ = project_point_to_polyline(
            saved_reference_point,
            reference,
        )

        boundary = make_pair_boundary_at_s(
            reference,
            float(reference_s),
            args.closed,
            args.tangent_window,
            str(
                saved.get(
                    "kind",
                    "transition",
                )
            ),
        )

        point, other_s, _ = intersect_infinite_line_with_polyline(
            boundary.reference_point,
            boundary.normal,
            other,
        )

        boundary.other_point = point
        boundary.other_s = float(other_s)

        result.append(
            boundary
        )

    return remove_duplicate_pair_boundaries(
        result,
        args.closed,
        roi_name,
    )


# ============================================================
# 8. Common Section Pair
# ============================================================

def make_section_pairs(
    boundaries,
    closed: bool,
):
    if closed:
        return [
            (
                boundaries[i],
                boundaries[
                    (i + 1)
                    %
                    len(boundaries)
                ],
            )
            for i
            in range(
                len(boundaries)
            )
        ]

    return [
        (
            boundaries[i],
            boundaries[i + 1],
        )
        for i
        in range(
            len(boundaries) - 1
        )
    ]


# ============================================================
# 9. Three-Line ROI Build
# ============================================================

def assemble_three_line_roi(
    args,
    left: np.ndarray,
    middle: np.ndarray,
    right: np.ndarray,
    boundaries: List[ThreeLineBoundary],
    frame_id: str,
) -> Dict:
    """
    현재 ThreeLineBoundary 목록을 기준으로
    IN / OUT section, polygon, boundary JSON 데이터를 다시 만든다.

    Interactive editor에서 경계를 이동한 뒤에도
    이 함수를 다시 호출하여 동일한 형식의 최종 결과를 생성한다.
    """

    middle_total = float(
        cumulative_lengths(
            middle
        )[-1]
    )

    left_total = float(
        cumulative_lengths(
            left
        )[-1]
    )

    right_total = float(
        cumulative_lengths(
            right
        )[-1]
    )

    section_pairs = make_section_pairs(
        boundaries,
        args.closed,
    )

    section_types = make_section_types(
        len(section_pairs)
    )

    left_s, left_resampled = (
        resample_with_mandatory_s(
            left,
            args.spacing,
            [
                boundary.left_s
                for boundary
                in boundaries
            ],
            args.closed,
        )
    )

    middle_s, middle_resampled = (
        resample_with_mandatory_s(
            middle,
            args.spacing,
            [
                boundary.middle_s
                for boundary
                in boundaries
            ],
            args.closed,
        )
    )

    right_s, right_resampled = (
        resample_with_mandatory_s(
            right,
            args.spacing,
            [
                boundary.right_s
                for boundary
                in boundaries
            ],
            args.closed,
        )
    )

    polygons = []
    in_sections = []
    out_sections = []

    straight_number = 0
    curve_number = 0

    for order_index, (
        boundary_pair,
        section_type,
    ) in enumerate(
        zip(
            section_pairs,
            section_types,
        ),
        start=1,
    ):
        start_boundary, end_boundary = (
            boundary_pair
        )

        if section_type == "STRAIGHT":
            straight_number += 1

            section_type_index = (
                straight_number
            )

            section_name = (
                f"straight"
                f"{section_type_index}"
            )

        else:
            curve_number += 1

            section_type_index = (
                curve_number
            )

            section_name = (
                f"curve"
                f"{section_type_index}"
            )

        left_section = (
            extract_section_from_resampled(
                left_s,
                left_resampled,
                start_boundary.left_s,
                end_boundary.left_s,
                left_total,
                args.closed,
            )
        )

        middle_section = (
            extract_section_from_resampled(
                middle_s,
                middle_resampled,
                start_boundary.middle_s,
                end_boundary.middle_s,
                middle_total,
                args.closed,
            )
        )

        right_section = (
            extract_section_from_resampled(
                right_s,
                right_resampled,
                start_boundary.right_s,
                end_boundary.right_s,
                right_total,
                args.closed,
            )
        )

        in_vertices = close_polygon(
            np.vstack(
                [
                    left_section,
                    middle_section[::-1],
                ]
            )
        )

        out_vertices = close_polygon(
            np.vstack(
                [
                    middle_section,
                    right_section[::-1],
                ]
            )
        )

        in_id = (
            f"IN{order_index}"
        )

        out_id = (
            f"OUT{order_index}"
        )

        in_section_data = {
            "roi": "IN",
            "track_order": order_index,
            "section_type": section_type,
            "section_type_index": section_type_index,
            "section_name": section_name,
            "line_names": {
                "outer": f"left_line_{section_name}",
                "inner": f"middle_line_{section_name}",
            },
            "outer_points": points_to_list(
                left_section
            ),
            "inner_points": points_to_list(
                middle_section
            ),
            "polygon_id": in_id,
        }

        out_section_data = {
            "roi": "OUT",
            "track_order": order_index,
            "section_type": section_type,
            "section_type_index": section_type_index,
            "section_name": section_name,
            "line_names": {
                "inner": f"middle_line_{section_name}",
                "outer": f"right_line_{section_name}",
            },
            "inner_points": points_to_list(
                middle_section
            ),
            "outer_points": points_to_list(
                right_section
            ),
            "polygon_id": out_id,
        }

        in_sections.append(
            in_section_data
        )

        out_sections.append(
            out_section_data
        )

        polygons.append(
            {
                "id": in_id,
                "roi": "IN",
                "track_order": order_index,
                "section_type": section_type,
                "section_type_index": section_type_index,
                "section_name": section_name,
                "vertices": points_to_list(
                    in_vertices
                ),
            }
        )

        polygons.append(
            {
                "id": out_id,
                "roi": "OUT",
                "track_order": order_index,
                "section_type": section_type,
                "section_type_index": section_type_index,
                "section_name": section_name,
                "vertices": points_to_list(
                    out_vertices
                ),
            }
        )

    boundary_data = []

    for index, boundary in enumerate(
        boundaries,
        start=1,
    ):
        boundary_data.append(
            {
                "roi": "SHARED",
                "id": index,
                "kind": boundary.kind,
                "points": [
                    points_to_list(
                        [boundary.left_point]
                    )[0],
                    points_to_list(
                        [boundary.middle_point]
                    )[0],
                    points_to_list(
                        [boundary.right_point]
                    )[0],
                ],
                "left_s": float(
                    boundary.left_s
                ),
                "middle_s": float(
                    boundary.middle_s
                ),
                "right_s": float(
                    boundary.right_s
                ),
            }
        )

    return {
        "metadata": {
            "coordinate_source": "/odom pose.position.x/y",
            "line_count": 3,
            "line_mode": "LEFT / MIDDLE / RIGHT",
            "frame_id": frame_id,
            "closed_track": bool(
                args.closed
            ),
            "resample_spacing_m": float(
                args.spacing
            ),
            "tangent_window_m": float(
                args.tangent_window
            ),
            "roi_definition": {
                "IN": "LEFT <-> MIDDLE",
                "OUT": "MIDDLE <-> RIGHT",
            },
        },
        "resampled_lines": {
            "left": points_to_list(
                left_resampled
            ),
            "middle": points_to_list(
                middle_resampled
            ),
            "right": points_to_list(
                right_resampled
            ),
        },
        "boundaries": boundary_data,
        "roi_sections": {
            "IN": in_sections,
            "OUT": out_sections,
        },
        "polygons": polygons,
    }


def forward_s_distance(
    start_s: float,
    end_s: float,
    total_s: float,
) -> float:
    """
    Closed path에서 start_s -> end_s의
    진행 방향 누적거리.
    """

    return (
        float(end_s)
        -
        float(start_s)
    ) % float(total_s)


def three_boundary_candidate_is_valid(
    boundaries: List[ThreeLineBoundary],
    index: int,
    candidate_s: float,
    middle_total: float,
    closed: bool,
    margin: float = 1.0e-3,
) -> bool:
    """
    드래그한 경계가 인접 경계를 넘어가지 않도록 검사한다.

    이유:
      경계 순서를 바꾸면
      STRAIGHT / CURVE의 track_order 의미가 달라질 수 있다.
    """

    count = len(
        boundaries
    )

    if count <= 1:
        return True

    if not closed:
        if boundaries[index].kind != "transition":
            return False

        lower = 0.0
        upper = middle_total

        if index > 0:
            lower = (
                boundaries[index - 1].middle_s
                +
                margin
            )

        if index < count - 1:
            upper = (
                boundaries[index + 1].middle_s
                -
                margin
            )

        return (
            lower
            <
            candidate_s
            <
            upper
        )

    # 경계가 2개뿐이면 서로 같은 위치로 겹치는 것만 방지한다.
    if count == 2:
        other_index = (
            1 - index
        )

        distance_to_other = min(
            forward_s_distance(
                candidate_s,
                boundaries[
                    other_index
                ].middle_s,
                middle_total,
            ),
            forward_s_distance(
                boundaries[
                    other_index
                ].middle_s,
                candidate_s,
                middle_total,
            ),
        )

        return (
            distance_to_other
            >
            margin
        )

    previous_index = (
        index - 1
    ) % count

    next_index = (
        index + 1
    ) % count

    previous_s = (
        boundaries[
            previous_index
        ].middle_s
    )

    next_s = (
        boundaries[
            next_index
        ].middle_s
    )

    whole_interval = (
        forward_s_distance(
            previous_s,
            next_s,
            middle_total,
        )
    )

    candidate_interval = (
        forward_s_distance(
            previous_s,
            candidate_s,
            middle_total,
        )
    )

    return (
        candidate_interval
        >
        margin
        and
        candidate_interval
        <
        whole_interval
        -
        margin
    )


def replace_three_boundary_at_s(
    boundaries: List[ThreeLineBoundary],
    index: int,
    new_s: float,
    middle: np.ndarray,
    left: np.ndarray,
    right: np.ndarray,
    args,
):
    """
    한 개 공유 경계를 MIDDLE상의 new_s로 이동시키고
    LEFT / RIGHT 교차점까지 다시 계산한다.
    """

    old_kind = (
        boundaries[index].kind
    )

    new_boundary = (
        make_three_boundary_at_s(
            middle,
            new_s,
            args.closed,
            args.tangent_window,
            old_kind,
        )
    )

    left_point, left_s, _ = (
        intersect_infinite_line_with_polyline(
            new_boundary.middle_point,
            new_boundary.normal,
            left,
        )
    )

    right_point, right_s, _ = (
        intersect_infinite_line_with_polyline(
            new_boundary.middle_point,
            new_boundary.normal,
            right,
        )
    )

    new_boundary.left_point = (
        left_point
    )

    new_boundary.left_s = float(
        left_s
    )

    new_boundary.right_point = (
        right_point
    )

    new_boundary.right_s = float(
        right_s
    )

    boundaries[index] = (
        new_boundary
    )


def restore_three_boundaries_from_s(
    boundaries: List[ThreeLineBoundary],
    original_s_values: List[float],
    middle: np.ndarray,
    left: np.ndarray,
    right: np.ndarray,
    args,
):
    for index, original_s in enumerate(
        original_s_values
    ):
        replace_three_boundary_at_s(
            boundaries,
            index,
            original_s,
            middle,
            left,
            right,
            args,
        )


def edit_three_line_boundaries_interactive(
    args,
    left: np.ndarray,
    middle: np.ndarray,
    right: np.ndarray,
    boundaries: List[ThreeLineBoundary],
    initial_result: Dict,
    frame_id: str,
) -> Dict:
    """
    3-Line ROI 결과 확인/수정 창.

    조작:
      Left drag : 빨간 공유 경계 이동
      Enter     : 현재 수정 상태 확정
      Esc       : 모든 수정 취소

    경계의 가운데 MIDDLE 점을 잡아 드래그한다.
    커서 위치는 MIDDLE polyline 위로 자동 projection된다.
    """

    if args.no_show:
        print(
            "[INFO] --no-show 사용 중이므로 "
            "interactive boundary editor를 건너뜁니다."
        )

        return initial_result

    middle_total = float(
        cumulative_lengths(
            middle
        )[-1]
    )

    original_s_values = [
        float(
            boundary.middle_s
        )
        for boundary
        in boundaries
    ]

    state = {
        "drag_index": None,
        "drag_start_s": None,
        "committed": False,
        "cancelled": False,
        "result": initial_result,
        "boundary_line_artists": [],
        "handle_scatter": None,
    }

    fig, ax = plt.subplots(
        figsize=(14, 10)
    )

    def redraw():
        ax.clear()

        draw_polygon_list(
            ax,
            state["result"]["polygons"],
            show_label=True,
        )

        draw_track_lines(
            ax,
            {
                "left": np.asarray(
                    state["result"][
                        "resampled_lines"
                    ]["left"],
                    dtype=float,
                ),
                "middle": np.asarray(
                    state["result"][
                        "resampled_lines"
                    ]["middle"],
                    dtype=float,
                ),
                "right": np.asarray(
                    state["result"][
                        "resampled_lines"
                    ]["right"],
                    dtype=float,
                ),
            },
            scatter=False,
        )

        state[
            "boundary_line_artists"
        ] = []

        middle_handles = []

        for boundary_index, boundary in enumerate(
            boundaries
        ):
            points = np.asarray(
                [
                    boundary.left_point,
                    boundary.middle_point,
                    boundary.right_point,
                ],
                dtype=float,
            )

            line_artist, = ax.plot(
                points[:, 0],
                points[:, 1],
                "--",
                color="crimson",
                linewidth=1.3,
                alpha=0.95,
                zorder=8,
                label=(
                    "Draggable shared boundary"
                    if boundary_index == 0
                    else None
                ),
            )

            state[
                "boundary_line_artists"
            ].append(
                line_artist
            )

            middle_handles.append(
                boundary.middle_point
            )

            ax.text(
                boundary.middle_point[0],
                boundary.middle_point[1],
                f"B{boundary_index + 1}",
                fontsize=8,
                ha="left",
                va="bottom",
                zorder=10,
            )

        middle_handles_array = np.asarray(
            middle_handles,
            dtype=float,
        )

        state[
            "handle_scatter"
        ] = ax.scatter(
            middle_handles_array[:, 0],
            middle_handles_array[:, 1],
            s=65,
            color="crimson",
            edgecolors="black",
            linewidths=0.6,
            zorder=11,
            label="Drag handle",
        )

        ax.set_aspect(
            "equal",
            adjustable="box",
        )

        ax.grid(
            True
        )

        ax.set_xlabel(
            "x [m]"
        )

        ax.set_ylabel(
            "y [m]"
        )

        ax.set_title(
            "3-Line ROI Boundary Editor\n"
            "Drag a red boundary handle | Enter: Save | Esc: Cancel"
        )

        ax.legend(
            loc="best"
        )

        fig.tight_layout()
        fig.canvas.draw_idle()

    def update_drag_artists(
        boundary_index: int,
    ):
        boundary = (
            boundaries[
                boundary_index
            ]
        )

        points = np.asarray(
            [
                boundary.left_point,
                boundary.middle_point,
                boundary.right_point,
            ],
            dtype=float,
        )

        line_artist = (
            state[
                "boundary_line_artists"
            ][boundary_index]
        )

        line_artist.set_data(
            points[:, 0],
            points[:, 1],
        )

        offsets = np.asarray(
            [
                boundary.middle_point
                for boundary
                in boundaries
            ],
            dtype=float,
        )

        state[
            "handle_scatter"
        ].set_offsets(
            offsets
        )

        fig.canvas.draw_idle()

    def pick_boundary_index(
        event,
    ):
        if (
            event.xdata is None
            or
            event.ydata is None
        ):
            return None

        cursor = np.array(
            [
                event.xdata,
                event.ydata,
            ],
            dtype=float,
        )

        handles = np.asarray(
            [
                boundary.middle_point
                for boundary
                in boundaries
            ],
            dtype=float,
        )

        distances = np.linalg.norm(
            handles
            -
            cursor,
            axis=1,
        )

        nearest_index = int(
            np.argmin(
                distances
            )
        )

        xlim = ax.get_xlim()
        ylim = ax.get_ylim()

        diagonal = float(
            np.hypot(
                xlim[1] - xlim[0],
                ylim[1] - ylim[0],
            )
        )

        pick_radius = max(
            diagonal * 0.02,
            0.5,
        )

        if (
            distances[
                nearest_index
            ]
            <=
            pick_radius
        ):
            return nearest_index

        return None

    def on_press(
        event,
    ):
        if (
            event.inaxes is not ax
            or
            event.button != 1
        ):
            return

        boundary_index = (
            pick_boundary_index(
                event
            )
        )

        if boundary_index is None:
            return

        if (
            not args.closed
            and
            boundaries[
                boundary_index
            ].kind
            !=
            "transition"
        ):
            print(
                "[WARN] Track start/end boundary는 이동하지 않습니다."
            )

            return

        state[
            "drag_index"
        ] = boundary_index

        state[
            "drag_start_s"
        ] = float(
            boundaries[
                boundary_index
            ].middle_s
        )

        print(
            f"[EDIT] B{boundary_index + 1} drag start"
        )

    def on_motion(
        event,
    ):
        boundary_index = (
            state[
                "drag_index"
            ]
        )

        if boundary_index is None:
            return

        if (
            event.inaxes is not ax
            or
            event.xdata is None
            or
            event.ydata is None
        ):
            return

        try:
            _, candidate_s, _, _ = (
                project_point_to_polyline(
                    np.array(
                        [
                            event.xdata,
                            event.ydata,
                        ],
                        dtype=float,
                    ),
                    middle,
                )
            )

            candidate_s = float(
                candidate_s
            )

            if not three_boundary_candidate_is_valid(
                boundaries,
                boundary_index,
                candidate_s,
                middle_total,
                args.closed,
            ):
                return

            replace_three_boundary_at_s(
                boundaries,
                boundary_index,
                candidate_s,
                middle,
                left,
                right,
                args,
            )

            update_drag_artists(
                boundary_index
            )

        except Exception:
            # 이동 중 교차점이 형성되지 않는 순간은 무시한다.
            return

    def on_release(
        event,
    ):
        boundary_index = (
            state[
                "drag_index"
            ]
        )

        if boundary_index is None:
            return

        try:
            state["result"] = (
                assemble_three_line_roi(
                    args,
                    left,
                    middle,
                    right,
                    boundaries,
                    frame_id,
                )
            )

            print(
                f"[EDIT] B{boundary_index + 1} updated: "
                f"s={boundaries[boundary_index].middle_s:.3f} m"
            )

        except Exception as exc:
            print(
                f"[WARN] 경계 수정 결과를 만들 수 없어 "
                f"B{boundary_index + 1}를 이전 위치로 복구합니다."
            )

            print(
                f"[WARN] {exc}"
            )

            replace_three_boundary_at_s(
                boundaries,
                boundary_index,
                state[
                    "drag_start_s"
                ],
                middle,
                left,
                right,
                args,
            )

            state["result"] = (
                assemble_three_line_roi(
                    args,
                    left,
                    middle,
                    right,
                    boundaries,
                    frame_id,
                )
            )

        state[
            "drag_index"
        ] = None

        state[
            "drag_start_s"
        ] = None

        redraw()

    def on_key(
        event,
    ):
        if event.key == "enter":
            state[
                "committed"
            ] = True

            print(
                "\n[OK] Boundary edit confirmed."
            )

            plt.close(
                fig
            )

        elif event.key == "escape":
            state[
                "cancelled"
            ] = True

            restore_three_boundaries_from_s(
                boundaries,
                original_s_values,
                middle,
                left,
                right,
                args,
            )

            state["result"] = (
                assemble_three_line_roi(
                    args,
                    left,
                    middle,
                    right,
                    boundaries,
                    frame_id,
                )
            )

            print(
                "\n[INFO] Boundary edits cancelled."
            )

            plt.close(
                fig
            )

    fig.canvas.mpl_connect(
        "button_press_event",
        on_press,
    )

    fig.canvas.mpl_connect(
        "motion_notify_event",
        on_motion,
    )

    fig.canvas.mpl_connect(
        "button_release_event",
        on_release,
    )

    fig.canvas.mpl_connect(
        "key_press_event",
        on_key,
    )

    redraw()

    print(
        "\n============================================"
    )
    print(
        "3-Line ROI Boundary Editor"
    )
    print(
        "============================================"
    )
    print(
        "빨간 공유 경계의 MIDDLE 점을 마우스로 드래그"
    )
    print(
        "경계는 MIDDLE line 위로 자동 투영"
    )
    print(
        "인접 경계를 넘어가는 이동은 차단"
    )
    print(
        "마우스를 놓으면 IN/OUT Polygon 즉시 재생성"
    )
    print(
        "Enter : 현재 수정 결과 확정 후 저장 진행"
    )
    print(
        "Esc   : 모든 수정 취소"
    )
    print(
        "============================================"
    )

    plt.show()

    if not state["committed"]:
        if not state["cancelled"]:
            print(
                "[INFO] Enter 없이 창을 닫았습니다. "
                "수정 전 결과를 사용합니다."
            )

            restore_three_boundaries_from_s(
                boundaries,
                original_s_values,
                middle,
                left,
                right,
                args,
            )

            state["result"] = (
                assemble_three_line_roi(
                    args,
                    left,
                    middle,
                    right,
                    boundaries,
                    frame_id,
                )
            )

    return state["result"]


def build_three_line_roi(
    args,
    data_dir: str,
) -> Dict:
    left_path = os.path.join(
        data_dir,
        "left_raw.csv",
    )

    middle_path = os.path.join(
        data_dir,
        "middle_raw.csv",
    )

    right_path = os.path.join(
        data_dir,
        "right_raw.csv",
    )

    left_raw, left_frame = (
        load_line_csv(
            left_path
        )
    )

    middle_raw, middle_frame = (
        load_line_csv(
            middle_path
        )
    )

    right_raw, right_frame = (
        load_line_csv(
            right_path
        )
    )

    frame_ids = [
        frame
        for frame
        in [
            left_frame,
            middle_frame,
            right_frame,
        ]
        if frame
    ]

    if (
        frame_ids
        and
        len(
            set(frame_ids)
        )
        != 1
    ):
        raise ValueError(
            "LEFT/MIDDLE/RIGHT의 frame_id가 서로 다릅니다."
        )

    frame_id = (
        frame_ids[0]
        if frame_ids
        else ""
    )

    left = prepare_polyline(
        left_raw,
        args.closed,
    )

    middle = prepare_polyline(
        middle_raw,
        args.closed,
    )

    right = prepare_polyline(
        right_raw,
        args.closed,
    )

    middle_total = float(
        cumulative_lengths(
            middle
        )[-1]
    )

    # --------------------------------------------------------
    # STEP 1: 기존 방식으로 초기 경계 클릭
    # --------------------------------------------------------

    boundaries = (
        select_three_line_boundaries(
            left,
            middle,
            right,
            args.closed,
            args.tangent_window,
        )
    )

    if not args.closed:
        boundaries = [
            make_three_boundary_at_s(
                middle,
                0.0,
                False,
                args.tangent_window,
                "track_start",
            ),
            *boundaries,
            make_three_boundary_at_s(
                middle,
                middle_total,
                False,
                args.tangent_window,
                "track_end",
            ),
        ]

    populate_three_line_intersections(
        boundaries,
        left,
        right,
    )

    # --------------------------------------------------------
    # LEFT / RIGHT 진행방향 보정
    # --------------------------------------------------------

    left_score = (
        three_side_orientation_score(
            boundaries,
            left,
            "left",
            args.closed,
            args.tangent_window,
        )
    )

    right_score = (
        three_side_orientation_score(
            boundaries,
            right,
            "right",
            args.closed,
            args.tangent_window,
        )
    )

    if left_score < 0.0:
        print(
            "[INFO] LEFT 진행방향이 MIDDLE과 반대 -> LEFT reverse"
        )

        left = reverse_polyline(
            left,
            args.closed,
        )

    if right_score < 0.0:
        print(
            "[INFO] RIGHT 진행방향이 MIDDLE과 반대 -> RIGHT reverse"
        )

        right = reverse_polyline(
            right,
            args.closed,
        )

    if (
        left_score < 0.0
        or
        right_score < 0.0
    ):
        populate_three_line_intersections(
            boundaries,
            left,
            right,
        )

    # --------------------------------------------------------
    # STEP 2: 초기 Polygon 생성
    # --------------------------------------------------------

    result = assemble_three_line_roi(
        args,
        left,
        middle,
        right,
        boundaries,
        frame_id,
    )

    # --------------------------------------------------------
    # STEP 3: 결과 화면에서 공유 경계 직접 드래그
    #
    # Enter를 눌러야 수정 결과가 확정된다.
    # 이 함수가 반환한 result가 이후 JSON/TXT/PNG로 저장된다.
    # --------------------------------------------------------

    result = (
        edit_three_line_boundaries_interactive(
            args,
            left,
            middle,
            right,
            boundaries,
            result,
            frame_id,
        )
    )

    return result


# ============================================================
# 10. Four-Line Pair ROI Builder
# ============================================================

def build_pair_roi(
    roi_name: str,
    reference_name: str,
    reference: np.ndarray,
    other_name: str,
    other: np.ndarray,
    all_lines_for_selection: Dict[
        str,
        np.ndarray,
    ],
    args,
    background_polygons: Optional[
        List[Dict]
    ] = None,
) -> Tuple[
    np.ndarray,
    np.ndarray,
    List[Dict],
    List[Dict],
    List[Dict],
]:
    reference_total = float(
        cumulative_lengths(
            reference
        )[-1]
    )

    boundaries = select_pair_boundaries(
        roi_name=roi_name,
        reference_name=reference_name,
        reference=reference,
        other=other,
        all_lines=all_lines_for_selection,
        closed=args.closed,
        tangent_window=args.tangent_window,
        background_polygons=background_polygons,
    )

    if not args.closed:
        boundaries = [
            make_pair_boundary_at_s(
                reference,
                0.0,
                False,
                args.tangent_window,
                "track_start",
            ),
            *boundaries,
            make_pair_boundary_at_s(
                reference,
                reference_total,
                False,
                args.tangent_window,
                "track_end",
            ),
        ]

    populate_pair_intersections(
        boundaries,
        other,
    )

    score = pair_orientation_score(
        boundaries,
        other,
        args.closed,
        args.tangent_window,
    )

    if score < 0.0:
        print(
            f"[INFO] {other_name.upper()} 진행방향이 "
            f"{reference_name.upper()}과 반대 -> reverse"
        )

        other = reverse_polyline(
            other,
            args.closed,
        )

        populate_pair_intersections(
            boundaries,
            other,
        )

    # 초기 polygon 생성 후 바로 경계 드래그 수정 단계 진행
    return edit_pair_boundaries_interactive(
        roi_name=roi_name,
        reference_name=reference_name,
        reference=reference,
        other_name=other_name,
        other=other,
        all_lines=all_lines_for_selection,
        boundaries=boundaries,
        args=args,
        background_polygons=background_polygons,
    )

# ============================================================
# 11. Four-Line ROI Build
# ============================================================

def build_four_line_roi(
    args,
    data_dir: str,
) -> Dict:
    file_map = {
        "left": os.path.join(
            data_dir,
            "left_raw.csv",
        ),
        "middle1": os.path.join(
            data_dir,
            "middle1_raw.csv",
        ),
        "middle2": os.path.join(
            data_dir,
            "middle2_raw.csv",
        ),
        "right": os.path.join(
            data_dir,
            "right_raw.csv",
        ),
    }

    raw_lines = {}
    frame_ids = []

    for name, path in file_map.items():
        points, frame_id = load_line_csv(
            path
        )

        raw_lines[name] = (
            prepare_polyline(
                points,
                args.closed,
            )
        )

        if frame_id:
            frame_ids.append(
                frame_id
            )

    if (
        frame_ids
        and
        len(
            set(frame_ids)
        )
        != 1
    ):
        raise ValueError(
            "LEFT/MIDDLE1/MIDDLE2/RIGHT의 frame_id가 서로 다릅니다."
        )

    left = raw_lines["left"]
    middle1 = raw_lines["middle1"]
    middle2 = raw_lines["middle2"]
    right = raw_lines["right"]

    all_lines = {
        "left": left,
        "middle1": middle1,
        "middle2": middle2,
        "right": right,
    }

    # --------------------------------------------------------
    # STEP 1: IN 한 바퀴 클릭
    # IN = LEFT <-> MIDDLE1
    # --------------------------------------------------------

    (
        middle1_resampled,
        left_resampled,
        in_sections,
        in_polygons,
        in_boundaries,
    ) = build_pair_roi(
        roi_name="IN",
        reference_name="middle1",
        reference=middle1,
        other_name="left",
        other=left,
        all_lines_for_selection=all_lines,
        args=args,
        background_polygons=None,
    )

    print(
        "\n[OK] IN Polygon 생성 완료."
    )
    print(
        "다음 창에서 생성된 IN Polygon을 확인한 뒤 "
        "MIDDLE2 위에 OUT 경계점을 한 바퀴 클릭하십시오."
    )

    # --------------------------------------------------------
    # STEP 2: IN Polygon을 띄운 상태에서 OUT 클릭
    # OUT = MIDDLE2 <-> RIGHT
    # --------------------------------------------------------

    (
        middle2_resampled,
        right_resampled,
        out_sections,
        out_polygons,
        out_boundaries,
    ) = build_pair_roi(
        roi_name="OUT",
        reference_name="middle2",
        reference=middle2,
        other_name="right",
        other=right,
        all_lines_for_selection=all_lines,
        args=args,
        background_polygons=in_polygons,
    )

    polygons = (
        in_polygons
        +
        out_polygons
    )

    boundaries = (
        in_boundaries
        +
        out_boundaries
    )

    return {
        "metadata": {
            "coordinate_source": "/odom pose.position.x/y",
            "line_count": 4,
            "line_mode": "LEFT / MIDDLE1 / MIDDLE2 / RIGHT",
            "frame_id": (
                frame_ids[0]
                if frame_ids
                else ""
            ),
            "closed_track": bool(
                args.closed
            ),
            "resample_spacing_m": float(
                args.spacing
            ),
            "tangent_window_m": float(
                args.tangent_window
            ),
            "roi_definition": {
                "IN": "LEFT <-> MIDDLE1",
                "CENTER_GAP": "MIDDLE1 <-> MIDDLE2 (ROI 생성 안 함)",
                "OUT": "MIDDLE2 <-> RIGHT",
            },
        },
        "resampled_lines": {
            "left": points_to_list(
                left_resampled
            ),
            "middle1": points_to_list(
                middle1_resampled
            ),
            "middle2": points_to_list(
                middle2_resampled
            ),
            "right": points_to_list(
                right_resampled
            ),
        },
        "boundaries": boundaries,
        "roi_sections": {
            "IN": in_sections,
            "OUT": out_sections,
        },
        "polygons": polygons,
    }



# ============================================================
# 11-1. Resume Existing 3-Line Polygon Boundary Edit
# ============================================================

def load_existing_track_roi_json(
    path: str,
) -> Dict:
    """
    기존 track_roi.json을 읽는다.
    Polygon 경계 수정 재개 모드의 기준 데이터다.
    """
    if not os.path.exists(
        path
    ):
        raise FileNotFoundError(
            "기존 Polygon 결과 JSON을 찾을 수 없습니다: "
            f"{path}"
        )

    with open(
        path,
        "r",
        encoding="utf-8",
    ) as fp:
        data = json.load(
            fp
        )

    if not isinstance(
        data,
        dict,
    ):
        raise ValueError(
            "track_roi.json 형식이 올바르지 않습니다."
        )

    return data


def rebuild_three_line_boundaries_from_saved_result(
    args,
    saved_result: Dict,
    left: np.ndarray,
    middle: np.ndarray,
    right: np.ndarray,
) -> List[ThreeLineBoundary]:
    """
    저장된 track_roi.json의 SHARED boundary 좌표를 현재 MIDDLE에 다시 투영하여
    interactive editor용 ThreeLineBoundary를 복원한다.
    """
    saved_boundaries = saved_result.get(
        "boundaries",
        [],
    )

    shared = [
        boundary
        for boundary in saved_boundaries
        if str(
            boundary.get(
                "roi",
                "",
            )
        ).upper()
        ==
        "SHARED"
    ]

    if len(shared) < 2:
        raise ValueError(
            "기존 JSON에서 3-Line SHARED boundary를 2개 이상 찾지 못했습니다."
        )

    try:
        shared = sorted(
            shared,
            key=lambda item: int(
                item.get(
                    "id",
                    0,
                )
            ),
        )
    except Exception:
        pass

    rebuilt = []

    for saved_boundary in shared:
        points = np.asarray(
            saved_boundary.get(
                "points",
                [],
            ),
            dtype=float,
        )

        if (
            points.ndim != 2
            or points.shape[1] != 2
            or len(points) < 2
        ):
            raise ValueError(
                "기존 JSON boundary points 형식이 올바르지 않습니다."
            )

        # 3-Line 저장 형식:
        # [LEFT 교점, MIDDLE 점, RIGHT 교점]
        if len(points) >= 3:
            saved_middle_point = points[1]
        else:
            saved_middle_point = np.mean(
                points,
                axis=0,
            )

        _, middle_s, _, _ = (
            project_point_to_polyline(
                saved_middle_point,
                middle,
            )
        )

        kind = str(
            saved_boundary.get(
                "kind",
                "transition",
            )
        )

        rebuilt.append(
            make_three_boundary_at_s(
                middle,
                float(
                    middle_s
                ),
                args.closed,
                args.tangent_window,
                kind,
            )
        )

    rebuilt = remove_duplicate_three_boundaries(
        rebuilt,
        args.closed,
    )

    populate_three_line_intersections(
        rebuilt,
        left,
        right,
    )

    return rebuilt


def run_existing_polygon_boundary_workflow(
    args,
):
    """
    작업 모드 2:
      기존 track_roi.json 로드
      -> 초기 경계 클릭 생략
      -> 3-Line 또는 4-Line Polygon 경계 드래그 수정
      -> Dense 다시 생성/편집
      -> 결과 저장
    """
    data_dir = os.path.abspath(
        args.data_dir
    )

    saved_result = run_silent_step(
        "기존 Track ROI JSON 로드",
        load_existing_track_roi_json,
        args.output,
    )

    metadata = saved_result.get(
        "metadata",
        {},
    )

    line_count = int(
        metadata.get(
            "line_count",
            0,
        )
    )

    args.closed = bool(
        metadata.get(
            "closed_track",
            args.closed,
        )
    )

    frame_id = str(
        metadata.get(
            "frame_id",
            "",
        )
    )

    if line_count == 3:
        raw_lines = dense_load_raw_boundaries(
            data_dir,
            3,
            args.closed,
        )

        left = raw_lines["left"]
        middle = raw_lines["middle"]
        right = raw_lines["right"]

        boundaries = run_silent_step(
            "기존 3-Line Polygon 경계 복원",
            rebuild_three_line_boundaries_from_saved_result,
            args,
            saved_result,
            left,
            middle,
            right,
        )

        left_score = three_side_orientation_score(
            boundaries,
            left,
            "left",
            args.closed,
            args.tangent_window,
        )

        right_score = three_side_orientation_score(
            boundaries,
            right,
            "right",
            args.closed,
            args.tangent_window,
        )

        if left_score < 0.0:
            left = reverse_polyline(
                left,
                args.closed,
            )

        if right_score < 0.0:
            right = reverse_polyline(
                right,
                args.closed,
            )

        if left_score < 0.0 or right_score < 0.0:
            populate_three_line_intersections(
                boundaries,
                left,
                right,
            )

        current_result = assemble_three_line_roi(
            args,
            left,
            middle,
            right,
            boundaries,
            frame_id,
        )

        edited_result = edit_three_line_boundaries_interactive(
            args,
            left,
            middle,
            right,
            boundaries,
            current_result,
            frame_id,
        )

    elif line_count == 4:
        raw_lines = dense_load_raw_boundaries(
            data_dir,
            4,
            args.closed,
        )

        left = raw_lines["left"]
        middle1 = raw_lines["middle1"]
        middle2 = raw_lines["middle2"]
        right = raw_lines["right"]

        all_lines = {
            "left": left,
            "middle1": middle1,
            "middle2": middle2,
            "right": right,
        }

        in_boundaries = run_silent_step(
            "기존 IN Polygon 경계 복원",
            rebuild_pair_boundaries_from_saved_result,
            args,
            saved_result,
            "IN",
            "middle1",
            middle1,
            left,
        )

        (
            middle1_resampled,
            left_resampled,
            in_sections,
            in_polygons,
            in_boundary_data,
        ) = edit_pair_boundaries_interactive(
            roi_name="IN",
            reference_name="middle1",
            reference=middle1,
            other_name="left",
            other=left,
            all_lines=all_lines,
            boundaries=in_boundaries,
            args=args,
            background_polygons=None,
        )

        out_boundaries = run_silent_step(
            "기존 OUT Polygon 경계 복원",
            rebuild_pair_boundaries_from_saved_result,
            args,
            saved_result,
            "OUT",
            "middle2",
            middle2,
            right,
        )

        (
            middle2_resampled,
            right_resampled,
            out_sections,
            out_polygons,
            out_boundary_data,
        ) = edit_pair_boundaries_interactive(
            roi_name="OUT",
            reference_name="middle2",
            reference=middle2,
            other_name="right",
            other=right,
            all_lines=all_lines,
            boundaries=out_boundaries,
            args=args,
            background_polygons=in_polygons,
        )

        edited_result = {
            "metadata": {
                "coordinate_source": "/odom pose.position.x/y",
                "line_count": 4,
                "line_mode": "LEFT / MIDDLE1 / MIDDLE2 / RIGHT",
                "frame_id": frame_id,
                "closed_track": bool(args.closed),
                "resample_spacing_m": float(args.spacing),
                "tangent_window_m": float(args.tangent_window),
                "roi_definition": {
                    "IN": "LEFT <-> MIDDLE1",
                    "CENTER_GAP": "MIDDLE1 <-> MIDDLE2 (ROI 생성 안 함)",
                    "OUT": "MIDDLE2 <-> RIGHT",
                },
            },
            "resampled_lines": {
                "left": points_to_list(left_resampled),
                "middle1": points_to_list(middle1_resampled),
                "middle2": points_to_list(middle2_resampled),
                "right": points_to_list(right_resampled),
            },
            "boundaries": (
                in_boundary_data
                +
                out_boundary_data
            ),
            "roi_sections": {
                "IN": in_sections,
                "OUT": out_sections,
            },
            "polygons": (
                in_polygons
                +
                out_polygons
            ),
        }

    else:
        raise ValueError(
            f"지원하지 않는 기존 JSON line_count입니다: {line_count}"
        )

    print(
        "[OK] Polygon 경계 수정 단계 완료"
    )

    if line_count == 3:
        offset_result = offset_left_right_interactive_after_polygon(
            result=edited_result,
            data_dir=data_dir,
            left_offset_m=args.left_offset,
            right_offset_m=args.right_offset,
            initial_window_points=args.offset_window,
            no_show=bool(args.no_show),
        )

        if offset_result is None:
            print(
                "[CANCEL] LEFT/RIGHT offset 단계가 확정되지 않았습니다."
            )
            print(
                "         Dense 중심선 단계로 진행하지 않습니다."
            )
            return

        edited_result = apply_three_line_offset_to_roi_result(
            result=edited_result,
            offset_result=offset_result,
        )

        print(
            "[OK] LEFT/RIGHT offset 저장 및 최종 ROI 경계 반영 완료 "
            f"(window=±{offset_result['window_points']} points)"
        )

        edited_result = edit_and_save_three_track_lines_after_offset(
            result=edited_result,
            data_dir=data_dir,
            no_show=bool(args.no_show),
        )

    dense_result = run_dense_workflow_from_result(
        result=edited_result,
        args=args,
        data_dir=data_dir,
    )

    if dense_result is None:
        print(
            "[CANCEL] Dense 수동 편집"
        )
        print(
            "         신규 결과 파일은 저장하지 않았습니다."
        )
        return

    in_info = dense_result["in_info"]
    out_info = dense_result["out_info"]

    def save_resume_outputs():
        save_json(
            edited_result,
            args.output,
        )

        save_roi_txt(
            edited_result,
            args.txt_output,
        )

        save_dense_roi_csv(
            info=in_info,
            path=args.in_dense_output,
        )

        save_dense_roi_csv(
            info=out_info,
            path=args.out_dense_output,
        )

        save_path_xy_csv(
            info=in_info,
            path=args.path_in_output,
        )

        save_path_xy_csv(
            info=out_info,
            path=args.path_out_output,
        )

    run_silent_step(
        "결과 파일 저장",
        save_resume_outputs,
    )

    run_silent_step(
        "최종 ROI 시각화",
        show_and_save_dense_roi_figure,
        display_lines=dense_result[
            "display_lines"
        ],
        in_info=in_info,
        out_info=out_info,
        figure_path=args.dense_figure,
        roi_plot_step=args.roi_plot_step,
        in_label=dense_result[
            "in_label"
        ],
        out_label=dense_result[
            "out_label"
        ],
        show=not args.no_show,
    )

    print(
        "[OK] 전체 작업 완료"
    )

# ============================================================
# 12. Main ROI Build
# ============================================================

def build_track_roi(
    args,
):
    """
    간결 로그 통합 Build Pipeline.

    화면 출력:
        각 작업의 성공/실패만 표시한다.

    저장:
        track_roi.json
        track_roi.txt
        left_track.csv
        middle_track.csv
        right_track.csv
        in_dense.csv
        out_dense.csv
        in_out_dense.png

    비활성:
        track_roi_cells.txt
        track_roi.png
    """
    data_dir = os.path.abspath(
        args.data_dir
    )

    # 사용자가 직접 3-Line / 4-Line 선택
    line_count = ask_line_count()

    print(
        f"[OK] 모드 선택: {line_count}-Line"
    )

    # --------------------------------------------------------
    # 1. Track ROI / Polygon 생성
    #
    # 3-Line 전체 생성 순서:
    #   7) RAW LEFT/MIDDLE/RIGHT로 section boundary 선택
    #   8) Polygon boundary 수정
    #   9) LEFT/RIGHT heading offset
    #   1~6) offset 적용 후 LEFT_TRACK/MIDDLE_TRACK/RIGHT_TRACK 편집
    #   10~11) [DISABLED] IN/OUT Dense 직선/곡선 편집
    #   12) Dense ROI 계산 / 최종 확인 / 저장
    #
    # IMPORTANT:
    #   build 단계에서는 *_raw.csv를 수정하지 않는다.
    # --------------------------------------------------------

    if line_count == 3:
        result = run_silent_step(
            "Track ROI 생성",
            build_three_line_roi,
            args,
            data_dir,
        )

    else:
        result = run_silent_step(
            "Track ROI 생성",
            build_four_line_roi,
            args,
            data_dir,
        )

    # --------------------------------------------------------
    # 3.5. LEFT / RIGHT heading 기반 offset
    #
    # LEFT  : 진행 heading 기준 왼쪽으로 offset
    # RIGHT : 진행 heading 기준 오른쪽으로 offset
    #
    # window 창의 Slider에서 앞/뒤 몇 개 waypoint를 볼지 조절한다.
    # Enter를 눌러야 left_offset.csv / right_offset.csv가 저장되고
    # 다음 Dense 중심선 생성/직선화 단계로 진행한다.
    # --------------------------------------------------------

    if line_count == 3:
        offset_result = offset_left_right_interactive_after_polygon(
            result=result,
            data_dir=data_dir,
            left_offset_m=args.left_offset,
            right_offset_m=args.right_offset,
            initial_window_points=args.offset_window,
            no_show=bool(args.no_show),
        )

        if offset_result is None:
            print(
                "[CANCEL] LEFT/RIGHT offset 단계가 확정되지 않았습니다."
            )
            print(
                "         Dense 중심선 단계로 진행하지 않습니다."
            )
            return

        result = apply_three_line_offset_to_roi_result(
            result=result,
            offset_result=offset_result,
        )

        print(
            "[OK] LEFT/RIGHT offset 저장 및 최종 ROI 경계 반영 완료 "
            f"(window=±{offset_result['window_points']} points)"
        )

        # ----------------------------------------------------
        # 1~6. Offset 기반 최종 Track line 편집
        #
        # LEFT   = LEFT_OFFSET
        # MIDDLE = MIDDLE
        # RIGHT  = RIGHT_OFFSET
        #
        # RAW 파일은 건드리지 않고 최종 결과를
        # left_track.csv / middle_track.csv / right_track.csv로 저장한다.
        # ----------------------------------------------------
        result = edit_and_save_three_track_lines_after_offset(
            result=result,
            data_dir=data_dir,
            no_show=bool(args.no_show),
        )

    # --------------------------------------------------------
    # 10~11. [DISABLED] Dense 직선/곡선 편집
    # 12. Dense ROI 계산 / 최종 확인
    # --------------------------------------------------------

    dense_result = (
        run_dense_workflow_from_result(
            result=result,
            args=args,
            data_dir=data_dir,
        )
    )

    if dense_result is None:
        print(
            "[CANCEL] Dense 수동 편집"
        )
        print(
            "         신규 결과 파일은 저장하지 않았습니다."
        )
        return

    in_info = dense_result[
        "in_info"
    ]

    out_info = dense_result[
        "out_info"
    ]

    # --------------------------------------------------------
    # 7. 결과 저장
    #
    # 현재 사용하는 파일만 저장.
    #
    # [DISABLED]
    # save_json(...)
    # save_roi_cells_txt(...)
    # visualize_roi_data(... track_roi.png ...)
    # --------------------------------------------------------

    def save_selected_outputs():
        # 다음 실행에서 Polygon 경계 수정부터 재개할 수 있도록
        # track_roi.json도 함께 저장한다.
        save_json(
            result,
            args.output,
        )

        save_roi_txt(
            result,
            args.txt_output,
        )

        save_dense_roi_csv(
            info=in_info,
            path=args.in_dense_output,
        )

        save_dense_roi_csv(
            info=out_info,
            path=args.out_dense_output,
        )

        save_path_xy_csv(
            info=in_info,
            path=args.path_in_output,
        )

        save_path_xy_csv(
            info=out_info,
            path=args.path_out_output,
        )

    run_silent_step(
        "결과 파일 저장",
        save_selected_outputs,
    )

    # --------------------------------------------------------
    # 8. 최종 Dense ROI 시각화
    # --------------------------------------------------------

    run_silent_step(
        "최종 ROI 시각화",
        show_and_save_dense_roi_figure,
        display_lines=dense_result[
            "display_lines"
        ],
        in_info=in_info,
        out_info=out_info,
        figure_path=args.dense_figure,
        roi_plot_step=args.roi_plot_step,
        in_label=dense_result[
            "in_label"
        ],
        out_label=dense_result[
            "out_label"
        ],
        show=not args.no_show,
    )

    print(
        "[OK] 전체 작업 완료"
    )


# ============================================================
# 13. Final Visualization
# ============================================================



def draw_cell_overlay(
    ax,
    data: Dict,
):
    """
    최종 시각화에서 ROI Cell 분할선까지 함께 표시한다.

    - IN Cells  : dark green line
    - OUT Cells : dark blue line

    Cell 정보는 JSON에 직접 저장하지 않고,
    roi_sections + resample_spacing_m 정보를 이용해
    시각화 시 다시 생성한다.
    """
    metadata = data.get(
        "metadata",
        {},
    )

    roi_sections = data.get(
        "roi_sections",
        {},
    )

    spacing = float(
        metadata.get(
            "resample_spacing_m",
            0.5,
        )
    )

    if spacing <= 0.0:
        return

    try:
        in_cells = build_cells_from_sections(
            roi_sections.get(
                "IN",
                [],
            ),
            spacing,
        )

        out_cells = build_cells_from_sections(
            roi_sections.get(
                "OUT",
                [],
            ),
            spacing,
        )

    except Exception as exc:
        print(
            f"[WARN] Cell 시각화 생성 실패: {exc}"
        )
        return

    first_in = True
    first_out = True

    for vertices in in_cells:
        vertices_array = np.asarray(
            vertices,
            dtype=float,
        )

        patch = MplPolygon(
            vertices_array,
            closed=True,
            facecolor="none",
            edgecolor="darkgreen",
            linewidth=0.55,
            alpha=0.75,
            zorder=6,
            label=(
                "IN cells"
                if first_in
                else None
            ),
        )

        ax.add_patch(
            patch
        )

        first_in = False

    for vertices in out_cells:
        vertices_array = np.asarray(
            vertices,
            dtype=float,
        )

        patch = MplPolygon(
            vertices_array,
            closed=True,
            facecolor="none",
            edgecolor="darkblue",
            linewidth=0.55,
            alpha=0.75,
            zorder=6,
            label=(
                "OUT cells"
                if first_out
                else None
            ),
        )

        ax.add_patch(
            patch
        )

        first_out = False

def visualize_roi_data(
    data: Dict,
    save_path: str = None,
    show: bool = True,
):
    fig, ax = plt.subplots(
        figsize=(14, 10)
    )

    draw_polygon_list(
        ax,
        data["polygons"],
        show_label=True,
    )

    lines = {
        name: np.asarray(
            points,
            dtype=float,
        )
        for name, points
        in data[
            "resampled_lines"
        ].items()
    }

    draw_track_lines(
        ax,
        lines,
        scatter=True,
    )

    # --------------------------------------------------------
    # Cell overlay
    # track_roi_cells.txt와 동일한 Cell 구성을
    # 최종 Figure에도 함께 시각화한다.
    # --------------------------------------------------------
    draw_cell_overlay(
        ax,
        data,
    )

    first_shared = True
    first_in = True
    first_out = True

    for boundary in data[
        "boundaries"
    ]:
        points = np.asarray(
            boundary["points"],
            dtype=float,
        )

        roi = boundary["roi"]

        if roi == "SHARED":
            color = "crimson"

            label = (
                "Shared section boundary"
                if first_shared
                else None
            )

            first_shared = False

        elif roi == "IN":
            color = "royalblue"

            label = (
                "IN section boundary"
                if first_in
                else None
            )

            first_in = False

        else:
            color = "purple"

            label = (
                "OUT section boundary"
                if first_out
                else None
            )

            first_out = False

        ax.plot(
            points[:, 0],
            points[:, 1],
            "--",
            color=color,
            linewidth=1.0,
            alpha=0.85,
            label=label,
        )

        ax.scatter(
            points[:, 0],
            points[:, 1],
            s=24,
            color=color,
            zorder=5,
        )

    ax.set_aspect(
        "equal",
        adjustable="box",
    )

    ax.grid(
        True
    )

    ax.set_xlabel(
        "x [m]"
    )

    ax.set_ylabel(
        "y [m]"
    )

    if (
        data["metadata"]["line_count"]
        ==
        3
    ):
        title = (
            "3-Line Track ROI Polygons"
        )

    else:
        title = (
            "4-Line Track ROI Polygons "
            "(MIDDLE1-MIDDLE2 gap excluded)"
        )

    ax.set_title(
        title
    )

    ax.legend(
        loc="best"
    )

    fig.tight_layout()

    if save_path:
        os.makedirs(
            os.path.dirname(
                os.path.abspath(
                    save_path
                )
            ),
            exist_ok=True,
        )

        fig.savefig(
            save_path,
            dpi=200,
            bbox_inches="tight",
        )

        print(
            f"[OK] 시각화 이미지 저장: "
            f"{save_path}"
        )

    if show:
        plt.show()

    else:
        plt.close(
            fig
        )


def visualize_from_json(
    args,
):
    with open(
        args.input,
        "r",
        encoding="utf-8",
    ) as fp:
        data = json.load(
            fp
        )

    visualize_roi_data(
        data,
        args.save,
        show=not args.no_show,
    )




def load_existing_dense_xy(
    path: str,
) -> np.ndarray:
    """
    기존 in_dense.csv / out_dense.csv에서 x, y만 읽는다.

    CSV에 기존 roi_radius 또는 distance column이 있어도
    x, y만 사용하므로 그대로 재사용 가능하다.
    """
    if not os.path.exists(
        path
    ):
        raise FileNotFoundError(
            f"기존 Dense 파일을 찾을 수 없습니다: {path}"
        )

    points = []

    with open(
        path,
        "r",
        newline="",
        encoding="utf-8-sig",
    ) as fp:
        reader = csv.DictReader(
            fp
        )

        fieldnames = set(
            reader.fieldnames
            or
            []
        )

        if not {
            "x",
            "y",
        }.issubset(
            fieldnames
        ):
            raise ValueError(
                f"{path}: CSV header에 x, y가 필요합니다."
            )

        for row in reader:
            points.append([
                float(
                    row["x"]
                ),
                float(
                    row["y"]
                ),
            ])

    if len(points) < 2:
        raise ValueError(
            f"{path}: 유효한 Dense waypoint가 2개 미만입니다."
        )

    return np.asarray(
        points,
        dtype=np.float64,
    )


def run_existing_dense_workflow(
    args,
    line_count: int,
):
    """
    기존 IN / OUT Dense를 그대로 불러온 뒤,
    중앙선 수동 수정부터 다시 수행한다.

    이 모드에서 하지 않는 것:
        - Track ROI 재생성
        - IN / OUT Dense 초기 생성

    이 모드에서 수행하는 것:
        - 기존 in_dense.csv / out_dense.csv 로드
        - Dense manual editor
        - 수정 후 약 0.30 m 재샘플링
        - ROI radius 계산
        - Dense CSV 갱신
        - 최종 ROI 시각화
    """
    data_dir = os.path.abspath(
        args.data_dir
    )

    closed = bool(
        args.closed
    )

    # --------------------------------------------------------
    # 1. 기존 Dense load
    # --------------------------------------------------------

    def load_existing_pair():
        in_dense = load_existing_dense_xy(
            args.in_dense_output
        )

        out_dense = load_existing_dense_xy(
            args.out_dense_output
        )

        return (
            in_dense,
            out_dense,
        )

    (
        in_dense,
        out_dense,
    ) = run_silent_step(
        "기존 IN/OUT Dense 로드",
        load_existing_pair,
    )

    # --------------------------------------------------------
    # 2. 원본 차선 load
    # --------------------------------------------------------

    raw_lines = run_silent_step(
        "원본 차선 데이터 로드",
        dense_load_raw_boundaries,
        data_dir,
        line_count,
        closed,
    )

    # --------------------------------------------------------
    # 3. 편집창 표시용 line / label
    # --------------------------------------------------------

    display_lines = {
        name.upper(): points
        for name, points
        in raw_lines.items()
    }

    if line_count == 3:
        for offset_name, offset_file in (
            ("LEFT_OFFSET", "left_offset.csv"),
            ("RIGHT_OFFSET", "right_offset.csv"),
        ):
            offset_path = os.path.join(
                data_dir,
                offset_file,
            )

            if os.path.exists(offset_path):
                try:
                    offset_points, _ = load_line_csv(
                        offset_path
                    )
                    display_lines[offset_name] = prepare_polyline(
                        offset_points,
                        closed,
                    )
                except Exception as exc:
                    print(
                        f"[WARN] {offset_file} display load failed: {exc}"
                    )

    if line_count == 3:
        if bool(
            metadata.get(
                "offset_applied_to_final_roi",
                False,
            )
        ):
            in_label = (
                "IN = LEFT_OFFSET-MIDDLE center"
            )

            out_label = (
                "OUT = MIDDLE-RIGHT_OFFSET center"
            )
        else:
            in_label = (
                "IN = LEFT-MIDDLE center"
            )

            out_label = (
                "OUT = MIDDLE-RIGHT center"
            )

    elif line_count == 4:
        in_label = (
            "IN = LEFT-MIDDLE1 center"
        )

        out_label = (
            "OUT = MIDDLE2-RIGHT center"
        )

    else:
        raise ValueError(
            f"Unsupported line_count: {line_count}"
        )

    # --------------------------------------------------------
    # 4. [DISABLED] 기존 Dense 중앙선 수동 수정 / 곡선 수정
    #
    # 기존 10) IN/OUT Straight Editor
    # 기존 11) IN/OUT Curve Editor
    # 는 현재 사용하지 않는다.
    # --------------------------------------------------------
    edited_in = in_dense.copy()
    edited_out = out_dense.copy()

    # --------------------------------------------------------
    # 5. 직선/곡선 수정 후 최종 0.30 m 재샘플링
    #
    # 수동 직선화 이후 점 간격이 달라질 수 있으므로
    # 최종 저장 전에 다시 균일 간격으로 맞춘다.
    # --------------------------------------------------------

    def final_resampling():
        in_result = dense_resample_final_path(
            edited_in,
            args.output_spacing,
            closed,
        )

        out_result = dense_resample_final_path(
            edited_out,
            args.output_spacing,
            closed,
        )

        return (
            in_result,
            out_result,
        )

    (
        (
            edited_in,
            final_in_spacing,
        ),
        (
            edited_out,
            final_out_spacing,
        ),
    ) = run_silent_step(
        f"최종 Dense {args.output_spacing:.2f} m 재샘플링",
        final_resampling,
    )

    # --------------------------------------------------------
    # 6. ROI radius 계산
    # --------------------------------------------------------

    (
        in_info,
        out_info,
    ) = run_silent_step(
        "ROI 반지름 계산",
        dense_calculate_roi_info,
        in_dense=edited_in,
        out_dense=edited_out,
        raw_lines=raw_lines,
        line_count=line_count,
        closed=closed,
    )

    # --------------------------------------------------------
    # 7. Dense CSV 갱신
    # --------------------------------------------------------

    def save_existing_dense_outputs():
        save_dense_roi_csv(
            info=in_info,
            path=args.in_dense_output,
        )

        save_dense_roi_csv(
            info=out_info,
            path=args.out_dense_output,
        )

        save_path_xy_csv(
            info=in_info,
            path=args.path_in_output,
        )

        save_path_xy_csv(
            info=out_info,
            path=args.path_out_output,
        )

    run_silent_step(
        "Dense ROI 결과 저장",
        save_existing_dense_outputs,
    )

    # --------------------------------------------------------
    # 8. 최종 ROI 시각화
    # --------------------------------------------------------

    run_silent_step(
        "최종 ROI 시각화",
        show_and_save_dense_roi_figure,
        display_lines=display_lines,
        in_info=in_info,
        out_info=out_info,
        figure_path=args.dense_figure,
        roi_plot_step=args.roi_plot_step,
        in_label=in_label,
        out_label=out_label,
        show=not args.no_show,
    )

    print(
        "[OK] 전체 작업 완료"
    )


# ============================================================
# 14-1. Dense Centerline / ROI Pipeline
# ============================================================

def dense_remove_duplicates(
    points: np.ndarray,
    tolerance: float = 1.0e-8,
) -> np.ndarray:
    points = np.asarray(
        points,
        dtype=np.float64,
    )

    if len(points) < 2:
        return points.copy()

    result = [
        points[0]
    ]

    for point in points[1:]:
        if (
            np.linalg.norm(
                point
                -
                result[-1]
            )
            >
            tolerance
        ):
            result.append(
                point
            )

    result = np.asarray(
        result,
        dtype=np.float64,
    )

    if len(result) < 2:
        raise ValueError(
            "Dense path has fewer than 2 unique points."
        )

    return result


def dense_open_path(
    points: np.ndarray,
) -> np.ndarray:
    points = np.asarray(
        points,
        dtype=np.float64,
    )

    if (
        len(points) >= 2
        and
        np.linalg.norm(
            points[-1]
            -
            points[0]
        )
        <=
        1.0e-8
    ):
        return points[
            :-1
        ].copy()

    return points.copy()


def dense_close_path(
    points: np.ndarray,
) -> np.ndarray:
    points = np.asarray(
        points,
        dtype=np.float64,
    )

    if len(points) < 2:
        raise ValueError(
            "Cannot close a path with fewer than 2 points."
        )

    if (
        np.linalg.norm(
            points[-1]
            -
            points[0]
        )
        <=
        1.0e-8
    ):
        return points.copy()

    return np.vstack([
        points,
        points[0],
    ])


def dense_point_at_s(
    points: np.ndarray,
    cum: np.ndarray,
    s: float,
) -> np.ndarray:
    total = float(
        cum[-1]
    )

    if total <= EPS:
        raise ValueError(
            "Dense path length is zero."
        )

    s = min(
        max(
            float(s),
            0.0,
        ),
        total,
    )

    if abs(
        s - total
    ) <= 1.0e-9:
        return points[
            -1
        ].copy()

    index = int(
        np.searchsorted(
            cum,
            s,
            side="right",
        )
        -
        1
    )

    index = max(
        0,
        min(
            index,
            len(points) - 2,
        ),
    )

    ds = float(
        cum[index + 1]
        -
        cum[index]
    )

    if ds <= EPS:
        return points[
            index
        ].copy()

    ratio = (
        s
        -
        float(
            cum[index]
        )
    ) / ds

    return (
        points[index]
        +
        ratio
        *
        (
            points[index + 1]
            -
            points[index]
        )
    )


def dense_resample_by_count(
    points: np.ndarray,
    count: int,
) -> np.ndarray:
    points = dense_remove_duplicates(
        points
    )

    if count < 2:
        raise ValueError(
            "Dense resample count must be >= 2."
        )

    cum = cumulative_lengths(
        points
    )

    total = float(
        cum[-1]
    )

    if total <= EPS:
        raise ValueError(
            "Cannot resample zero-length dense path."
        )

    target_s = np.linspace(
        0.0,
        total,
        count,
    )

    return np.asarray([
        dense_point_at_s(
            points,
            cum,
            float(s),
        )
        for s
        in target_s
    ], dtype=np.float64)


def dense_resample_by_spacing(
    points: np.ndarray,
    spacing: float,
) -> np.ndarray:
    points = dense_remove_duplicates(
        points
    )

    if spacing <= 0.0:
        raise ValueError(
            "Dense spacing must be > 0."
        )

    total = polyline_length(
        points
    )

    count = max(
        2,
        int(
            np.ceil(
                total
                /
                spacing
            )
        )
        +
        1,
    )

    return dense_resample_by_count(
        points,
        count,
    )


def dense_resample_final_path(
    points: np.ndarray,
    target_spacing: float,
    closed: bool,
) -> Tuple[
    np.ndarray,
    float,
]:
    """
    최종 IN/OUT path를 target_spacing에 가장 가까운 균일 간격으로 재샘플링.

    closed track:
        한 바퀴 전체를 동일한 interval 수로 나누고 마지막에 첫 점을 추가.

    open track:
        시작/끝을 포함하여 동일 간격으로 나눈다.
    """
    if target_spacing <= 0.0:
        raise ValueError(
            "Final dense spacing must be > 0."
        )

    points = dense_remove_duplicates(
        points
    )

    if closed:
        points = dense_close_path(
            points
        )

        cum = cumulative_lengths(
            points
        )

        total = float(
            cum[-1]
        )

        if total <= EPS:
            raise ValueError(
                "Closed dense path length is zero."
            )

        interval_count = max(
            3,
            int(
                round(
                    total
                    /
                    target_spacing
                )
            ),
        )

        actual_spacing = (
            total
            /
            interval_count
        )

        sample_s = (
            np.arange(
                interval_count,
                dtype=np.float64,
            )
            *
            actual_spacing
        )

        sampled = np.asarray([
            dense_point_at_s(
                points,
                cum,
                float(s),
            )
            for s
            in sample_s
        ], dtype=np.float64)

        sampled = np.vstack([
            sampled,
            sampled[0],
        ])

        return (
            sampled,
            actual_spacing,
        )

    cum = cumulative_lengths(
        points
    )

    total = float(
        cum[-1]
    )

    if total <= EPS:
        raise ValueError(
            "Open dense path length is zero."
        )

    interval_count = max(
        1,
        int(
            round(
                total
                /
                target_spacing
            )
        ),
    )

    actual_spacing = (
        total
        /
        interval_count
    )

    sample_s = np.linspace(
        0.0,
        total,
        interval_count + 1,
    )

    sampled = np.asarray([
        dense_point_at_s(
            points,
            cum,
            float(s),
        )
        for s
        in sample_s
    ], dtype=np.float64)

    return (
        sampled,
        actual_spacing,
    )


def dense_pair_straight(
    path_a: np.ndarray,
    path_b: np.ndarray,
) -> Tuple[
    np.ndarray,
    np.ndarray,
    np.ndarray,
]:
    path_a = dense_remove_duplicates(
        path_a
    )

    path_b = dense_remove_duplicates(
        path_b
    )

    target_count = max(
        len(path_a),
        len(path_b),
    )

    paired_a = (
        path_a.copy()
        if len(path_a) == target_count
        else dense_resample_by_count(
            path_a,
            target_count,
        )
    )

    paired_b = (
        path_b.copy()
        if len(path_b) == target_count
        else dense_resample_by_count(
            path_b,
            target_count,
        )
    )

    center = (
        paired_a
        +
        paired_b
    ) * 0.5

    return (
        paired_a,
        paired_b,
        center,
    )


def dense_pair_curve(
    path_a: np.ndarray,
    path_b: np.ndarray,
    spacing: float,
) -> Tuple[
    np.ndarray,
    np.ndarray,
    np.ndarray,
    str,
]:
    """
    긴 곡선을 기준으로 dense waypoint를 생성하고
    짧은 곡선은 동일 진행률 u=s/L 위치로 보간한다.
    """
    path_a = dense_remove_duplicates(
        path_a
    )

    path_b = dense_remove_duplicates(
        path_b
    )

    length_a = polyline_length(
        path_a
    )

    length_b = polyline_length(
        path_b
    )

    if (
        length_a <= EPS
        or
        length_b <= EPS
    ):
        raise ValueError(
            "CURVE section contains a zero-length boundary."
        )

    if length_a >= length_b:
        reference = dense_resample_by_spacing(
            path_a,
            spacing,
        )

        reference_cum = cumulative_lengths(
            reference
        )

        reference_total = float(
            reference_cum[-1]
        )

        short_cum = cumulative_lengths(
            path_b
        )

        short_total = float(
            short_cum[-1]
        )

        progress = (
            reference_cum
            /
            reference_total
        )

        paired_a = reference

        paired_b = np.asarray([
            dense_point_at_s(
                path_b,
                short_cum,
                float(
                    u
                    *
                    short_total
                ),
            )
            for u
            in progress
        ], dtype=np.float64)

        longer = "A"

    else:
        reference = dense_resample_by_spacing(
            path_b,
            spacing,
        )

        reference_cum = cumulative_lengths(
            reference
        )

        reference_total = float(
            reference_cum[-1]
        )

        short_cum = cumulative_lengths(
            path_a
        )

        short_total = float(
            short_cum[-1]
        )

        progress = (
            reference_cum
            /
            reference_total
        )

        paired_b = reference

        paired_a = np.asarray([
            dense_point_at_s(
                path_a,
                short_cum,
                float(
                    u
                    *
                    short_total
                ),
            )
            for u
            in progress
        ], dtype=np.float64)

        longer = "B"

    center = (
        paired_a
        +
        paired_b
    ) * 0.5

    return (
        paired_a,
        paired_b,
        center,
        longer,
    )


def dense_pair_section(
    path_a: np.ndarray,
    path_b: np.ndarray,
    section_type: str,
    curve_spacing: float,
) -> Tuple[
    np.ndarray,
    str,
]:
    section_type = str(
        section_type
    ).upper()

    if section_type == "STRAIGHT":
        _, _, center = (
            dense_pair_straight(
                path_a,
                path_b,
            )
        )

        return (
            center,
            "index-by-index",
        )

    if section_type == "CURVE":
        _, _, center, longer = (
            dense_pair_curve(
                path_a,
                path_b,
                curve_spacing,
            )
        )

        return (
            center,
            f"progress-% / longer={longer}",
        )

    raise ValueError(
        f"Unsupported dense section type: {section_type}"
    )


def dense_extract_section_pair(
    section: Dict,
    line_count: int,
    roi_name: str,
) -> Tuple[
    np.ndarray,
    np.ndarray,
    str,
    str,
]:
    """
    ROI Builder가 이미 만든 section 데이터에서
    Dense 계산에 사용할 양쪽 경계를 직접 가져온다.

    3-Line:
        IN  : LEFT   / MIDDLE
        OUT : MIDDLE / RIGHT

    4-Line:
        IN  : LEFT    / MIDDLE1
        OUT : MIDDLE2 / RIGHT
    """
    roi_name = str(
        roi_name
    ).upper()

    if line_count == 3:
        if roi_name == "IN":
            path_a = np.asarray(
                section[
                    "outer_points"
                ],
                dtype=np.float64,
            )

            path_b = np.asarray(
                section[
                    "inner_points"
                ],
                dtype=np.float64,
            )

            return (
                path_a,
                path_b,
                "LEFT",
                "MIDDLE",
            )

        path_a = np.asarray(
            section[
                "inner_points"
            ],
            dtype=np.float64,
        )

        path_b = np.asarray(
            section[
                "outer_points"
            ],
            dtype=np.float64,
        )

        return (
            path_a,
            path_b,
            "MIDDLE",
            "RIGHT",
        )

    if line_count == 4:
        if roi_name == "IN":
            path_a = np.asarray(
                section[
                    "other_points"
                ],
                dtype=np.float64,
            )

            path_b = np.asarray(
                section[
                    "reference_points"
                ],
                dtype=np.float64,
            )

            return (
                path_a,
                path_b,
                "LEFT",
                "MIDDLE1",
            )

        path_a = np.asarray(
            section[
                "reference_points"
            ],
            dtype=np.float64,
        )

        path_b = np.asarray(
            section[
                "other_points"
            ],
            dtype=np.float64,
        )

        return (
            path_a,
            path_b,
            "MIDDLE2",
            "RIGHT",
        )

    raise ValueError(
        f"Unsupported line_count: {line_count}"
    )


def dense_generate_one_roi_line(
    sections: List[Dict],
    line_count: int,
    roi_name: str,
    curve_spacing: float,
    closed: bool,
) -> np.ndarray:
    if not sections:
        raise ValueError(
            f"{roi_name}: no ROI sections."
        )

    parts = []

    print(
        f"\n[{roi_name} Dense Sections]"
    )

    for index, section in enumerate(
        sections
    ):
        (
            path_a,
            path_b,
            label_a,
            label_b,
        ) = dense_extract_section_pair(
            section,
            line_count,
            roi_name,
        )

        center, method = (
            dense_pair_section(
                path_a,
                path_b,
                section[
                    "section_type"
                ],
                curve_spacing,
            )
        )

        if index > 0:
            center = center[
                1:
            ]

        parts.append(
            center
        )

        print(
            f"[{roi_name} {int(section['track_order']):02d}] "
            f"{str(section['section_type']).upper():<8} "
            f"{label_a}={polyline_length(path_a):7.3f} m "
            f"({len(path_a):4d} wp)  "
            f"{label_b}={polyline_length(path_b):7.3f} m "
            f"({len(path_b):4d} wp)"
        )

        print(
            f"         -> {len(center):4d} pts  "
            f"{method}"
        )

    result = np.vstack(
        parts
    )

    if closed:
        result = dense_close_path(
            result
        )

    return result


def dense_generate_centerlines_from_result(
    result: Dict,
    curve_spacing: float,
) -> Tuple[
    np.ndarray,
    np.ndarray,
]:
    metadata = result.get(
        "metadata",
        {},
    )

    line_count = int(
        metadata.get(
            "line_count",
            0,
        )
    )

    closed = bool(
        metadata.get(
            "closed_track",
            True,
        )
    )

    roi_sections = result.get(
        "roi_sections",
        {},
    )

    print(
        "\n============================================"
    )
    print(
        "Dense Centerline Generation"
    )
    print(
        "============================================"
    )

    if line_count == 3:
        if bool(
            metadata.get(
                "track_lines_applied_to_final_roi",
                False,
            )
        ):
            print(
                "IN  = LEFT_TRACK <-> MIDDLE_TRACK"
            )
            print(
                "OUT = MIDDLE_TRACK <-> RIGHT_TRACK"
            )
        elif bool(
            metadata.get(
                "offset_applied_to_final_roi",
                False,
            )
        ):
            print(
                "IN  = LEFT_OFFSET <-> MIDDLE"
            )
            print(
                "OUT = MIDDLE <-> RIGHT_OFFSET"
            )
        else:
            print(
                "IN  = LEFT <-> MIDDLE"
            )
            print(
                "OUT = MIDDLE <-> RIGHT"
            )

    elif line_count == 4:
        print(
            "IN  = LEFT <-> MIDDLE1"
        )
        print(
            "OUT = MIDDLE2 <-> RIGHT"
        )
        print(
            "CENTER GAP = excluded"
        )

    else:
        raise ValueError(
            f"Unsupported line_count: {line_count}"
        )

    in_dense = dense_generate_one_roi_line(
        sections=roi_sections.get(
            "IN",
            [],
        ),
        line_count=line_count,
        roi_name="IN",
        curve_spacing=curve_spacing,
        closed=closed,
    )

    out_dense = dense_generate_one_roi_line(
        sections=roi_sections.get(
            "OUT",
            [],
        ),
        line_count=line_count,
        roi_name="OUT",
        curve_spacing=curve_spacing,
        closed=closed,
    )

    print(
        "\n============================================"
    )
    print(
        f"[OK] Initial IN dense points : "
        f"{len(in_dense)}"
    )
    print(
        f"[OK] Initial OUT dense points: "
        f"{len(out_dense)}"
    )
    print(
        "============================================"
    )

    return (
        in_dense,
        out_dense,
    )


def dense_segment_indices(
    index1: int,
    index2: int,
    count: int,
    closed: bool,
) -> np.ndarray:
    if index1 == index2:
        return np.asarray(
            [index1],
            dtype=np.int64,
        )

    if not closed:
        start = min(
            index1,
            index2,
        )

        end = max(
            index1,
            index2,
        )

        return np.arange(
            start,
            end + 1,
            dtype=np.int64,
        )

    def forward_indices(
        start_index: int,
        end_index: int,
    ) -> np.ndarray:
        indices = [
            int(
                start_index
            )
        ]

        current = int(
            start_index
        )

        while current != end_index:
            current = (
                current + 1
            ) % count

            indices.append(
                current
            )

            if len(indices) > count + 1:
                raise RuntimeError(
                    "Failed to build cyclic dense index sequence."
                )

        return np.asarray(
            indices,
            dtype=np.int64,
        )

    path_12 = forward_indices(
        index1,
        index2,
    )

    path_21 = forward_indices(
        index2,
        index1,
    )

    if len(path_12) <= len(path_21):
        return path_12

    return path_21



# ============================================================
# 14-1A. Interactive Cubic-Spline Curve Editor
# ============================================================

def curve_spline_not_a_knot_1d(
    knots: np.ndarray,
    values: np.ndarray,
    query: np.ndarray,
) -> np.ndarray:
    """
    MATLAB spline()과 같은 계열의 not-a-knot cubic spline을
    NumPy만 사용해 1차원 값에 적용한다.

    control point가 3개일 때는 하나의 2차 다항식으로 보간한다.
    4개 이상일 때는 second derivative formulation으로
    not-a-knot 경계조건을 적용한다.
    """
    x = np.asarray(
        knots,
        dtype=np.float64,
    )

    y = np.asarray(
        values,
        dtype=np.float64,
    )

    q = np.asarray(
        query,
        dtype=np.float64,
    )

    if len(x) != len(y):
        raise ValueError(
            "Spline knot/value 개수가 서로 다릅니다."
        )

    if len(x) < 2:
        raise ValueError(
            "Spline에는 최소 2개의 점이 필요합니다."
        )

    h = np.diff(
        x
    )

    if np.any(
        h <= 1.0e-10
    ):
        raise ValueError(
            "Curve control point 사이 거리가 너무 작거나 중복되어 있습니다."
        )

    if len(x) == 2:
        return np.interp(
            q,
            x,
            y,
        )

    # MATLAB spline에서 3개 점은 사실상 하나의 포물선으로 연결된다.
    if len(x) == 3:
        coefficients = np.polyfit(
            x,
            y,
            2,
        )

        return np.polyval(
            coefficients,
            q,
        )

    n = len(
        x
    )

    matrix = np.zeros(
        (n, n),
        dtype=np.float64,
    )

    rhs = np.zeros(
        n,
        dtype=np.float64,
    )

    # First not-a-knot condition:
    # (M1-M0)/h0 == (M2-M1)/h1
    matrix[0, 0] = -h[1]
    matrix[0, 1] = h[0] + h[1]
    matrix[0, 2] = -h[0]

    # Interior cubic-spline equations.
    for i in range(
        1,
        n - 1,
    ):
        h_left = float(
            h[i - 1]
        )

        h_right = float(
            h[i]
        )

        matrix[i, i - 1] = h_left
        matrix[i, i] = 2.0 * (
            h_left
            +
            h_right
        )
        matrix[i, i + 1] = h_right

        rhs[i] = 6.0 * (
            (
                y[i + 1]
                -
                y[i]
            )
            /
            h_right
            -
            (
                y[i]
                -
                y[i - 1]
            )
            /
            h_left
        )

    # Last not-a-knot condition:
    # (M[n-2]-M[n-3])/h[n-3] == (M[n-1]-M[n-2])/h[n-2]
    matrix[n - 1, n - 3] = -h[n - 2]
    matrix[n - 1, n - 2] = h[n - 3] + h[n - 2]
    matrix[n - 1, n - 1] = -h[n - 3]

    second_derivatives = np.linalg.solve(
        matrix,
        rhs,
    )

    result = np.empty_like(
        q,
        dtype=np.float64,
    )

    segment_indices = np.searchsorted(
        x,
        q,
        side="right",
    ) - 1

    segment_indices = np.clip(
        segment_indices,
        0,
        n - 2,
    )

    for output_index, (
        query_value,
        segment_index,
    ) in enumerate(
        zip(
            q,
            segment_indices,
        )
    ):
        i = int(
            segment_index
        )

        hi = float(
            h[i]
        )

        a = (
            x[i + 1]
            -
            query_value
        ) / hi

        b = (
            query_value
            -
            x[i]
        ) / hi

        result[output_index] = (
            a * y[i]
            +
            b * y[i + 1]
            +
            (
                (
                    a ** 3
                    -
                    a
                )
                *
                second_derivatives[i]
                +
                (
                    b ** 3
                    -
                    b
                )
                *
                second_derivatives[i + 1]
            )
            *
            (
                hi ** 2
            )
            /
            6.0
        )

    return result


def curve_order_controls(
    controls: List[Dict],
    point_count: int,
    closed: bool,
) -> List[Dict]:
    """
    control point를 원래 path index 순서로 정렬한다.

    closed path에서는 control point 사이의 가장 큰 index gap을
    트랙의 바깥 구간으로 간주해 그 gap 다음 점부터 시작한다.
    따라서 0번 index를 가로지르는 curve도 연속 구간으로 처리된다.
    """
    if not controls:
        return []

    ordered = sorted(
        controls,
        key=lambda item: int(
            item["index"]
        ),
    )

    if (
        not closed
        or
        len(ordered) <= 1
    ):
        return ordered

    indices = [
        int(
            item["index"]
        )
        for item
        in ordered
    ]

    gaps = []

    for i in range(
        len(indices)
    ):
        current = indices[i]

        if i == len(indices) - 1:
            following = (
                indices[0]
                +
                point_count
            )
        else:
            following = indices[i + 1]

        gaps.append(
            following
            -
            current
        )

    largest_gap_index = int(
        np.argmax(
            np.asarray(
                gaps,
                dtype=np.float64,
            )
        )
    )

    start_index = (
        largest_gap_index
        +
        1
    ) % len(
        ordered
    )

    return (
        ordered[
            start_index:
        ]
        +
        ordered[
            :start_index
        ]
    )


def curve_segment_indices_from_controls(
    ordered_controls: List[Dict],
    point_count: int,
    closed: bool,
) -> np.ndarray:
    if len(
        ordered_controls
    ) < 2:
        raise ValueError(
            "Curve 구간에는 최소 2개의 control point가 필요합니다."
        )

    start_index = int(
        ordered_controls[0][
            "index"
        ]
    )

    end_index = int(
        ordered_controls[-1][
            "index"
        ]
    )

    if not closed:
        if end_index < start_index:
            start_index, end_index = (
                end_index,
                start_index,
            )

        return np.arange(
            start_index,
            end_index + 1,
            dtype=np.int64,
        )

    indices = [
        start_index
    ]

    current = start_index

    while current != end_index:
        current = (
            current
            +
            1
        ) % point_count

        indices.append(
            current
        )

        if len(
            indices
        ) > point_count + 1:
            raise RuntimeError(
                "Curve cyclic segment index 생성에 실패했습니다."
            )

    return np.asarray(
        indices,
        dtype=np.int64,
    )


def curve_generate_spline_points(
    control_positions: np.ndarray,
    sample_count: int,
) -> np.ndarray:
    """
    MATLAB Add Curve의 핵심 로직을 옮긴 부분.

    1) control point 사이 chord distance 계산
    2) 누적거리 s_knots 생성
    3) x(s), y(s)를 각각 cubic spline으로 보간
    4) s를 균일하게 나누어 curve point 생성
    """
    positions = np.asarray(
        control_positions,
        dtype=np.float64,
    )

    if (
        positions.ndim != 2
        or
        positions.shape[1] != 2
        or
        len(positions) < 3
    ):
        raise ValueError(
            "Curve에는 서로 다른 control point가 최소 3개 필요합니다."
        )

    differences = np.diff(
        positions,
        axis=0,
    )

    distances = np.linalg.norm(
        differences,
        axis=1,
    )

    if np.any(
        distances <= 1.0e-8
    ):
        raise ValueError(
            "서로 겹친 Curve control point가 있습니다."
        )

    s_knots = np.concatenate(
        [
            np.asarray(
                [0.0],
                dtype=np.float64,
            ),
            np.cumsum(
                distances
            ),
        ]
    )

    sample_count = max(
        3,
        int(
            sample_count
        ),
    )

    s_new = np.linspace(
        0.0,
        float(
            s_knots[-1]
        ),
        sample_count,
    )

    x_new = curve_spline_not_a_knot_1d(
        s_knots,
        positions[:, 0],
        s_new,
    )

    y_new = curve_spline_not_a_knot_1d(
        s_knots,
        positions[:, 1],
        s_new,
    )

    return np.column_stack(
        [
            x_new,
            y_new,
        ]
    )


def curve_interactive_editor_qualifying_v24(
    lines: Dict[
        str,
        np.ndarray,
    ],
    closed: bool,
    no_show: bool,
    title: str,
    background_lines: Optional[
        Dict[
            str,
            np.ndarray,
        ]
    ] = None,
    initial_reference_lines: Optional[
        Dict[
            str,
            np.ndarray,
        ]
    ] = None,
    selection_reference_lines: Optional[
        Dict[
            str,
            np.ndarray,
        ]
    ] = None,
    editable_selection_alias: Optional[str] = None,
    section_main_context: Optional[Dict] = None,
) -> Tuple[
    Dict[
        str,
        np.ndarray,
    ],
    bool,
]:
    """
    Interactive cubic-spline curve editor with a two-stage workflow.

    Stage 1 - SELECT:
        Left click near an editable path to add a control point snapped to
        the nearest existing waypoint.

        Dragging an existing control point keeps it snapped to a waypoint on
        the same editable path.

        Enter behavior in SELECT mode:
          - 0 control points: close the Curve Editor and proceed.
          - 1~2 control points: discard the pending selection and restart
            SELECT mode from 0 control points.
          - 3 or more control points: switch to FREE SHAPE mode.

    Stage 2 - FREE SHAPE:
        Interior control points can be dragged freely anywhere in the axes.
        The final control point of each active curve is constrained to the
        same editable path and snaps to its nearest waypoint while dragging.
        Enter applies the current cubic-spline curve, clears the control
        points, and returns to SELECT mode for another curve.

    Ctrl+Z:
        Undo the latest control-point edit, mode transition, or applied curve.

    Ctrl+Y:
        Redo the latest undone edit.

    Enter behavior:
        SELECT mode + 0 control points  -> leave the Curve Editor and proceed.
        SELECT mode + 1~2 points        -> discard the pending points and
                                           restart SELECT mode from 0 points.
        SELECT mode + 3+ points         -> enter FREE SHAPE mode.
        FREE SHAPE mode                 -> apply the current curve and return
                                           to SELECT mode.

    Window close:
        Discard only the currently un-applied control points and leave the
        Curve Editor. Curves already applied with Enter are preserved.

    The replacement keeps the original number of waypoints in the selected
    segment so the existing ROI/section index structure remains valid.
    """
    editable_lines = {}

    for name, points in lines.items():
        points_array = np.asarray(
            points,
            dtype=np.float64,
        )

        if closed:
            points_array = dense_open_path(
                points_array
            )
        else:
            points_array = dense_remove_duplicates(
                points_array
            )

        if len(points_array) < 3:
            raise ValueError(
                f"{name}: at least 3 waypoints are required for curve editing."
            )

        editable_lines[name] = points_array.copy()

    # Fixed reference geometry shown throughout this Curve Editor session.
    # If the caller supplies the geometry from before the straight-line edit,
    # keep that as the true initial line. Otherwise use the curve-editor entry
    # geometry as the initial reference.
    initial_lines = {}

    for name, current_points in editable_lines.items():
        if (
            initial_reference_lines is not None
            and name in initial_reference_lines
        ):
            reference_points = np.asarray(
                initial_reference_lines[name],
                dtype=np.float64,
            )

            if closed:
                reference_points = dense_open_path(reference_points)
            else:
                reference_points = dense_remove_duplicates(reference_points)

            initial_lines[name] = reference_points.copy()
        else:
            initial_lines[name] = current_points.copy()

    # Control-point snap sources. Normally each editable path is its own
    # selection source. For PATH_YEAH qualifying mode, the caller can provide
    # IN_DENSE / MIDDLE_RAW / OUT_DENSE so control points may be selected from
    # any of those three reference lines while still modifying one PATH_YEAH.
    if selection_reference_lines is None:
        selectable_lines = {
            name: points.copy()
            for name, points
            in editable_lines.items()
        }
        selection_target_line = None
    else:
        if len(editable_lines) != 1:
            raise ValueError(
                "selection_reference_lines currently requires exactly one editable path."
            )

        selection_target_line = next(
            iter(editable_lines.keys())
        )
        selectable_lines = {}

        for reference_name, reference_points in selection_reference_lines.items():
            reference_array = np.asarray(
                reference_points,
                dtype=np.float64,
            )

            if closed:
                reference_array = dense_open_path(
                    reference_array
                )
            else:
                reference_array = dense_remove_duplicates(
                    reference_array
                )

            if len(reference_array) < 2:
                raise ValueError(
                    f"{reference_name}: at least 2 waypoints are required as a curve selection source."
                )

            selectable_lines[str(reference_name)] = reference_array.copy()

        if not selectable_lines:
            raise ValueError(
                "selection_reference_lines is empty."
            )

    # Optional dynamic selection source that always points to the CURRENT
    # editable path rather than a frozen copy. This is used by qualifying
    # PATH_YEAH so a second curve can select points from the result of the
    # first applied curve.
    dynamic_selection_alias = None
    if editable_selection_alias is not None:
        if selection_target_line is None:
            raise ValueError(
                "editable_selection_alias requires selection_reference_lines "
                "with exactly one editable path."
            )

        dynamic_selection_alias = str(editable_selection_alias)
        if dynamic_selection_alias in selectable_lines:
            raise ValueError(
                f"Duplicate curve selection source name: {dynamic_selection_alias}"
            )

        # Placeholder only. All geometry reads for this source go through
        # selectable_points_for_source(), which returns editable_lines directly.
        selectable_lines[dynamic_selection_alias] = editable_lines[
            selection_target_line
        ]

    if no_show:
        return (
            {
                name: (
                    dense_close_path(points)
                    if closed
                    else points.copy()
                )
                for name, points
                in editable_lines.items()
            },
            False,
        )

    controls = {
        name: []
        for name in editable_lines.keys()
    }

    undo_stack = []
    redo_stack = []

    interaction_state = {
        "drag_line": None,
        "drag_control_index": None,
        "drag_is_end_control": False,
        "exit_requested": False,
        "applied_any": False,
        "phase": "select",
        "section_main_map": {},
        "section_sequence": [],
        "pending_section_orders": [],
        "section_overlay_artists": [],
        "editable_revision": 0,
    }

    # Clicking near an existing control point selects that point instead of
    # creating a new one.
    pick_radius_pixels = 14.0

    # New control points can only be created near an editable path.
    path_pick_radius_pixels = 28.0

    fig, ax = plt.subplots(
        figsize=(14, 10)
    )

    # Qualifying PATH_YEAH can use track_roi polygons as longitudinal
    # section guides. All section polygons stay visible throughout the
    # Curve Editor; the section currently waiting for a main-line choice
    # is highlighted dynamically in refresh().
    if section_main_context is not None:
        for section_order in section_main_context.get("orders", []):
            for vertices in section_main_context.get("polygons", {}).get(
                int(section_order),
                [],
            ):
                vertices = np.asarray(vertices, dtype=np.float64)
                if len(vertices) < 3:
                    continue

                patch = MplPolygon(
                    vertices,
                    closed=True,
                    facecolor="none",
                    edgecolor="0.55",
                    linewidth=0.8,
                    alpha=0.45,
                    zorder=0,
                )
                ax.add_patch(patch)

    if background_lines:
        for background_name, background_points in background_lines.items():
            background_points = np.asarray(
                background_points,
                dtype=np.float64,
            )

            background_label = str(background_name)
            is_initial_background = (
                "initial" in background_label.lower()
            )

            background_style = line_visual_style(
                background_label,
                active=False,
                initial=is_initial_background,
            )

            ax.plot(
                background_points[:, 0],
                background_points[:, 1],
                color=background_style["color"],
                linewidth=background_style["linewidth"],
                linestyle=background_style["linestyle"],
                alpha=background_style["alpha"],
                label=background_label,
                zorder=(
                    1
                    if is_initial_background
                    else 2
                ),
            )

    initial_line_artists = {}
    line_artists = {}
    preview_artists = {}
    control_artists = {}

    for name, points in editable_lines.items():
        initial_draw_points = (
            dense_close_path(initial_lines[name])
            if closed
            else initial_lines[name]
        )

        base = lane_base_name(name)
        initial_semantic_name = (
            f"{base}_offset"
            if base in ("left", "right")
            else f"{base}_initial"
        )
        initial_style = line_visual_style(
            initial_semantic_name,
            initial=(base not in ("left", "right")),
        )
        active_style = line_visual_style(
            f"{base}_track",
            active=True,
        )

        initial_line_artist, = ax.plot(
            initial_draw_points[:, 0],
            initial_draw_points[:, 1],
            color=initial_style["color"],
            linewidth=initial_style["linewidth"],
            linestyle=initial_style["linestyle"],
            alpha=initial_style["alpha"],
            label=f"{name} initial",
            zorder=2,
        )

        draw_points = (
            dense_close_path(points)
            if closed
            else points
        )

        line_artist, = ax.plot(
            draw_points[:, 0],
            draw_points[:, 1],
            color=active_style["color"],
            linewidth=active_style["linewidth"],
            linestyle=active_style["linestyle"],
            alpha=active_style["alpha"],
            label=f"{name} modified",
            zorder=4,
        )

        preview_artist, = ax.plot(
            [],
            [],
            color=active_style["color"],
            linewidth=3.4,
            linestyle="--",
            alpha=0.95,
            label=f"{name} curve preview",
            zorder=7,
        )

        control_artist = ax.scatter(
            [],
            [],
            s=70,
            marker="o",
            facecolors=active_style["color"],
            edgecolors="black",
            linewidths=0.8,
            label=f"{name} control",
            zorder=9,
        )

        initial_line_artists[name] = initial_line_artist
        line_artists[name] = line_artist
        preview_artists[name] = preview_artist
        control_artists[name] = control_artist

    status_text = ax.text(
        0.01,
        0.01,
        "",
        transform=ax.transAxes,
        fontsize=9,
        verticalalignment="bottom",
    )

    ax.set_aspect(
        "equal",
        adjustable="box",
    )
    ax.grid(True)
    ax.set_xlabel("x [m]")
    ax.set_ylabel("y [m]")
    ax.legend(
        loc="best",
        fontsize=8,
    )
    fig.tight_layout()

    def phase_instruction() -> str:
        phase = interaction_state["phase"]

        if phase == "select":
            return (
                "SELECT mode | Click near path: add snapped control point | "
                "Drag point: move along same path | "
                "Enter: 0 pts=next, 1-2 pts=reset, 3+ pts=section/free-shape | "
                "Ctrl+Z: Undo | Ctrl+Y: Redo"
            )

        if phase == "section":
            pending = interaction_state.get("pending_section_orders", [])
            current = pending[0] if pending else "-"
            return (
                f"SECTION MAIN mode | Section {current}: click IN_DENSE, "
                "MIDDLE_RAW, or OUT_DENSE inside the highlighted section | "
                "Ctrl+Z: Undo | Ctrl+Y: Redo"
            )

        return (
            "FREE SHAPE mode | Interior points: free drag | "
            "Final point: constrained to the same path | "
            "Enter: apply curve and return to SELECT mode | "
            "Ctrl+Z: Undo | Ctrl+Y: Redo"
        )

    def update_title():
        phase = interaction_state["phase"]

        if phase == "select":
            subtitle = (
                "SELECT MODE - Enter: 0 pts = next stage, "
                "1-2 pts = reset selection, 3+ pts = section/free-shape."
            )
        elif phase == "section":
            pending = interaction_state.get("pending_section_orders", [])
            current = pending[0] if pending else "-"
            subtitle = (
                f"SECTION MAIN MODE - Section {current}: click the main line "
                "inside the highlighted polygon section."
            )
        else:
            subtitle = (
                "FREE SHAPE MODE - Interior points move freely; "
                "the final point stays on the path. Enter: apply."
            )

        ax.set_title(
            title
            + "\n"
            + subtitle
            + " | Dashed = initial, Solid = modified"
        )

    def set_status(message: str):
        status_text.set_text(message)
        fig.canvas.draw_idle()

    def copy_controls():
        return {
            name: [
                {
                    "index": int(item["index"]),
                    "position": np.asarray(
                        item["position"],
                        dtype=np.float64,
                    ).copy(),
                    "snap_line": str(
                        item.get(
                            "snap_line",
                            name,
                        )
                    ),
                    "source_index": int(
                        item.get(
                            "source_index",
                            item.get("index", 0),
                        )
                    ),
                }
                for item in items
            ]
            for name, items in controls.items()
        }

    def copy_lines():
        return {
            name: np.asarray(
                points,
                dtype=np.float64,
            ).copy()
            for name, points in editable_lines.items()
        }

    def make_snapshot():
        return {
            "lines": copy_lines(),
            "controls": copy_controls(),
            "applied_any": bool(
                interaction_state["applied_any"]
            ),
            "phase": str(
                interaction_state["phase"]
            ),
            "section_main_map": dict(
                interaction_state.get("section_main_map", {})
            ),
            "section_sequence": list(
                interaction_state.get("section_sequence", [])
            ),
            "pending_section_orders": list(
                interaction_state.get("pending_section_orders", [])
            ),
        }

    def restore_snapshot(snapshot):
        for name in editable_lines.keys():
            editable_lines[name] = np.asarray(
                snapshot["lines"][name],
                dtype=np.float64,
            ).copy()

            controls[name] = [
                {
                    "index": int(item["index"]),
                    "position": np.asarray(
                        item["position"],
                        dtype=np.float64,
                    ).copy(),
                    "snap_line": str(
                        item.get(
                            "snap_line",
                            name,
                        )
                    ),
                    "source_index": int(
                        item.get(
                            "source_index",
                            item.get("index", 0),
                        )
                    ),
                }
                for item in snapshot["controls"].get(name, [])
            ]

        interaction_state["applied_any"] = bool(
            snapshot.get("applied_any", False)
        )
        interaction_state["phase"] = str(
            snapshot.get("phase", "select")
        )
        interaction_state["section_main_map"] = dict(
            snapshot.get("section_main_map", {})
        )
        interaction_state["section_sequence"] = list(
            snapshot.get("section_sequence", [])
        )
        interaction_state["pending_section_orders"] = list(
            snapshot.get("pending_section_orders", [])
        )
        interaction_state["editable_revision"] = int(
            interaction_state.get("editable_revision", 0)
        ) + 1

    dynamic_section_cache = {
        "revision": None,
        "sections": None,
    }

    def selectable_points_for_source(source_name: str) -> np.ndarray:
        source_name = str(source_name)

        if (
            dynamic_selection_alias is not None
            and source_name == dynamic_selection_alias
        ):
            return editable_lines[selection_target_line]

        return selectable_lines[source_name]

    def selectable_sections_for_source(
        source_name: str,
    ) -> Optional[np.ndarray]:
        if section_main_context is None:
            return None

        source_name = str(source_name)

        if not (
            dynamic_selection_alias is not None
            and source_name == dynamic_selection_alias
        ):
            sections = section_main_context.get(
                "point_sections", {}
            ).get(source_name)
            if sections is None:
                return None
            return np.asarray(sections, dtype=np.int64)

        revision = int(
            interaction_state.get("editable_revision", 0)
        )
        if (
            dynamic_section_cache["revision"] == revision
            and dynamic_section_cache["sections"] is not None
        ):
            return dynamic_section_cache["sections"]

        points = np.asarray(
            selectable_points_for_source(source_name),
            dtype=np.float64,
        )
        orders = [
            int(value)
            for value in section_main_context.get("orders", [])
        ]
        references = section_main_context.get("references", {})

        if len(points) == 0 or not orders:
            return None

        distance_rows = []
        for order in orders:
            order_references = references.get(int(order), {})
            per_line_distances = []

            for reference_name in (
                "IN_DENSE",
                "MIDDLE_RAW",
                "OUT_DENSE",
            ):
                reference_points = order_references.get(reference_name)
                if reference_points is None or len(reference_points) < 2:
                    continue

                per_line_distances.append(
                    dense_point_to_polyline_distances_numpy(
                        points,
                        np.asarray(reference_points, dtype=np.float64),
                    )
                )

            if not per_line_distances:
                distance_rows.append(
                    np.full(len(points), np.inf, dtype=np.float64)
                )
            else:
                distance_rows.append(
                    np.min(np.vstack(per_line_distances), axis=0)
                )

        distance_matrix = np.vstack(distance_rows)
        nearest_positions = np.argmin(distance_matrix, axis=0)
        sections = np.asarray(
            [orders[int(position)] for position in nearest_positions],
            dtype=np.int64,
        )

        dynamic_section_cache["revision"] = revision
        dynamic_section_cache["sections"] = sections
        return sections

    def clear_controls():
        for name in controls.keys():
            controls[name] = []

        interaction_state["drag_line"] = None
        interaction_state["drag_control_index"] = None
        interaction_state["drag_is_end_control"] = False
        interaction_state["section_main_map"] = {}
        interaction_state["section_sequence"] = []
        interaction_state["pending_section_orders"] = []

    def control_section_order(item: Dict) -> Optional[int]:
        if section_main_context is None:
            return None

        source_name = str(
            item.get("snap_line", "")
        )
        source_sections = selectable_sections_for_source(
            source_name
        )

        if source_sections is None or len(source_sections) == 0:
            return None

        source_index = int(
            item.get("source_index", 0)
        )
        source_index = max(
            0,
            min(
                source_index,
                len(source_sections) - 1,
            ),
        )

        return int(
            source_sections[source_index]
        )

    def section_order_sequence(
        start_order: int,
        end_order: int,
    ) -> List[int]:
        if section_main_context is None:
            return []

        orders = [
            int(value)
            for value in section_main_context.get("orders", [])
        ]

        if not orders:
            return []

        if start_order not in orders or end_order not in orders:
            return []

        start_position = orders.index(start_order)
        end_position = orders.index(end_order)

        if not closed:
            if start_position <= end_position:
                return orders[start_position:end_position + 1]
            return orders[end_position:start_position + 1]

        result = [orders[start_position]]
        position = start_position

        while orders[position] != end_order:
            position = (position + 1) % len(orders)
            result.append(orders[position])

            if len(result) > len(orders) + 1:
                raise RuntimeError(
                    "Failed to build polygon section sequence."
                )

        return result

    def nearest_selection_in_section(
        event,
        section_order: int,
        line_name: str,
    ):
        if section_main_context is None:
            return None

        best = None
        used_target_indices = {
            int(item["index"])
            for item in controls.get(line_name, [])
        }

        for source_name in selectable_lines.keys():
            points = selectable_points_for_source(source_name)
            source_sections = selectable_sections_for_source(source_name)

            if source_sections is None:
                continue

            candidate_indices = np.where(
                np.asarray(source_sections, dtype=np.int64)
                == int(section_order)
            )[0]

            if len(candidate_indices) == 0:
                continue

            candidate_points = points[candidate_indices]
            screen_points = ax.transData.transform(candidate_points)
            differences = (
                screen_points
                - np.asarray([event.x, event.y], dtype=np.float64)
            )
            distance2 = np.sum(
                differences * differences,
                axis=1,
            )
            sorted_positions = np.argsort(distance2)

            for local_position in sorted_positions:
                source_index = int(
                    candidate_indices[int(local_position)]
                )
                snapped_point = points[source_index].copy()
                target_index = (
                    source_index
                    if selection_target_line is None
                    else nearest_editable_index_to_point(
                        line_name,
                        snapped_point,
                    )
                )

                if int(target_index) in used_target_indices:
                    continue

                distance = float(
                    np.sqrt(
                        distance2[int(local_position)]
                    )
                )

                candidate = (
                    distance,
                    source_name,
                    source_index,
                    snapped_point,
                    int(target_index),
                )

                if best is None or distance < best[0]:
                    best = candidate
                break

        return best

    def prepare_polygon_section_mains() -> bool:
        if section_main_context is None:
            return enter_free_shape_mode()

        active_names = validate_active_controls()
        if active_names is None:
            return False

        if len(active_names) != 1:
            set_status(
                "Polygon section-main mode supports one active path at a time."
            )
            return False

        line_name = active_names[0]
        ordered = curve_order_controls(
            controls[line_name],
            len(editable_lines[line_name]),
            closed,
        )

        if len(ordered) < 3:
            return False

        start_order = control_section_order(ordered[0])
        end_order = control_section_order(ordered[-1])

        if start_order is None or end_order is None:
            set_status(
                "Could not determine the polygon section for the curve endpoints."
            )
            return False

        sequence = section_order_sequence(
            int(start_order),
            int(end_order),
        )

        if not sequence:
            set_status(
                "Could not determine the polygon sections between the curve endpoints."
            )
            return False

        undo_stack.append(make_snapshot())
        redo_stack.clear()

        main_map = {}

        # Any section that already contains a selected control point inherits
        # that point's source line as its initial main line.
        for item in ordered:
            order = control_section_order(item)
            if order in sequence and order not in main_map:
                main_map[int(order)] = str(
                    item.get("snap_line", "")
                )

        # Explicit endpoint rule requested for qualifying path generation.
        main_map[int(start_order)] = str(
            ordered[0].get("snap_line", "")
        )
        if int(end_order) != int(start_order):
            main_map[int(end_order)] = str(
                ordered[-1].get("snap_line", "")
            )

        missing = [
            int(order)
            for order in sequence
            if int(order) not in main_map
        ]

        interaction_state["section_main_map"] = main_map
        interaction_state["section_sequence"] = [
            int(order) for order in sequence
        ]
        interaction_state["pending_section_orders"] = missing
        interaction_state["drag_line"] = None
        interaction_state["drag_control_index"] = None
        interaction_state["drag_is_end_control"] = False

        if missing:
            interaction_state["phase"] = "section"
            refresh()
            current = int(missing[0])
            set_status(
                f"Section {current} has no main line. "
                "Click IN_DENSE, MIDDLE_RAW, OUT_DENSE, or current PATH_YEAH inside the highlighted section."
            )
            print(
                f"[CURVE] Section {current}: select main line by click."
            )
            return True

        interaction_state["phase"] = "shape"
        refresh()
        set_status(
            "All polygon sections have a main line. FREE SHAPE mode is active. "
            "Press Enter to apply the curve."
        )
        return True

    def section_source_run_indices(
        source_name: str,
        section_order: int,
        source_index: int,
    ) -> np.ndarray:
        """
        Return the contiguous waypoint run of source_name that belongs to one
        polygon section and contains source_index. Closed paths are handled
        circularly so a section that crosses index 0 still forms one run.
        """
        if section_main_context is None:
            return np.asarray([int(source_index)], dtype=np.int64)

        source_points = selectable_points_for_source(str(source_name))
        point_sections = selectable_sections_for_source(str(source_name))

        if point_sections is None or len(source_points) == 0:
            return np.asarray([int(source_index)], dtype=np.int64)

        usable_count = min(len(source_points), len(point_sections))
        if usable_count <= 0:
            return np.asarray([0], dtype=np.int64)

        source_index = int(source_index) % usable_count if closed else max(
            0, min(int(source_index), usable_count - 1)
        )
        sections = np.asarray(point_sections[:usable_count], dtype=np.int64)
        target_order = int(section_order)

        # If numerical section assignment around the selected source point is
        # inconsistent, fall back to all points assigned to the requested
        # section and choose the closest one to the selected index.
        if int(sections[source_index]) != target_order:
            candidates = np.where(sections == target_order)[0]
            if len(candidates) == 0:
                return np.asarray([source_index], dtype=np.int64)
            if closed:
                delta = np.minimum(
                    np.abs(candidates - source_index),
                    usable_count - np.abs(candidates - source_index),
                )
                source_index = int(candidates[int(np.argmin(delta))])
            else:
                source_index = int(
                    candidates[int(np.argmin(np.abs(candidates - source_index)))]
                )

        if not closed:
            left = source_index
            while left > 0 and int(sections[left - 1]) == target_order:
                left -= 1

            right = source_index
            while (
                right + 1 < usable_count
                and int(sections[right + 1]) == target_order
            ):
                right += 1

            return np.arange(left, right + 1, dtype=np.int64)

        left = source_index
        for _ in range(usable_count - 1):
            previous = (left - 1) % usable_count
            if previous == source_index or int(sections[previous]) != target_order:
                break
            left = previous

        right = source_index
        for _ in range(usable_count - 1):
            following = (right + 1) % usable_count
            if following == source_index or int(sections[following]) != target_order:
                break
            right = following

        result = [left]
        cursor = left
        while cursor != right:
            cursor = (cursor + 1) % usable_count
            result.append(cursor)
            if len(result) > usable_count:
                raise RuntimeError(
                    "Failed to build the source-line run for a polygon section."
                )

        return np.asarray(result, dtype=np.int64)

    def curve_deduplicate_allow_single(
        points: np.ndarray,
        tolerance: float = 1.0e-8,
    ) -> np.ndarray:
        points = np.asarray(points, dtype=np.float64)
        if len(points) <= 1:
            return points.copy()

        result = [points[0].copy()]
        for point in points[1:]:
            if np.linalg.norm(point - result[-1]) > tolerance:
                result.append(point.copy())
        return np.asarray(result, dtype=np.float64)

    def endpoint_main_connector(
        line_name: str,
        endpoint_item: Dict,
        is_start: bool,
    ):
        """
        Build the real MAIN connector for a qualifying curve endpoint.

        Start section:
            existing PATH -> selected source line -> start control point
        End section:
            end control point -> selected source line -> existing PATH

        The returned anchor index expands the replacement segment to the
        section-side connection point on the existing editable path.
        """
        if section_main_context is None:
            return int(endpoint_item["index"]), np.asarray(
                [endpoint_item["position"]], dtype=np.float64
            )

        source_name = str(endpoint_item.get("snap_line", ""))
        if source_name not in selectable_lines:
            return int(endpoint_item["index"]), np.asarray(
                [endpoint_item["position"]], dtype=np.float64
            )

        section_order = control_section_order(endpoint_item)
        if section_order is None:
            return int(endpoint_item["index"]), np.asarray(
                [endpoint_item["position"]], dtype=np.float64
            )

        source_points = selectable_points_for_source(source_name)
        run_indices = section_source_run_indices(
            source_name,
            int(section_order),
            int(endpoint_item.get("source_index", 0)),
        )

        if len(run_indices) == 0:
            return int(endpoint_item["index"]), np.asarray(
                [endpoint_item["position"]], dtype=np.float64
            )

        # Find the selected source waypoint inside this section run.
        source_index = int(endpoint_item.get("source_index", 0))
        run_list = [int(value) for value in run_indices]
        if source_index in run_list:
            local_position = run_list.index(source_index)
        else:
            run_points = source_points[run_indices]
            distance2 = np.sum(
                (run_points - np.asarray(endpoint_item["position"], dtype=np.float64)) ** 2,
                axis=1,
            )
            local_position = int(np.argmin(distance2))
            source_index = int(run_indices[local_position])

        if is_start:
            # Section entrance -> selected start point.
            selected_indices = run_indices[:local_position + 1]
            section_boundary_point = source_points[int(run_indices[0])].copy()
        else:
            # Selected end point -> section exit.
            selected_indices = run_indices[local_position:]
            section_boundary_point = source_points[int(run_indices[-1])].copy()

        path_anchor_index = nearest_editable_index_to_point(
            line_name,
            section_boundary_point,
        )
        path_anchor_point = editable_lines[line_name][path_anchor_index].copy()
        source_connector = source_points[selected_indices].copy()
        current_endpoint = np.asarray(
            endpoint_item["position"],
            dtype=np.float64,
        ).copy()

        if is_start:
            connector_parts = [path_anchor_point.reshape(1, 2)]
            if len(source_connector) > 0:
                connector_parts.append(source_connector)
            if (
                len(source_connector) == 0
                or np.linalg.norm(source_connector[-1] - current_endpoint) > EPS
            ):
                connector_parts.append(current_endpoint.reshape(1, 2))
        else:
            connector_parts = [current_endpoint.reshape(1, 2)]
            if len(source_connector) > 0:
                if np.linalg.norm(source_connector[0] - current_endpoint) <= EPS:
                    if len(source_connector) > 1:
                        connector_parts.append(source_connector[1:])
                else:
                    connector_parts.append(source_connector)
            if (
                np.linalg.norm(connector_parts[-1][-1] - path_anchor_point) > EPS
            ):
                connector_parts.append(path_anchor_point.reshape(1, 2))

        connector = curve_deduplicate_allow_single(
            np.vstack(connector_parts)
        )

        return int(path_anchor_index), connector

    def build_curve_geometry(
        name: str,
        ordered: List[Dict],
        output_count: int,
    ):
        """
        Build a curve replacement. Qualifying PATH_YEAH additionally uses
        endpoint-section MAIN connectors so the selected start/end source
        lines actually connect the edited curve to the existing path.
        """
        control_positions = np.asarray(
            [item["position"] for item in ordered],
            dtype=np.float64,
        )

        if section_main_context is None:
            segment_indices = curve_segment_indices_from_controls(
                ordered,
                len(editable_lines[name]),
                closed,
            )
            curve_points = curve_generate_spline_points(
                control_positions,
                max(2, int(output_count)),
            )
            return segment_indices, curve_points

        start_anchor_index, start_connector = endpoint_main_connector(
            name, ordered[0], True
        )
        end_anchor_index, end_connector = endpoint_main_connector(
            name, ordered[-1], False
        )

        anchor_controls = [
            {"index": int(start_anchor_index)},
            {"index": int(end_anchor_index)},
        ]
        segment_indices = curve_segment_indices_from_controls(
            anchor_controls,
            len(editable_lines[name]),
            closed,
        )

        central_count = max(
            120,
            len(segment_indices) * 3,
            int(output_count),
        )
        central_curve = curve_generate_spline_points(
            control_positions,
            central_count,
        )

        pieces = []
        if len(start_connector) > 0:
            pieces.append(start_connector)
        if len(central_curve) > 0:
            if pieces and np.linalg.norm(pieces[-1][-1] - central_curve[0]) <= EPS:
                pieces.append(central_curve[1:])
            else:
                pieces.append(central_curve)
        if len(end_connector) > 0:
            if pieces and np.linalg.norm(pieces[-1][-1] - end_connector[0]) <= EPS:
                pieces.append(end_connector[1:])
            else:
                pieces.append(end_connector)

        pieces = [piece for piece in pieces if len(piece) > 0]
        if not pieces:
            raise ValueError("Failed to build qualifying curve geometry.")

        composite = curve_deduplicate_allow_single(np.vstack(pieces))
        if len(composite) < 2:
            raise ValueError(
                "Qualifying curve geometry has fewer than 2 unique points."
            )

        if len(segment_indices) < 2:
            # Extremely short/degenerate endpoint-section anchors can map to
            # one PATH waypoint. Fall back to the original control-point span
            # rather than attempting a one-point resample.
            segment_indices = curve_segment_indices_from_controls(
                ordered,
                len(editable_lines[name]),
                closed,
            )

        return segment_indices, composite

    def build_preview(name: str):
        line_controls = controls[name]

        if len(line_controls) < 3:
            return (
                None,
                None,
            )

        ordered = curve_order_controls(
            line_controls,
            len(editable_lines[name]),
            closed,
        )

        # For qualifying PATH_YEAH, the preview includes the actual MAIN
        # connectors in the start/end polygon sections.
        segment_indices, preview_points = build_curve_geometry(
            name,
            ordered,
            max(120, len(editable_lines[name]) // 3),
        )

        return (
            segment_indices,
            preview_points,
        )

    def refresh():
        # Remove dynamic polygon-section overlays from the previous frame.
        for artist in interaction_state.get("section_overlay_artists", []):
            try:
                artist.remove()
            except Exception:
                pass
        interaction_state["section_overlay_artists"] = []

        if section_main_context is not None:
            # Show the chosen main line for each section in the active curve.
            for section_order, main_name in interaction_state.get(
                "section_main_map", {}
            ).items():
                polygon_list = section_main_context.get(
                    "polygons", {}
                ).get(int(section_order), [])

                if polygon_list:
                    all_vertices = np.vstack([
                        np.asarray(vertices, dtype=np.float64)
                        for vertices in polygon_list
                        if len(vertices) >= 3
                    ])
                    center = np.mean(all_vertices, axis=0)
                    text_artist = ax.text(
                        center[0],
                        center[1],
                        f"S{int(section_order)}\n{main_name}",
                        fontsize=8,
                        ha="center",
                        va="center",
                        zorder=12,
                    )
                    interaction_state["section_overlay_artists"].append(
                        text_artist
                    )

            pending = interaction_state.get(
                "pending_section_orders", []
            )
            if interaction_state.get("phase") == "section" and pending:
                current_order = int(pending[0])
                for vertices in section_main_context.get(
                    "polygons", {}
                ).get(current_order, []):
                    vertices = np.asarray(vertices, dtype=np.float64)
                    if len(vertices) < 3:
                        continue
                    highlight = MplPolygon(
                        vertices,
                        closed=True,
                        facecolor="gold",
                        edgecolor="crimson",
                        linewidth=2.2,
                        alpha=0.18,
                        zorder=1,
                    )
                    ax.add_patch(highlight)
                    interaction_state["section_overlay_artists"].append(
                        highlight
                    )

        for name in editable_lines.keys():
            draw_points = (
                dense_close_path(editable_lines[name])
                if closed
                else editable_lines[name]
            )

            line_artists[name].set_data(
                draw_points[:, 0],
                draw_points[:, 1],
            )

            positions = np.asarray(
                [
                    item["position"]
                    for item in controls[name]
                ],
                dtype=np.float64,
            )

            if len(positions) == 0:
                control_artists[name].set_offsets(
                    np.empty(
                        (0, 2),
                        dtype=np.float64,
                    )
                )
            else:
                control_artists[name].set_offsets(
                    positions
                )

            try:
                _, preview_points = build_preview(name)

                if preview_points is None:
                    preview_artists[name].set_data(
                        [],
                        [],
                    )
                else:
                    preview_artists[name].set_data(
                        preview_points[:, 0],
                        preview_points[:, 1],
                    )

            except Exception as exc:
                preview_artists[name].set_data(
                    [],
                    [],
                )
                set_status(
                    f"{name}: curve preview failed: {exc}"
                )

        update_title()
        ax.relim()
        ax.autoscale_view()
        fig.canvas.draw_idle()

    def pixel_distance_to_control(event):
        best = None

        for name, items in controls.items():
            for control_index, item in enumerate(items):
                screen_xy = ax.transData.transform(
                    item["position"]
                )

                distance = float(
                    np.hypot(
                        screen_xy[0] - event.x,
                        screen_xy[1] - event.y,
                    )
                )

                if (
                    best is None
                    or distance < best[0]
                ):
                    best = (
                        distance,
                        name,
                        control_index,
                    )

        return best

    def nearest_index_on_line_from_event(
        line_name: str,
        event,
    ):
        points = editable_lines[line_name]
        screen_points = ax.transData.transform(points)

        differences = (
            screen_points
            -
            np.asarray(
                [event.x, event.y],
                dtype=np.float64,
            )
        )

        distance2 = np.sum(
            differences * differences,
            axis=1,
        )

        index = int(np.argmin(distance2))
        distance = float(
            np.sqrt(distance2[index])
        )

        return (
            distance,
            index,
            points[index].copy(),
        )

    def nearest_index_on_selectable_line_from_event(
        source_name: str,
        event,
    ):
        points = selectable_points_for_source(source_name)
        screen_points = ax.transData.transform(points)

        differences = (
            screen_points
            -
            np.asarray(
                [event.x, event.y],
                dtype=np.float64,
            )
        )

        distance2 = np.sum(
            differences * differences,
            axis=1,
        )

        source_index = int(
            np.argmin(distance2)
        )
        distance = float(
            np.sqrt(distance2[source_index])
        )

        return (
            distance,
            source_index,
            points[source_index].copy(),
        )

    def nearest_editable_index_to_point(
        line_name: str,
        point: np.ndarray,
    ) -> int:
        points = editable_lines[line_name]
        distance2 = np.sum(
            (
                points
                -
                np.asarray(
                    point,
                    dtype=np.float64,
                )
            )
            ** 2,
            axis=1,
        )

        return int(
            np.argmin(distance2)
        )

    def nearest_selection_source(event):
        best = None

        for source_name in selectable_lines.keys():
            distance, source_index, point = (
                nearest_index_on_selectable_line_from_event(
                    source_name,
                    event,
                )
            )

            if (
                best is None
                or distance < best[0]
            ):
                best = (
                    distance,
                    source_name,
                    source_index,
                    point,
                )

        return best

    def is_curve_end_control(
        line_name: str,
        control_index: int,
    ) -> bool:
        """
        Return True when the selected control point is the final control point
        in the path-order used to build the current spline segment.
        """
        items = controls.get(
            line_name,
            [],
        )

        if not items:
            return False

        if (
            control_index < 0
            or control_index >= len(items)
        ):
            return False

        ordered = curve_order_controls(
            items,
            len(editable_lines[line_name]),
            closed,
        )

        if not ordered:
            return False

        return (
            ordered[-1]
            is
            items[int(control_index)]
        )

    def undo_once():
        if not undo_stack:
            set_status("There is no curve edit to undo.")
            return

        current_snapshot = make_snapshot()
        previous_snapshot = undo_stack.pop()
        redo_stack.append(current_snapshot)
        restore_snapshot(previous_snapshot)

        interaction_state["drag_line"] = None
        interaction_state["drag_control_index"] = None
        interaction_state["drag_is_end_control"] = False

        refresh()
        set_status(
            "Undo complete. "
            + phase_instruction()
        )

    def redo_once():
        if not redo_stack:
            set_status("There is no curve edit to redo.")
            return

        current_snapshot = make_snapshot()
        next_snapshot = redo_stack.pop()
        undo_stack.append(current_snapshot)
        restore_snapshot(next_snapshot)

        interaction_state["drag_line"] = None
        interaction_state["drag_control_index"] = None
        interaction_state["drag_is_end_control"] = False

        refresh()
        set_status(
            "Redo complete. "
            + phase_instruction()
        )

    def on_press(event):
        if interaction_state["exit_requested"]:
            return

        if (
            event.inaxes is not ax
            or event.button != 1
            or event.xdata is None
            or event.ydata is None
        ):
            return

        toolbar = getattr(
            fig.canvas,
            "toolbar",
            None,
        )

        toolbar_mode = (
            getattr(toolbar, "mode", "")
            if toolbar is not None
            else ""
        )

        if toolbar_mode:
            return

        # Polygon-section main-line selection. In this phase the click is
        # interpreted only as a main-line choice for the currently highlighted
        # section; it does not drag existing controls.
        if interaction_state["phase"] == "section":
            pending = interaction_state.get(
                "pending_section_orders", []
            )

            if not pending:
                interaction_state["phase"] = "shape"
                refresh()
                return

            line_name = (
                selection_target_line
                if selection_target_line is not None
                else next(iter(editable_lines.keys()))
            )
            current_order = int(pending[0])
            selected = nearest_selection_in_section(
                event,
                current_order,
                line_name,
            )

            if selected is None or selected[0] > path_pick_radius_pixels:
                set_status(
                    f"Section {current_order}: click closer to IN_DENSE, "
                    "MIDDLE_RAW, OUT_DENSE, or current PATH_YEAH inside the highlighted section."
                )
                return

            (
                _distance,
                source_name,
                source_index,
                snapped_point,
                path_index,
            ) = selected

            undo_stack.append(make_snapshot())
            redo_stack.clear()

            controls[line_name].append(
                {
                    "index": int(path_index),
                    "position": snapped_point.copy(),
                    "snap_line": str(source_name),
                    "source_index": int(source_index),
                }
            )
            interaction_state["section_main_map"][current_order] = str(
                source_name
            )
            interaction_state["pending_section_orders"] = [
                int(value)
                for value in pending[1:]
            ]

            if interaction_state["pending_section_orders"]:
                next_order = int(
                    interaction_state["pending_section_orders"][0]
                )
                refresh()
                set_status(
                    f"Section {current_order} main = {source_name}. "
                    f"Now select the main line for section {next_order}."
                )
                print(
                    f"[CURVE] Section {current_order} main = {source_name}"
                )
                return

            interaction_state["phase"] = "shape"
            refresh()
            set_status(
                f"Section {current_order} main = {source_name}. "
                "All sections are assigned. FREE SHAPE mode is active; "
                "press Enter to apply the curve."
            )
            print(
                f"[CURVE] Section {current_order} main = {source_name}"
            )
            return

        # Existing control-point selection always has priority.
        existing = pixel_distance_to_control(event)

        if (
            existing is not None
            and existing[0] <= pick_radius_pixels
        ):
            undo_stack.append(make_snapshot())
            redo_stack.clear()

            interaction_state["drag_line"] = existing[1]
            interaction_state["drag_control_index"] = int(
                existing[2]
            )
            interaction_state["drag_is_end_control"] = bool(
                interaction_state["phase"] == "shape"
                and is_curve_end_control(
                    existing[1],
                    int(existing[2]),
                )
            )

            if interaction_state["phase"] == "select":
                set_status(
                    f"Dragging {existing[1]} control point along the same path."
                )
            elif interaction_state["drag_is_end_control"]:
                set_status(
                    f"Dragging final {existing[1]} control point along the same path."
                )
            else:
                set_status(
                    f"Dragging {existing[1]} control point freely."
                )
            return

        # In FREE SHAPE mode, clicks away from existing control points do not
        # add new control points.
        if interaction_state["phase"] == "shape":
            set_status(
                "FREE SHAPE mode: drag an existing control point, "
                "or press Enter to apply the curve."
            )
            return

        nearest = nearest_selection_source(event)

        if nearest is None:
            return

        (
            path_pixel_distance,
            source_name,
            _source_index,
            snapped_point,
        ) = nearest

        if path_pixel_distance > path_pick_radius_pixels:
            set_status(
                "Click closer to a selectable reference line. "
                "No control point was added."
            )
            return

        if selection_target_line is None:
            line_name = source_name
            path_index = int(_source_index)
        else:
            line_name = selection_target_line
            path_index = nearest_editable_index_to_point(
                line_name,
                snapped_point,
            )

        for item in controls[line_name]:
            if int(item["index"]) == int(path_index):
                set_status(
                    f"{line_name}[{path_index}] already has a control point. "
                    "Drag the existing point instead."
                )
                return

        undo_stack.append(make_snapshot())
        redo_stack.clear()

        controls[line_name].append(
            {
                "index": int(path_index),
                "position": snapped_point.copy(),
                "snap_line": str(source_name),
                "source_index": int(_source_index),
            }
        )

        refresh()

        control_count = len(controls[line_name])
        set_status(
            f"{line_name}: control point added from {source_name} "
            f"at target waypoint {path_index} ({control_count} selected). "
            "Add more points or press Enter for FREE SHAPE mode."
        )

    def on_motion(event):
        line_name = interaction_state["drag_line"]
        control_index = interaction_state["drag_control_index"]

        if (
            line_name is None
            or control_index is None
        ):
            return

        if (
            event.inaxes is not ax
            or event.xdata is None
            or event.ydata is None
        ):
            return

        if interaction_state["phase"] == "shape":
            if interaction_state["drag_is_end_control"]:
                # The final control point is constrained to the same editable
                # path. Its waypoint index may move along that path, while all
                # other FREE SHAPE control points remain free in x/y.
                snap_line_name = str(
                    controls[line_name][int(control_index)].get(
                        "snap_line",
                        line_name,
                    )
                )

                (
                    _,
                    _source_index,
                    snapped_point,
                ) = nearest_index_on_selectable_line_from_event(
                    snap_line_name,
                    event,
                )

                path_index = (
                    int(_source_index)
                    if selection_target_line is None
                    else nearest_editable_index_to_point(
                        line_name,
                        snapped_point,
                    )
                )

                for other_index, item in enumerate(controls[line_name]):
                    if (
                        other_index != int(control_index)
                        and int(item["index"]) == int(path_index)
                    ):
                        return

                controls[line_name][int(control_index)]["index"] = int(
                    path_index
                )
                controls[line_name][int(control_index)]["position"] = (
                    snapped_point.copy()
                )
                controls[line_name][int(control_index)]["source_index"] = int(
                    _source_index
                )
            else:
                # Interior control points move freely while their original
                # waypoint indices stay fixed.
                controls[line_name][int(control_index)]["position"] = np.asarray(
                    [event.xdata, event.ydata],
                    dtype=np.float64,
                )

            refresh()
            return

        snap_line_name = str(
            controls[line_name][int(control_index)].get(
                "snap_line",
                line_name,
            )
        )

        (
            path_pixel_distance,
            _source_index,
            snapped_point,
        ) = nearest_index_on_selectable_line_from_event(
            snap_line_name,
            event,
        )

        path_index = (
            int(_source_index)
            if selection_target_line is None
            else nearest_editable_index_to_point(
                line_name,
                snapped_point,
            )
        )

        # SELECT mode keeps the control point snapped to its original source
        # line. If the cursor moves too far away, keep the last valid snap.
        # cursor moves too far away, keep the last valid snapped position.
        if path_pixel_distance > path_pick_radius_pixels:
            return

        for other_index, item in enumerate(controls[line_name]):
            if (
                other_index != int(control_index)
                and int(item["index"]) == int(path_index)
            ):
                return

        controls[line_name][int(control_index)]["index"] = int(
            path_index
        )
        controls[line_name][int(control_index)]["position"] = (
            snapped_point.copy()
        )
        controls[line_name][int(control_index)]["source_index"] = int(
            _source_index
        )

        refresh()

    def on_release(_event):
        if interaction_state["drag_line"] is None:
            return

        line_name = interaction_state["drag_line"]
        control_index = interaction_state["drag_control_index"]

        was_end_control = bool(
            interaction_state["drag_is_end_control"]
        )

        interaction_state["drag_line"] = None
        interaction_state["drag_control_index"] = None
        interaction_state["drag_is_end_control"] = False

        if interaction_state["phase"] == "select":
            set_status(
                f"{line_name} control point {int(control_index) + 1} moved "
                "along the path. Press Enter when point selection is complete."
            )
        elif was_end_control:
            set_status(
                f"Final {line_name} control point moved along the path. "
                "Press Enter to apply this curve."
            )
        else:
            set_status(
                f"{line_name} control point {int(control_index) + 1} moved freely. "
                "Press Enter to apply this curve."
            )

    def validate_active_controls():
        incomplete = [
            name
            for name, items in controls.items()
            if 0 < len(items) < 3
        ]

        if incomplete:
            set_status(
                "At least 3 control points are required for each active curve: "
                + ", ".join(incomplete)
            )
            return None

        active_names = [
            name
            for name, items in controls.items()
            if len(items) >= 3
        ]

        if not active_names:
            set_status(
                "No active curve. Add at least 3 control points, "
                "or press Enter to continue to the next stage."
            )
            return None

        return active_names

    def reset_incomplete_selection():
        pending_count = sum(
            len(items)
            for items in controls.values()
        )

        if pending_count <= 0:
            return

        undo_stack.append(make_snapshot())
        redo_stack.clear()

        clear_controls()
        interaction_state["phase"] = "select"
        refresh()

        set_status(
            f"Only {pending_count} control point(s) were selected. "
            "Pending curve selection was discarded. "
            "SELECT mode restarted from 0 points."
        )

        print(
            f"[CURVE] Incomplete selection reset: {pending_count} point(s) -> 0"
        )

    def enter_free_shape_mode():
        active_names = validate_active_controls()

        if active_names is None:
            return False

        undo_stack.append(make_snapshot())
        redo_stack.clear()

        interaction_state["phase"] = "shape"
        interaction_state["drag_line"] = None
        interaction_state["drag_control_index"] = None

        refresh()

        summary = ", ".join(
            f"{name}({len(controls[name])} pts)"
            for name in active_names
        )

        set_status(
            "FREE SHAPE mode: "
            + summary
            + ". Interior points move freely; each final point stays on its path. "
            "Press Enter to apply."
        )

        print(
            "[CURVE] Free-shape mode: "
            + summary
        )

        return True

    def apply_current_curves():
        active_names = validate_active_controls()

        if active_names is None:
            return False

        before_apply = make_snapshot()

        try:
            for name in active_names:
                items = controls[name]

                ordered = curve_order_controls(
                    items,
                    len(editable_lines[name]),
                    closed,
                )

                segment_indices, replacement_geometry = build_curve_geometry(
                    name,
                    ordered,
                    len(editable_lines[name]),
                )

                # Keep the editable PATH waypoint count unchanged. The full
                # geometry is re-sampled only to the number of indices being
                # replaced, so downstream section/index assumptions remain
                # intact while the endpoint MAIN connectors are preserved.
                replacement = dense_resample_by_count(
                    replacement_geometry,
                    len(segment_indices),
                )

                editable_lines[name][segment_indices] = replacement

            interaction_state["editable_revision"] = int(
                interaction_state.get("editable_revision", 0)
            ) + 1

            undo_stack.append(before_apply)
            redo_stack.clear()
            interaction_state["applied_any"] = True

            applied_summary = ", ".join(
                f"{name}({len(controls[name])} pts)"
                for name in active_names
            )

            clear_controls()
            interaction_state["phase"] = "select"
            refresh()

            set_status(
                "Curve applied: "
                + applied_summary
                + ". SELECT mode is active again. Add another curve, "
                "or press Enter with no control points for the next stage."
            )

            print(
                "[CURVE] Applied: "
                + applied_summary
            )

            return True

        except Exception as exc:
            restore_snapshot(before_apply)
            refresh()
            set_status(
                f"Curve application failed: {exc}"
            )
            return False

    def on_key(event):
        key = (
            event.key
            or ""
        ).lower()

        if key in (
            "ctrl+z",
            "control+z",
        ):
            undo_once()
            return

        if key in (
            "ctrl+y",
            "control+y",
        ):
            redo_once()
            return

        if key in (
            "enter",
            "return",
        ):
            if interaction_state["phase"] == "select":
                active_counts = [
                    len(items)
                    for items in controls.values()
                    if len(items) > 0
                ]

                if not active_counts:
                    # 0 points: finish this Curve Editor and continue to the
                    # next pipeline stage.
                    interaction_state["exit_requested"] = True
                    plt.close(fig)
                    return

                if any(count < 3 for count in active_counts):
                    # 1~2 pending points: discard only the unfinished current
                    # selection. Already-applied curve edits remain intact.
                    reset_incomplete_selection()
                    return

                # 3+ points: qualifying PATH_YEAH first resolves the main
                # line for every polygon section between the curve endpoints.
                # Other editors continue directly to FREE SHAPE mode.
                if section_main_context is not None:
                    prepare_polygon_section_mains()
                else:
                    enter_free_shape_mode()
                return

            # FREE SHAPE mode: Enter applies the current curve, clears the
            # controls, and returns to SELECT mode for another curve.
            apply_current_curves()
            return

    def on_close(_event):
        if not interaction_state["exit_requested"]:
            clear_controls()
            interaction_state["phase"] = "select"
            interaction_state["exit_requested"] = True

    fig.canvas.mpl_connect(
        "button_press_event",
        on_press,
    )
    fig.canvas.mpl_connect(
        "motion_notify_event",
        on_motion,
    )
    fig.canvas.mpl_connect(
        "button_release_event",
        on_release,
    )
    fig.canvas.mpl_connect(
        "key_press_event",
        on_key,
    )
    fig.canvas.mpl_connect(
        "close_event",
        on_close,
    )

    print()
    print("============================================")
    print("Interactive Curve Editor")
    print("============================================")
    print("Stage 1 - SELECT")
    print("  Left click   : add a control point snapped to the nearest path waypoint")
    print("  Point drag   : move a control point along the same path")
    print("  Enter (0 pts)  : finish curve editing and continue")
    print("  Enter (1-2 pts): discard pending points and restart SELECT from 0")
    print("  Enter (3+ pts) : switch to FREE SHAPE mode")
    if section_main_context is not None:
        print("Stage 1.5 - POLYGON SECTION MAIN")
        print("  Start section : existing PATH -> start-point source line -> start point")
        print("  End section   : end point -> end-point source line -> existing PATH")
        print("  Missing section: click IN_DENSE / MIDDLE_RAW / OUT_DENSE / current PATH_YEAH")
    print("Stage 2 - FREE SHAPE")
    print("  Interior drag: move interior control points freely")
    print("  Final drag   : final control point stays on the same path")
    print("  Enter        : apply the curve and return to SELECT mode")
    print(
        f"Control radius: {pick_radius_pixels:.0f} px "
        "(clicking near an existing point will not create a new point)"
    )
    print(
        f"Path radius   : {path_pick_radius_pixels:.0f} px "
        "(SELECT-mode clicks farther from the path are ignored)"
    )
    print("Ctrl+Z         : Undo")
    print("Ctrl+Y         : Redo")
    print("Enter          : context action described above")
    print("============================================")

    refresh()
    set_status(phase_instruction())
    plt.show()

    output = {}

    for name, points in editable_lines.items():
        output[name] = (
            dense_close_path(points)
            if closed
            else points.copy()
        )

    return (
        output,
        bool(interaction_state["applied_any"]),
    )


def curve_interactive_editor(
    lines: Dict[
        str,
        np.ndarray,
    ],
    closed: bool,
    no_show: bool,
    title: str,
    background_lines: Optional[
        Dict[
            str,
            np.ndarray,
        ]
    ] = None,
    initial_reference_lines: Optional[
        Dict[
            str,
            np.ndarray,
        ]
    ] = None,
    selection_reference_lines: Optional[
        Dict[
            str,
            np.ndarray,
        ]
    ] = None,
    editable_selection_alias: Optional[str] = None,
    prefer_dynamic_selection: bool = False,
    section_main_context: Optional[Dict] = None,
) -> Tuple[
    Dict[
        str,
        np.ndarray,
    ],
    bool,
]:
    """
    Interactive cubic-spline curve editor with a two-stage workflow.

    Stage 1 - SELECT:
        Left click near an editable path to add a control point snapped to
        the nearest existing waypoint.

        Dragging an existing control point keeps it snapped to a waypoint on
        the same editable path.

        Enter behavior in SELECT mode:
          - 0 control points: close the Curve Editor and proceed.
          - 1~2 control points: discard the pending selection and restart
            SELECT mode from 0 control points.
          - 3 or more control points: switch to FREE SHAPE mode.

    Stage 2 - FREE SHAPE:
        Interior control points can be dragged freely anywhere in the axes.
        The final control point of each active curve is constrained to the
        same editable path and snaps to its nearest waypoint while dragging.
        Enter applies the current cubic-spline curve, clears the control
        points, and returns to SELECT mode for another curve.

    Ctrl+Z:
        Undo the latest control-point edit, mode transition, or applied curve.

    Ctrl+Y:
        Redo the latest undone edit.

    Enter behavior:
        SELECT mode + 0 control points  -> leave the Curve Editor and proceed.
        SELECT mode + 1~2 points        -> discard the pending points and
                                           restart SELECT mode from 0 points.
        SELECT mode + 3+ points         -> enter FREE SHAPE mode.
        FREE SHAPE mode                 -> apply the current curve and return
                                           to SELECT mode.

    Window close:
        Discard only the currently un-applied control points and leave the
        Curve Editor. Curves already applied with Enter are preserved.

    The replacement keeps the original number of waypoints in the selected
    segment so the existing ROI/section index structure remains valid.
    """
    editable_lines = {}

    for name, points in lines.items():
        points_array = np.asarray(
            points,
            dtype=np.float64,
        )

        if closed:
            points_array = dense_open_path(
                points_array
            )
        else:
            points_array = dense_remove_duplicates(
                points_array
            )

        if len(points_array) < 3:
            raise ValueError(
                f"{name}: at least 3 waypoints are required for curve editing."
            )

        editable_lines[name] = points_array.copy()

    # Fixed reference geometry shown throughout this Curve Editor session.
    # If the caller supplies the geometry from before the straight-line edit,
    # keep that as the true initial line. Otherwise use the curve-editor entry
    # geometry as the initial reference.
    initial_lines = {}

    for name, current_points in editable_lines.items():
        if (
            initial_reference_lines is not None
            and name in initial_reference_lines
        ):
            reference_points = np.asarray(
                initial_reference_lines[name],
                dtype=np.float64,
            )

            if closed:
                reference_points = dense_open_path(reference_points)
            else:
                reference_points = dense_remove_duplicates(reference_points)

            initial_lines[name] = reference_points.copy()
        else:
            initial_lines[name] = current_points.copy()

    # Control-point snap sources. Normally each editable path is its own
    # selection source. For PATH_YEAH qualifying mode, the caller can provide
    # IN_DENSE / MIDDLE_RAW / OUT_DENSE so control points may be selected from
    # any of those three reference lines while still modifying one PATH_YEAH.
    if selection_reference_lines is None:
        selectable_lines = {
            name: points.copy()
            for name, points
            in editable_lines.items()
        }
        selection_target_line = None
    else:
        if len(editable_lines) != 1:
            raise ValueError(
                "selection_reference_lines currently requires exactly one editable path."
            )

        selection_target_line = next(
            iter(editable_lines.keys())
        )
        selectable_lines = {}

        for reference_name, reference_points in selection_reference_lines.items():
            reference_array = np.asarray(
                reference_points,
                dtype=np.float64,
            )

            if closed:
                reference_array = dense_open_path(
                    reference_array
                )
            else:
                reference_array = dense_remove_duplicates(
                    reference_array
                )

            if len(reference_array) < 2:
                raise ValueError(
                    f"{reference_name}: at least 2 waypoints are required as a curve selection source."
                )

            selectable_lines[str(reference_name)] = reference_array.copy()

        if not selectable_lines:
            raise ValueError(
                "selection_reference_lines is empty."
            )

    # Optional dynamic selection source that always points to the CURRENT
    # editable path rather than a frozen copy. This is used by qualifying
    # PATH_YEAH so a second curve can select points from the result of the
    # first applied curve.
    dynamic_selection_alias = None
    if editable_selection_alias is not None:
        if selection_target_line is None:
            raise ValueError(
                "editable_selection_alias requires selection_reference_lines "
                "with exactly one editable path."
            )

        dynamic_selection_alias = str(editable_selection_alias)
        if dynamic_selection_alias in selectable_lines:
            raise ValueError(
                f"Duplicate curve selection source name: {dynamic_selection_alias}"
            )

        # Placeholder only. All geometry reads for this source go through
        # selectable_points_for_source(), which returns editable_lines directly.
        selectable_lines[dynamic_selection_alias] = editable_lines[
            selection_target_line
        ]

    if no_show:
        return (
            {
                name: (
                    dense_close_path(points)
                    if closed
                    else points.copy()
                )
                for name, points
                in editable_lines.items()
            },
            False,
        )

    controls = {
        name: []
        for name in editable_lines.keys()
    }

    undo_stack = []
    redo_stack = []

    interaction_state = {
        "drag_line": None,
        "drag_control_index": None,
        "drag_is_end_control": False,
        "exit_requested": False,
        "applied_any": False,
        "phase": "select",
        "section_main_map": {},
        # Polygon sections whose MAIN line has already been committed by an
        # applied curve. These assignments survive clear_controls() and cannot
        # be overwritten by later curve edits.
        "locked_section_main_map": {},
        "section_sequence": [],
        "pending_section_orders": [],
        "section_overlay_artists": [],
        "editable_revision": 0,
    }

    # Clicking near an existing control point selects that point instead of
    # creating a new one.
    pick_radius_pixels = 14.0

    # New control points can only be created near an editable path.
    path_pick_radius_pixels = 28.0

    fig, ax = plt.subplots(
        figsize=(14, 10)
    )

    # Qualifying PATH_YEAH can use track_roi polygons as longitudinal
    # section guides. All section polygons stay visible throughout the
    # Curve Editor; the section currently waiting for a main-line choice
    # is highlighted dynamically in refresh().
    if section_main_context is not None:
        for section_order in section_main_context.get("orders", []):
            for vertices in section_main_context.get("polygons", {}).get(
                int(section_order),
                [],
            ):
                vertices = np.asarray(vertices, dtype=np.float64)
                if len(vertices) < 3:
                    continue

                patch = MplPolygon(
                    vertices,
                    closed=True,
                    facecolor="none",
                    edgecolor="0.55",
                    linewidth=0.8,
                    alpha=0.45,
                    zorder=0,
                )
                ax.add_patch(patch)

    if background_lines:
        for background_name, background_points in background_lines.items():
            background_points = np.asarray(
                background_points,
                dtype=np.float64,
            )

            background_label = str(background_name)
            is_initial_background = (
                "initial" in background_label.lower()
            )

            background_style = line_visual_style(
                background_label,
                active=False,
                initial=is_initial_background,
            )

            ax.plot(
                background_points[:, 0],
                background_points[:, 1],
                color=background_style["color"],
                linewidth=background_style["linewidth"],
                linestyle=background_style["linestyle"],
                alpha=background_style["alpha"],
                label=background_label,
                zorder=(
                    1
                    if is_initial_background
                    else 2
                ),
            )

    initial_line_artists = {}
    line_artists = {}
    preview_artists = {}
    control_artists = {}

    for name, points in editable_lines.items():
        initial_draw_points = (
            dense_close_path(initial_lines[name])
            if closed
            else initial_lines[name]
        )

        base = lane_base_name(name)
        initial_semantic_name = (
            f"{base}_offset"
            if base in ("left", "right")
            else f"{base}_initial"
        )
        initial_style = line_visual_style(
            initial_semantic_name,
            initial=(base not in ("left", "right")),
        )
        active_style = line_visual_style(
            f"{base}_track",
            active=True,
        )

        initial_line_artist, = ax.plot(
            initial_draw_points[:, 0],
            initial_draw_points[:, 1],
            color=initial_style["color"],
            linewidth=initial_style["linewidth"],
            linestyle=initial_style["linestyle"],
            alpha=initial_style["alpha"],
            label=f"{name} initial",
            zorder=2,
        )

        draw_points = (
            dense_close_path(points)
            if closed
            else points
        )

        line_artist, = ax.plot(
            draw_points[:, 0],
            draw_points[:, 1],
            color=active_style["color"],
            linewidth=active_style["linewidth"],
            linestyle=active_style["linestyle"],
            alpha=active_style["alpha"],
            label=f"{name} modified",
            zorder=4,
        )

        preview_artist, = ax.plot(
            [],
            [],
            color=active_style["color"],
            linewidth=3.4,
            linestyle="--",
            alpha=0.95,
            label=f"{name} curve preview",
            zorder=7,
        )

        control_artist = ax.scatter(
            [],
            [],
            s=70,
            marker="o",
            facecolors=active_style["color"],
            edgecolors="black",
            linewidths=0.8,
            label=f"{name} control",
            zorder=9,
        )

        initial_line_artists[name] = initial_line_artist
        line_artists[name] = line_artist
        preview_artists[name] = preview_artist
        control_artists[name] = control_artist

    status_text = ax.text(
        0.01,
        0.01,
        "",
        transform=ax.transAxes,
        fontsize=9,
        verticalalignment="bottom",
    )

    ax.set_aspect(
        "equal",
        adjustable="box",
    )
    ax.grid(True)
    ax.set_xlabel("x [m]")
    ax.set_ylabel("y [m]")
    ax.legend(
        loc="best",
        fontsize=8,
    )
    fig.tight_layout()

    def phase_instruction() -> str:
        phase = interaction_state["phase"]

        if phase == "select":
            return (
                "SELECT mode | Click near path: add snapped control point | "
                "Drag point: move along same path | "
                "Enter: 0 pts=next, 1-2 pts=reset, 3+ pts=section/free-shape | "
                "Ctrl+Z: Undo | Ctrl+Y: Redo"
            )

        if phase == "section":
            pending = interaction_state.get("pending_section_orders", [])
            current = pending[0] if pending else "-"
            return (
                f"SECTION MAIN mode | Section {current}: click IN_DENSE, "
                "MIDDLE_RAW, or OUT_DENSE inside the highlighted section | "
                "Ctrl+Z: Undo | Ctrl+Y: Redo"
            )

        return (
            "FREE SHAPE mode | Interior points: free drag | "
            "Final point: constrained to the same path | "
            "Enter: apply curve and return to SELECT mode | "
            "Ctrl+Z: Undo | Ctrl+Y: Redo"
        )

    def update_title():
        phase = interaction_state["phase"]

        if phase == "select":
            subtitle = (
                "SELECT MODE - Enter: 0 pts = next stage, "
                "1-2 pts = reset selection, 3+ pts = section/free-shape."
            )
        elif phase == "section":
            pending = interaction_state.get("pending_section_orders", [])
            current = pending[0] if pending else "-"
            subtitle = (
                f"SECTION MAIN MODE - Section {current}: click the main line "
                "inside the highlighted polygon section."
            )
        else:
            subtitle = (
                "FREE SHAPE MODE - Interior points move freely; "
                "the final point stays on the path. Enter: apply."
            )

        ax.set_title(
            title
            + "\n"
            + subtitle
            + " | Dashed = initial, Solid = modified"
        )

    def set_status(message: str):
        status_text.set_text(message)
        fig.canvas.draw_idle()

    def copy_controls():
        return {
            name: [
                {
                    "index": int(item["index"]),
                    "position": np.asarray(
                        item["position"],
                        dtype=np.float64,
                    ).copy(),
                    "snap_line": str(
                        item.get(
                            "snap_line",
                            name,
                        )
                    ),
                    "source_index": int(
                        item.get(
                            "source_index",
                            item.get("index", 0),
                        )
                    ),
                }
                for item in items
            ]
            for name, items in controls.items()
        }

    def copy_lines():
        return {
            name: np.asarray(
                points,
                dtype=np.float64,
            ).copy()
            for name, points in editable_lines.items()
        }

    def make_snapshot():
        return {
            "lines": copy_lines(),
            "controls": copy_controls(),
            "applied_any": bool(
                interaction_state["applied_any"]
            ),
            "phase": str(
                interaction_state["phase"]
            ),
            "section_main_map": dict(
                interaction_state.get("section_main_map", {})
            ),
            "locked_section_main_map": dict(
                interaction_state.get("locked_section_main_map", {})
            ),
            "section_sequence": list(
                interaction_state.get("section_sequence", [])
            ),
            "pending_section_orders": list(
                interaction_state.get("pending_section_orders", [])
            ),
        }

    def restore_snapshot(snapshot):
        for name in editable_lines.keys():
            editable_lines[name] = np.asarray(
                snapshot["lines"][name],
                dtype=np.float64,
            ).copy()

            controls[name] = [
                {
                    "index": int(item["index"]),
                    "position": np.asarray(
                        item["position"],
                        dtype=np.float64,
                    ).copy(),
                    "snap_line": str(
                        item.get(
                            "snap_line",
                            name,
                        )
                    ),
                    "source_index": int(
                        item.get(
                            "source_index",
                            item.get("index", 0),
                        )
                    ),
                }
                for item in snapshot["controls"].get(name, [])
            ]

        interaction_state["applied_any"] = bool(
            snapshot.get("applied_any", False)
        )
        interaction_state["phase"] = str(
            snapshot.get("phase", "select")
        )
        interaction_state["section_main_map"] = dict(
            snapshot.get("section_main_map", {})
        )
        interaction_state["locked_section_main_map"] = dict(
            snapshot.get("locked_section_main_map", {})
        )
        interaction_state["section_sequence"] = list(
            snapshot.get("section_sequence", [])
        )
        interaction_state["pending_section_orders"] = list(
            snapshot.get("pending_section_orders", [])
        )
        interaction_state["editable_revision"] = int(
            interaction_state.get("editable_revision", 0)
        ) + 1

    dynamic_section_cache = {
        "revision": None,
        "sections": None,
    }

    def selectable_points_for_source(source_name: str) -> np.ndarray:
        source_name = str(source_name)

        if (
            dynamic_selection_alias is not None
            and source_name == dynamic_selection_alias
        ):
            return editable_lines[selection_target_line]

        return selectable_lines[source_name]

    def selectable_sections_for_source(
        source_name: str,
    ) -> Optional[np.ndarray]:
        if section_main_context is None:
            return None

        source_name = str(source_name)

        if not (
            dynamic_selection_alias is not None
            and source_name == dynamic_selection_alias
        ):
            sections = section_main_context.get(
                "point_sections", {}
            ).get(source_name)
            if sections is None:
                return None
            return np.asarray(sections, dtype=np.int64)

        revision = int(
            interaction_state.get("editable_revision", 0)
        )
        if (
            dynamic_section_cache["revision"] == revision
            and dynamic_section_cache["sections"] is not None
        ):
            return dynamic_section_cache["sections"]

        points = np.asarray(
            selectable_points_for_source(source_name),
            dtype=np.float64,
        )
        orders = [
            int(value)
            for value in section_main_context.get("orders", [])
        ]
        references = section_main_context.get("references", {})

        if len(points) == 0 or not orders:
            return None

        distance_rows = []
        for order in orders:
            order_references = references.get(int(order), {})
            per_line_distances = []

            for reference_name in (
                "IN_DENSE",
                "MIDDLE_RAW",
                "OUT_DENSE",
            ):
                reference_points = order_references.get(reference_name)
                if reference_points is None or len(reference_points) < 2:
                    continue

                per_line_distances.append(
                    dense_point_to_polyline_distances_numpy(
                        points,
                        np.asarray(reference_points, dtype=np.float64),
                    )
                )

            if not per_line_distances:
                distance_rows.append(
                    np.full(len(points), np.inf, dtype=np.float64)
                )
            else:
                distance_rows.append(
                    np.min(np.vstack(per_line_distances), axis=0)
                )

        distance_matrix = np.vstack(distance_rows)
        nearest_positions = np.argmin(distance_matrix, axis=0)
        sections = np.asarray(
            [orders[int(position)] for position in nearest_positions],
            dtype=np.int64,
        )

        dynamic_section_cache["revision"] = revision
        dynamic_section_cache["sections"] = sections
        return sections

    def clear_controls():
        for name in controls.keys():
            controls[name] = []

        interaction_state["drag_line"] = None
        interaction_state["drag_control_index"] = None
        interaction_state["drag_is_end_control"] = False
        interaction_state["section_main_map"] = {}
        interaction_state["section_sequence"] = []
        interaction_state["pending_section_orders"] = []

    def control_section_order(item: Dict) -> Optional[int]:
        if section_main_context is None:
            return None

        source_name = str(
            item.get("snap_line", "")
        )
        source_sections = selectable_sections_for_source(
            source_name
        )

        if source_sections is None or len(source_sections) == 0:
            return None

        source_index = int(
            item.get("source_index", 0)
        )
        source_index = max(
            0,
            min(
                source_index,
                len(source_sections) - 1,
            ),
        )

        return int(
            source_sections[source_index]
        )

    def section_order_sequence(
        start_order: int,
        end_order: int,
    ) -> List[int]:
        if section_main_context is None:
            return []

        orders = [
            int(value)
            for value in section_main_context.get("orders", [])
        ]

        if not orders:
            return []

        if start_order not in orders or end_order not in orders:
            return []

        start_position = orders.index(start_order)
        end_position = orders.index(end_order)

        if not closed:
            if start_position <= end_position:
                return orders[start_position:end_position + 1]
            return orders[end_position:start_position + 1]

        result = [orders[start_position]]
        position = start_position

        while orders[position] != end_order:
            position = (position + 1) % len(orders)
            result.append(orders[position])

            if len(result) > len(orders) + 1:
                raise RuntimeError(
                    "Failed to build polygon section sequence."
                )

        return result

    def nearest_selection_in_section(
        event,
        section_order: int,
        line_name: str,
    ):
        if section_main_context is None:
            return None

        best = None
        used_target_indices = {
            int(item["index"])
            for item in controls.get(line_name, [])
        }

        for source_name in selectable_lines.keys():
            points = selectable_points_for_source(source_name)
            source_sections = selectable_sections_for_source(source_name)

            if source_sections is None:
                continue

            candidate_indices = np.where(
                np.asarray(source_sections, dtype=np.int64)
                == int(section_order)
            )[0]

            if len(candidate_indices) == 0:
                continue

            candidate_points = points[candidate_indices]
            screen_points = ax.transData.transform(candidate_points)
            differences = (
                screen_points
                - np.asarray([event.x, event.y], dtype=np.float64)
            )
            distance2 = np.sum(
                differences * differences,
                axis=1,
            )
            sorted_positions = np.argsort(distance2)

            for local_position in sorted_positions:
                source_index = int(
                    candidate_indices[int(local_position)]
                )
                snapped_point = points[source_index].copy()
                target_index = (
                    source_index
                    if selection_target_line is None
                    else nearest_editable_index_to_point(
                        line_name,
                        snapped_point,
                    )
                )

                if int(target_index) in used_target_indices:
                    continue

                distance = float(
                    np.sqrt(
                        distance2[int(local_position)]
                    )
                )

                candidate = (
                    distance,
                    source_name,
                    source_index,
                    snapped_point,
                    int(target_index),
                )

                if best is None or distance < best[0]:
                    best = candidate
                break

        return best

    def prepare_polygon_section_mains() -> bool:
        if section_main_context is None:
            return enter_free_shape_mode()

        active_names = validate_active_controls()
        if active_names is None:
            return False

        if len(active_names) != 1:
            set_status(
                "Polygon section-main mode supports one active path at a time."
            )
            return False

        line_name = active_names[0]
        ordered = curve_order_controls(
            controls[line_name],
            len(editable_lines[line_name]),
            closed,
        )

        if len(ordered) < 3:
            return False

        start_order = control_section_order(ordered[0])
        end_order = control_section_order(ordered[-1])

        if start_order is None or end_order is None:
            set_status(
                "Could not determine the polygon section for the curve endpoints."
            )
            return False

        sequence = section_order_sequence(
            int(start_order),
            int(end_order),
        )

        if not sequence:
            set_status(
                "Could not determine the polygon sections between the curve endpoints."
            )
            return False

        undo_stack.append(make_snapshot())
        redo_stack.clear()

        locked_map = {
            int(order): str(main_name)
            for order, main_name in interaction_state.get(
                "locked_section_main_map", {}
            ).items()
        }

        # Start from already-committed MAIN assignments. A section that was
        # modified by a previously applied curve is locked and later control
        # points are not allowed to replace its MAIN line.
        main_map = {
            int(order): str(locked_map[int(order)])
            for order in sequence
            if int(order) in locked_map
        }

        # For still-unlocked sections, a selected control point can choose the
        # initial MAIN line. Locked sections are deliberately skipped.
        for item in ordered:
            order = control_section_order(item)
            if (
                order in sequence
                and int(order) not in locked_map
                and int(order) not in main_map
            ):
                main_map[int(order)] = str(
                    item.get("snap_line", "")
                )

        # Endpoint rule applies only to sections that have not already been
        # committed. If the start/end section is locked, its old MAIN remains.
        if int(start_order) not in locked_map:
            main_map[int(start_order)] = str(
                ordered[0].get("snap_line", "")
            )
        if (
            int(end_order) != int(start_order)
            and int(end_order) not in locked_map
        ):
            main_map[int(end_order)] = str(
                ordered[-1].get("snap_line", "")
            )

        missing = [
            int(order)
            for order in sequence
            if int(order) not in main_map
        ]

        interaction_state["section_main_map"] = main_map
        interaction_state["section_sequence"] = [
            int(order) for order in sequence
        ]
        interaction_state["pending_section_orders"] = missing
        interaction_state["drag_line"] = None
        interaction_state["drag_control_index"] = None
        interaction_state["drag_is_end_control"] = False

        if missing:
            interaction_state["phase"] = "section"
            refresh()
            current = int(missing[0])
            set_status(
                f"Section {current} has no main line. "
                "Click IN_DENSE, MIDDLE_RAW, OUT_DENSE, or current PATH_YEAH inside the highlighted section."
            )
            print(
                f"[CURVE] Section {current}: select main line by click."
            )
            return True

        interaction_state["phase"] = "shape"
        refresh()
        set_status(
            "All polygon sections have a main line. FREE SHAPE mode is active. "
            "Press Enter to apply the curve."
        )
        return True

    def section_source_run_indices(
        source_name: str,
        section_order: int,
        source_index: int,
    ) -> np.ndarray:
        """
        Return the contiguous waypoint run of source_name that belongs to one
        polygon section and contains source_index. Closed paths are handled
        circularly so a section that crosses index 0 still forms one run.
        """
        if section_main_context is None:
            return np.asarray([int(source_index)], dtype=np.int64)

        source_points = selectable_points_for_source(str(source_name))
        point_sections = selectable_sections_for_source(str(source_name))

        if point_sections is None or len(source_points) == 0:
            return np.asarray([int(source_index)], dtype=np.int64)

        usable_count = min(len(source_points), len(point_sections))
        if usable_count <= 0:
            return np.asarray([0], dtype=np.int64)

        source_index = int(source_index) % usable_count if closed else max(
            0, min(int(source_index), usable_count - 1)
        )
        sections = np.asarray(point_sections[:usable_count], dtype=np.int64)
        target_order = int(section_order)

        # If numerical section assignment around the selected source point is
        # inconsistent, fall back to all points assigned to the requested
        # section and choose the closest one to the selected index.
        if int(sections[source_index]) != target_order:
            candidates = np.where(sections == target_order)[0]
            if len(candidates) == 0:
                return np.asarray([source_index], dtype=np.int64)
            if closed:
                delta = np.minimum(
                    np.abs(candidates - source_index),
                    usable_count - np.abs(candidates - source_index),
                )
                source_index = int(candidates[int(np.argmin(delta))])
            else:
                source_index = int(
                    candidates[int(np.argmin(np.abs(candidates - source_index)))]
                )

        if not closed:
            left = source_index
            while left > 0 and int(sections[left - 1]) == target_order:
                left -= 1

            right = source_index
            while (
                right + 1 < usable_count
                and int(sections[right + 1]) == target_order
            ):
                right += 1

            return np.arange(left, right + 1, dtype=np.int64)

        left = source_index
        for _ in range(usable_count - 1):
            previous = (left - 1) % usable_count
            if previous == source_index or int(sections[previous]) != target_order:
                break
            left = previous

        right = source_index
        for _ in range(usable_count - 1):
            following = (right + 1) % usable_count
            if following == source_index or int(sections[following]) != target_order:
                break
            right = following

        result = [left]
        cursor = left
        while cursor != right:
            cursor = (cursor + 1) % usable_count
            result.append(cursor)
            if len(result) > usable_count:
                raise RuntimeError(
                    "Failed to build the source-line run for a polygon section."
                )

        return np.asarray(result, dtype=np.int64)

    def curve_deduplicate_allow_single(
        points: np.ndarray,
        tolerance: float = 1.0e-8,
    ) -> np.ndarray:
        points = np.asarray(points, dtype=np.float64)
        if len(points) <= 1:
            return points.copy()

        result = [points[0].copy()]
        for point in points[1:]:
            if np.linalg.norm(point - result[-1]) > tolerance:
                result.append(point.copy())
        return np.asarray(result, dtype=np.float64)

    def endpoint_main_connector(
        line_name: str,
        endpoint_item: Dict,
        is_start: bool,
    ):
        """
        Build the real MAIN connector for a qualifying curve endpoint.

        Start section:
            existing PATH -> selected source line -> start control point
        End section:
            end control point -> selected source line -> existing PATH

        The returned anchor index expands the replacement segment to the
        section-side connection point on the existing editable path.
        """
        if section_main_context is None:
            return int(endpoint_item["index"]), np.asarray(
                [endpoint_item["position"]], dtype=np.float64
            )

        endpoint_source_name = str(endpoint_item.get("snap_line", ""))

        section_order = control_section_order(endpoint_item)
        if section_order is None:
            return int(endpoint_item["index"]), np.asarray(
                [endpoint_item["position"]], dtype=np.float64
            )

        # MAIN is resolved from the active section map first. This map is
        # pre-seeded with locked assignments, so an already-modified section
        # continues to use the same MAIN even if a later endpoint is clicked
        # on another selectable line.
        source_name = str(
            interaction_state.get("section_main_map", {}).get(
                int(section_order),
                interaction_state.get("locked_section_main_map", {}).get(
                    int(section_order),
                    endpoint_source_name,
                ),
            )
        )

        if source_name not in selectable_lines:
            return int(endpoint_item["index"]), np.asarray(
                [endpoint_item["position"]], dtype=np.float64
            )

        source_points = selectable_points_for_source(source_name)

        # If the endpoint itself was clicked on another line while this section
        # is locked, project that endpoint to the nearest waypoint on the locked
        # MAIN and use that waypoint to choose the contiguous section run.
        if source_name == endpoint_source_name:
            main_source_index = int(endpoint_item.get("source_index", 0))
        else:
            endpoint_position = np.asarray(
                endpoint_item["position"], dtype=np.float64
            )
            main_source_index = int(
                np.argmin(
                    np.sum(
                        (source_points - endpoint_position) ** 2,
                        axis=1,
                    )
                )
            )

        run_indices = section_source_run_indices(
            source_name,
            int(section_order),
            int(main_source_index),
        )

        if len(run_indices) == 0:
            return int(endpoint_item["index"]), np.asarray(
                [endpoint_item["position"]], dtype=np.float64
            )

        # Find the selected source waypoint inside this section run.
        source_index = int(main_source_index)
        run_list = [int(value) for value in run_indices]
        if source_index in run_list:
            local_position = run_list.index(source_index)
        else:
            run_points = source_points[run_indices]
            distance2 = np.sum(
                (run_points - np.asarray(endpoint_item["position"], dtype=np.float64)) ** 2,
                axis=1,
            )
            local_position = int(np.argmin(distance2))
            source_index = int(run_indices[local_position])

        if is_start:
            # Section entrance -> selected start point.
            selected_indices = run_indices[:local_position + 1]
            section_boundary_point = source_points[int(run_indices[0])].copy()
        else:
            # Selected end point -> section exit.
            selected_indices = run_indices[local_position:]
            section_boundary_point = source_points[int(run_indices[-1])].copy()

        path_anchor_index = nearest_editable_index_to_point(
            line_name,
            section_boundary_point,
        )
        path_anchor_point = editable_lines[line_name][path_anchor_index].copy()
        source_connector = source_points[selected_indices].copy()
        current_endpoint = np.asarray(
            endpoint_item["position"],
            dtype=np.float64,
        ).copy()

        if is_start:
            connector_parts = [path_anchor_point.reshape(1, 2)]
            if len(source_connector) > 0:
                connector_parts.append(source_connector)
            if (
                len(source_connector) == 0
                or np.linalg.norm(source_connector[-1] - current_endpoint) > EPS
            ):
                connector_parts.append(current_endpoint.reshape(1, 2))
        else:
            connector_parts = [current_endpoint.reshape(1, 2)]
            if len(source_connector) > 0:
                if np.linalg.norm(source_connector[0] - current_endpoint) <= EPS:
                    if len(source_connector) > 1:
                        connector_parts.append(source_connector[1:])
                else:
                    connector_parts.append(source_connector)
            if (
                np.linalg.norm(connector_parts[-1][-1] - path_anchor_point) > EPS
            ):
                connector_parts.append(path_anchor_point.reshape(1, 2))

        connector = curve_deduplicate_allow_single(
            np.vstack(connector_parts)
        )

        return int(path_anchor_index), connector

    def build_curve_geometry(
        name: str,
        ordered: List[Dict],
        output_count: int,
    ):
        """
        Build a curve replacement. Qualifying PATH_YEAH additionally uses
        endpoint-section MAIN connectors so the selected start/end source
        lines actually connect the edited curve to the existing path.
        """
        control_positions = np.asarray(
            [item["position"] for item in ordered],
            dtype=np.float64,
        )

        if section_main_context is None:
            segment_indices = curve_segment_indices_from_controls(
                ordered,
                len(editable_lines[name]),
                closed,
            )
            curve_points = curve_generate_spline_points(
                control_positions,
                max(2, int(output_count)),
            )
            return segment_indices, curve_points

        start_anchor_index, start_connector = endpoint_main_connector(
            name, ordered[0], True
        )
        end_anchor_index, end_connector = endpoint_main_connector(
            name, ordered[-1], False
        )

        anchor_controls = [
            {"index": int(start_anchor_index)},
            {"index": int(end_anchor_index)},
        ]
        segment_indices = curve_segment_indices_from_controls(
            anchor_controls,
            len(editable_lines[name]),
            closed,
        )

        central_count = max(
            120,
            len(segment_indices) * 3,
            int(output_count),
        )
        central_curve = curve_generate_spline_points(
            control_positions,
            central_count,
        )

        pieces = []
        if len(start_connector) > 0:
            pieces.append(start_connector)
        if len(central_curve) > 0:
            if pieces and np.linalg.norm(pieces[-1][-1] - central_curve[0]) <= EPS:
                pieces.append(central_curve[1:])
            else:
                pieces.append(central_curve)
        if len(end_connector) > 0:
            if pieces and np.linalg.norm(pieces[-1][-1] - end_connector[0]) <= EPS:
                pieces.append(end_connector[1:])
            else:
                pieces.append(end_connector)

        pieces = [piece for piece in pieces if len(piece) > 0]
        if not pieces:
            raise ValueError("Failed to build qualifying curve geometry.")

        composite = curve_deduplicate_allow_single(np.vstack(pieces))
        if len(composite) < 2:
            raise ValueError(
                "Qualifying curve geometry has fewer than 2 unique points."
            )

        if len(segment_indices) < 2:
            # Extremely short/degenerate endpoint-section anchors can map to
            # one PATH waypoint. Fall back to the original control-point span
            # rather than attempting a one-point resample.
            segment_indices = curve_segment_indices_from_controls(
                ordered,
                len(editable_lines[name]),
                closed,
            )

        return segment_indices, composite

    def build_preview(name: str):
        line_controls = controls[name]

        if len(line_controls) < 3:
            return (
                None,
                None,
            )

        ordered = curve_order_controls(
            line_controls,
            len(editable_lines[name]),
            closed,
        )

        # For qualifying PATH_YEAH, the preview includes the actual MAIN
        # connectors in the start/end polygon sections.
        segment_indices, preview_points = build_curve_geometry(
            name,
            ordered,
            max(120, len(editable_lines[name]) // 3),
        )

        return (
            segment_indices,
            preview_points,
        )

    def refresh():
        # Remove dynamic polygon-section overlays from the previous frame.
        for artist in interaction_state.get("section_overlay_artists", []):
            try:
                artist.remove()
            except Exception:
                pass
        interaction_state["section_overlay_artists"] = []

        if section_main_context is not None:
            # Show the chosen main line for each section in the active curve.
            for section_order, main_name in interaction_state.get(
                "section_main_map", {}
            ).items():
                polygon_list = section_main_context.get(
                    "polygons", {}
                ).get(int(section_order), [])

                if polygon_list:
                    all_vertices = np.vstack([
                        np.asarray(vertices, dtype=np.float64)
                        for vertices in polygon_list
                        if len(vertices) >= 3
                    ])
                    center = np.mean(all_vertices, axis=0)
                    locked = int(section_order) in interaction_state.get(
                        "locked_section_main_map", {}
                    )
                    lock_suffix = "\nLOCKED" if locked else ""
                    text_artist = ax.text(
                        center[0],
                        center[1],
                        f"S{int(section_order)}\n{main_name}{lock_suffix}",
                        fontsize=8,
                        ha="center",
                        va="center",
                        zorder=12,
                    )
                    interaction_state["section_overlay_artists"].append(
                        text_artist
                    )

            pending = interaction_state.get(
                "pending_section_orders", []
            )
            if interaction_state.get("phase") == "section" and pending:
                current_order = int(pending[0])
                for vertices in section_main_context.get(
                    "polygons", {}
                ).get(current_order, []):
                    vertices = np.asarray(vertices, dtype=np.float64)
                    if len(vertices) < 3:
                        continue
                    highlight = MplPolygon(
                        vertices,
                        closed=True,
                        facecolor="gold",
                        edgecolor="crimson",
                        linewidth=2.2,
                        alpha=0.18,
                        zorder=1,
                    )
                    ax.add_patch(highlight)
                    interaction_state["section_overlay_artists"].append(
                        highlight
                    )

        for name in editable_lines.keys():
            draw_points = (
                dense_close_path(editable_lines[name])
                if closed
                else editable_lines[name]
            )

            line_artists[name].set_data(
                draw_points[:, 0],
                draw_points[:, 1],
            )

            positions = np.asarray(
                [
                    item["position"]
                    for item in controls[name]
                ],
                dtype=np.float64,
            )

            if len(positions) == 0:
                control_artists[name].set_offsets(
                    np.empty(
                        (0, 2),
                        dtype=np.float64,
                    )
                )
            else:
                control_artists[name].set_offsets(
                    positions
                )

            try:
                _, preview_points = build_preview(name)

                if preview_points is None:
                    preview_artists[name].set_data(
                        [],
                        [],
                    )
                else:
                    preview_artists[name].set_data(
                        preview_points[:, 0],
                        preview_points[:, 1],
                    )

            except Exception as exc:
                preview_artists[name].set_data(
                    [],
                    [],
                )
                set_status(
                    f"{name}: curve preview failed: {exc}"
                )

        update_title()
        ax.relim()
        ax.autoscale_view()
        fig.canvas.draw_idle()

    def pixel_distance_to_control(event):
        best = None

        for name, items in controls.items():
            for control_index, item in enumerate(items):
                screen_xy = ax.transData.transform(
                    item["position"]
                )

                distance = float(
                    np.hypot(
                        screen_xy[0] - event.x,
                        screen_xy[1] - event.y,
                    )
                )

                if (
                    best is None
                    or distance < best[0]
                ):
                    best = (
                        distance,
                        name,
                        control_index,
                    )

        return best

    def nearest_index_on_line_from_event(
        line_name: str,
        event,
    ):
        points = editable_lines[line_name]
        screen_points = ax.transData.transform(points)

        differences = (
            screen_points
            -
            np.asarray(
                [event.x, event.y],
                dtype=np.float64,
            )
        )

        distance2 = np.sum(
            differences * differences,
            axis=1,
        )

        index = int(np.argmin(distance2))
        distance = float(
            np.sqrt(distance2[index])
        )

        return (
            distance,
            index,
            points[index].copy(),
        )

    def nearest_index_on_selectable_line_from_event(
        source_name: str,
        event,
    ):
        points = selectable_points_for_source(source_name)
        screen_points = ax.transData.transform(points)

        differences = (
            screen_points
            -
            np.asarray(
                [event.x, event.y],
                dtype=np.float64,
            )
        )

        distance2 = np.sum(
            differences * differences,
            axis=1,
        )

        source_index = int(
            np.argmin(distance2)
        )
        distance = float(
            np.sqrt(distance2[source_index])
        )

        return (
            distance,
            source_index,
            points[source_index].copy(),
        )

    def nearest_editable_index_to_point(
        line_name: str,
        point: np.ndarray,
    ) -> int:
        points = editable_lines[line_name]
        distance2 = np.sum(
            (
                points
                -
                np.asarray(
                    point,
                    dtype=np.float64,
                )
            )
            ** 2,
            axis=1,
        )

        return int(
            np.argmin(distance2)
        )

    def nearest_selection_source(event):
        best = None

        # Optional priority for the current editable path as a curve-control
        # source. This is useful for PATH_BORN builders where the user wants
        # clicks near the currently modified path to select that path first.
        if (
            prefer_dynamic_selection
            and dynamic_selection_alias is not None
        ):
            distance, source_index, point = (
                nearest_index_on_selectable_line_from_event(
                    dynamic_selection_alias,
                    event,
                )
            )

            if distance <= path_pick_radius_pixels:
                return (
                    distance,
                    dynamic_selection_alias,
                    source_index,
                    point,
                )

        for source_name in selectable_lines.keys():
            distance, source_index, point = (
                nearest_index_on_selectable_line_from_event(
                    source_name,
                    event,
                )
            )

            if (
                best is None
                or distance < best[0]
            ):
                best = (
                    distance,
                    source_name,
                    source_index,
                    point,
                )

        return best

    def is_curve_end_control(
        line_name: str,
        control_index: int,
    ) -> bool:
        """
        Return True when the selected control point is the final control point
        in the path-order used to build the current spline segment.
        """
        items = controls.get(
            line_name,
            [],
        )

        if not items:
            return False

        if (
            control_index < 0
            or control_index >= len(items)
        ):
            return False

        ordered = curve_order_controls(
            items,
            len(editable_lines[line_name]),
            closed,
        )

        if not ordered:
            return False

        return (
            ordered[-1]
            is
            items[int(control_index)]
        )

    def undo_once():
        if not undo_stack:
            set_status("There is no curve edit to undo.")
            return

        current_snapshot = make_snapshot()
        previous_snapshot = undo_stack.pop()
        redo_stack.append(current_snapshot)
        restore_snapshot(previous_snapshot)

        interaction_state["drag_line"] = None
        interaction_state["drag_control_index"] = None
        interaction_state["drag_is_end_control"] = False

        refresh()
        set_status(
            "Undo complete. "
            + phase_instruction()
        )

    def redo_once():
        if not redo_stack:
            set_status("There is no curve edit to redo.")
            return

        current_snapshot = make_snapshot()
        next_snapshot = redo_stack.pop()
        undo_stack.append(current_snapshot)
        restore_snapshot(next_snapshot)

        interaction_state["drag_line"] = None
        interaction_state["drag_control_index"] = None
        interaction_state["drag_is_end_control"] = False

        refresh()
        set_status(
            "Redo complete. "
            + phase_instruction()
        )

    def on_press(event):
        if interaction_state["exit_requested"]:
            return

        if (
            event.inaxes is not ax
            or event.button != 1
            or event.xdata is None
            or event.ydata is None
        ):
            return

        toolbar = getattr(
            fig.canvas,
            "toolbar",
            None,
        )

        toolbar_mode = (
            getattr(toolbar, "mode", "")
            if toolbar is not None
            else ""
        )

        if toolbar_mode:
            return

        # Polygon-section main-line selection. In this phase the click is
        # interpreted only as a main-line choice for the currently highlighted
        # section; it does not drag existing controls.
        if interaction_state["phase"] == "section":
            pending = interaction_state.get(
                "pending_section_orders", []
            )

            if not pending:
                interaction_state["phase"] = "shape"
                refresh()
                return

            line_name = (
                selection_target_line
                if selection_target_line is not None
                else next(iter(editable_lines.keys()))
            )
            current_order = int(pending[0])
            selected = nearest_selection_in_section(
                event,
                current_order,
                line_name,
            )

            if selected is None or selected[0] > path_pick_radius_pixels:
                set_status(
                    f"Section {current_order}: click closer to IN_DENSE, "
                    "MIDDLE_RAW, OUT_DENSE, or current PATH_YEAH inside the highlighted section."
                )
                return

            (
                _distance,
                source_name,
                source_index,
                snapped_point,
                path_index,
            ) = selected

            undo_stack.append(make_snapshot())
            redo_stack.clear()

            controls[line_name].append(
                {
                    "index": int(path_index),
                    "position": snapped_point.copy(),
                    "snap_line": str(source_name),
                    "source_index": int(source_index),
                }
            )
            interaction_state["section_main_map"][current_order] = str(
                source_name
            )
            interaction_state["pending_section_orders"] = [
                int(value)
                for value in pending[1:]
            ]

            if interaction_state["pending_section_orders"]:
                next_order = int(
                    interaction_state["pending_section_orders"][0]
                )
                refresh()
                set_status(
                    f"Section {current_order} main = {source_name}. "
                    f"Now select the main line for section {next_order}."
                )
                print(
                    f"[CURVE] Section {current_order} main = {source_name}"
                )
                return

            interaction_state["phase"] = "shape"
            refresh()
            set_status(
                f"Section {current_order} main = {source_name}. "
                "All sections are assigned. FREE SHAPE mode is active; "
                "press Enter to apply the curve."
            )
            print(
                f"[CURVE] Section {current_order} main = {source_name}"
            )
            return

        # Existing control-point selection always has priority.
        existing = pixel_distance_to_control(event)

        if (
            existing is not None
            and existing[0] <= pick_radius_pixels
        ):
            undo_stack.append(make_snapshot())
            redo_stack.clear()

            interaction_state["drag_line"] = existing[1]
            interaction_state["drag_control_index"] = int(
                existing[2]
            )
            interaction_state["drag_is_end_control"] = bool(
                interaction_state["phase"] == "shape"
                and is_curve_end_control(
                    existing[1],
                    int(existing[2]),
                )
            )

            if interaction_state["phase"] == "select":
                set_status(
                    f"Dragging {existing[1]} control point along the same path."
                )
            elif interaction_state["drag_is_end_control"]:
                set_status(
                    f"Dragging final {existing[1]} control point along the same path."
                )
            else:
                set_status(
                    f"Dragging {existing[1]} control point freely."
                )
            return

        # In FREE SHAPE mode, clicks away from existing control points do not
        # add new control points.
        if interaction_state["phase"] == "shape":
            set_status(
                "FREE SHAPE mode: drag an existing control point, "
                "or press Enter to apply the curve."
            )
            return

        nearest = nearest_selection_source(event)

        if nearest is None:
            return

        (
            path_pixel_distance,
            source_name,
            _source_index,
            snapped_point,
        ) = nearest

        if path_pixel_distance > path_pick_radius_pixels:
            set_status(
                "Click closer to a selectable reference line. "
                "No control point was added."
            )
            return

        if selection_target_line is None:
            line_name = source_name
            path_index = int(_source_index)
        else:
            line_name = selection_target_line
            path_index = nearest_editable_index_to_point(
                line_name,
                snapped_point,
            )

        for item in controls[line_name]:
            if int(item["index"]) == int(path_index):
                set_status(
                    f"{line_name}[{path_index}] already has a control point. "
                    "Drag the existing point instead."
                )
                return

        undo_stack.append(make_snapshot())
        redo_stack.clear()

        controls[line_name].append(
            {
                "index": int(path_index),
                "position": snapped_point.copy(),
                "snap_line": str(source_name),
                "source_index": int(_source_index),
            }
        )

        refresh()

        control_count = len(controls[line_name])
        set_status(
            f"{line_name}: control point added from {source_name} "
            f"at target waypoint {path_index} ({control_count} selected). "
            "Add more points or press Enter for FREE SHAPE mode."
        )

    def on_motion(event):
        line_name = interaction_state["drag_line"]
        control_index = interaction_state["drag_control_index"]

        if (
            line_name is None
            or control_index is None
        ):
            return

        if (
            event.inaxes is not ax
            or event.xdata is None
            or event.ydata is None
        ):
            return

        if interaction_state["phase"] == "shape":
            if interaction_state["drag_is_end_control"]:
                # The final control point is constrained to the same editable
                # path. Its waypoint index may move along that path, while all
                # other FREE SHAPE control points remain free in x/y.
                snap_line_name = str(
                    controls[line_name][int(control_index)].get(
                        "snap_line",
                        line_name,
                    )
                )

                (
                    _,
                    _source_index,
                    snapped_point,
                ) = nearest_index_on_selectable_line_from_event(
                    snap_line_name,
                    event,
                )

                path_index = (
                    int(_source_index)
                    if selection_target_line is None
                    else nearest_editable_index_to_point(
                        line_name,
                        snapped_point,
                    )
                )

                for other_index, item in enumerate(controls[line_name]):
                    if (
                        other_index != int(control_index)
                        and int(item["index"]) == int(path_index)
                    ):
                        return

                controls[line_name][int(control_index)]["index"] = int(
                    path_index
                )
                controls[line_name][int(control_index)]["position"] = (
                    snapped_point.copy()
                )
                controls[line_name][int(control_index)]["source_index"] = int(
                    _source_index
                )
            else:
                # Interior control points move freely while their original
                # waypoint indices stay fixed.
                controls[line_name][int(control_index)]["position"] = np.asarray(
                    [event.xdata, event.ydata],
                    dtype=np.float64,
                )

            refresh()
            return

        snap_line_name = str(
            controls[line_name][int(control_index)].get(
                "snap_line",
                line_name,
            )
        )

        (
            path_pixel_distance,
            _source_index,
            snapped_point,
        ) = nearest_index_on_selectable_line_from_event(
            snap_line_name,
            event,
        )

        path_index = (
            int(_source_index)
            if selection_target_line is None
            else nearest_editable_index_to_point(
                line_name,
                snapped_point,
            )
        )

        # SELECT mode keeps the control point snapped to its original source
        # line. If the cursor moves too far away, keep the last valid snap.
        # cursor moves too far away, keep the last valid snapped position.
        if path_pixel_distance > path_pick_radius_pixels:
            return

        for other_index, item in enumerate(controls[line_name]):
            if (
                other_index != int(control_index)
                and int(item["index"]) == int(path_index)
            ):
                return

        controls[line_name][int(control_index)]["index"] = int(
            path_index
        )
        controls[line_name][int(control_index)]["position"] = (
            snapped_point.copy()
        )
        controls[line_name][int(control_index)]["source_index"] = int(
            _source_index
        )

        refresh()

    def on_release(_event):
        if interaction_state["drag_line"] is None:
            return

        line_name = interaction_state["drag_line"]
        control_index = interaction_state["drag_control_index"]

        was_end_control = bool(
            interaction_state["drag_is_end_control"]
        )

        interaction_state["drag_line"] = None
        interaction_state["drag_control_index"] = None
        interaction_state["drag_is_end_control"] = False

        if interaction_state["phase"] == "select":
            set_status(
                f"{line_name} control point {int(control_index) + 1} moved "
                "along the path. Press Enter when point selection is complete."
            )
        elif was_end_control:
            set_status(
                f"Final {line_name} control point moved along the path. "
                "Press Enter to apply this curve."
            )
        else:
            set_status(
                f"{line_name} control point {int(control_index) + 1} moved freely. "
                "Press Enter to apply this curve."
            )

    def validate_active_controls():
        incomplete = [
            name
            for name, items in controls.items()
            if 0 < len(items) < 3
        ]

        if incomplete:
            set_status(
                "At least 3 control points are required for each active curve: "
                + ", ".join(incomplete)
            )
            return None

        active_names = [
            name
            for name, items in controls.items()
            if len(items) >= 3
        ]

        if not active_names:
            set_status(
                "No active curve. Add at least 3 control points, "
                "or press Enter to continue to the next stage."
            )
            return None

        return active_names

    def reset_incomplete_selection():
        pending_count = sum(
            len(items)
            for items in controls.values()
        )

        if pending_count <= 0:
            return

        undo_stack.append(make_snapshot())
        redo_stack.clear()

        clear_controls()
        interaction_state["phase"] = "select"
        refresh()

        set_status(
            f"Only {pending_count} control point(s) were selected. "
            "Pending curve selection was discarded. "
            "SELECT mode restarted from 0 points."
        )

        print(
            f"[CURVE] Incomplete selection reset: {pending_count} point(s) -> 0"
        )

    def enter_free_shape_mode():
        active_names = validate_active_controls()

        if active_names is None:
            return False

        undo_stack.append(make_snapshot())
        redo_stack.clear()

        interaction_state["phase"] = "shape"
        interaction_state["drag_line"] = None
        interaction_state["drag_control_index"] = None

        refresh()

        summary = ", ".join(
            f"{name}({len(controls[name])} pts)"
            for name in active_names
        )

        set_status(
            "FREE SHAPE mode: "
            + summary
            + ". Interior points move freely; each final point stays on its path. "
            "Press Enter to apply."
        )

        print(
            "[CURVE] Free-shape mode: "
            + summary
        )

        return True

    def apply_current_curves():
        active_names = validate_active_controls()

        if active_names is None:
            return False

        before_apply = make_snapshot()

        try:
            for name in active_names:
                items = controls[name]

                ordered = curve_order_controls(
                    items,
                    len(editable_lines[name]),
                    closed,
                )

                segment_indices, replacement_geometry = build_curve_geometry(
                    name,
                    ordered,
                    len(editable_lines[name]),
                )

                # Keep the editable PATH waypoint count unchanged. The full
                # geometry is re-sampled only to the number of indices being
                # replaced, so downstream section/index assumptions remain
                # intact while the endpoint MAIN connectors are preserved.
                replacement = dense_resample_by_count(
                    replacement_geometry,
                    len(segment_indices),
                )

                editable_lines[name][segment_indices] = replacement

            # Once a qualifying curve has been applied, every polygon section
            # participating in that curve keeps its MAIN assignment permanently
            # for the rest of this editor session. Later curves may edit geometry
            # there, but cannot switch the section MAIN to another line.
            if section_main_context is not None:
                locked_map = interaction_state.setdefault(
                    "locked_section_main_map", {}
                )
                for section_order in interaction_state.get(
                    "section_sequence", []
                ):
                    section_order = int(section_order)
                    main_name = interaction_state.get(
                        "section_main_map", {}
                    ).get(section_order)
                    if (
                        section_order not in locked_map
                        and main_name is not None
                    ):
                        locked_map[section_order] = str(main_name)

            interaction_state["editable_revision"] = int(
                interaction_state.get("editable_revision", 0)
            ) + 1

            undo_stack.append(before_apply)
            redo_stack.clear()
            interaction_state["applied_any"] = True

            applied_summary = ", ".join(
                f"{name}({len(controls[name])} pts)"
                for name in active_names
            )

            clear_controls()
            interaction_state["phase"] = "select"
            refresh()

            set_status(
                "Curve applied: "
                + applied_summary
                + ". SELECT mode is active again. Add another curve, "
                "or press Enter with no control points for the next stage."
            )

            print(
                "[CURVE] Applied: "
                + applied_summary
            )

            return True

        except Exception as exc:
            restore_snapshot(before_apply)
            refresh()
            set_status(
                f"Curve application failed: {exc}"
            )
            return False

    def on_key(event):
        key = (
            event.key
            or ""
        ).lower()

        if key in (
            "ctrl+z",
            "control+z",
        ):
            undo_once()
            return

        if key in (
            "ctrl+y",
            "control+y",
        ):
            redo_once()
            return

        if key in (
            "enter",
            "return",
        ):
            if interaction_state["phase"] == "select":
                active_counts = [
                    len(items)
                    for items in controls.values()
                    if len(items) > 0
                ]

                if not active_counts:
                    # 0 points: finish this Curve Editor and continue to the
                    # next pipeline stage.
                    interaction_state["exit_requested"] = True
                    plt.close(fig)
                    return

                if any(count < 3 for count in active_counts):
                    # 1~2 pending points: discard only the unfinished current
                    # selection. Already-applied curve edits remain intact.
                    reset_incomplete_selection()
                    return

                # 3+ points: qualifying PATH_YEAH first resolves the main
                # line for every polygon section between the curve endpoints.
                # Other editors continue directly to FREE SHAPE mode.
                if section_main_context is not None:
                    prepare_polygon_section_mains()
                else:
                    enter_free_shape_mode()
                return

            # FREE SHAPE mode: Enter applies the current curve, clears the
            # controls, and returns to SELECT mode for another curve.
            apply_current_curves()
            return

    def on_close(_event):
        if not interaction_state["exit_requested"]:
            clear_controls()
            interaction_state["phase"] = "select"
            interaction_state["exit_requested"] = True

    fig.canvas.mpl_connect(
        "button_press_event",
        on_press,
    )
    fig.canvas.mpl_connect(
        "motion_notify_event",
        on_motion,
    )
    fig.canvas.mpl_connect(
        "button_release_event",
        on_release,
    )
    fig.canvas.mpl_connect(
        "key_press_event",
        on_key,
    )
    fig.canvas.mpl_connect(
        "close_event",
        on_close,
    )

    print()
    print("============================================")
    print("Interactive Curve Editor")
    print("============================================")
    print("Stage 1 - SELECT")
    print("  Left click   : add a control point snapped to the nearest path waypoint")
    print("  Point drag   : move a control point along the same path")
    print("  Enter (0 pts)  : finish curve editing and continue")
    print("  Enter (1-2 pts): discard pending points and restart SELECT from 0")
    print("  Enter (3+ pts) : switch to FREE SHAPE mode")
    if section_main_context is not None:
        print("Stage 1.5 - POLYGON SECTION MAIN")
        print("  Start section : existing PATH -> start-point source line -> start point")
        print("  End section   : end point -> end-point source line -> existing PATH")
        print("  Missing section: click IN_DENSE / MIDDLE_RAW / OUT_DENSE / current PATH_YEAH")
    print("Stage 2 - FREE SHAPE")
    print("  Interior drag: move interior control points freely")
    print("  Final drag   : final control point stays on the same path")
    print("  Enter        : apply the curve and return to SELECT mode")
    print(
        f"Control radius: {pick_radius_pixels:.0f} px "
        "(clicking near an existing point will not create a new point)"
    )
    print(
        f"Path radius   : {path_pick_radius_pixels:.0f} px "
        "(SELECT-mode clicks farther from the path are ignored)"
    )
    print("Ctrl+Z         : Undo")
    print("Ctrl+Y         : Redo")
    print("Enter          : context action described above")
    print("============================================")

    refresh()
    set_status(phase_instruction())
    plt.show()

    output = {}

    for name, points in editable_lines.items():
        output[name] = (
            dense_close_path(points)
            if closed
            else points.copy()
        )

    return (
        output,
        bool(interaction_state["applied_any"]),
    )

def dense_interactive_editor(
    display_lines: Dict[
        str,
        np.ndarray,
    ],
    in_dense: np.ndarray,
    out_dense: np.ndarray,
    in_label: str,
    out_label: str,
    closed: bool,
    no_show: bool,
) -> Tuple[
    np.ndarray,
    np.ndarray,
    bool,
]:
    """
    Dense manual editor.

    Left click twice:
        같은 IN 또는 OUT 선의 두 waypoint 선택.
        그 사이 구간을 직선으로 교체.

    Ctrl+Z:
        직전 수정 Undo.

    Ctrl+Y:
        Undo한 수정 Redo.

    Enter:
        최종 확정.

    Esc / window close:
        이번 통합 build 저장을 취소.
    """
    if no_show:
        print(
            "[INFO] --no-show: Dense manual editor skipped."
        )

        return (
            in_dense,
            out_dense,
            True,
        )

    state = {
        "IN": (
            dense_open_path(
                in_dense
            )
            if closed
            else np.asarray(
                in_dense,
                dtype=np.float64,
            ).copy()
        ),
        "OUT": (
            dense_open_path(
                out_dense
            )
            if closed
            else np.asarray(
                out_dense,
                dtype=np.float64,
            ).copy()
        ),
    }

    undo_stack = []
    redo_stack = []

    pending = {
        "line": None,
        "index": None,
    }

    result_state = {
        "finalized": False,
        "cancelled": False,
    }

    fig, ax = plt.subplots(
        figsize=(14, 10)
    )

    for (
        display_name,
        display_points,
    ) in display_lines.items():
        display_points = np.asarray(
            display_points,
            dtype=np.float64,
        )

        ax.plot(
            display_points[:, 0],
            display_points[:, 1],
            linewidth=0.8,
            label=display_name,
        )

    def drawable(
        line_name: str,
    ) -> np.ndarray:
        if closed:
            return dense_close_path(
                state[
                    line_name
                ]
            )

        return state[
            line_name
        ]

    in_draw = drawable(
        "IN"
    )

    out_draw = drawable(
        "OUT"
    )

    in_artist, = ax.plot(
        in_draw[:, 0],
        in_draw[:, 1],
        linewidth=1.8,
        label=in_label,
    )

    out_artist, = ax.plot(
        out_draw[:, 0],
        out_draw[:, 1],
        linewidth=1.8,
        label=out_label,
    )

    selected_artist, = ax.plot(
        [],
        [],
        marker="o",
        linestyle="None",
        markersize=8,
        label="Selected point",
    )

    status_text = ax.text(
        0.01,
        0.01,
        (
            "Left click twice: select two points on the same IN/OUT line | "
            "Enter: straight 확정 후 Curve 단계 | Esc: cancel all | "
            "Ctrl+Z: Undo | Ctrl+Y: Redo"
        ),
        transform=ax.transAxes,
        fontsize=9,
        verticalalignment="bottom",
    )

    ax.set_aspect(
        "equal",
        adjustable="box",
    )

    ax.grid(
        True
    )

    ax.legend(
        loc="best"
    )

    ax.set_xlabel(
        "x [m]"
    )

    ax.set_ylabel(
        "y [m]"
    )

    ax.set_title(
        "IN / OUT Manual Editor\n"
        "Select two points to replace the segment with a straight line"
    )

    fig.tight_layout()

    def set_status(
        message: str,
    ):
        status_text.set_text(
            message
        )
        fig.canvas.draw_idle()

    def refresh():
        in_points = drawable(
            "IN"
        )

        out_points = drawable(
            "OUT"
        )

        in_artist.set_data(
            in_points[:, 0],
            in_points[:, 1],
        )

        out_artist.set_data(
            out_points[:, 0],
            out_points[:, 1],
        )

        fig.canvas.draw_idle()

    def clear_pending():
        pending[
            "line"
        ] = None

        pending[
            "index"
        ] = None

        selected_artist.set_data(
            [],
            [],
        )

        fig.canvas.draw_idle()

    def nearest_point(
        x: float,
        y: float,
    ):
        query = np.asarray(
            [x, y],
            dtype=np.float64,
        )

        in_d2 = np.sum(
            (
                state["IN"]
                -
                query
            )
            ** 2,
            axis=1,
        )

        out_d2 = np.sum(
            (
                state["OUT"]
                -
                query
            )
            ** 2,
            axis=1,
        )

        in_index = int(
            np.argmin(
                in_d2
            )
        )

        out_index = int(
            np.argmin(
                out_d2
            )
        )

        if (
            in_d2[in_index]
            <=
            out_d2[out_index]
        ):
            return (
                "IN",
                in_index,
                state["IN"][
                    in_index
                ].copy(),
            )

        return (
            "OUT",
            out_index,
            state["OUT"][
                out_index
            ].copy(),
        )

    def apply_edit(
        line_name: str,
        index1: int,
        index2: int,
    ):
        target = state[
            line_name
        ]

        if index1 == index2:
            set_status(
                "The same waypoint was selected twice. Select again."
            )
            return

        indices = dense_segment_indices(
            index1,
            index2,
            len(target),
            closed,
        )

        if len(indices) < 2:
            set_status(
                "The selected segment is too short."
            )
            return

        before = target[
            indices
        ].copy()

        start_point = target[
            indices[0]
        ].copy()

        end_point = target[
            indices[-1]
        ].copy()

        after = np.linspace(
            start_point,
            end_point,
            len(indices),
        )

        target[
            indices
        ] = after

        undo_stack.append(
            {
                "line": line_name,
                "indices": indices.copy(),
                "before": before,
                "after": after.copy(),
            }
        )

        redo_stack.clear()

        refresh()

        print(
            f"[EDIT] {line_name}: "
            f"{len(indices)} waypoints straightened."
        )

        set_status(
            f"{line_name} edit complete. "
            f"Continue selecting points or press Enter to finalize."
        )

    def undo_once():
        if not undo_stack:
            set_status(
                "There is no edit to undo."
            )
            return

        operation = undo_stack.pop()

        state[
            operation["line"]
        ][
            operation["indices"]
        ] = operation[
            "before"
        ]

        redo_stack.append(
            operation
        )

        clear_pending()
        refresh()

        set_status(
            "The previous edit was undone. Press Ctrl+Y to redo it."
        )

    def redo_once():
        if not redo_stack:
            set_status(
                "There is no edit to redo."
            )
            return

        operation = redo_stack.pop()

        state[
            operation["line"]
        ][
            operation["indices"]
        ] = operation[
            "after"
        ]

        undo_stack.append(
            operation
        )

        clear_pending()
        refresh()

        set_status(
            "The undone edit was reapplied."
        )

    def on_click(
        event,
    ):
        if (
            result_state["finalized"]
            or
            result_state["cancelled"]
        ):
            return

        if (
            event.inaxes is not ax
            or
            event.button != 1
            or
            event.xdata is None
            or
            event.ydata is None
        ):
            return

        toolbar = getattr(
            fig.canvas,
            "toolbar",
            None,
        )

        toolbar_mode = (
            getattr(
                toolbar,
                "mode",
                "",
            )
            if toolbar is not None
            else ""
        )

        if toolbar_mode:
            return

        (
            line_name,
            index,
            point,
        ) = nearest_point(
            float(
                event.xdata
            ),
            float(
                event.ydata
            ),
        )

        if pending[
            "line"
        ] is None:
            pending[
                "line"
            ] = line_name

            pending[
                "index"
            ] = index

            selected_artist.set_data(
                [point[0]],
                [point[1]],
            )

            set_status(
                f"First point selected: {line_name}[{index}]. "
                f"Select the second point on the same {line_name} line."
            )

            return

        if (
            pending["line"]
            !=
            line_name
        ):
            set_status(
                f"The first point is on {pending['line']}. "
                f"Select the second point on the same {pending['line']} line."
            )
            return

        first_index = int(
            pending[
                "index"
            ]
        )

        clear_pending()

        apply_edit(
            line_name,
            first_index,
            index,
        )

    def on_key(
        event,
    ):
        key = (
            event.key
            or
            ""
        ).lower()

        if key in (
            "ctrl+z",
            "control+z",
        ):
            undo_once()
            return

        if key in (
            "ctrl+y",
            "control+y",
        ):
            redo_once()
            return

        if key in (
            "enter",
            "return",
        ):
            result_state[
                "finalized"
            ] = True

            clear_pending()

            print(
                "\n[FINALIZE] Dense editing confirmed."
            )

            plt.close(
                fig
            )
            return

        if key in (
            "escape",
            "esc",
        ):
            result_state[
                "cancelled"
            ] = True

            print(
                "\n[CANCEL] Dense editing cancelled."
            )

            plt.close(
                fig
            )

    def on_close(
        _event,
    ):
        if not result_state[
            "finalized"
        ]:
            result_state[
                "cancelled"
            ] = True

    fig.canvas.mpl_connect(
        "button_press_event",
        on_click,
    )

    fig.canvas.mpl_connect(
        "key_press_event",
        on_key,
    )

    fig.canvas.mpl_connect(
        "close_event",
        on_close,
    )

    print(
        "\n============================================"
    )
    print(
        "Dense Manual Editor"
    )
    print(
        "============================================"
    )
    print(
        "Left click x2 : straighten one IN/OUT segment"
    )
    print(
        "Ctrl+Z        : undo"
    )
    print(
        "Ctrl+Y        : redo"
    )
    print(
        "Enter         : 직선 수정 확정 후 Curve 단계"
    )
    print(
        "Esc           : cancel entire build without new output save"
    )
    print(
        "============================================"
    )

    plt.show()

    if (
        result_state["cancelled"]
        or
        not result_state["finalized"]
    ):
        return (
            in_dense,
            out_dense,
            False,
        )

    final_in = (
        dense_close_path(
            state["IN"]
        )
        if closed
        else state["IN"].copy()
    )

    final_out = (
        dense_close_path(
            state["OUT"]
        )
        if closed
        else state["OUT"].copy()
    )

    return (
        final_in,
        final_out,
        True,
    )


def dense_point_to_polyline_distances_numpy(
    query_points: np.ndarray,
    polyline: np.ndarray,
    chunk_size: int = 64,
) -> np.ndarray:
    query_points = np.asarray(
        query_points,
        dtype=np.float64,
    )

    polyline = dense_remove_duplicates(
        np.asarray(
            polyline,
            dtype=np.float64,
        )
    )

    segment_a = polyline[
        :-1
    ]

    segment_b = polyline[
        1:
    ]

    segment_ab = (
        segment_b
        -
        segment_a
    )

    segment_length2 = np.sum(
        segment_ab
        *
        segment_ab,
        axis=1,
    )

    valid = (
        segment_length2
        >
        EPS
    )

    segment_a = segment_a[
        valid
    ]

    segment_ab = segment_ab[
        valid
    ]

    segment_length2 = segment_length2[
        valid
    ]

    if len(segment_a) == 0:
        raise ValueError(
            "Boundary polyline has no valid segment."
        )

    result = np.empty(
        len(query_points),
        dtype=np.float64,
    )

    for start in range(
        0,
        len(query_points),
        chunk_size,
    ):
        end = min(
            start
            +
            chunk_size,
            len(query_points),
        )

        query = query_points[
            start:end
        ][
            :,
            None,
            :
        ]

        ap = (
            query
            -
            segment_a[
                None,
                :,
                :
            ]
        )

        ratio = np.sum(
            ap
            *
            segment_ab[
                None,
                :,
                :
            ],
            axis=2,
        ) / segment_length2[
            None,
            :
        ]

        ratio = np.clip(
            ratio,
            0.0,
            1.0,
        )

        closest = (
            segment_a[
                None,
                :,
                :
            ]
            +
            ratio[
                :,
                :,
                None,
            ]
            *
            segment_ab[
                None,
                :,
                :
            ]
        )

        distance2 = np.sum(
            (
                query
                -
                closest
            )
            ** 2,
            axis=2,
        )

        result[
            start:end
        ] = np.sqrt(
            np.min(
                distance2,
                axis=1,
            )
        )

    return result


def dense_point_to_polyline_distances(
    query_points: np.ndarray,
    polyline: np.ndarray,
) -> np.ndarray:
    """
    Shapely 2.x가 있으면 사용하고,
    없으면 NumPy exact point-to-segment 계산으로 fallback.
    """
    query_points = np.asarray(
        query_points,
        dtype=np.float64,
    )

    polyline = np.asarray(
        polyline,
        dtype=np.float64,
    )

    try:
        import shapely
        from shapely.geometry import LineString

        line_geometry = LineString(
            polyline
        )

        point_geometries = shapely.points(
            query_points[:, 0],
            query_points[:, 1],
        )

        distances = np.asarray(
            shapely.distance(
                point_geometries,
                line_geometry,
            ),
            dtype=np.float64,
        )

        if (
            len(distances)
            ==
            len(query_points)
            and
            np.all(
                np.isfinite(
                    distances
                )
            )
        ):
            return distances

    except (
        ImportError,
        AttributeError,
    ):
        pass

    return dense_point_to_polyline_distances_numpy(
        query_points,
        polyline,
    )


def dense_load_raw_boundaries(
    data_dir: str,
    line_count: int,
    closed: bool,
) -> Dict[
    str,
    np.ndarray
]:
    if line_count == 3:
        names = [
            "left",
            "middle",
            "right",
        ]

    elif line_count == 4:
        names = [
            "left",
            "middle1",
            "middle2",
            "right",
        ]

    else:
        raise ValueError(
            f"Unsupported line_count: {line_count}"
        )

    result = {}

    for name in names:
        path = os.path.join(
            data_dir,
            f"{name}_raw.csv",
        )

        points, _ = load_line_csv(
            path
        )

        result[
            name
        ] = prepare_polyline(
            points,
            closed,
        )

    return result


def dense_calculate_roi_info(
    in_dense: np.ndarray,
    out_dense: np.ndarray,
    raw_lines: Dict[
        str,
        np.ndarray
    ],
    line_count: int,
    closed: bool,
) -> Tuple[
    Dict[str, np.ndarray],
    Dict[str, np.ndarray],
]:
    in_points = (
        dense_open_path(
            in_dense
        )
        if closed
        else np.asarray(
            in_dense,
            dtype=np.float64,
        )
    )

    out_points = (
        dense_open_path(
            out_dense
        )
        if closed
        else np.asarray(
            out_dense,
            dtype=np.float64,
        )
    )

    print(
        "\n============================================"
    )
    print(
        "Dense ROI Radius Calculation"
    )
    print(
        "============================================"
    )

    if line_count == 3:
        in_distance_a = (
            dense_point_to_polyline_distances(
                in_points,
                raw_lines[
                    "left"
                ],
            )
        )

        in_distance_b = (
            dense_point_to_polyline_distances(
                in_points,
                raw_lines[
                    "middle"
                ],
            )
        )

        out_distance_a = (
            dense_point_to_polyline_distances(
                out_points,
                raw_lines[
                    "middle"
                ],
            )
        )

        out_distance_b = (
            dense_point_to_polyline_distances(
                out_points,
                raw_lines[
                    "right"
                ],
            )
        )

        in_info = {
            "distance_to_left": in_distance_a,
            "distance_to_middle": in_distance_b,
        }

        out_info = {
            "distance_to_middle": out_distance_a,
            "distance_to_right": out_distance_b,
        }

    elif line_count == 4:
        in_distance_a = (
            dense_point_to_polyline_distances(
                in_points,
                raw_lines[
                    "left"
                ],
            )
        )

        in_distance_b = (
            dense_point_to_polyline_distances(
                in_points,
                raw_lines[
                    "middle1"
                ],
            )
        )

        out_distance_a = (
            dense_point_to_polyline_distances(
                out_points,
                raw_lines[
                    "middle2"
                ],
            )
        )

        out_distance_b = (
            dense_point_to_polyline_distances(
                out_points,
                raw_lines[
                    "right"
                ],
            )
        )

        in_info = {
            "distance_to_left": in_distance_a,
            "distance_to_middle1": in_distance_b,
        }

        out_info = {
            "distance_to_middle2": out_distance_a,
            "distance_to_right": out_distance_b,
        }

    else:
        raise ValueError(
            f"Unsupported line_count: {line_count}"
        )

    in_radius = np.minimum(
        in_distance_a,
        in_distance_b,
    )

    out_radius = np.minimum(
        out_distance_a,
        out_distance_b,
    )

    in_info[
        "roi_radius"
    ] = in_radius

    out_info[
        "roi_radius"
    ] = out_radius

    in_info[
        "points"
    ] = in_points.copy()

    out_info[
        "points"
    ] = out_points.copy()

    if closed:
        for key in list(
            in_info.keys()
        ):
            if key == "points":
                in_info[key] = dense_close_path(
                    in_info[key]
                )
            else:
                in_info[key] = np.append(
                    in_info[key],
                    in_info[key][0],
                )

        for key in list(
            out_info.keys()
        ):
            if key == "points":
                out_info[key] = dense_close_path(
                    out_info[key]
                )
            else:
                out_info[key] = np.append(
                    out_info[key],
                    out_info[key][0],
                )

    print(
        f"[OK] IN ROI radius  : "
        f"min={np.min(in_radius):.6f} m, "
        f"max={np.max(in_radius):.6f} m"
    )

    print(
        f"[OK] OUT ROI radius : "
        f"min={np.min(out_radius):.6f} m, "
        f"max={np.max(out_radius):.6f} m"
    )

    return (
        in_info,
        out_info,
    )


def save_dense_roi_csv(
    info: Dict[
        str,
        np.ndarray
    ],
    path: str,
):
    os.makedirs(
        os.path.dirname(
            os.path.abspath(
                path
            )
        ),
        exist_ok=True,
    )

    points = np.asarray(
        info[
            "points"
        ],
        dtype=np.float64,
    )

    extra_columns = [
        key
        for key
        in info.keys()
        if key != "points"
    ]

    # roi_radius를 x,y 다음에 우선 배치
    if "roi_radius" in extra_columns:
        extra_columns.remove(
            "roi_radius"
        )

        extra_columns.insert(
            0,
            "roi_radius",
        )

    with open(
        path,
        "w",
        newline="",
        encoding="utf-8",
    ) as fp:
        writer = csv.writer(
            fp
        )

        writer.writerow(
            [
                "x",
                "y",
            ]
            +
            extra_columns
        )

        for index, point in enumerate(
            points
        ):
            row = [
                f"{float(point[0]):.12f}",
                f"{float(point[1]):.12f}",
            ]

            for column in extra_columns:
                row.append(
                    f"{float(info[column][index]):.12f}"
                )

            writer.writerow(
                row
            )


def save_path_xy_csv(
    info: Dict[
        str,
        np.ndarray
    ],
    path: str,
):
    """
    Dense 최종 waypoint와 동일한 x, y를 path CSV로 저장한다.

    별도의 재샘플링이나 경로 재생성은 수행하지 않는다.
    따라서 같은 저장 시점의:
      path_in.csv  x,y == in_dense.csv  x,y
      path_out.csv x,y == out_dense.csv x,y
    이다.
    """
    os.makedirs(
        os.path.dirname(
            os.path.abspath(
                path
            )
        ),
        exist_ok=True,
    )

    points = np.asarray(
        info[
            "points"
        ],
        dtype=np.float64,
    )

    with open(
        path,
        "w",
        newline="",
        encoding="utf-8",
    ) as fp:
        writer = csv.writer(
            fp
        )

        writer.writerow(
            [
                "x",
                "y",
            ]
        )

        for point in points:
            writer.writerow(
                [
                    f"{float(point[0]):.12f}",
                    f"{float(point[1]):.12f}",
                ]
            )



# ============================================================
# 14-2. Driving Path -> Dense ROI Mapping
# ============================================================

def load_driving_path_xy(
    path: str,
) -> np.ndarray:
    """
    Driving Path 파일에서 각 행의 첫 번째/두 번째 숫자를 x, y로 읽는다.

    지원 예:
        x,y
        x y z radius
        x,y,...

    빈 줄, # 주석, 숫자가 아닌 header는 건너뛴다.
    파일의 행 순서를 유지하므로 반환 index가 path_index가 된다.
    """
    if not os.path.exists(path):
        raise FileNotFoundError(
            f"Path 파일을 찾을 수 없습니다: {path}"
        )

    points = []

    with open(
        path,
        "r",
        encoding="utf-8-sig",
    ) as fp:
        for raw_line in fp:
            line = raw_line.strip()

            if (
                not line
                or line.startswith("#")
            ):
                continue

            tokens = line.replace(",", " ").split()

            if len(tokens) < 2:
                continue

            try:
                x = float(tokens[0])
                y = float(tokens[1])
            except ValueError:
                # CSV header 등 숫자로 시작하지 않는 행은 무시한다.
                continue

            if not (
                np.isfinite(x)
                and np.isfinite(y)
            ):
                raise ValueError(
                    f"{path}: 유효하지 않은 Path 좌표가 있습니다: {line}"
                )

            points.append(
                [x, y]
            )

    if len(points) < 2:
        raise ValueError(
            f"{path}: 유효한 Path waypoint가 2개 미만입니다."
        )

    return np.asarray(
        points,
        dtype=np.float64,
    )


def build_path_to_roi_mapping(
    path_points: np.ndarray,
    roi_points: np.ndarray,
    closed: bool,
    chunk_size: int = 256,
) -> Dict[str, np.ndarray]:
    """
    각 Path waypoint에 가장 가까운 Dense ROI waypoint를 대응시킨다.

    mapping 방향:
        path_index -> roi_index

    현재 path와 dense가 1:1 좌표여도 별도 1:1 가정을 사용하지 않고
    실제 Euclidean nearest-neighbor 검색을 수행한다.

    폐곡선 Dense의 마지막 행이 첫 점의 중복점이면 후보에서 제외한다.
    따라서 roi_index는 Dense CSV의 첫 바퀴 실제 waypoint index를 가리킨다.

    주의:
        트랙 자기교차 또는 서로 다른 구간이 매우 가까운 경우 단순 최근접
        좌표만으로 구간을 구분하기 어려울 수 있다. 검증을 위해 distance_m도 저장한다.
    """
    path_points = np.asarray(
        path_points,
        dtype=np.float64,
    )

    roi_points = np.asarray(
        roi_points,
        dtype=np.float64,
    )

    if len(path_points) < 1:
        raise ValueError(
            "Path waypoint가 없습니다."
        )

    if len(roi_points) < 1:
        raise ValueError(
            "ROI waypoint가 없습니다."
        )

    roi_core = (
        dense_open_path(roi_points)
        if closed
        else roi_points.copy()
    )

    if len(roi_core) < 1:
        raise ValueError(
            "Mapping 후보 ROI waypoint가 없습니다."
        )

    chunk_size = max(
        1,
        int(chunk_size),
    )

    mapped_indices = np.empty(
        len(path_points),
        dtype=np.int64,
    )

    mapped_distances = np.empty(
        len(path_points),
        dtype=np.float64,
    )

    for start in range(
        0,
        len(path_points),
        chunk_size,
    ):
        end = min(
            start + chunk_size,
            len(path_points),
        )

        query = path_points[start:end]

        diff = (
            query[:, None, :]
            - roi_core[None, :, :]
        )

        distance2 = np.sum(
            diff * diff,
            axis=2,
        )

        local_indices = np.argmin(
            distance2,
            axis=1,
        )

        mapped_indices[start:end] = (
            local_indices
        )

        mapped_distances[start:end] = np.sqrt(
            distance2[
                np.arange(end - start),
                local_indices,
            ]
        )

    mapped_points = roi_core[
        mapped_indices
    ]

    return {
        "path_index": np.arange(
            len(path_points),
            dtype=np.int64,
        ),
        "path_points": path_points.copy(),
        "roi_index": mapped_indices,
        "roi_points": mapped_points.copy(),
        "distance_m": mapped_distances,
    }


def save_path_roi_mapping_csv(
    mapping: Dict[str, np.ndarray],
    path: str,
) -> None:
    """
    C++ ROI node에서 읽을 Path -> ROI mapping CSV 저장.

    형식:
        path_index,path_x,path_y,roi_index,roi_x,roi_y,distance_m

    C++에서는 path_index와 roi_index를 사용하고,
    나머지 열은 mapping 검증용으로 함께 저장한다.
    """
    os.makedirs(
        os.path.dirname(
            os.path.abspath(path)
        ),
        exist_ok=True,
    )

    path_indices = np.asarray(
        mapping["path_index"],
        dtype=np.int64,
    )
    path_points = np.asarray(
        mapping["path_points"],
        dtype=np.float64,
    )
    roi_indices = np.asarray(
        mapping["roi_index"],
        dtype=np.int64,
    )
    roi_points = np.asarray(
        mapping["roi_points"],
        dtype=np.float64,
    )
    distances = np.asarray(
        mapping["distance_m"],
        dtype=np.float64,
    )

    count = len(path_indices)

    if not (
        len(path_points) == count
        and len(roi_indices) == count
        and len(roi_points) == count
        and len(distances) == count
    ):
        raise ValueError(
            "Mapping 데이터 길이가 서로 다릅니다."
        )

    with open(
        path,
        "w",
        newline="",
        encoding="utf-8",
    ) as fp:
        writer = csv.writer(fp)

        writer.writerow(
            [
                "path_index",
                "path_x",
                "path_y",
                "roi_index",
                "roi_x",
                "roi_y",
                "distance_m",
            ]
        )

        for i in range(count):
            writer.writerow(
                [
                    int(path_indices[i]),
                    f"{float(path_points[i, 0]):.12f}",
                    f"{float(path_points[i, 1]):.12f}",
                    int(roi_indices[i]),
                    f"{float(roi_points[i, 0]):.12f}",
                    f"{float(roi_points[i, 1]):.12f}",
                    f"{float(distances[i]):.12f}",
                ]
            )


def detect_mapping_closed(
    in_dense: np.ndarray,
    out_dense: np.ndarray,
    track_roi_path: Optional[str] = None,
) -> bool:
    """
    Mapping에서 폐곡선 여부를 결정한다.

    우선순위:
      1) track_roi.json metadata.closed_track
      2) IN/OUT Dense의 first == last 여부
    """
    if (
        track_roi_path
        and os.path.exists(track_roi_path)
    ):
        try:
            with open(
                track_roi_path,
                "r",
                encoding="utf-8",
            ) as fp:
                data = json.load(fp)

            closed_value = data.get(
                "metadata",
                {},
            ).get(
                "closed_track",
                None,
            )

            if isinstance(
                closed_value,
                bool,
            ):
                return closed_value
        except Exception:
            pass

    in_closed = (
        len(in_dense) >= 2
        and np.linalg.norm(
            in_dense[0] - in_dense[-1]
        ) <= 1.0e-8
    )

    out_closed = (
        len(out_dense) >= 2
        and np.linalg.norm(
            out_dense[0] - out_dense[-1]
        ) <= 1.0e-8
    )

    return bool(
        in_closed
        and out_closed
    )


def generate_and_save_path_roi_mappings(
    path_in_file: str,
    path_out_file: str,
    in_dense_file: str,
    out_dense_file: str,
    in_mapping_output: str,
    out_mapping_output: str,
    track_roi_path: Optional[str] = None,
) -> Dict[str, float]:
    """
    기존 Path / Dense 파일을 읽어 IN/OUT Path -> ROI mapping을 생성한다.
    """
    path_in_points = load_driving_path_xy(
        path_in_file
    )
    path_out_points = load_driving_path_xy(
        path_out_file
    )

    in_dense_points = load_existing_dense_xy(
        in_dense_file
    )
    out_dense_points = load_existing_dense_xy(
        out_dense_file
    )

    closed = detect_mapping_closed(
        in_dense=in_dense_points,
        out_dense=out_dense_points,
        track_roi_path=track_roi_path,
    )

    in_mapping = build_path_to_roi_mapping(
        path_points=path_in_points,
        roi_points=in_dense_points,
        closed=closed,
    )

    out_mapping = build_path_to_roi_mapping(
        path_points=path_out_points,
        roi_points=out_dense_points,
        closed=closed,
    )

    save_path_roi_mapping_csv(
        in_mapping,
        in_mapping_output,
    )

    save_path_roi_mapping_csv(
        out_mapping,
        out_mapping_output,
    )

    return {
        "closed": bool(closed),
        "in_path_count": int(
            len(in_mapping["path_index"])
        ),
        "in_roi_count": int(
            len(
                dense_open_path(in_dense_points)
                if closed
                else in_dense_points
            )
        ),
        "out_path_count": int(
            len(out_mapping["path_index"])
        ),
        "out_roi_count": int(
            len(
                dense_open_path(out_dense_points)
                if closed
                else out_dense_points
            )
        ),
        "in_mean_distance": float(
            np.mean(in_mapping["distance_m"])
        ),
        "in_max_distance": float(
            np.max(in_mapping["distance_m"])
        ),
        "out_mean_distance": float(
            np.mean(out_mapping["distance_m"])
        ),
        "out_max_distance": float(
            np.max(out_mapping["distance_m"])
        ),
    }


def load_path_roi_mapping_csv(
    path: str,
) -> Dict[str, np.ndarray]:
    """
    저장된 Path -> ROI mapping CSV를 다시 읽는다.

    시각화는 실제 저장된 mapping 파일을 기준으로 수행한다.
    """
    if not os.path.exists(path):
        raise FileNotFoundError(
            f"Mapping CSV를 찾을 수 없습니다: {path}"
        )

    path_indices = []
    path_points = []
    roi_indices = []
    roi_points = []
    distances = []

    with open(
        path,
        "r",
        newline="",
        encoding="utf-8-sig",
    ) as fp:
        reader = csv.DictReader(fp)

        required = {
            "path_index",
            "path_x",
            "path_y",
            "roi_index",
            "roi_x",
            "roi_y",
            "distance_m",
        }

        fieldnames = set(
            reader.fieldnames
            or
            []
        )

        if not required.issubset(fieldnames):
            raise ValueError(
                f"{path}: mapping CSV header가 올바르지 않습니다."
            )

        for row in reader:
            path_indices.append(
                int(row["path_index"])
            )

            path_points.append(
                [
                    float(row["path_x"]),
                    float(row["path_y"]),
                ]
            )

            roi_indices.append(
                int(row["roi_index"])
            )

            roi_points.append(
                [
                    float(row["roi_x"]),
                    float(row["roi_y"]),
                ]
            )

            distances.append(
                float(row["distance_m"])
            )

    if not path_indices:
        raise ValueError(
            f"{path}: mapping 데이터가 없습니다."
        )

    return {
        "path_index": np.asarray(
            path_indices,
            dtype=np.int64,
        ),
        "path_points": np.asarray(
            path_points,
            dtype=np.float64,
        ),
        "roi_index": np.asarray(
            roi_indices,
            dtype=np.int64,
        ),
        "roi_points": np.asarray(
            roi_points,
            dtype=np.float64,
        ),
        "distance_m": np.asarray(
            distances,
            dtype=np.float64,
        ),
    }


def load_dense_roi_for_mapping_visualization(
    path: str,
) -> Dict[str, Optional[np.ndarray]]:
    """
    Mapping 결과 시각화용 Dense ROI CSV loader.

    x/y는 필수이며 roi_radius는 있으면 사용한다.
    """
    if not os.path.exists(path):
        raise FileNotFoundError(
            f"Dense ROI CSV를 찾을 수 없습니다: {path}"
        )

    points = []
    radii = []
    has_radius = False

    with open(
        path,
        "r",
        newline="",
        encoding="utf-8-sig",
    ) as fp:
        reader = csv.DictReader(fp)
        fieldnames = set(
            reader.fieldnames
            or
            []
        )

        if not {"x", "y"}.issubset(fieldnames):
            raise ValueError(
                f"{path}: CSV header에 x, y가 필요합니다."
            )

        has_radius = "roi_radius" in fieldnames

        for row in reader:
            points.append(
                [
                    float(row["x"]),
                    float(row["y"]),
                ]
            )

            if has_radius:
                radii.append(
                    float(row["roi_radius"])
                )

    if len(points) < 2:
        raise ValueError(
            f"{path}: Dense ROI waypoint가 2개 미만입니다."
        )

    return {
        "points": np.asarray(
            points,
            dtype=np.float64,
        ),
        "roi_radius": (
            np.asarray(
                radii,
                dtype=np.float64,
            )
            if has_radius
            else None
        ),
    }


def visualize_path_roi_mapping_result(
    args,
) -> None:
    """
    Start Menu 4번 mapping 결과를 한 창에서 검증한다.

    표시:
      - track_roi.json Polygon (있으면)
      - LEFT_TRACK / MIDDLE_TRACK / RIGHT_TRACK (있으면)
      - IN / OUT Dense centerline
      - IN / OUT ROI radius circles (roi_radius 열이 있으면)
      - path_in / path_out
      - 각 Path waypoint -> mapping된 Dense ROI waypoint 연결선

    Enter:
      창 종료
    """
    path_in = load_driving_path_xy(
        args.path_in
    )
    path_out = load_driving_path_xy(
        args.path_out
    )

    in_dense_info = (
        load_dense_roi_for_mapping_visualization(
            args.in_dense
        )
    )
    out_dense_info = (
        load_dense_roi_for_mapping_visualization(
            args.out_dense
        )
    )

    in_mapping = load_path_roi_mapping_csv(
        args.in_mapping_output
    )
    out_mapping = load_path_roi_mapping_csv(
        args.out_mapping_output
    )

    in_dense = np.asarray(
        in_dense_info["points"],
        dtype=np.float64,
    )
    out_dense = np.asarray(
        out_dense_info["points"],
        dtype=np.float64,
    )

    closed = detect_mapping_closed(
        in_dense=in_dense,
        out_dense=out_dense,
        track_roi_path=args.track_roi,
    )

    fig, ax = plt.subplots(
        figsize=(15, 11)
    )

    # --------------------------------------------------------
    # 1. Polygon ROI background
    # --------------------------------------------------------
    if (
        args.track_roi
        and os.path.exists(args.track_roi)
    ):
        try:
            with open(
                args.track_roi,
                "r",
                encoding="utf-8",
            ) as fp:
                roi_json = json.load(fp)

            draw_polygon_list(
                ax,
                roi_json.get(
                    "polygons",
                    [],
                ),
                show_label=False,
            )
        except Exception as exc:
            print(
                f"[WARN] track_roi.json polygon display skipped: {exc}"
            )

    # --------------------------------------------------------
    # 2. Final TRACK lines
    # --------------------------------------------------------
    data_dir = os.path.dirname(
        os.path.abspath(
            args.path_in
        )
    )

    track_files = {
        "left": os.path.join(
            data_dir,
            "left_track.csv",
        ),
        "middle": os.path.join(
            data_dir,
            "middle_track.csv",
        ),
        "right": os.path.join(
            data_dir,
            "right_track.csv",
        ),
    }

    for lane_name, track_file in track_files.items():
        if not os.path.exists(track_file):
            print(
                f"[WARN] Mapping preview track skipped: {track_file}"
            )
            continue

        try:
            track_points, _ = load_line_csv(
                track_file
            )

            style = line_visual_style(
                f"{lane_name}_track"
            )

            ax.plot(
                track_points[:, 0],
                track_points[:, 1],
                color=line_color(lane_name),
                linestyle=style["linestyle"],
                linewidth=style["linewidth"],
                alpha=style["alpha"],
                label=f"{lane_name.upper()}_TRACK",
                zorder=6,
            )
        except Exception as exc:
            print(
                f"[WARN] Mapping preview track load failed ({lane_name}): {exc}"
            )

    # --------------------------------------------------------
    # 3. Dense ROI centerlines
    # --------------------------------------------------------
    in_dense_draw = (
        dense_close_path(
            dense_open_path(in_dense)
        )
        if closed
        else in_dense
    )
    out_dense_draw = (
        dense_close_path(
            dense_open_path(out_dense)
        )
        if closed
        else out_dense
    )

    in_dense_artist, = ax.plot(
        in_dense_draw[:, 0],
        in_dense_draw[:, 1],
        color="crimson",
        linewidth=2.0,
        label="IN Dense ROI",
        zorder=8,
    )

    out_dense_artist, = ax.plot(
        out_dense_draw[:, 0],
        out_dense_draw[:, 1],
        color="purple",
        linewidth=2.0,
        label="OUT Dense ROI",
        zorder=8,
    )

    # --------------------------------------------------------
    # 4. ROI radius circles
    # --------------------------------------------------------
    def add_roi_circles(
        points: np.ndarray,
        radii: Optional[np.ndarray],
        color: str,
        label: str,
    ):
        if radii is None:
            return

        radius_values = np.asarray(
            radii,
            dtype=np.float64,
        )

        # 화면 과밀 방지를 위해 약 150개 circle 이하로 표시한다.
        core_count = (
            len(points) - 1
            if (
                closed
                and len(points) >= 2
                and np.linalg.norm(
                    points[0] - points[-1]
                ) <= 1.0e-8
            )
            else len(points)
        )

        plot_step = max(
            1,
            int(
                math.ceil(
                    core_count / 150.0
                )
            ),
        )

        segments = build_dense_roi_circle_segments(
            points=points,
            radii=radius_values,
            plot_step=plot_step,
            closed=closed,
            resolution=32,
        )

        if segments:
            ax.add_collection(
                LineCollection(
                    segments,
                    colors=[color],
                    linewidths=0.55,
                    alpha=0.20,
                    label=label,
                    zorder=2,
                )
            )

    add_roi_circles(
        in_dense,
        in_dense_info["roi_radius"],
        in_dense_artist.get_color(),
        "IN ROI radius",
    )

    add_roi_circles(
        out_dense,
        out_dense_info["roi_radius"],
        out_dense_artist.get_color(),
        "OUT ROI radius",
    )

    # --------------------------------------------------------
    # 5. Driving paths
    # --------------------------------------------------------
    ax.plot(
        path_in[:, 0],
        path_in[:, 1],
        color="deepskyblue",
        linewidth=1.45,
        linestyle="-.",
        label="PATH_IN",
        zorder=10,
    )

    ax.plot(
        path_out[:, 0],
        path_out[:, 1],
        color="magenta",
        linewidth=1.45,
        linestyle="-.",
        label="PATH_OUT",
        zorder=10,
    )

    # --------------------------------------------------------
    # 6. Path -> Dense ROI mapping connector lines
    # --------------------------------------------------------
    in_segments = np.stack(
        [
            np.asarray(
                in_mapping["path_points"],
                dtype=np.float64,
            ),
            np.asarray(
                in_mapping["roi_points"],
                dtype=np.float64,
            ),
        ],
        axis=1,
    )

    out_segments = np.stack(
        [
            np.asarray(
                out_mapping["path_points"],
                dtype=np.float64,
            ),
            np.asarray(
                out_mapping["roi_points"],
                dtype=np.float64,
            ),
        ],
        axis=1,
    )

    if len(in_segments) > 0:
        ax.add_collection(
            LineCollection(
                in_segments,
                colors=["deepskyblue"],
                linewidths=0.75,
                alpha=0.50,
                label="PATH_IN -> IN Dense mapping",
                zorder=7,
            )
        )

    if len(out_segments) > 0:
        ax.add_collection(
            LineCollection(
                out_segments,
                colors=["magenta"],
                linewidths=0.75,
                alpha=0.50,
                label="PATH_OUT -> OUT Dense mapping",
                zorder=7,
            )
        )

    # 실제 1:1 동일 좌표이면 connector 길이가 0이라 보이지 않으므로,
    # mapped ROI 위치를 작은 marker로도 표시한다.
    ax.scatter(
        in_mapping["roi_points"][:, 0],
        in_mapping["roi_points"][:, 1],
        s=11,
        facecolors="none",
        edgecolors="deepskyblue",
        linewidths=0.55,
        alpha=0.72,
        label="Mapped IN ROI points",
        zorder=11,
    )

    ax.scatter(
        out_mapping["roi_points"][:, 0],
        out_mapping["roi_points"][:, 1],
        s=11,
        facecolors="none",
        edgecolors="magenta",
        linewidths=0.55,
        alpha=0.72,
        label="Mapped OUT ROI points",
        zorder=11,
    )

    in_mean = float(
        np.mean(
            in_mapping["distance_m"]
        )
    )
    in_max = float(
        np.max(
            in_mapping["distance_m"]
        )
    )
    out_mean = float(
        np.mean(
            out_mapping["distance_m"]
        )
    )
    out_max = float(
        np.max(
            out_mapping["distance_m"]
        )
    )

    status_text = ax.text(
        0.01,
        0.01,
        (
            f"IN mapping: {len(in_mapping['path_index'])} points | "
            f"mean={in_mean:.4f} m | max={in_max:.4f} m\n"
            f"OUT mapping: {len(out_mapping['path_index'])} points | "
            f"mean={out_mean:.4f} m | max={out_max:.4f} m | "
            "Enter: close"
        ),
        transform=ax.transAxes,
        fontsize=9,
        verticalalignment="bottom",
        bbox={
            "facecolor": "white",
            "alpha": 0.78,
            "edgecolor": "gray",
        },
        zorder=20,
    )

    ax.set_aspect(
        "equal",
        adjustable="box",
    )
    ax.grid(True)
    ax.set_xlabel("x [m]")
    ax.set_ylabel("y [m]")
    ax.set_title(
        "Path -> Dense ROI Mapping Verification\n"
        "Connector lines show the mapped Path waypoint to Dense ROI waypoint"
    )
    ax.legend(
        loc="best",
        fontsize=8,
    )
    ax.autoscale_view()
    fig.tight_layout()

    def on_key(event):
        key = (
            event.key
            or
            ""
        ).lower()

        if key in (
            "enter",
            "return",
        ):
            plt.close(fig)

    fig.canvas.mpl_connect(
        "key_press_event",
        on_key,
    )

    print()
    print("============================================")
    print("Path -> Dense ROI Mapping Preview")
    print("============================================")
    print("TRACK lines         : LEFT / MIDDLE / RIGHT")
    print("ROI                 : track_roi polygons + Dense ROI radius")
    print("PATH_IN mapping     : cyan connector lines")
    print("PATH_OUT mapping    : magenta connector lines")
    print("Enter               : close preview")
    print("============================================")

    plt.show()


def run_path_roi_mapping_mode(
    args,
) -> None:
    """
    Start Menu 4번 전용 모드.

    기존 파일:
      path_in.csv
      path_out.csv
      in_dense.csv
      out_dense.csv

    생성 파일:
      in_path_roi_map.csv
      out_path_roi_map.csv

    생성 후:
      Track / ROI / Path / mapping connector를 한 창에서 검증한다.
    """
    stats = generate_and_save_path_roi_mappings(
        path_in_file=args.path_in,
        path_out_file=args.path_out,
        in_dense_file=args.in_dense,
        out_dense_file=args.out_dense,
        in_mapping_output=args.in_mapping_output,
        out_mapping_output=args.out_mapping_output,
        track_roi_path=args.track_roi,
    )

    print()
    print("============================================")
    print("Path -> Dense ROI Mapping Complete")
    print("============================================")
    print(
        f"Closed track : {stats['closed']}"
    )
    print(
        f"IN  : path={stats['in_path_count']} / "
        f"roi={stats['in_roi_count']} / "
        f"mean distance={stats['in_mean_distance']:.6f} m / "
        f"max distance={stats['in_max_distance']:.6f} m"
    )
    print(
        f"OUT : path={stats['out_path_count']} / "
        f"roi={stats['out_roi_count']} / "
        f"mean distance={stats['out_mean_distance']:.6f} m / "
        f"max distance={stats['out_max_distance']:.6f} m"
    )
    print(
        f"IN mapping  : {os.path.abspath(args.in_mapping_output)}"
    )
    print(
        f"OUT mapping : {os.path.abspath(args.out_mapping_output)}"
    )
    print("============================================")

    if not getattr(
        args,
        "no_show",
        False,
    ):
        visualize_path_roi_mapping_result(
            args
        )

def build_dense_roi_circle_segments(
    points: np.ndarray,
    radii: np.ndarray,
    plot_step: int,
    closed: bool,
    resolution: int = 40,
) -> List[
    np.ndarray
]:
    if plot_step <= 0:
        raise ValueError(
            "ROI plot step must be > 0."
        )

    center_points = (
        dense_open_path(
            points
        )
        if closed
        else np.asarray(
            points,
            dtype=np.float64,
        )
    )

    radius_values = np.asarray(
        radii,
        dtype=np.float64,
    )

    if (
        closed
        and
        len(radius_values)
        ==
        len(points)
    ):
        radius_values = radius_values[
            :-1
        ]

    if (
        len(center_points)
        !=
        len(radius_values)
    ):
        raise ValueError(
            "Dense ROI radius count does not match point count."
        )

    theta = np.linspace(
        0.0,
        2.0 * np.pi,
        max(
            12,
            int(
                resolution
            ),
        ),
    )

    cos_theta = np.cos(
        theta
    )

    sin_theta = np.sin(
        theta
    )

    segments = []

    for index in range(
        0,
        len(center_points),
        int(
            plot_step
        ),
    ):
        radius = float(
            radius_values[
                index
            ]
        )

        if (
            not np.isfinite(
                radius
            )
            or
            radius <= EPS
        ):
            continue

        center = center_points[
            index
        ]

        segments.append(
            np.column_stack([
                center[0]
                +
                radius
                *
                cos_theta,
                center[1]
                +
                radius
                *
                sin_theta,
            ])
        )

    return segments


def show_and_save_dense_roi_figure(
    display_lines: Dict[
        str,
        np.ndarray
    ],
    in_info: Dict[
        str,
        np.ndarray
    ],
    out_info: Dict[
        str,
        np.ndarray
    ],
    figure_path: str,
    roi_plot_step: int,
    in_label: str,
    out_label: str,
    show: bool,
):
    closed = bool(
        np.linalg.norm(
            in_info["points"][0]
            -
            in_info["points"][-1]
        )
        <=
        1.0e-8
    )

    fig, ax = plt.subplots(
        figsize=(14, 10)
    )

    for (
        name,
        points,
    ) in display_lines.items():
        points = np.asarray(
            points,
            dtype=np.float64,
        )

        style = line_visual_style(
            name
        )

        ax.plot(
            points[:, 0],
            points[:, 1],
            color=style["color"],
            linestyle=style["linestyle"],
            linewidth=style["linewidth"],
            alpha=style["alpha"],
            label=name,
            zorder=3,
        )

    in_points = np.asarray(
        in_info[
            "points"
        ],
        dtype=np.float64,
    )

    out_points = np.asarray(
        out_info[
            "points"
        ],
        dtype=np.float64,
    )

    in_line, = ax.plot(
        in_points[:, 0],
        in_points[:, 1],
        color="purple",
        linewidth=2.0,
        linestyle="-",
        label=in_label,
        zorder=5,
    )

    out_line, = ax.plot(
        out_points[:, 0],
        out_points[:, 1],
        color="teal",
        linewidth=2.0,
        linestyle="-",
        label=out_label,
        zorder=5,
    )

    in_circles = (
        build_dense_roi_circle_segments(
            in_points,
            in_info[
                "roi_radius"
            ],
            roi_plot_step,
            closed,
        )
    )

    out_circles = (
        build_dense_roi_circle_segments(
            out_points,
            out_info[
                "roi_radius"
            ],
            roi_plot_step,
            closed,
        )
    )

    if in_circles:
        ax.add_collection(
            LineCollection(
                in_circles,
                colors=[
                    in_line.get_color()
                ],
                linewidths=0.55,
                alpha=0.22,
                label="IN ROI circles",
                zorder=1,
            )
        )

    if out_circles:
        ax.add_collection(
            LineCollection(
                out_circles,
                colors=[
                    out_line.get_color()
                ],
                linewidths=0.55,
                alpha=0.22,
                label="OUT ROI circles",
                zorder=1,
            )
        )

    ax.set_aspect(
        "equal",
        adjustable="box",
    )

    ax.grid(
        True
    )

    ax.set_xlabel(
        "x [m]"
    )

    ax.set_ylabel(
        "y [m]"
    )

    ax.set_title(
        "Final IN / OUT Dense + ROI\nEnter: finish"
    )

    ax.legend(
        loc="best",
        fontsize=8,
    )

    ax.autoscale_view()

    fig.tight_layout()

    os.makedirs(
        os.path.dirname(
            os.path.abspath(
                figure_path
            )
        ),
        exist_ok=True,
    )

    fig.savefig(
        figure_path,
        dpi=200,
        bbox_inches="tight",
    )

    print(
        f"[OK] Dense ROI figure saved: "
        f"{figure_path}"
    )

    print(
        f"[INFO] IN ROI circles shown : "
        f"{len(in_circles)}"
    )

    print(
        f"[INFO] OUT ROI circles shown: "
        f"{len(out_circles)}"
    )

    if show:
        def on_key(event):
            key = (
                event.key
                or ""
            ).lower()

            if key in (
                "enter",
                "return",
            ):
                plt.close(
                    fig
                )

        fig.canvas.mpl_connect(
            "key_press_event",
            on_key,
        )

        print(
            "[INFO] Final view: press Enter to finish."
        )

        plt.show()

    else:
        plt.close(
            fig
        )


# ============================================================
# 14-2. Track Line Straight-Line Editor
# ============================================================

def track_line_find_section_indices(
    global_points: np.ndarray,
    section_points: np.ndarray,
    closed: bool,
    tolerance: float = 1.0e-6,
) -> np.ndarray:
    """
    기존 ROI section의 점들이 전체 resampled line에서
    어떤 index 구간에 해당하는지 찾는다.

    직선 보간은 point 개수를 바꾸지 않으므로,
    이 index mapping을 그대로 사용하여 편집 후
    roi_sections / polygons를 다시 구성할 수 있다.
    """
    global_points = np.asarray(
        global_points,
        dtype=np.float64,
    )

    section_points = np.asarray(
        section_points,
        dtype=np.float64,
    )

    if len(global_points) < 2:
        raise ValueError(
            "전체 track line point가 2개 미만입니다."
        )

    if len(section_points) < 2:
        raise ValueError(
            "ROI section point가 2개 미만입니다."
        )

    candidate_start_indices = np.where(
        np.linalg.norm(
            global_points
            -
            section_points[0],
            axis=1,
        )
        <=
        tolerance
    )[0]

    if len(candidate_start_indices) == 0:
        # 아주 작은 부동소수점 차이가 있는 경우
        # 가장 가까운 점도 후보로 확인한다.
        nearest = int(
            np.argmin(
                np.linalg.norm(
                    global_points
                    -
                    section_points[0],
                    axis=1,
                )
            )
        )

        candidate_start_indices = np.asarray(
            [nearest],
            dtype=np.int64,
        )

    best_indices = None
    best_error = float(
        "inf"
    )

    for start_index in candidate_start_indices:
        start_index = int(
            start_index
        )

        if closed:
            indices = (
                start_index
                +
                np.arange(
                    len(section_points),
                    dtype=np.int64,
                )
            ) % len(
                global_points
            )

        else:
            end_index = (
                start_index
                +
                len(section_points)
            )

            if end_index > len(
                global_points
            ):
                continue

            indices = np.arange(
                start_index,
                end_index,
                dtype=np.int64,
            )

        candidate_points = global_points[
            indices
        ]

        if len(
            candidate_points
        ) != len(
            section_points
        ):
            continue

        error = float(
            np.max(
                np.linalg.norm(
                    candidate_points
                    -
                    section_points,
                    axis=1,
                )
            )
        )

        if error < best_error:
            best_error = error
            best_indices = (
                indices.copy()
            )

    if (
        best_indices is None
        or
        best_error > 1.0e-4
    ):
        raise ValueError(
            "ROI section을 전체 resampled line의 index에 "
            "매핑하지 못했습니다. "
            f"최소 최대오차={best_error:.6e} m"
        )

    return best_indices


def track_line_build_three_line_section_maps(
    result: Dict,
) -> Dict[
    int,
    Dict[
        str,
        np.ndarray
    ]
]:
    """
    3-Line result에서 각 track_order section이
    LEFT / MIDDLE / RIGHT 전체 line의 어느 index를
    사용하는지 저장한다.
    """
    metadata = result.get(
        "metadata",
        {},
    )

    if int(
        metadata.get(
            "line_count",
            0,
        )
    ) != 3:
        raise ValueError(
            "이 편집기는 3-Line 결과만 지원합니다."
        )

    closed = bool(
        metadata.get(
            "closed_track",
            True,
        )
    )

    resampled_lines = result.get(
        "resampled_lines",
        {},
    )

    global_lines = {}

    for name in (
        "left",
        "middle",
        "right",
    ):
        if name not in resampled_lines:
            raise ValueError(
                f"resampled_lines에 {name}가 없습니다."
            )

        points = np.asarray(
            resampled_lines[
                name
            ],
            dtype=np.float64,
        )

        if (
            closed
            and
            len(points) >= 2
            and
            np.linalg.norm(
                points[0]
                -
                points[-1]
            )
            <=
            1.0e-8
        ):
            points = points[
                :-1
            ].copy()

        global_lines[
            name
        ] = points

    roi_sections = result.get(
        "roi_sections",
        {},
    )

    in_sections = {
        int(
            section[
                "track_order"
            ]
        ): section
        for section
        in roi_sections.get(
            "IN",
            [],
        )
    }

    out_sections = {
        int(
            section[
                "track_order"
            ]
        ): section
        for section
        in roi_sections.get(
            "OUT",
            [],
        )
    }

    common_orders = sorted(
        set(
            in_sections.keys()
        )
        &
        set(
            out_sections.keys()
        )
    )

    if not common_orders:
        raise ValueError(
            "3-Line IN/OUT ROI section을 찾지 못했습니다."
        )

    mapping = {}

    for track_order in common_orders:
        in_section = in_sections[
            track_order
        ]

        out_section = out_sections[
            track_order
        ]

        left_points = np.asarray(
            in_section[
                "outer_points"
            ],
            dtype=np.float64,
        )

        middle_points_in = np.asarray(
            in_section[
                "inner_points"
            ],
            dtype=np.float64,
        )

        middle_points_out = np.asarray(
            out_section[
                "inner_points"
            ],
            dtype=np.float64,
        )

        right_points = np.asarray(
            out_section[
                "outer_points"
            ],
            dtype=np.float64,
        )

        middle_difference = float(
            np.max(
                np.linalg.norm(
                    middle_points_in
                    -
                    middle_points_out,
                    axis=1,
                )
            )
        ) if (
            len(
                middle_points_in
            )
            ==
            len(
                middle_points_out
            )
        ) else float(
            "inf"
        )

        if middle_difference > 1.0e-6:
            raise ValueError(
                f"Section {track_order}: "
                "IN/OUT의 MIDDLE section이 서로 다릅니다."
            )

        mapping[
            track_order
        ] = {
            "left": (
                track_line_find_section_indices(
                    global_lines[
                        "left"
                    ],
                    left_points,
                    closed,
                )
            ),
            "middle": (
                track_line_find_section_indices(
                    global_lines[
                        "middle"
                    ],
                    middle_points_in,
                    closed,
                )
            ),
            "right": (
                track_line_find_section_indices(
                    global_lines[
                        "right"
                    ],
                    right_points,
                    closed,
                )
            ),
        }

    return mapping


def track_line_rebuild_three_line_result(
    result: Dict,
    edited_lines: Dict[
        str,
        np.ndarray
    ],
    section_maps: Dict[
        int,
        Dict[
            str,
            np.ndarray
        ]
    ],
) -> Dict:
    """
    LEFT / MIDDLE / RIGHT 직선 보간 후
    기존 ROI section / polygon / boundary를
    같은 index 기준으로 다시 구성한다.
    """
    metadata = result.get(
        "metadata",
        {},
    )

    closed = bool(
        metadata.get(
            "closed_track",
            True,
        )
    )

    # --------------------------------------------------------
    # 1. resampled_lines 갱신
    # --------------------------------------------------------

    for name in (
        "left",
        "middle",
        "right",
    ):
        result[
            "resampled_lines"
        ][
            name
        ] = points_to_list(
            edited_lines[
                name
            ]
        )

    # --------------------------------------------------------
    # 2. ROI section 갱신
    # --------------------------------------------------------

    in_sections = {
        int(
            section[
                "track_order"
            ]
        ): section
        for section
        in result[
            "roi_sections"
        ].get(
            "IN",
            [],
        )
    }

    out_sections = {
        int(
            section[
                "track_order"
            ]
        ): section
        for section
        in result[
            "roi_sections"
        ].get(
            "OUT",
            [],
        )
    }

    for track_order, mapping in section_maps.items():
        left_section = edited_lines[
            "left"
        ][
            mapping[
                "left"
            ]
        ]

        middle_section = edited_lines[
            "middle"
        ][
            mapping[
                "middle"
            ]
        ]

        right_section = edited_lines[
            "right"
        ][
            mapping[
                "right"
            ]
        ]

        in_section = in_sections[
            track_order
        ]

        out_section = out_sections[
            track_order
        ]

        in_section[
            "outer_points"
        ] = points_to_list(
            left_section
        )

        in_section[
            "inner_points"
        ] = points_to_list(
            middle_section
        )

        out_section[
            "inner_points"
        ] = points_to_list(
            middle_section
        )

        out_section[
            "outer_points"
        ] = points_to_list(
            right_section
        )

    # --------------------------------------------------------
    # 3. Polygon 갱신
    # --------------------------------------------------------

    polygon_lookup = {
        (
            str(
                polygon.get(
                    "roi",
                    "",
                )
            ).upper(),
            int(
                polygon.get(
                    "track_order",
                    0,
                )
            ),
        ): polygon
        for polygon
        in result.get(
            "polygons",
            [],
        )
    }

    for track_order in sorted(
        section_maps.keys()
    ):
        in_section = in_sections[
            track_order
        ]

        out_section = out_sections[
            track_order
        ]

        left_section = np.asarray(
            in_section[
                "outer_points"
            ],
            dtype=np.float64,
        )

        middle_section = np.asarray(
            in_section[
                "inner_points"
            ],
            dtype=np.float64,
        )

        right_section = np.asarray(
            out_section[
                "outer_points"
            ],
            dtype=np.float64,
        )

        in_vertices = close_polygon(
            np.vstack(
                [
                    left_section,
                    middle_section[
                        ::-1
                    ],
                ]
            )
        )

        out_vertices = close_polygon(
            np.vstack(
                [
                    middle_section,
                    right_section[
                        ::-1
                    ],
                ]
            )
        )

        in_polygon = polygon_lookup.get(
            (
                "IN",
                track_order,
            )
        )

        out_polygon = polygon_lookup.get(
            (
                "OUT",
                track_order,
            )
        )

        if in_polygon is None:
            raise ValueError(
                f"IN Polygon {track_order}를 찾지 못했습니다."
            )

        if out_polygon is None:
            raise ValueError(
                f"OUT Polygon {track_order}를 찾지 못했습니다."
            )

        in_polygon[
            "vertices"
        ] = points_to_list(
            in_vertices
        )

        out_polygon[
            "vertices"
        ] = points_to_list(
            out_vertices
        )

    # --------------------------------------------------------
    # 4. Boundary 좌표 / s 갱신
    # --------------------------------------------------------

    line_for_projection = {}

    for name in (
        "left",
        "middle",
        "right",
    ):
        points = edited_lines[
            name
        ]

        if closed:
            points = dense_close_path(
                points
            )

        line_for_projection[
            name
        ] = points

    boundaries = [
        boundary
        for boundary
        in result.get(
            "boundaries",
            []
        )
        if str(
            boundary.get(
                "roi",
                "",
            )
        ).upper()
        ==
        "SHARED"
    ]

    try:
        boundaries.sort(
            key=lambda item: int(
                item.get(
                    "id",
                    0,
                )
            )
        )
    except Exception:
        pass

    section_orders = sorted(
        section_maps.keys()
    )

    if len(
        boundaries
    ) != len(
        section_orders
    ):
        raise ValueError(
            "SHARED boundary 수와 ROI section 수가 일치하지 않습니다."
        )

    for boundary, track_order in zip(
        boundaries,
        section_orders,
    ):
        in_section = in_sections[
            track_order
        ]

        out_section = out_sections[
            track_order
        ]

        left_point = np.asarray(
            in_section[
                "outer_points"
            ][0],
            dtype=np.float64,
        )

        middle_point = np.asarray(
            in_section[
                "inner_points"
            ][0],
            dtype=np.float64,
        )

        right_point = np.asarray(
            out_section[
                "outer_points"
            ][0],
            dtype=np.float64,
        )

        boundary[
            "points"
        ] = points_to_list(
            [
                left_point,
                middle_point,
                right_point,
            ]
        )

        _, left_s, _, _ = (
            project_point_to_polyline(
                left_point,
                line_for_projection[
                    "left"
                ],
            )
        )

        _, middle_s, _, _ = (
            project_point_to_polyline(
                middle_point,
                line_for_projection[
                    "middle"
                ],
            )
        )

        _, right_s, _, _ = (
            project_point_to_polyline(
                right_point,
                line_for_projection[
                    "right"
                ],
            )
        )

        boundary[
            "left_s"
        ] = float(
            left_s
        )

        boundary[
            "middle_s"
        ] = float(
            middle_s
        )

        boundary[
            "right_s"
        ] = float(
            right_s
        )

    result.setdefault(
        "metadata",
        {},
    )[
        "manual_line_straightening"
    ] = True

    return result


def track_line_interactive_editor_after_polygon(
    result: Dict,
    no_show: bool,
) -> Dict:
    """
    3-Line Polygon 수정 이후 실행되는
    LEFT / MIDDLE / RIGHT 직선 보간 편집기.

    Left click x2:
        같은 line의 두 waypoint를 선택하고,
        두 점 사이를 직선으로 보간한다.

    Ctrl+Z:
        Undo

    Ctrl+Y:
        Redo

    Enter:
        현재 수정 확정 후 다음 Dense 단계 진행

    Esc / 창 닫기:
        이번 line 수정만 취소하고,
        Polygon 수정 결과는 그대로 유지한 채 다음 단계 진행
    """
    metadata = result.get(
        "metadata",
        {},
    )

    line_count = int(
        metadata.get(
            "line_count",
            0,
        )
    )

    if line_count != 3:
        return result

    if no_show:
        return result

    closed = bool(
        metadata.get(
            "closed_track",
            True,
        )
    )

    section_maps = (
        track_line_build_three_line_section_maps(
            result
        )
    )

    original_result = copy.deepcopy(
        result
    )

    state = {}

    for name in (
        "left",
        "middle",
        "right",
    ):
        points = np.asarray(
            result[
                "resampled_lines"
            ][
                name
            ],
            dtype=np.float64,
        )

        if (
            closed
            and
            len(points) >= 2
            and
            np.linalg.norm(
                points[0]
                -
                points[-1]
            )
            <=
            1.0e-8
        ):
            points = points[
                :-1
            ]

        state[
            name
        ] = points.copy()

    undo_stack = []
    redo_stack = []

    pending = {
        "line": None,
        "index": None,
    }

    result_state = {
        "finalized": False,
        "cancelled": False,
    }

    fig, ax = plt.subplots(
        figsize=(14, 10)
    )

    colors = {
        "left": "black",
        "middle": "darkorange",
        "right": "dimgray",
    }

    artists = {}

    for name in (
        "left",
        "middle",
        "right",
    ):
        draw_points = (
            dense_close_path(
                state[
                    name
                ]
            )
            if closed
            else state[
                name
            ]
        )

        artist, = ax.plot(
            draw_points[:, 0],
            draw_points[:, 1],
            color=colors[
                name
            ],
            linewidth=2.0,
            label=name.upper(),
        )

        artists[
            name
        ] = artist

    selected_artist, = ax.plot(
        [],
        [],
        marker="o",
        linestyle="None",
        markersize=9,
        color="crimson",
        label="Selected point",
        zorder=10,
    )

    status_text = ax.text(
        0.01,
        0.01,
        (
            "같은 LEFT/MIDDLE/RIGHT에서 두 점 클릭 -> 직선 보간 | "
            "Enter: 직선 확정 후 Curve 단계 | Esc: 이번 수정 취소 | "
            "Ctrl+Z: Undo | Ctrl+Y: Redo"
        ),
        transform=ax.transAxes,
        fontsize=9,
        verticalalignment="bottom",
    )

    ax.set_aspect(
        "equal",
        adjustable="box",
    )

    ax.grid(
        True
    )

    ax.legend(
        loc="best"
    )

    ax.set_xlabel(
        "x [m]"
    )

    ax.set_ylabel(
        "y [m]"
    )

    ax.set_title(
        "LEFT / MIDDLE / RIGHT Straight-Line Editor\n"
        "Select two points on the same line"
    )

    fig.tight_layout()

    def set_status(
        message: str,
    ):
        status_text.set_text(
            message
        )

        fig.canvas.draw_idle()

    def refresh():
        for name in (
            "left",
            "middle",
            "right",
        ):
            draw_points = (
                dense_close_path(
                    state[
                        name
                    ]
                )
                if closed
                else state[
                    name
                ]
            )

            artists[
                name
            ].set_data(
                draw_points[
                    :,
                    0
                ],
                draw_points[
                    :,
                    1
                ],
            )

        ax.relim()
        ax.autoscale_view()
        fig.canvas.draw_idle()

    def clear_pending():
        pending[
            "line"
        ] = None

        pending[
            "index"
        ] = None

        selected_artist.set_data(
            [],
            [],
        )

        fig.canvas.draw_idle()

    def nearest_point(
        x: float,
        y: float,
    ):
        query = np.asarray(
            [
                x,
                y,
            ],
            dtype=np.float64,
        )

        best = None

        for name in (
            "left",
            "middle",
            "right",
        ):
            distances2 = np.sum(
                (
                    state[
                        name
                    ]
                    -
                    query
                )
                **
                2,
                axis=1,
            )

            index = int(
                np.argmin(
                    distances2
                )
            )

            value = float(
                distances2[
                    index
                ]
            )

            if (
                best is None
                or
                value
                <
                best[
                    0
                ]
            ):
                best = (
                    value,
                    name,
                    index,
                    state[
                        name
                    ][
                        index
                    ].copy(),
                )

        return (
            best[
                1
            ],
            best[
                2
            ],
            best[
                3
            ],
        )

    def apply_edit(
        line_name: str,
        index1: int,
        index2: int,
    ):
        target = state[
            line_name
        ]

        if index1 == index2:
            set_status(
                "같은 waypoint를 두 번 선택했습니다."
            )
            return

        indices = dense_segment_indices(
            index1,
            index2,
            len(
                target
            ),
            closed,
        )

        if len(
            indices
        ) < 2:
            set_status(
                "선택 구간이 너무 짧습니다."
            )
            return

        before = target[
            indices
        ].copy()

        start_point = target[
            indices[
                0
            ]
        ].copy()

        end_point = target[
            indices[
                -1
            ]
        ].copy()

        after = np.linspace(
            start_point,
            end_point,
            len(
                indices
            ),
        )

        target[
            indices
        ] = after

        undo_stack.append(
            {
                "line": line_name,
                "indices": indices.copy(),
                "before": before,
                "after": after.copy(),
            }
        )

        redo_stack.clear()

        refresh()

        set_status(
            f"{line_name.upper()} {len(indices)}개 waypoint 직선 보간 완료."
        )

    def undo_once():
        if not undo_stack:
            set_status(
                "Undo할 수정이 없습니다."
            )
            return

        operation = undo_stack.pop()

        state[
            operation[
                "line"
            ]
        ][
            operation[
                "indices"
            ]
        ] = operation[
            "before"
        ]

        redo_stack.append(
            operation
        )

        clear_pending()
        refresh()

        set_status(
            "직전 수정 Undo 완료."
        )

    def redo_once():
        if not redo_stack:
            set_status(
                "Redo할 수정이 없습니다."
            )
            return

        operation = redo_stack.pop()

        state[
            operation[
                "line"
            ]
        ][
            operation[
                "indices"
            ]
        ] = operation[
            "after"
        ]

        undo_stack.append(
            operation
        )

        clear_pending()
        refresh()

        set_status(
            "Redo 완료."
        )

    def on_click(
        event,
    ):
        if (
            result_state[
                "finalized"
            ]
            or
            result_state[
                "cancelled"
            ]
        ):
            return

        if (
            event.inaxes is not ax
            or
            event.button != 1
            or
            event.xdata is None
            or
            event.ydata is None
        ):
            return

        toolbar = getattr(
            fig.canvas,
            "toolbar",
            None,
        )

        toolbar_mode = (
            getattr(
                toolbar,
                "mode",
                "",
            )
            if toolbar is not None
            else ""
        )

        if toolbar_mode:
            return

        (
            line_name,
            index,
            point,
        ) = nearest_point(
            float(
                event.xdata
            ),
            float(
                event.ydata
            ),
        )

        if pending[
            "line"
        ] is None:
            pending[
                "line"
            ] = line_name

            pending[
                "index"
            ] = index

            selected_artist.set_data(
                [
                    point[
                        0
                    ]
                ],
                [
                    point[
                        1
                    ]
                ],
            )

            set_status(
                f"첫 점: {line_name.upper()}[{index}] "
                f"-> 같은 {line_name.upper()}에서 두 번째 점 선택"
            )

            return

        if pending[
            "line"
        ] != line_name:
            set_status(
                f"첫 점은 {pending['line'].upper()}입니다. "
                "같은 선에서 두 번째 점을 선택하십시오."
            )
            return

        first_index = int(
            pending[
                "index"
            ]
        )

        clear_pending()

        apply_edit(
            line_name,
            first_index,
            index,
        )

    def on_key(
        event,
    ):
        key = (
            event.key
            or
            ""
        ).lower()

        if key in (
            "ctrl+z",
            "control+z",
        ):
            undo_once()
            return

        if key in (
            "ctrl+y",
            "control+y",
        ):
            redo_once()
            return

        if key in (
            "enter",
            "return",
        ):
            result_state[
                "finalized"
            ] = True

            clear_pending()

            plt.close(
                fig
            )
            return

        if key in (
            "escape",
            "esc",
        ):
            result_state[
                "cancelled"
            ] = True

            plt.close(
                fig
            )

    def on_close(
        _event,
    ):
        if not result_state[
            "finalized"
        ]:
            result_state[
                "cancelled"
            ] = True

    fig.canvas.mpl_connect(
        "button_press_event",
        on_click,
    )

    fig.canvas.mpl_connect(
        "key_press_event",
        on_key,
    )

    fig.canvas.mpl_connect(
        "close_event",
        on_close,
    )

    plt.show()

    if (
        result_state[
            "cancelled"
        ]
        or
        not result_state[
            "finalized"
        ]
    ):
        result.clear()
        result.update(
            original_result
        )

        return result

    straight_changed = bool(
        undo_stack
    )

    curve_lines, curve_changed = curve_interactive_editor(
        lines={
            "LEFT": state["left"],
            "MIDDLE": state["middle"],
            "RIGHT": state["right"],
        },
        closed=closed,
        no_show=False,
        title="LEFT / MIDDLE / RIGHT Curve Editor",
        background_lines=None,
        initial_reference_lines={
            "LEFT": np.asarray(
                original_result["resampled_lines"]["left"],
                dtype=np.float64,
            ),
            "MIDDLE": np.asarray(
                original_result["resampled_lines"]["middle"],
                dtype=np.float64,
            ),
            "RIGHT": np.asarray(
                original_result["resampled_lines"]["right"],
                dtype=np.float64,
            ),
        },
    )

    state[
        "left"
    ] = dense_open_path(
        curve_lines[
            "LEFT"
        ]
    ) if closed else curve_lines[
        "LEFT"
    ].copy()

    state[
        "middle"
    ] = dense_open_path(
        curve_lines[
            "MIDDLE"
        ]
    ) if closed else curve_lines[
        "MIDDLE"
    ].copy()

    state[
        "right"
    ] = dense_open_path(
        curve_lines[
            "RIGHT"
        ]
    ) if closed else curve_lines[
        "RIGHT"
    ].copy()

    if (
        not straight_changed
        and
        not curve_changed
    ):
        return result

    return track_line_rebuild_three_line_result(
        result,
        edited_lines=state,
        section_maps=section_maps,
    )


def dense_load_corrected_boundaries_from_result(
    result: Dict,
    closed: bool,
) -> Dict[
    str,
    np.ndarray
]:
    """
    Track line 수동 직선 보간이 수행된 경우
    raw CSV 대신 수정된 resampled_lines를
    ROI radius 기준 경계로 사용한다.
    """
    metadata = result.get(
        "metadata",
        {},
    )

    line_count = int(
        metadata.get(
            "line_count",
            0,
        )
    )

    if line_count == 3:
        names = (
            "left",
            "middle",
            "right",
        )

    elif line_count == 4:
        names = (
            "left",
            "middle1",
            "middle2",
            "right",
        )

    else:
        raise ValueError(
            f"Unsupported line_count: {line_count}"
        )

    resampled_lines = result.get(
        "resampled_lines",
        {},
    )

    output = {}

    for name in names:
        points = np.asarray(
            resampled_lines[
                name
            ],
            dtype=np.float64,
        )

        output[
            name
        ] = prepare_polyline(
            points,
            closed,
        )

    return output





# ============================================================
# 14-3. LEFT / RIGHT Heading Offset Preview + Save
# ============================================================

def heading_offset_by_point_window(
    points: np.ndarray,
    offset_distance: float,
    side: str,
    window_points: int,
    closed: bool,
) -> np.ndarray:
    """
    각 waypoint의 heading을 index 기준 앞/뒤 window_points개 점으로 계산하고
    heading의 좌/우 법선 방향으로 일정 거리 offset한다.

    side='left':
        heading 기준 왼쪽 법선 (-dy, +dx)

    side='right':
        heading 기준 오른쪽 법선 (+dy, -dx)

    closed track은 순환 index를 사용하고,
    open track은 시작/끝에서 index를 clamp한다.
    """
    pts = np.asarray(
        points,
        dtype=np.float64,
    )

    if closed:
        pts = dense_open_path(
            pts
        )
    else:
        pts = dense_remove_duplicates(
            pts
        )

    if len(pts) < 2:
        raise ValueError(
            "Offset 계산용 waypoint가 2개 미만입니다."
        )

    window_points = int(
        window_points
    )

    if window_points < 1:
        raise ValueError(
            "heading window point 수는 1 이상이어야 합니다."
        )

    side = str(
        side
    ).lower().strip()

    if side not in (
        "left",
        "right",
    ):
        raise ValueError(
            "side는 left 또는 right여야 합니다."
        )

    n = len(
        pts
    )

    # 폐곡선에서는 정확히 반대편 점을 잡아 접선이 불안정해지는 것을 막는다.
    if closed and n >= 3:
        max_window = max(
            1,
            (n - 1) // 2,
        )
        window_points = min(
            window_points,
            max_window,
        )
    else:
        window_points = min(
            window_points,
            max(
                1,
                n - 1,
            ),
        )

    output = np.empty_like(
        pts
    )

    for index in range(
        n
    ):
        if closed:
            previous_index = (
                index
                -
                window_points
            ) % n

            next_index = (
                index
                +
                window_points
            ) % n

        else:
            previous_index = max(
                0,
                index - window_points,
            )

            next_index = min(
                n - 1,
                index + window_points,
            )

            if previous_index == next_index:
                if index == 0:
                    next_index = min(
                        n - 1,
                        1,
                    )
                else:
                    previous_index = max(
                        0,
                        n - 2,
                    )

        heading = (
            pts[next_index]
            -
            pts[previous_index]
        )

        heading_norm = float(
            np.linalg.norm(
                heading
            )
        )

        # 극히 드물게 앞/뒤 점이 같은 위치가 되면 가까운 점부터 다시 찾는다.
        if heading_norm <= EPS:
            found = False

            for fallback_window in range(
                1,
                min(
                    n,
                    window_points + 2,
                ),
            ):
                if closed:
                    previous_index = (
                        index
                        -
                        fallback_window
                    ) % n

                    next_index = (
                        index
                        +
                        fallback_window
                    ) % n
                else:
                    previous_index = max(
                        0,
                        index - fallback_window,
                    )

                    next_index = min(
                        n - 1,
                        index + fallback_window,
                    )

                heading = (
                    pts[next_index]
                    -
                    pts[previous_index]
                )

                heading_norm = float(
                    np.linalg.norm(
                        heading
                    )
                )

                if heading_norm > EPS:
                    found = True
                    break

            if not found:
                raise ValueError(
                    f"index {index}에서 heading을 계산할 수 없습니다."
                )

        tangent = (
            heading
            /
            heading_norm
        )

        if side == "left":
            normal = np.asarray(
                [
                    -tangent[1],
                    tangent[0],
                ],
                dtype=np.float64,
            )
        else:
            normal = np.asarray(
                [
                    tangent[1],
                    -tangent[0],
                ],
                dtype=np.float64,
            )

        output[index] = (
            pts[index]
            +
            float(offset_distance)
            *
            normal
        )

    if closed:
        output = dense_close_path(
            output
        )

    return output


def save_offset_line_csv(
    points: np.ndarray,
    path: str,
    frame_id: str,
) -> None:
    """
    left_offset.csv / right_offset.csv 저장.
    기존 line CSV와 동일하게 load_line_csv()로 읽을 수 있는 형식을 사용한다.
    """
    save_processed_record_line_csv(
        points=np.asarray(
            points,
            dtype=np.float64,
        ),
        output_path=path,
        frame_id=frame_id,
    )


def offset_left_right_interactive_after_polygon(
    result: Dict,
    data_dir: str,
    left_offset_m: float,
    right_offset_m: float,
    initial_window_points: int,
    no_show: bool,
) -> Optional[Dict]:
    """
    3-Line Polygon 수정 완료 후, Dense 중심선 생성 전에 실행한다.

    LEFT:
        LEFT line의 진행 heading 기준 왼쪽으로 left_offset_m 이동

    RIGHT:
        RIGHT line의 진행 heading 기준 오른쪽으로 right_offset_m 이동

    Slider:
        heading 계산 시 현재 점 기준 앞/뒤로 볼 waypoint 개수

    Enter:
        현재 window 값 확정
        -> left_offset.csv / right_offset.csv 저장
        -> 다음 Dense 단계로 진행

    Esc / 창 닫기:
        offset 단계를 확정하지 않고 전체 build를 중단한다.
    """
    metadata = result.get(
        "metadata",
        {},
    )

    if int(
        metadata.get(
            "line_count",
            0,
        )
    ) != 3:
        return {
            "finalized": True,
            "window_points": int(
                initial_window_points
            ),
        }

    if left_offset_m < 0.0:
        raise ValueError(
            "LEFT offset은 0 이상이어야 합니다."
        )

    if right_offset_m < 0.0:
        raise ValueError(
            "RIGHT offset은 0 이상이어야 합니다."
        )

    initial_window_points = max(
        1,
        int(
            initial_window_points
        ),
    )

    closed = bool(
        metadata.get(
            "closed_track",
            True,
        )
    )

    frame_id = str(
        metadata.get(
            "frame_id",
            "",
        )
    )

    resampled_lines = result.get(
        "resampled_lines",
        {},
    )

    if (
        "left" not in resampled_lines
        or
        "right" not in resampled_lines
    ):
        raise ValueError(
            "Offset 계산에 필요한 LEFT/RIGHT resampled line이 없습니다."
        )

    left = np.asarray(
        resampled_lines[
            "left"
        ],
        dtype=np.float64,
    )

    right = np.asarray(
        resampled_lines[
            "right"
        ],
        dtype=np.float64,
    )

    left_core = (
        dense_open_path(
            left
        )
        if closed
        else dense_remove_duplicates(
            left
        )
    )

    right_core = (
        dense_open_path(
            right
        )
        if closed
        else dense_remove_duplicates(
            right
        )
    )

    min_count = min(
        len(left_core),
        len(right_core),
    )

    if min_count < 2:
        raise ValueError(
            "Offset 계산용 LEFT/RIGHT waypoint가 부족합니다."
        )

    if closed:
        max_window_points = max(
            1,
            min(
                100,
                (min_count - 1) // 2,
            ),
        )
    else:
        max_window_points = max(
            1,
            min(
                100,
                min_count - 1,
            ),
        )

    initial_window_points = min(
        initial_window_points,
        max_window_points,
    )

    left_output_path = os.path.join(
        data_dir,
        "left_offset.csv",
    )

    right_output_path = os.path.join(
        data_dir,
        "right_offset.csv",
    )

    state = {
        "window_points": int(
            initial_window_points
        ),
        "left_offset": None,
        "right_offset": None,
        "finalized": False,
        "cancelled": False,
    }

    def recalculate(
        window_points: int,
    ):
        window_points = int(
            window_points
        )

        state[
            "window_points"
        ] = window_points

        state[
            "left_offset"
        ] = heading_offset_by_point_window(
            points=left,
            offset_distance=left_offset_m,
            side="left",
            window_points=window_points,
            closed=closed,
        )

        state[
            "right_offset"
        ] = heading_offset_by_point_window(
            points=right,
            offset_distance=right_offset_m,
            side="right",
            window_points=window_points,
            closed=closed,
        )

    recalculate(
        initial_window_points
    )

    if no_show:
        save_offset_line_csv(
            state[
                "left_offset"
            ],
            left_output_path,
            frame_id,
        )

        save_offset_line_csv(
            state[
                "right_offset"
            ],
            right_output_path,
            frame_id,
        )

        state[
            "finalized"
        ] = True

    else:
        from matplotlib.widgets import Slider

        fig, ax = plt.subplots(
            figsize=(14, 10)
        )

        plt.subplots_adjust(
            bottom=0.16
        )

        # Polygon을 배경으로 표시하여 offset 방향을 바로 확인할 수 있게 한다.
        draw_polygon_list(
            ax,
            result.get(
                "polygons",
                [],
            ),
            show_label=False,
        )

        middle = np.asarray(
            resampled_lines.get(
                "middle",
                [],
            ),
            dtype=np.float64,
        )

        left_draw = (
            dense_close_path(
                left_core
            )
            if closed
            else left_core
        )

        right_draw = (
            dense_close_path(
                right_core
            )
            if closed
            else right_core
        )

        left_source_style = line_visual_style(
            "LEFT",
            initial=True,
        )
        ax.plot(
            left_draw[:, 0],
            left_draw[:, 1],
            color=left_source_style["color"],
            linestyle=left_source_style["linestyle"],
            linewidth=left_source_style["linewidth"],
            alpha=left_source_style["alpha"],
            label="LEFT original",
            zorder=5,
        )

        if len(middle) >= 2:
            middle_draw = (
                dense_close_path(
                    dense_open_path(
                        middle
                    )
                )
                if closed
                else middle
            )

            middle_style = line_visual_style(
                "MIDDLE"
            )
            ax.plot(
                middle_draw[:, 0],
                middle_draw[:, 1],
                color=middle_style["color"],
                linestyle=middle_style["linestyle"],
                linewidth=middle_style["linewidth"],
                alpha=middle_style["alpha"],
                label="MIDDLE",
                zorder=4,
            )

        right_source_style = line_visual_style(
            "RIGHT",
            initial=True,
        )
        ax.plot(
            right_draw[:, 0],
            right_draw[:, 1],
            color=right_source_style["color"],
            linestyle=right_source_style["linestyle"],
            linewidth=right_source_style["linewidth"],
            alpha=right_source_style["alpha"],
            label="RIGHT original",
            zorder=5,
        )

        left_offset_style = line_visual_style(
            "LEFT_OFFSET"
        )
        left_offset_artist, = ax.plot(
            state[
                "left_offset"
            ][:, 0],
            state[
                "left_offset"
            ][:, 1],
            color=left_offset_style["color"],
            linewidth=left_offset_style["linewidth"],
            linestyle=left_offset_style["linestyle"],
            alpha=left_offset_style["alpha"],
            label=(
                f"LEFT offset = {left_offset_m:.3f} m"
            ),
            zorder=7,
        )

        right_offset_style = line_visual_style(
            "RIGHT_OFFSET"
        )
        right_offset_artist, = ax.plot(
            state[
                "right_offset"
            ][:, 0],
            state[
                "right_offset"
            ][:, 1],
            color=right_offset_style["color"],
            linewidth=right_offset_style["linewidth"],
            linestyle=right_offset_style["linestyle"],
            alpha=right_offset_style["alpha"],
            label=(
                f"RIGHT offset = {right_offset_m:.3f} m"
            ),
            zorder=7,
        )

        status_text = ax.text(
            0.01,
            0.01,
            "",
            transform=ax.transAxes,
            fontsize=9,
            verticalalignment="bottom",
        )

        slider_ax = fig.add_axes(
            [
                0.20,
                0.055,
                0.62,
                0.035,
            ]
        )

        window_slider = Slider(
            ax=slider_ax,
            label="Heading window (points each side)",
            valmin=1,
            valmax=max_window_points,
            valinit=initial_window_points,
            valstep=1,
        )

        def update_status():
            status_text.set_text(
                f"heading = P[i+{state['window_points']}] - "
                f"P[i-{state['window_points']}] | "
                f"LEFT: {left_offset_m:.3f} m left | "
                f"RIGHT: {right_offset_m:.3f} m right | "
                "Enter: save/proceed | Esc: cancel"
            )

        def on_slider_change(
            value,
        ):
            try:
                recalculate(
                    int(
                        round(
                            float(
                                value
                            )
                        )
                    )
                )

                left_offset_artist.set_data(
                    state[
                        "left_offset"
                    ][:, 0],
                    state[
                        "left_offset"
                    ][:, 1],
                )

                right_offset_artist.set_data(
                    state[
                        "right_offset"
                    ][:, 0],
                    state[
                        "right_offset"
                    ][:, 1],
                )

                update_status()
                fig.canvas.draw_idle()

            except Exception as exc:
                status_text.set_text(
                    f"Offset 계산 실패: {exc}"
                )
                fig.canvas.draw_idle()

        def on_key(
            event,
        ):
            key = (
                event.key
                or
                ""
            ).lower()

            if key in (
                "enter",
                "return",
            ):
                save_offset_line_csv(
                    state[
                        "left_offset"
                    ],
                    left_output_path,
                    frame_id,
                )

                save_offset_line_csv(
                    state[
                        "right_offset"
                    ],
                    right_output_path,
                    frame_id,
                )

                state[
                    "finalized"
                ] = True

                plt.close(
                    fig
                )
                return

            if key in (
                "escape",
                "esc",
            ):
                state[
                    "cancelled"
                ] = True

                plt.close(
                    fig
                )

        def on_close(
            _event,
        ):
            if not state[
                "finalized"
            ]:
                state[
                    "cancelled"
                ] = True

        window_slider.on_changed(
            on_slider_change
        )

        fig.canvas.mpl_connect(
            "key_press_event",
            on_key,
        )

        fig.canvas.mpl_connect(
            "close_event",
            on_close,
        )

        ax.set_aspect(
            "equal",
            adjustable="box",
        )

        ax.grid(
            True
        )

        ax.set_xlabel(
            "x [m]"
        )

        ax.set_ylabel(
            "y [m]"
        )

        ax.set_title(
            "LEFT / RIGHT Heading Offset Preview\n"
            "Adjust heading window with the slider, then press Enter"
        )

        ax.legend(
            loc="best",
            fontsize=8,
        )

        update_status()

        print()
        print(
            "============================================================"
        )
        print(
            "LEFT / RIGHT HEADING OFFSET"
        )
        print(
            "============================================================"
        )
        print(
            f"LEFT  : heading 기준 왼쪽 {left_offset_m:.3f} m"
        )
        print(
            f"RIGHT : heading 기준 오른쪽 {right_offset_m:.3f} m"
        )
        print(
            "Slider: heading 계산 시 앞/뒤 waypoint 개수"
        )
        print(
            "Enter : left_offset.csv / right_offset.csv 저장 후 다음 단계"
        )
        print(
            "Esc   : build 중단"
        )
        print(
            "============================================================"
        )

        plt.show()

    if not state[
        "finalized"
    ]:
        return None

    result.setdefault(
        "metadata",
        {},
    )[
        "side_heading_offset"
    ] = {
        "left_offset_m": float(
            left_offset_m
        ),
        "right_offset_m": float(
            right_offset_m
        ),
        "heading_window_points_each_side": int(
            state[
                "window_points"
            ]
        ),
        "left_file": "left_offset.csv",
        "right_file": "right_offset.csv",
    }

    result[
        "offset_lines"
    ] = {
        "left_offset": points_to_list(
            state[
                "left_offset"
            ]
        ),
        "right_offset": points_to_list(
            state[
                "right_offset"
            ]
        ),
    }

    return {
        "finalized": True,
        "window_points": int(
            state[
                "window_points"
            ]
        ),
        "left_path": left_output_path,
        "right_path": right_output_path,
        "left_points": state[
            "left_offset"
        ],
        "right_points": state[
            "right_offset"
        ],
    }


def apply_three_line_offset_to_roi_result(
    result: Dict,
    offset_result: Dict,
) -> Dict:
    """
    확정된 LEFT/RIGHT heading offset을 최종 3-Line ROI 경계에 반영한다.

    최종 경계:
        IN  = LEFT_OFFSET <-> MIDDLE
        OUT = MIDDLE <-> RIGHT_OFFSET

    단순히 resampled_lines만 교체하지 않고, 기존 section index mapping을
    이용해 roi_sections / polygons / boundaries까지 함께 재구성한다.
    이후 Dense 중심선과 ROI radius 계산은 이 갱신된 result를 사용한다.
    """
    metadata = result.get(
        "metadata",
        {},
    )

    if int(
        metadata.get(
            "line_count",
            0,
        )
    ) != 3:
        return result

    if not offset_result or not bool(
        offset_result.get(
            "finalized",
            False,
        )
    ):
        raise ValueError(
            "확정된 LEFT/RIGHT offset 결과가 없습니다."
        )

    if (
        "left_points" not in offset_result
        or
        "right_points" not in offset_result
    ):
        raise ValueError(
            "offset_result에 LEFT/RIGHT offset 좌표가 없습니다."
        )

    # 기존 ROI section이 원래 LEFT/MIDDLE/RIGHT의 어느 index를
    # 사용하는지 먼저 저장한다. 반드시 offset 적용 전에 수행한다.
    section_maps = (
        track_line_build_three_line_section_maps(
            result
        )
    )

    resampled_lines = result.get(
        "resampled_lines",
        {},
    )

    if "middle" not in resampled_lines:
        raise ValueError(
            "최종 ROI 재구성에 필요한 MIDDLE line이 없습니다."
        )

    edited_lines = {
        "left": np.asarray(
            offset_result[
                "left_points"
            ],
            dtype=np.float64,
        ),
        "middle": np.asarray(
            resampled_lines[
                "middle"
            ],
            dtype=np.float64,
        ),
        "right": np.asarray(
            offset_result[
                "right_points"
            ],
            dtype=np.float64,
        ),
    }

    result = track_line_rebuild_three_line_result(
        result=result,
        edited_lines=edited_lines,
        section_maps=section_maps,
    )

    result.setdefault(
        "metadata",
        {},
    )[
        "roi_definition"
    ] = {
        "IN": "LEFT_OFFSET <-> MIDDLE",
        "OUT": "MIDDLE <-> RIGHT_OFFSET",
    }

    result[
        "metadata"
    ][
        "offset_applied_to_final_roi"
    ] = True

    result[
        "metadata"
    ][
        "offset_heading_window_points"
    ] = int(
        offset_result.get(
            "window_points",
            0,
        )
    )

    # JSON에도 최종 적용된 offset 선을 명시적으로 남긴다.
    result[
        "offset_lines"
    ] = {
        "left": points_to_list(
            edited_lines[
                "left"
            ]
        ),
        "right": points_to_list(
            edited_lines[
                "right"
            ]
        ),
    }

    return result



def edit_and_save_three_track_lines_after_offset(
    result: Dict,
    data_dir: str,
    no_show: bool,
) -> Dict:
    """
    3-Line offset 적용 직후 실행되는 최종 Track line 편집 단계.

    입력 선:
        LEFT   = LEFT_OFFSET
        MIDDLE = Polygon 단계의 MIDDLE
        RIGHT  = RIGHT_OFFSET

    편집 순서:
        1) LEFT straight
        2) LEFT curve
        3) MIDDLE straight
        4) MIDDLE curve
        5) RIGHT straight
        6) RIGHT curve

    저장:
        left_track.csv
        middle_track.csv
        right_track.csv

    중요:
        - *_raw.csv는 수정하지 않는다.
        - 직선/곡선 편집은 waypoint 개수를 유지한다.
        - 기존 section index mapping을 사용하여 roi_sections / polygons /
          boundaries를 동일한 index 기준으로 함께 갱신한다.
    """
    metadata = result.get(
        "metadata",
        {},
    )

    if int(
        metadata.get(
            "line_count",
            0,
        )
    ) != 3:
        return result

    if not bool(
        metadata.get(
            "offset_applied_to_final_roi",
            False,
        )
    ):
        raise ValueError(
            "Track line editor requires LEFT/RIGHT offset to be applied first."
        )

    closed = bool(
        metadata.get(
            "closed_track",
            True,
        )
    )

    frame_id = str(
        metadata.get(
            "frame_id",
            "",
        )
    )

    section_maps = track_line_build_three_line_section_maps(
        result
    )

    resampled_lines = result.get(
        "resampled_lines",
        {},
    )

    line_order = [
        "left",
        "middle",
        "right",
    ]

    initial_lines = {}
    current_lines = {}

    for line_name in line_order:
        if line_name not in resampled_lines:
            raise ValueError(
                f"Final track edit requires resampled_lines['{line_name}']."
            )

        points = np.asarray(
            resampled_lines[line_name],
            dtype=np.float64,
        )

        initial_lines[line_name] = points.copy()
        current_lines[line_name] = points.copy()

    print()
    print("============================================================")
    print("FINAL TRACK LINE EDIT AFTER OFFSET")
    print("============================================================")
    print("Input : LEFT_OFFSET / MIDDLE / RIGHT_OFFSET")
    print("Order : LEFT -> MIDDLE -> RIGHT")
    print("Each line: Straight Editor -> Curve Editor")
    print("Output: left_track.csv / middle_track.csv / right_track.csv")
    print("RAW files are not modified in this stage.")
    print("============================================================")

    edit_flags = {}

    for line_index, line_name in enumerate(
        line_order,
        start=1,
    ):
        print()
        print(
            f"[{line_index}/3] {line_name.upper()}_TRACK editing"
        )

        if no_show:
            edited = current_lines[line_name].copy()
            straight_edited = False
            curve_edited = False

        else:
            edited, straight_edited = record_line_interactive_editor(
                line_name=line_name,
                points=current_lines[line_name],
                closed=closed,
                context_initial_lines=initial_lines,
                context_current_lines=current_lines,
                editor_title=(
                    f"{line_name.upper()} TRACK Straight-Line Editor"
                ),
            )

            curve_background_lines = {}

            for context_name in line_order:
                if context_name == line_name:
                    continue

                initial_label = (
                    f"{context_name.upper()}_OFFSET"
                    if context_name in ("left", "right")
                    else f"{context_name.upper()}_INITIAL"
                )

                same_as_initial = (
                    initial_lines[context_name].shape
                    ==
                    current_lines[context_name].shape
                    and
                    np.allclose(
                        initial_lines[context_name],
                        current_lines[context_name],
                        atol=1.0e-10,
                        rtol=0.0,
                    )
                )

                current_label = (
                    (
                        f"{context_name.upper()}_OFFSET"
                        if context_name in ("left", "right")
                        else "MIDDLE"
                    )
                    if same_as_initial
                    else f"{context_name.upper()}_TRACK"
                )

                curve_background_lines[
                    initial_label
                ] = initial_lines[context_name]

                curve_background_lines[
                    current_label
                ] = current_lines[context_name]

            curve_lines, curve_edited = curve_interactive_editor(
                lines={
                    line_name.upper(): edited,
                },
                closed=closed,
                no_show=False,
                title=f"{line_name.upper()} TRACK Curve Editor",
                background_lines=curve_background_lines,
                initial_reference_lines={
                    line_name.upper(): initial_lines[line_name],
                },
            )

            edited = curve_lines[
                line_name.upper()
            ]

        current_lines[line_name] = np.asarray(
            edited,
            dtype=np.float64,
        ).copy()

        edit_flags[line_name] = {
            "straight": bool(straight_edited),
            "curve": bool(curve_edited),
        }

    result = track_line_rebuild_three_line_result(
        result=result,
        edited_lines=current_lines,
        section_maps=section_maps,
    )

    track_paths = {}

    for line_name in line_order:
        track_path = os.path.join(
            data_dir,
            f"{line_name}_track.csv",
        )

        save_processed_record_line_csv(
            points=current_lines[line_name],
            output_path=track_path,
            frame_id=frame_id,
        )

        track_paths[line_name] = track_path

    result.setdefault(
        "metadata",
        {},
    )[
        "final_track_line_files"
    ] = {
        "left": "left_track.csv",
        "middle": "middle_track.csv",
        "right": "right_track.csv",
    }

    result[
        "metadata"
    ][
        "track_lines_applied_to_final_roi"
    ] = True

    result[
        "metadata"
    ][
        "roi_definition"
    ] = {
        "IN": "LEFT_TRACK <-> MIDDLE_TRACK",
        "OUT": "MIDDLE_TRACK <-> RIGHT_TRACK",
    }

    result[
        "track_lines"
    ] = {
        "left": points_to_list(
            current_lines["left"]
        ),
        "middle": points_to_list(
            current_lines["middle"]
        ),
        "right": points_to_list(
            current_lines["right"]
        ),
    }

    print()
    print("============================================================")
    print("[OK] FINAL TRACK LINE EDIT COMPLETE")
    print("============================================================")

    for line_name in line_order:
        flags = edit_flags[line_name]
        print(
            f"{line_name.upper():6s}: "
            f"straight={'YES' if flags['straight'] else 'NO'} | "
            f"curve={'YES' if flags['curve'] else 'NO'} | "
            f"{track_paths[line_name]}"
        )

    print("============================================================")

    return result



def run_dense_workflow_from_result(
    result: Dict,
    args,
    data_dir: str,
):
    metadata = result.get(
        "metadata",
        {},
    )

    line_count = int(
        metadata.get(
            "line_count",
            0,
        )
    )

    closed = bool(
        metadata.get(
            "closed_track",
            True,
        )
    )

    # --------------------------------------------------------
    # 1. Dense 중심선 생성
    #
    # LEFT/MIDDLE/RIGHT 직선 보간은 이제 record 종료 직후
    # *_raw.csv 생성 전에 완료된다.
    # Polygon 생성 이후에는 원본 Track line을 다시 수정하지 않는다.
    # --------------------------------------------------------

    (
        in_dense,
        out_dense,
    ) = run_silent_step(
        "IN/OUT Dense 중심선 생성",
        dense_generate_centerlines_from_result,
        result,
        args.curve_spacing,
    )

    # --------------------------------------------------------
    # 3. 편집 전 0.30 m 재샘플링
    # --------------------------------------------------------

    def initial_resampling():
        in_result = (
            dense_resample_final_path(
                in_dense,
                args.output_spacing,
                closed,
            )
        )

        out_result = (
            dense_resample_final_path(
                out_dense,
                args.output_spacing,
                closed,
            )
        )

        return (
            in_result,
            out_result,
        )

    (
        (
            in_dense,
            initial_in_spacing,
        ),
        (
            out_dense,
            initial_out_spacing,
        ),
    ) = run_silent_step(
        f"Dense {args.output_spacing:.2f} m 재샘플링",
        initial_resampling,
    )

    # --------------------------------------------------------
    # 표시용 차선
    # --------------------------------------------------------

    resampled_lines = result.get(
        "resampled_lines",
        {},
    )

    if (
        line_count == 3
        and bool(
            metadata.get(
                "track_lines_applied_to_final_roi",
                False,
            )
        )
    ):
        display_lines = {
            f"{name.upper()}_TRACK": np.asarray(
                points,
                dtype=np.float64,
            )
            for name, points
            in resampled_lines.items()
        }
    elif (
        line_count == 3
        and bool(
            metadata.get(
                "offset_applied_to_final_roi",
                False,
            )
        )
    ):
        display_lines = {}
        for name, points in resampled_lines.items():
            label = name.upper()
            if name.lower() in ("left", "right"):
                label = f"{name.upper()}_OFFSET"
            display_lines[label] = np.asarray(
                points,
                dtype=np.float64,
            )
    else:
        display_lines = {
            name.upper(): np.asarray(
                points,
                dtype=np.float64,
            )
            for name, points
            in resampled_lines.items()
        }

    # Final view also shows the offset lines used before TRACK editing.
    if line_count == 3:
        for offset_name, offset_file in (
            ("LEFT_OFFSET", "left_offset.csv"),
            ("RIGHT_OFFSET", "right_offset.csv"),
        ):
            offset_path = os.path.join(
                data_dir,
                offset_file,
            )

            if os.path.exists(offset_path):
                try:
                    offset_points, _ = load_line_csv(
                        offset_path
                    )

                    display_lines[offset_name] = prepare_polyline(
                        offset_points,
                        closed,
                    )
                except Exception as exc:
                    print(
                        f"[WARN] {offset_file} display load failed: {exc}"
                    )

    if line_count == 3:
        if bool(
            metadata.get(
                "track_lines_applied_to_final_roi",
                False,
            )
        ):
            in_label = (
                "IN = LEFT_TRACK-MIDDLE_TRACK center"
            )

            out_label = (
                "OUT = MIDDLE_TRACK-RIGHT_TRACK center"
            )
        elif bool(
            metadata.get(
                "offset_applied_to_final_roi",
                False,
            )
        ):
            in_label = (
                "IN = LEFT_OFFSET-MIDDLE center"
            )

            out_label = (
                "OUT = MIDDLE-RIGHT_OFFSET center"
            )
        else:
            in_label = (
                "IN = LEFT-MIDDLE center"
            )

            out_label = (
                "OUT = MIDDLE-RIGHT center"
            )

    elif line_count == 4:
        in_label = (
            "IN = LEFT-MIDDLE1 center"
        )

        out_label = (
            "OUT = MIDDLE2-RIGHT center"
        )

    else:
        print(
            "[FAIL] Line mode 확인"
        )
        print(
            f"       원인: Unsupported line_count: {line_count}"
        )
        raise PipelineStepError(
            "Line mode 확인"
        )

    # --------------------------------------------------------
    # 4. [DISABLED] Dense 수동 직선/곡선 편집
    #
    # 기존 10) IN/OUT Straight Editor
    # 기존 11) IN/OUT Curve Editor
    # 는 현재 사용하지 않는다.
    # --------------------------------------------------------
    edited_in = in_dense.copy()
    edited_out = out_dense.copy()

    # --------------------------------------------------------
    # 5. 직선/곡선 편집 후 최종 0.30 m 재샘플링
    # --------------------------------------------------------

    def final_resampling():
        in_result = (
            dense_resample_final_path(
                edited_in,
                args.output_spacing,
                closed,
            )
        )

        out_result = (
            dense_resample_final_path(
                edited_out,
                args.output_spacing,
                closed,
            )
        )

        return (
            in_result,
            out_result,
        )

    (
        (
            edited_in,
            final_in_spacing,
        ),
        (
            edited_out,
            final_out_spacing,
        ),
    ) = run_silent_step(
        f"최종 Dense {args.output_spacing:.2f} m 재샘플링",
        final_resampling,
    )

    # --------------------------------------------------------
    # 6. ROI radius 계산
    # --------------------------------------------------------

    if bool(
        result.get(
            "metadata",
            {},
        ).get(
            "manual_line_straightening",
            False,
        )
    ):
        raw_lines = run_silent_step(
            "수정 차선 데이터 로드",
            dense_load_corrected_boundaries_from_result,
            result,
            closed,
        )

    else:
        raw_lines = run_silent_step(
            "원본 차선 데이터 로드",
            dense_load_raw_boundaries,
            data_dir,
            line_count,
            closed,
        )

    (
        in_info,
        out_info,
    ) = run_silent_step(
        "ROI 반지름 계산",
        dense_calculate_roi_info,
        in_dense=edited_in,
        out_dense=edited_out,
        raw_lines=raw_lines,
        line_count=line_count,
        closed=closed,
    )

    return {
        "in_info": in_info,
        "out_info": out_info,
        "display_lines": display_lines,
        "in_label": in_label,
        "out_label": out_label,
    }


# ============================================================
# 13-2. Recorded GPS/ODOM -> Resample -> Straight Edit -> RAW
# ============================================================

def save_processed_record_line_csv(
    points: np.ndarray,
    output_path: str,
    frame_id: str,
) -> None:
    """
    재샘플링/직선 보간된 최종 차선을 *_raw.csv로 저장한다.

    최종 점은 실제 센서 측정점과 1:1 대응하지 않으므로
    stamp는 빈 값으로 둔다.
    z는 Track ROI 기하 계산에서 사용하지 않으므로 0.0으로 저장한다.
    """
    points = np.asarray(
        points,
        dtype=np.float64,
    )

    if len(points) < 2:
        raise ValueError(
            "최종 저장할 차선 좌표가 2개 미만입니다."
        )

    os.makedirs(
        os.path.dirname(
            os.path.abspath(
                output_path
            )
        ),
        exist_ok=True,
    )

    with open(
        output_path,
        "w",
        newline="",
        encoding="utf-8",
    ) as fp:
        writer = csv.writer(
            fp
        )

        writer.writerow(
            [
                "x",
                "y",
                "z",
                "stamp",
                "frame_id",
            ]
        )

        for point in points:
            writer.writerow(
                [
                    f"{float(point[0]):.12f}",
                    f"{float(point[1]):.12f}",
                    "0.000000000000",
                    "",
                    frame_id,
                ]
            )


def record_line_interactive_editor(
    line_name: str,
    points: np.ndarray,
    closed: bool,
    context_initial_lines: Optional[Dict[str, np.ndarray]] = None,
    context_current_lines: Optional[Dict[str, np.ndarray]] = None,
    editor_title: Optional[str] = None,
    background_lines: Optional[Dict[str, np.ndarray]] = None,
) -> Tuple[
    np.ndarray,
    bool,
]:
    """
    record 종료 후 한 개의 LEFT/MIDDLE/RIGHT 라인을 직접 수정한다.

    Left click x2:
        두 waypoint 사이를 직선으로 보간한다.

    Ctrl+Z:
        Undo

    Ctrl+Y:
        Redo

    Enter:
        편집 결과 확정

    Esc / 창 닫기:
        수동 편집을 취소하고 최초 재샘플링 결과를 사용
    """
    points = np.asarray(
        points,
        dtype=np.float64,
    )

    original = points.copy()

    if closed:
        state_points = dense_open_path(
            points
        )
    else:
        state_points = points.copy()

    if len(state_points) < 2:
        raise ValueError(
            "직선 보간 편집용 waypoint가 2개 미만입니다."
        )

    state = {
        "points": state_points,
        "first_index": None,
        "finalized": False,
        "cancelled": False,
    }

    undo_stack = []
    redo_stack = []

    fig, ax = plt.subplots(
        figsize=(14, 10)
    )

    def drawable():
        if closed:
            return dense_close_path(
                state["points"]
            )

        return state["points"]

    draw = drawable()

    # Show LEFT / MIDDLE / RIGHT together in every individual editor.
    # The active line stays interactive; the other two are context only.
    context_colors = {
        "left": line_color("LEFT"),
        "middle": line_color("MIDDLE"),
        "right": line_color("RIGHT"),
    }

    active_key = str(line_name).lower()

    # Optional arbitrary reference/background lines.
    # Used by Driving Path Builder so IN_DENSE / MIDDLE_RAW / OUT_DENSE
    # and LEFT/RIGHT offset can all remain visible while editing PATH_YEAH.
    if background_lines:
        for background_name, background_points in background_lines.items():
            background_points = np.asarray(
                background_points,
                dtype=np.float64,
            )

            if len(background_points) < 2:
                continue

            if closed:
                background_points = dense_close_path(
                    dense_open_path(background_points)
                )

            background_style = line_visual_style(
                background_name,
                initial=True,
            )

            ax.plot(
                background_points[:, 0],
                background_points[:, 1],
                linestyle=background_style["linestyle"],
                linewidth=background_style["linewidth"],
                alpha=background_style["alpha"],
                color=background_style["color"],
                label=str(background_name),
                zorder=0,
            )

    if context_initial_lines is not None or context_current_lines is not None:
        all_names = ["left", "middle", "right"]

        for context_name in all_names:
            if context_name == active_key:
                continue

            color = context_colors.get(context_name, None)

            if (
                context_initial_lines is not None
                and context_name in context_initial_lines
            ):
                context_initial = np.asarray(
                    context_initial_lines[context_name],
                    dtype=np.float64,
                )
                if closed:
                    context_initial = dense_close_path(
                        dense_open_path(context_initial)
                    )

                initial_semantic = (
                    f"{context_name.upper()}_OFFSET"
                    if context_name in ("left", "right")
                    else f"{context_name.upper()}_INITIAL"
                )
                initial_style = line_visual_style(
                    initial_semantic,
                    initial=(context_name == "middle"),
                )
                ax.plot(
                    context_initial[:, 0],
                    context_initial[:, 1],
                    linestyle=initial_style["linestyle"],
                    linewidth=initial_style["linewidth"],
                    alpha=initial_style["alpha"],
                    color=initial_style["color"],
                    label=initial_semantic,
                    zorder=1,
                )

            if (
                context_current_lines is not None
                and context_name in context_current_lines
            ):
                context_current = np.asarray(
                    context_current_lines[context_name],
                    dtype=np.float64,
                )
                if closed:
                    context_current = dense_close_path(
                        dense_open_path(context_current)
                    )

                initial_candidate = None
                if (
                    context_initial_lines is not None
                    and context_name in context_initial_lines
                ):
                    initial_candidate = np.asarray(
                        context_initial_lines[context_name],
                        dtype=np.float64,
                    )
                    if closed:
                        initial_candidate = dense_close_path(
                            dense_open_path(initial_candidate)
                        )

                is_modified_track = (
                    initial_candidate is None
                    or initial_candidate.shape != context_current.shape
                    or not np.allclose(
                        initial_candidate,
                        context_current,
                        atol=1.0e-10,
                        rtol=0.0,
                    )
                )

                current_semantic = (
                    f"{context_name.upper()}_TRACK"
                    if is_modified_track
                    else (
                        f"{context_name.upper()}_OFFSET"
                        if context_name in ("left", "right")
                        else "MIDDLE"
                    )
                )
                current_style = line_visual_style(
                    current_semantic
                )
                ax.plot(
                    context_current[:, 0],
                    context_current[:, 1],
                    linestyle=current_style["linestyle"],
                    linewidth=current_style["linewidth"],
                    alpha=current_style["alpha"],
                    color=current_style["color"],
                    label=current_semantic,
                    zorder=2,
                )

    # Keep the line at editor entry fixed so the user can compare
    # the initial geometry with the currently modified geometry.
    initial_draw = (
        dense_close_path(dense_open_path(original))
        if closed
        else original.copy()
    )

    active_color = context_colors.get(active_key, None)
    active_initial_semantic = (
        f"{line_name.upper()}_OFFSET"
        if active_key in ("left", "right")
        else f"{line_name.upper()}_INITIAL"
    )
    active_initial_style = line_visual_style(
        active_initial_semantic,
        initial=(active_key == "middle"),
    )
    active_track_style = line_visual_style(
        f"{line_name.upper()}_TRACK",
        active=True,
    )

    initial_line_artist, = ax.plot(
        initial_draw[:, 0],
        initial_draw[:, 1],
        linewidth=active_initial_style["linewidth"],
        linestyle=active_initial_style["linestyle"],
        alpha=active_initial_style["alpha"],
        color=active_initial_style["color"],
        label=active_initial_semantic,
        zorder=3,
    )

    line_artist, = ax.plot(
        draw[:, 0],
        draw[:, 1],
        linewidth=active_track_style["linewidth"],
        linestyle=active_track_style["linestyle"],
        alpha=active_track_style["alpha"],
        color=active_track_style["color"],
        label=f"{line_name.upper()}_TRACK editing",
        zorder=5,
    )

    point_artist = ax.scatter(
        state["points"][:, 0],
        state["points"][:, 1],
        s=8,
        alpha=0.35,
        label="Modified waypoints",
        zorder=5,
    )

    selected_artist, = ax.plot(
        [],
        [],
        marker="o",
        linestyle="None",
        markersize=9,
        label="First selected point",
        zorder=10,
    )

    status_text = ax.text(
        0.01,
        0.01,
        (
            "Left click x2: straighten segment | "
            "Enter: straight 확정 후 Curve 단계 | Esc: cancel edits | "
            "Ctrl+Z: undo | Ctrl+Y: redo"
        ),
        transform=ax.transAxes,
        fontsize=9,
        verticalalignment="bottom",
    )

    ax.set_aspect(
        "equal",
        adjustable="box",
    )

    ax.grid(
        True
    )

    ax.legend(
        loc="best"
    )

    ax.set_xlabel(
        "x [m]"
    )

    ax.set_ylabel(
        "y [m]"
    )

    window_title = (
        str(editor_title)
        if editor_title
        else f"{line_name.upper()} RAW Line Editor"
    )

    ax.set_title(
        window_title + "\n"
        "Dashed = initial | Solid = modified | "
        "Select two points to straighten a segment"
    )

    fig.tight_layout()

    def set_status(
        message: str,
    ):
        status_text.set_text(
            message
        )
        fig.canvas.draw_idle()

    def clear_selection():
        state[
            "first_index"
        ] = None

        selected_artist.set_data(
            [],
            [],
        )

        fig.canvas.draw_idle()

    def refresh():
        current = drawable()

        line_artist.set_data(
            current[:, 0],
            current[:, 1],
        )

        point_artist.set_offsets(
            state["points"]
        )

        ax.relim()
        ax.autoscale_view()
        fig.canvas.draw_idle()

    def nearest_index(
        x: float,
        y: float,
    ) -> int:
        query = np.asarray(
            [x, y],
            dtype=np.float64,
        )

        distances2 = np.sum(
            (
                state["points"]
                -
                query
            )
            ** 2,
            axis=1,
        )

        return int(
            np.argmin(
                distances2
            )
        )

    def apply_edit(
        index1: int,
        index2: int,
    ):
        if index1 == index2:
            set_status(
                "같은 waypoint가 두 번 선택되었습니다. 다시 선택하십시오."
            )
            return

        indices = dense_segment_indices(
            index1,
            index2,
            len(
                state["points"]
            ),
            closed,
        )

        if len(indices) < 2:
            set_status(
                "선택 구간이 너무 짧습니다."
            )
            return

        before = state[
            "points"
        ][
            indices
        ].copy()

        start_point = state[
            "points"
        ][
            indices[0]
        ].copy()

        end_point = state[
            "points"
        ][
            indices[-1]
        ].copy()

        after = np.linspace(
            start_point,
            end_point,
            len(indices),
        )

        state[
            "points"
        ][
            indices
        ] = after

        undo_stack.append(
            {
                "indices": indices.copy(),
                "before": before,
                "after": after.copy(),
            }
        )

        redo_stack.clear()

        refresh()

        print(
            f"[EDIT] {line_name.upper()}: "
            f"{len(indices)} waypoints straightened."
        )

        set_status(
            f"{line_name.upper()} 직선 보간 완료. "
            "추가 수정하거나 Enter를 누르십시오."
        )

    def undo_once():
        if not undo_stack:
            set_status(
                "Undo할 수정이 없습니다."
            )
            return

        operation = undo_stack.pop()

        state[
            "points"
        ][
            operation["indices"]
        ] = operation[
            "before"
        ]

        redo_stack.append(
            operation
        )

        clear_selection()
        refresh()

        set_status(
            "직전 수정이 취소되었습니다."
        )

    def redo_once():
        if not redo_stack:
            set_status(
                "Redo할 수정이 없습니다."
            )
            return

        operation = redo_stack.pop()

        state[
            "points"
        ][
            operation["indices"]
        ] = operation[
            "after"
        ]

        undo_stack.append(
            operation
        )

        clear_selection()
        refresh()

        set_status(
            "취소했던 수정이 다시 적용되었습니다."
        )

    def on_click(
        event,
    ):
        if (
            state["finalized"]
            or
            state["cancelled"]
        ):
            return

        if (
            event.inaxes is not ax
            or
            event.button != 1
            or
            event.xdata is None
            or
            event.ydata is None
        ):
            return

        toolbar = getattr(
            fig.canvas,
            "toolbar",
            None,
        )

        toolbar_mode = (
            getattr(
                toolbar,
                "mode",
                "",
            )
            if toolbar is not None
            else ""
        )

        if toolbar_mode:
            return

        index = nearest_index(
            float(
                event.xdata
            ),
            float(
                event.ydata
            ),
        )

        if state[
            "first_index"
        ] is None:
            state[
                "first_index"
            ] = index

            point = state[
                "points"
            ][
                index
            ]

            selected_artist.set_data(
                [point[0]],
                [point[1]],
            )

            set_status(
                f"첫 점 선택: {line_name.upper()}[{index}]. "
                "두 번째 점을 선택하십시오."
            )
            return

        first_index = int(
            state[
                "first_index"
            ]
        )

        clear_selection()

        apply_edit(
            first_index,
            index,
        )

    def on_key(
        event,
    ):
        key = (
            event.key
            or
            ""
        ).lower()

        if key in (
            "ctrl+z",
            "control+z",
        ):
            undo_once()
            return

        if key in (
            "ctrl+y",
            "control+y",
        ):
            redo_once()
            return

        if key in (
            "enter",
            "return",
        ):
            state[
                "finalized"
            ] = True

            clear_selection()

            print(
                f"[FINALIZE] {line_name.upper()} line editing confirmed."
            )

            plt.close(
                fig
            )
            return

        if key in (
            "escape",
            "esc",
        ):
            state[
                "cancelled"
            ] = True

            print(
                f"[CANCEL] {line_name.upper()} manual edits cancelled."
            )

            plt.close(
                fig
            )

    def on_close(
        _event,
    ):
        if not state[
            "finalized"
        ]:
            state[
                "cancelled"
            ] = True

    fig.canvas.mpl_connect(
        "button_press_event",
        on_click,
    )

    fig.canvas.mpl_connect(
        "key_press_event",
        on_key,
    )

    fig.canvas.mpl_connect(
        "close_event",
        on_close,
    )

    print()
    print(
        "============================================"
    )
    print(
        window_title
    )
    print(
        "============================================"
    )
    print(
        "Left click x2 : 두 점 사이 직선 보간"
    )
    print(
        "Ctrl+Z        : Undo"
    )
    print(
        "Ctrl+Y        : Redo"
    )
    print(
        "Enter         : 직선 수정 확정 후 Curve 단계"
    )
    print(
        "Esc           : 수정 취소, 재샘플링 결과 사용"
    )
    print(
        "============================================"
    )

    plt.show()

    if (
        state["cancelled"]
        or
        not state["finalized"]
    ):
        return (
            original,
            False,
        )

    edited = (
        dense_close_path(
            state["points"]
        )
        if closed
        else state["points"].copy()
    )

    return (
        edited,
        True,
    )


def process_recorded_line_to_raw(
    line_name: str,
    recorded_path: str,
    raw_output_path: str,
    target_spacing: float,
    closed: bool,
) -> None:
    """
    *_recorded.csv
        -> x/y 로드
        -> 균일 간격 재샘플링
        -> interactive straight edit
        -> interactive cubic-spline curve edit
        -> 전체 라인 다시 균일 간격 재샘플링
        -> *_raw.csv 저장
    """
    if target_spacing <= 0.0:
        raise ValueError(
            "--record-spacing은 0보다 커야 합니다."
        )

    recorded_xy, frame_id = load_line_csv(
        recorded_path
    )

    print()
    print(
        "============================================"
    )
    print(
        f"{line_name.upper()} Record Post-Processing"
    )
    print(
        "============================================"
    )
    print(
        f"Original : {recorded_path}"
    )
    print(
        f"Raw      : {raw_output_path}"
    )
    print(
        f"Spacing  : {target_spacing:.3f} m"
    )
    print(
        f"Track    : {'CLOSED' if closed else 'OPEN'}"
    )
    print(
        "============================================"
    )

    # 최초 센서 데이터 자체는 건드리지 않는다.
    prepared = prepare_polyline(
        recorded_xy,
        closed,
    )

    initial_resampled, actual_spacing = (
        dense_resample_final_path(
            prepared,
            target_spacing,
            closed,
        )
    )

    print(
        f"[OK] 최초 재샘플링: "
        f"{len(recorded_xy)} -> {len(initial_resampled)} points "
        f"(actual spacing={actual_spacing:.6f} m)"
    )

    edited, edited_flag = record_line_interactive_editor(
        line_name=line_name,
        points=initial_resampled,
        closed=closed,
    )

    curve_lines, curve_edited_flag = curve_interactive_editor(
        lines={
            line_name.upper(): edited,
        },
        closed=closed,
        no_show=False,
        title=f"{line_name.upper()} Curve Editor",
        background_lines=None,
        initial_reference_lines={
            line_name.upper(): initial_resampled,
        },
    )

    edited = curve_lines[
        line_name.upper()
    ]

    # 직선/곡선 보정 후 연결부 waypoint 간격도 다시 균일하게 만든다.
    final_resampled, final_spacing = (
        dense_resample_final_path(
            edited,
            target_spacing,
            closed,
        )
    )

    save_processed_record_line_csv(
        points=final_resampled,
        output_path=raw_output_path,
        frame_id=frame_id,
    )

    print()
    print(
        "============================================"
    )
    print(
        f"[OK] {line_name.upper()} RAW 저장 완료"
    )
    print(
        f"     원본 GPS/ODOM : {recorded_path}"
    )
    print(
        f"     최종 RAW      : {raw_output_path}"
    )
    print(
        f"     직선 수정     : {'적용' if edited_flag else '미적용'}"
    )
    print(
        f"     곡선 수정     : {'적용' if curve_edited_flag else '미적용'}"
    )
    print(
        f"     최종 points   : {len(final_resampled)}"
    )
    print(
        f"     최종 spacing  : {final_spacing:.6f} m"
    )
    print(
        "============================================"
    )



# ============================================================
# 13-3. Existing RAW -> Resample -> Straight Edit -> RAW overwrite
# ============================================================

def preprocess_existing_raw_line_before_polygon(
    line_name: str,
    raw_path: str,
    target_spacing: float,
    closed: bool,
    no_show: bool,
    context_initial_lines: Optional[Dict[str, np.ndarray]] = None,
    context_current_lines: Optional[Dict[str, np.ndarray]] = None,
) -> np.ndarray:
    """
    Polygon 생성 전에 기존 *_raw.csv를 직접 정리한다.

    순서:
        1) 기존 *_raw.csv 로드
        2) target_spacing으로 1차 재샘플링
        3) 수동 직선 보간
        4) 수동 cubic-spline 곡선 보간
        5) target_spacing으로 다시 재샘플링
        6) 같은 *_raw.csv에 덮어쓰기

    반환:
        최종 XY 좌표
    """
    if target_spacing <= 0.0:
        raise ValueError(
            "raw line 재샘플링 간격은 0보다 커야 합니다."
        )

    points, frame_id = load_line_csv(
        raw_path
    )

    prepared = prepare_polyline(
        points,
        closed,
    )

    initial_resampled, initial_spacing = (
        dense_resample_final_path(
            prepared,
            target_spacing,
            closed,
        )
    )

    print()
    print(
        "============================================"
    )
    print(
        f"{line_name.upper()} PRE-POLYGON LINE EDIT"
    )
    print(
        "============================================"
    )
    print(
        f"Input   : {raw_path}"
    )
    print(
        f"Points  : {len(points)} -> {len(initial_resampled)}"
    )
    print(
        f"Spacing : {initial_spacing:.6f} m"
    )
    print(
        "조작    : 두 점 클릭 -> 직선 보간"
    )
    print(
        "          Enter -> 저장 후 다음 차선"
    )
    print(
        "          Ctrl+Z / Ctrl+Y -> Undo / Redo"
    )
    print(
        "============================================"
    )

    if no_show:
        edited = initial_resampled.copy()
        edited_flag = False
        curve_edited_flag = False

    else:
        edited, edited_flag = (
            record_line_interactive_editor(
                line_name=line_name,
                points=initial_resampled,
                closed=closed,
                context_initial_lines=context_initial_lines,
                context_current_lines=context_current_lines,
            )
        )

        curve_background_lines = {}

        for context_name in ("left", "middle", "right"):
            if context_name == str(line_name).lower():
                continue

            if (
                context_initial_lines is not None
                and context_name in context_initial_lines
            ):
                curve_background_lines[
                    f"{context_name.upper()} initial"
                ] = context_initial_lines[context_name]

            if (
                context_current_lines is not None
                and context_name in context_current_lines
            ):
                curve_background_lines[
                    f"{context_name.upper()} current"
                ] = context_current_lines[context_name]

        curve_lines, curve_edited_flag = curve_interactive_editor(
            lines={
                line_name.upper(): edited,
            },
            closed=closed,
            no_show=False,
            title=f"{line_name.upper()} PRE-POLYGON Curve Editor",
            background_lines=(
                curve_background_lines
                if curve_background_lines
                else None
            ),
            initial_reference_lines={
                line_name.upper(): initial_resampled,
            },
        )

        edited = curve_lines[
            line_name.upper()
        ]

    # 직선/곡선 보정 후 구간 경계에서 점 간격이 달라질 수 있으므로
    # 최종 저장 전에 전체 라인을 다시 균일 간격으로 재샘플링한다.
    final_resampled, final_spacing = (
        dense_resample_final_path(
            edited,
            target_spacing,
            closed,
        )
    )

    # 사용자가 요청한 대로 기존 *_raw.csv 자체를 수정한다.
    save_processed_record_line_csv(
        points=final_resampled,
        output_path=raw_path,
        frame_id=frame_id,
    )

    print()
    print(
        f"[OK] {line_name.upper()} 저장 완료"
    )
    print(
        f"     CSV     : {raw_path}"
    )
    print(
        f"     직선보간: {'적용' if edited_flag else '미적용'}"
    )
    print(
        f"     곡선보간: {'적용' if curve_edited_flag else '미적용'}"
    )
    print(
        f"     Points  : {len(final_resampled)}"
    )
    print(
        f"     Spacing : {final_spacing:.6f} m"
    )

    return final_resampled


def preprocess_three_raw_lines_before_polygon(
    data_dir: str,
    target_spacing: float,
    closed: bool,
    no_show: bool,
) -> None:
    """
    3-Line Polygon 선택 직전에 반드시 다음 순서로 실행:

        LEFT
          Enter
        MIDDLE
          Enter
        RIGHT
          Enter
        Polygon 선택 시작

    각각의 최종 결과는:
        left_raw.csv
        middle_raw.csv
        right_raw.csv

    에 즉시 덮어쓴다.
    """
    line_order = [
        "left",
        "middle",
        "right",
    ]

    print()
    print(
        "============================================================"
    )
    print(
        "PRE-POLYGON RAW LINE EDIT"
    )
    print(
        "============================================================"
    )
    print(
        "순서: LEFT -> MIDDLE -> RIGHT"
    )
    print(
        f"최종 재샘플링 간격: {target_spacing:.3f} m"
    )
    print(
        "각 창에서 Enter를 누르면 CSV 저장 후 다음 차선으로 이동합니다."
    )
    print(
        "RIGHT 완료 후 Polygon 선택 단계가 시작됩니다."
    )
    print(
        "============================================================"
    )

    # Load all three lines before the first editor opens so every
    # LEFT / MIDDLE / RIGHT editor can display the complete track context.
    context_initial_lines = {}
    context_current_lines = {}

    for context_name in line_order:
        context_path = os.path.join(
            data_dir,
            f"{context_name}_raw.csv",
        )

        if not os.path.exists(context_path):
            raise FileNotFoundError(
                f"{context_name.upper()} RAW 파일을 찾을 수 없습니다: "
                f"{context_path}"
            )

        context_points, _ = load_line_csv(context_path)
        context_prepared = prepare_polyline(
            context_points,
            closed,
        )
        context_resampled, _ = dense_resample_final_path(
            context_prepared,
            target_spacing,
            closed,
        )

        context_initial_lines[context_name] = context_resampled.copy()
        context_current_lines[context_name] = context_resampled.copy()

    for line_index, line_name in enumerate(
        line_order,
        start=1,
    ):
        raw_path = os.path.join(
            data_dir,
            f"{line_name}_raw.csv",
        )

        print()
        print(
            f"[{line_index}/3] {line_name.upper()} 편집 시작"
        )

        final_line = preprocess_existing_raw_line_before_polygon(
            line_name=line_name,
            raw_path=raw_path,
            target_spacing=target_spacing,
            closed=closed,
            no_show=no_show,
            context_initial_lines=context_initial_lines,
            context_current_lines=context_current_lines,
        )

        # Subsequent editors immediately show the modifications already
        # confirmed on earlier lines while preserving all original lines.
        context_current_lines[line_name] = np.asarray(
            final_line,
            dtype=np.float64,
        ).copy()

    print()
    print(
        "============================================================"
    )
    print(
        "[OK] LEFT / MIDDLE / RIGHT 전처리 완료"
    )
    print(
        "     이제 수정된 CSV를 기준으로 Polygon을 생성합니다."
    )
    print(
        "============================================================"
    )


# ============================================================
# 13-9. Driving Path Builder
# ============================================================

def detect_path_builder_closed(
    candidate: np.ndarray,
    track_roi_path: Optional[str],
) -> bool:
    """
    Path 생성 시 폐곡선 여부를 결정한다.

    우선순위:
      1) track_roi.json metadata.closed_track
      2) candidate의 first == last 여부
    """
    if (
        track_roi_path
        and os.path.exists(track_roi_path)
    ):
        try:
            with open(
                track_roi_path,
                "r",
                encoding="utf-8",
            ) as fp:
                data = json.load(fp)

            value = data.get(
                "metadata",
                {},
            ).get(
                "closed_track",
                None,
            )

            if isinstance(value, bool):
                return value
        except Exception:
            pass

    points = np.asarray(
        candidate,
        dtype=np.float64,
    )

    return bool(
        len(points) >= 2
        and np.linalg.norm(
            points[0] - points[-1]
        ) <= 1.0e-8
    )


def load_path_builder_boundaries(
    data_dir: str,
) -> Dict[str, np.ndarray]:
    """
    Path Builder에서 표시할 3개 경계선을 로드한다.

    LEFT  : left_offset.csv
    MIDDLE: middle_raw.csv
    RIGHT : right_offset.csv
    """
    file_map = {
        "left": "left_offset.csv",
        "middle": "middle_raw.csv",
        "right": "right_offset.csv",
    }

    output = {}

    for name, filename in file_map.items():
        path = os.path.join(
            data_dir,
            filename,
        )

        points, _ = load_line_csv(
            path
        )

        output[name] = np.asarray(
            points,
            dtype=np.float64,
        )

    return output



def visualize_final_driving_path(
    path_name: str,
    final_path: np.ndarray,
    background_lines: Dict[str, np.ndarray],
    no_show: bool,
) -> None:
    """
    Driving Path Builder 마지막 결과 확인용 창.

    표시:
      - 전달받은 경계/참조선
      - 최종 재샘플링된 driving path

    Enter:
      창 종료
    """
    if no_show:
        return

    final_path = np.asarray(
        final_path,
        dtype=np.float64,
    )

    fig, ax = plt.subplots(
        figsize=(15, 11)
    )

    for name, points in background_lines.items():
        points = np.asarray(
            points,
            dtype=np.float64,
        )

        if len(points) < 2:
            continue

        style = line_visual_style(name)

        ax.plot(
            points[:, 0],
            points[:, 1],
            color=style["color"],
            linestyle=style["linestyle"],
            linewidth=max(1.0, float(style["linewidth"]) * 0.85),
            alpha=min(0.80, float(style["alpha"])),
            label=name,
            zorder=3,
        )

    ax.plot(
        final_path[:, 0],
        final_path[:, 1],
        color="black",
        linestyle="-",
        linewidth=3.2,
        alpha=1.0,
        label=path_name.upper(),
        zorder=12,
    )

    ax.scatter(
        final_path[:, 0],
        final_path[:, 1],
        s=8,
        color="black",
        alpha=0.55,
        zorder=13,
    )

    ax.set_aspect(
        "equal",
        adjustable="box",
    )
    ax.grid(True)
    ax.set_xlabel("x [m]")
    ax.set_ylabel("y [m]")
    ax.set_title(
        f"Final {path_name.upper()}\nEnter: close"
    )
    ax.legend(
        loc="best",
        fontsize=8,
    )
    ax.autoscale_view()
    fig.tight_layout()

    def on_key(event):
        key = (
            event.key
            or ""
        ).lower()

        if key in (
            "enter",
            "return",
        ):
            plt.close(fig)

    fig.canvas.mpl_connect(
        "key_press_event",
        on_key,
    )

    print(
        f"[INFO] Final {path_name.upper()} preview: press Enter to close."
    )
    plt.show()

def path_builder_edit_one_path(
    path_name: str,
    initial_path: np.ndarray,
    boundaries: Dict[str, np.ndarray],
    output_path: str,
    path_spacing: float,
    closed: bool,
    no_show: bool,
) -> np.ndarray:
    """
    한 개 driving path를
      1) Straight-Line Editor
      2) Curve Editor
      3) 최종 균일 재샘플링
      4) x,y CSV 저장
    순서로 생성한다.
    """
    initial_path = np.asarray(
        initial_path,
        dtype=np.float64,
    )

    if len(initial_path) < 3:
        raise ValueError(
            f"{path_name}: Path waypoint가 3개 미만입니다."
        )

    # Straight editor에서는 모든 경계를 context로 표시한다.
    context_initial = {
        name: np.asarray(
            points,
            dtype=np.float64,
        ).copy()
        for name, points
        in boundaries.items()
    }

    context_current = {
        name: np.asarray(
            points,
            dtype=np.float64,
        ).copy()
        for name, points
        in boundaries.items()
    }

    straight_path, _ = record_line_interactive_editor(
        line_name=path_name,
        points=initial_path,
        closed=closed,
        context_initial_lines=context_initial,
        context_current_lines=context_current,
        editor_title=(
            f"{path_name.upper()} Straight-Line Editor"
        ),
    ) if not no_show else (
        initial_path.copy(),
        False,
    )

    background_lines = {
        "LEFT_OFFSET": boundaries["left"],
        "MIDDLE_RAW": boundaries["middle"],
        "RIGHT_OFFSET": boundaries["right"],
    }

    if str(path_name).lower().endswith("_in"):
        selection_reference_lines = {
            "LEFT_OFFSET": np.asarray(
                boundaries["left"],
                dtype=np.float64,
            ).copy(),
            "MIDDLE_RAW": np.asarray(
                boundaries["middle"],
                dtype=np.float64,
            ).copy(),
        }
    elif str(path_name).lower().endswith("_out"):
        selection_reference_lines = {
            "MIDDLE_RAW": np.asarray(
                boundaries["middle"],
                dtype=np.float64,
            ).copy(),
            "RIGHT_OFFSET": np.asarray(
                boundaries["right"],
                dtype=np.float64,
            ).copy(),
        }
    else:
        selection_reference_lines = {
            "LEFT_OFFSET": np.asarray(
                boundaries["left"],
                dtype=np.float64,
            ).copy(),
            "MIDDLE_RAW": np.asarray(
                boundaries["middle"],
                dtype=np.float64,
            ).copy(),
            "RIGHT_OFFSET": np.asarray(
                boundaries["right"],
                dtype=np.float64,
            ).copy(),
        }

    curve_result, _ = curve_interactive_editor(
        lines={
            path_name: straight_path,
        },
        closed=closed,
        no_show=no_show,
        title=(
            f"{path_name.upper()} Curve Editor"
        ),
        background_lines=background_lines,
        initial_reference_lines={
            path_name: initial_path,
        },
        selection_reference_lines=selection_reference_lines,
        editable_selection_alias=path_name.upper(),
        prefer_dynamic_selection=True,
    )

    final_path = np.asarray(
        curve_result[path_name],
        dtype=np.float64,
    )

    final_path, actual_spacing = (
        dense_resample_final_path(
            final_path,
            path_spacing,
            closed,
        )
    )

    save_path_xy_csv(
        info={
            "points": final_path,
        },
        path=output_path,
    )

    print(
        f"[OK] {path_name.upper()} saved: {output_path}"
    )
    print(
        f"     waypoints={len(final_path)}, "
        f"spacing={actual_spacing:.6f} m"
    )

    visualize_final_driving_path(
        path_name=path_name,
        final_path=final_path,
        background_lines=background_lines,
        no_show=no_show,
    )

    return final_path


def build_qualifying_curve_section_context(
    track_roi_path: str,
    selectable_lines: Dict[str, np.ndarray],
    curve_spacing: float = 0.05,
) -> Dict:
    """
    Build polygon/section information for qualifying PATH_YEAH curve editing.

    Each track_order is treated as one longitudinal section composed of the
    paired IN/OUT polygons. For each section we build three reference paths:
      IN_DENSE   : center of LEFT <-> MIDDLE
      MIDDLE_RAW : MIDDLE section itself
      OUT_DENSE  : center of MIDDLE <-> RIGHT

    Every selectable source waypoint is then assigned to the closest
    track_order section. The Curve Editor uses this mapping to decide which
    polygon section contains each control point.
    """
    if not os.path.exists(track_roi_path):
        raise FileNotFoundError(
            f"track_roi.json not found for polygon section selection: {track_roi_path}"
        )

    with open(
        track_roi_path,
        "r",
        encoding="utf-8",
    ) as fp:
        data = json.load(fp)

    metadata = data.get("metadata", {})
    line_count = int(metadata.get("line_count", 0))

    if line_count != 3:
        raise ValueError(
            "Qualifying polygon-section main selection currently requires a 3-Line track_roi.json."
        )

    roi_sections = data.get("roi_sections", {})
    in_sections = {
        int(section["track_order"]): section
        for section in roi_sections.get("IN", [])
    }
    out_sections = {
        int(section["track_order"]): section
        for section in roi_sections.get("OUT", [])
    }

    orders = sorted(
        set(in_sections.keys())
        & set(out_sections.keys())
    )

    if not orders:
        raise ValueError(
            "No paired IN/OUT polygon sections were found in track_roi.json."
        )

    references = {}

    for order in orders:
        in_section = in_sections[order]
        out_section = out_sections[order]

        in_outer = np.asarray(
            in_section["outer_points"],
            dtype=np.float64,
        )
        middle = np.asarray(
            in_section["inner_points"],
            dtype=np.float64,
        )
        out_middle = np.asarray(
            out_section["inner_points"],
            dtype=np.float64,
        )
        out_outer = np.asarray(
            out_section["outer_points"],
            dtype=np.float64,
        )

        if len(middle) != len(out_middle) or np.max(
            np.linalg.norm(middle - out_middle, axis=1)
        ) > 1.0e-5:
            # Keep the IN-side MIDDLE section as the longitudinal reference.
            # This does not alter any saved ROI data.
            pass

        in_center, _ = dense_pair_section(
            in_outer,
            middle,
            in_section.get("section_type", "CURVE"),
            curve_spacing,
        )
        out_center, _ = dense_pair_section(
            out_middle,
            out_outer,
            out_section.get("section_type", "CURVE"),
            curve_spacing,
        )

        references[int(order)] = {
            "IN_DENSE": np.asarray(in_center, dtype=np.float64),
            "MIDDLE_RAW": np.asarray(middle, dtype=np.float64),
            "OUT_DENSE": np.asarray(out_center, dtype=np.float64),
        }

    polygons = {
        int(order): []
        for order in orders
    }

    for polygon in data.get("polygons", []):
        try:
            order = int(polygon.get("track_order", 0))
        except Exception:
            continue

        if order not in polygons:
            continue

        vertices = np.asarray(
            polygon.get("vertices", []),
            dtype=np.float64,
        )

        if vertices.ndim == 2 and vertices.shape[1] == 2 and len(vertices) >= 3:
            polygons[order].append(vertices)

    point_sections = {}

    for source_name, source_points in selectable_lines.items():
        source_points = np.asarray(
            source_points,
            dtype=np.float64,
        )

        source_key = str(source_name).upper()
        if source_key not in (
            "IN_DENSE",
            "MIDDLE_RAW",
            "OUT_DENSE",
        ):
            raise ValueError(
                f"Unsupported qualifying curve selection source: {source_name}"
            )

        section_distance_rows = []

        for order in orders:
            reference_line = references[int(order)][source_key]
            distances = dense_point_to_polyline_distances_numpy(
                source_points,
                reference_line,
            )
            section_distance_rows.append(distances)

        distance_matrix = np.vstack(section_distance_rows)
        nearest_positions = np.argmin(
            distance_matrix,
            axis=0,
        )

        point_sections[str(source_name)] = np.asarray(
            [orders[int(position)] for position in nearest_positions],
            dtype=np.int64,
        )

    return {
        "orders": [int(order) for order in orders],
        "references": references,
        "polygons": polygons,
        "point_sections": point_sections,
    }


def run_path_builder_mode(args):
    """
    Menu 5: Driving Path 생성.

    qualifying:
        초기 Path = middle_raw.csv

        Curve control-point selection:
          IN_DENSE / MIDDLE_RAW / OUT_DENSE / 현재 PATH_YEAH 중 어느 선에서든 선택 가능

        편집창 표시:
          LEFT_OFFSET / IN_DENSE / MIDDLE_RAW / OUT_DENSE / RIGHT_OFFSET

        출력 = path_yeah.csv

    final-in:
        경계 표시 = LEFT_OFFSET / MIDDLE_RAW / RIGHT_OFFSET
        초기 Path = in_dense.csv
        출력       = path_born_in.csv

    final-out:
        경계 표시 = LEFT_OFFSET / MIDDLE_RAW / RIGHT_OFFSET
        초기 Path = out_dense.csv
        출력       = path_born_out.csv
    """
    data_dir = os.path.abspath(
        args.data_dir
    )

    boundaries = load_path_builder_boundaries(
        data_dir
    )

    mode = str(
        args.path_mode
    ).lower().strip()

    # IMPORTANT: qualifying(PATH_YEAH) intentionally uses the v24 editor/flow.
    # final-in/final-out intentionally keep the v26 editor/flow.
    if mode == "qualifying":
        in_dense = load_existing_dense_xy(
            args.in_dense
        )

        middle_raw = np.asarray(
            boundaries["middle"],
            dtype=np.float64,
        ).copy()

        out_dense = load_existing_dense_xy(
            args.out_dense
        )

        # PATH_YEAH starts from MIDDLE_RAW. The Curve Editor can then pick
        # control points from IN_DENSE / MIDDLE_RAW / OUT_DENSE / current PATH_YEAH,
        # so there is no separate 1/2/3 initial-source menu anymore.
        initial_path = middle_raw.copy()
        source_label = "MIDDLE_RAW"

        closed = detect_path_builder_closed(
            initial_path,
            args.track_roi,
        )

        # Qualifying editor always shows every important reference line.
        # PATH_YEAH starts from MIDDLE_RAW, while the Curve Editor can select
        # control points from IN_DENSE / MIDDLE_RAW / OUT_DENSE / current PATH_YEAH.
        qualifying_background = {
            "LEFT_OFFSET": boundaries["left"],
            "IN_DENSE": in_dense,
            "MIDDLE_RAW": middle_raw,
            "OUT_DENSE": out_dense,
            "RIGHT_OFFSET": boundaries["right"],
        }

        output_path = args.path_yeah_output

        print()
        print("============================================")
        print("QUALIFYING PATH_YEAH BUILDER")
        print("============================================")
        print(f"Initial source : {source_label}")
        print("Display        : LEFT_OFFSET / IN_DENSE / MIDDLE_RAW / OUT_DENSE / RIGHT_OFFSET")
        print(f"Output         : {output_path}")
        print("============================================")

        straight_path, _ = record_line_interactive_editor(
            line_name="path_yeah",
            points=initial_path,
            closed=closed,
            context_initial_lines=None,
            context_current_lines=None,
            editor_title=(
                f"PATH_YEAH Straight-Line Editor | source={source_label}"
            ),
            background_lines=qualifying_background,
        ) if not args.no_show else (
            initial_path.copy(),
            False,
        )

        qualifying_selection_lines = {
            "IN_DENSE": in_dense,
            "MIDDLE_RAW": middle_raw,
            "OUT_DENSE": out_dense,
        }

        qualifying_section_context = build_qualifying_curve_section_context(
            args.track_roi,
            qualifying_selection_lines,
            curve_spacing=0.05,
        )

        curve_result, _ = curve_interactive_editor_qualifying_v24(
            lines={
                "path_yeah": straight_path,
            },
            closed=closed,
            no_show=args.no_show,
            title=(
                f"PATH_YEAH Curve Editor | source={source_label}"
            ),
            background_lines=qualifying_background,
            initial_reference_lines={
                "path_yeah": initial_path,
            },
            selection_reference_lines=qualifying_selection_lines,
            editable_selection_alias="PATH_YEAH",
            section_main_context=qualifying_section_context,
        )

        final_path, actual_spacing = dense_resample_final_path(
            np.asarray(
                curve_result["path_yeah"],
                dtype=np.float64,
            ),
            args.path_spacing,
            closed,
        )

        save_path_xy_csv(
            info={
                "points": final_path,
            },
            path=output_path,
        )

        print(
            f"[OK] PATH_YEAH saved: {output_path}"
        )
        print(
            f"     source={source_label}, "
            f"waypoints={len(final_path)}, "
            f"spacing={actual_spacing:.6f} m"
        )
        return

    if mode not in (
        "final-in",
        "final-out",
    ):
        raise ValueError(
            f"Unsupported path mode: {mode}"
        )

    if mode == "final-in":
        initial_path = load_existing_dense_xy(
            args.in_dense
        )
        path_name = "path_born_in"
        output_path = args.path_born_in_output
    else:
        initial_path = load_existing_dense_xy(
            args.out_dense
        )
        path_name = "path_born_out"
        output_path = args.path_born_out_output

    closed = detect_path_builder_closed(
        initial_path,
        args.track_roi,
    )

    path_builder_edit_one_path(
        path_name=path_name,
        initial_path=initial_path,
        boundaries=boundaries,
        output_path=output_path,
        path_spacing=args.path_spacing,
        closed=closed,
        no_show=args.no_show,
    )


# ============================================================
# 14. CLI
# ============================================================

def build_arg_parser():
    parser = argparse.ArgumentParser(
        description=(
            "3-Line 또는 4-Line 차선 경계 데이터로 "
            "IN/OUT Polygon을 생성하는 Track ROI Builder"
        )
    )

    sub = parser.add_subparsers(
        dest="command",
        required=True,
    )

    # --------------------------------------------------------
    # record
    # --------------------------------------------------------

    record_parser = sub.add_parser(
        "record",
        help="ROS2 ublox1/fix 또는 /odom을 차선 경계 데이터로 기록",
    )

    record_parser.add_argument(
        "--line",
        required=True,
        choices=[
            "left",
            "middle",
            "middle1",
            "middle2",
            "right",
            "all",
        ],
        help=(
            "3-Line: left/middle/right, "
            "4-Line: left/middle1/middle2/right, "
            "all: LEFT->MIDDLE->RIGHT 연속 기록"
        ),
    )

    record_parser.add_argument(
        "--data-dir",
        default=DEFAULT_DATA_DIR,
    )

    record_parser.add_argument(
        "--source",
        choices=[
            "fix",
            "odom",
        ],
        default="fix",
        help="live record 입력 소스. 기본 fix",
    )

    record_parser.add_argument(
        "--topic",
        default=None,
        help="생략 시 fix=ublox1/fix, odom=/odom",
    )

    record_parser.add_argument(
        "--map-offset-x",
        type=float,
        default=-125320.0,
        help="ublox1/fix -> local XY 변환 offset X",
    )

    record_parser.add_argument(
        "--map-offset-y",
        type=float,
        default=136746.0,
        help="ublox1/fix -> local XY 변환 offset Y",
    )

    record_parser.add_argument(
        "--min-distance",
        type=float,
        default=0.05,
        help="센서 원본 기록 시 연속점 최소 거리 [m] (기본 0.05)",
    )

    record_parser.add_argument(
        "--record-spacing",
        type=float,
        default=0.05,
        help=(
            "record 종료 후 *_raw.csv 최종 재샘플링 간격 [m]. "
            "기본 0.05"
        ),
    )

    record_parser.add_argument(
        "--open-record",
        action="store_true",
        help=(
            "기록 경로를 open path로 처리. "
            "미지정 시 폐곡선(CLOSED)으로 처리."
        ),
    )

    # --------------------------------------------------------
    # build
    # --------------------------------------------------------

    build_parser = sub.add_parser(
        "build",
        help=(
            "차선 개수 선택 -> 구간 클릭 -> "
            "재샘플링 -> Polygon 생성 -> JSON 저장"
        ),
    )

    build_parser.add_argument(
        "--data-dir",
        default=DEFAULT_DATA_DIR,
    )

    build_parser.add_argument(
        "--spacing",
        type=float,
        required=True,
        help=(
            "재샘플링 간격 [m]. "
            "구간 경계점은 spacing과 무관하게 추가됩니다."
        ),
    )

    build_parser.add_argument(
        "--closed",
        action="store_true",
        help=(
            "폐곡선 트랙이면 지정. "
            "미지정 시 open track."
        ),
    )

    build_parser.add_argument(
        "--tangent-window",
        type=float,
        default=1.0,
        help=(
            "기준선 접선 계산 범위 [m] "
            "(기본 1.0)"
        ),
    )

    build_parser.add_argument(
        "--raw-edit-spacing",
        type=float,
        default=0.05,
        help=(
            "Polygon 선택 전 LEFT/MIDDLE/RIGHT RAW 차선 "
            "재샘플링 간격 [m]. 기본 0.05"
        ),
    )

    build_parser.add_argument(
        "--left-offset",
        type=float,
        default=0.50,
        help=(
            "Polygon 수정 후 LEFT line을 진행 heading 기준 "
            "왼쪽으로 이동할 거리 [m]. 기본 0.50"
        ),
    )

    build_parser.add_argument(
        "--right-offset",
        type=float,
        default=0.50,
        help=(
            "Polygon 수정 후 RIGHT line을 진행 heading 기준 "
            "오른쪽으로 이동할 거리 [m]. 기본 0.50"
        ),
    )

    build_parser.add_argument(
        "--offset-window",
        type=int,
        default=3,
        help=(
            "LEFT/RIGHT offset heading 계산 시 초기 앞/뒤 waypoint 수. "
            "실행 중 Slider에서 변경 가능. 기본 3"
        ),
    )

    build_parser.add_argument(
        "--output",
        default=DEFAULT_JSON_PATH,
    )

    build_parser.add_argument(
        "--txt-output",
        default=DEFAULT_TXT_PATH,
        help=(
            "C++ ROI node용 TXT 저장 경로."
        ),
    )

    build_parser.add_argument(
        "--figure",
        default=DEFAULT_FIGURE_PATH,
    )

    build_parser.add_argument(
        "--cells-output",
        default=DEFAULT_CELLS_PATH,
        help=(
            "LiDAR ROI filtering용 Cell TXT 저장 경로."
        ),
    )

    build_parser.add_argument(
        "--no-show",
        action="store_true",
    )

    build_parser.add_argument(
        "--curve-spacing",
        type=float,
        default=0.05,
        help=(
            "CURVE section 내부 dense 계산용 기준 간격 [m]. "
            "기본 0.05"
        ),
    )

    build_parser.add_argument(
        "--output-spacing",
        type=float,
        default=0.30,
        help=(
            "최종 IN/OUT waypoint 목표 간격 [m]. "
            "기본 0.30"
        ),
    )

    build_parser.add_argument(
        "--roi-plot-step",
        type=int,
        default=1,
        help=(
            "최종 Dense ROI 시각화에서 N개 waypoint마다 "
            "ROI circle 1개 표시. 기본 1"
        ),
    )

    build_parser.add_argument(
        "--in-dense-output",
        default=DEFAULT_IN_DENSE_PATH,
        help="최종 IN dense CSV 저장 경로",
    )

    build_parser.add_argument(
        "--out-dense-output",
        default=DEFAULT_OUT_DENSE_PATH,
        help="최종 OUT dense CSV 저장 경로",
    )

    build_parser.add_argument(
        "--path-in-output",
        default=DEFAULT_PATH_IN_PATH,
        help="in_dense.csv와 동일한 x,y를 저장하는 path_in.csv 경로",
    )

    build_parser.add_argument(
        "--path-out-output",
        default=DEFAULT_PATH_OUT_PATH,
        help="out_dense.csv와 동일한 x,y를 저장하는 path_out.csv 경로",
    )

    build_parser.add_argument(
        "--dense-figure",
        default=DEFAULT_DENSE_FIGURE_PATH,
        help="최종 IN/OUT + ROI circle 시각화 PNG 저장 경로",
    )

    # --------------------------------------------------------
    # mapping
    # --------------------------------------------------------

    mapping_parser = sub.add_parser(
        "mapping",
        help="기존 path_in/out과 in/out_dense를 최근접 대응하여 Path->ROI mapping CSV 생성",
    )

    mapping_parser.add_argument(
        "--path-in",
        default=DEFAULT_PATH_IN_PATH,
        help="IN driving path CSV",
    )

    mapping_parser.add_argument(
        "--path-out",
        default=DEFAULT_PATH_OUT_PATH,
        help="OUT driving path CSV",
    )

    mapping_parser.add_argument(
        "--in-dense",
        default=DEFAULT_IN_DENSE_PATH,
        help="IN dense ROI CSV",
    )

    mapping_parser.add_argument(
        "--out-dense",
        default=DEFAULT_OUT_DENSE_PATH,
        help="OUT dense ROI CSV",
    )

    mapping_parser.add_argument(
        "--in-mapping-output",
        default=DEFAULT_IN_PATH_ROI_MAP_PATH,
        help="IN path_index -> roi_index mapping CSV 저장 경로",
    )

    mapping_parser.add_argument(
        "--out-mapping-output",
        default=DEFAULT_OUT_PATH_ROI_MAP_PATH,
        help="OUT path_index -> roi_index mapping CSV 저장 경로",
    )

    mapping_parser.add_argument(
        "--track-roi",
        default=DEFAULT_JSON_PATH,
        help="폐곡선 여부 확인용 track_roi.json 경로",
    )

    mapping_parser.add_argument(
        "--no-show",
        action="store_true",
        help="mapping 결과 시각화 창을 띄우지 않음",
    )

    # --------------------------------------------------------
    # path builder
    # --------------------------------------------------------

    path_parser = sub.add_parser(
        "path",
        help="예선/본선 driving path 직선/곡선 수정 생성",
    )

    path_parser.add_argument(
        "--data-dir",
        default=DEFAULT_DATA_DIR,
    )

    path_parser.add_argument(
        "--path-mode",
        required=True,
        choices=[
            "qualifying",
            "final-in",
            "final-out",
        ],
    )

    path_parser.add_argument(
        "--qualifying-source",
        default="middle",
        choices=[
            "in",
            "middle",
            "out",
        ],
        help=(
            "호환성 유지용 옵션. 현재 예선 PATH_YEAH는 MIDDLE_RAW에서 시작하며 "
            "Curve 단계에서 IN_DENSE/MIDDLE_RAW/OUT_DENSE를 직접 선택합니다."
        ),
    )

    path_parser.add_argument(
        "--path-spacing",
        type=float,
        default=0.30,
        help="최종 driving path 재샘플링 목표 간격 [m]. 기본 0.30",
    )

    path_parser.add_argument(
        "--path-yeah-output",
        default=DEFAULT_PATH_YEAH_PATH,
    )

    path_parser.add_argument(
        "--path-born-in-output",
        default=DEFAULT_PATH_BORN_IN_PATH,
    )

    path_parser.add_argument(
        "--path-born-out-output",
        default=DEFAULT_PATH_BORN_OUT_PATH,
    )

    path_parser.add_argument(
        "--in-dense",
        default=DEFAULT_IN_DENSE_PATH,
    )

    path_parser.add_argument(
        "--out-dense",
        default=DEFAULT_OUT_DENSE_PATH,
    )

    path_parser.add_argument(
        "--track-roi",
        default=DEFAULT_JSON_PATH,
        help="closed/open 판별용 track_roi.json",
    )

    path_parser.add_argument(
        "--no-show",
        action="store_true",
    )

    # --------------------------------------------------------
    # visualize
    # --------------------------------------------------------

    visualize_parser = sub.add_parser(
        "visualize",
        help="생성된 track_roi.json 재시각화",
    )

    visualize_parser.add_argument(
        "--input",
        default=DEFAULT_JSON_PATH,
    )

    visualize_parser.add_argument(
        "--save",
        default=None,
    )

    visualize_parser.add_argument(
        "--no-show",
        action="store_true",
    )

    return parser



def detect_existing_dense_line_count(
    args,
) -> int:
    """
    작업 모드 3에서 3/4-Line을 자동 판별한다.

    우선순위:
      1) track_roi.json metadata.line_count
      2) track_data/middle1_raw.csv + middle2_raw.csv 존재 -> 4-Line
      3) track_data/middle_raw.csv 존재 -> 3-Line

    자동 판별이 불가능할 때만 사용자에게 묻는다.
    """
    try:
        if os.path.exists(
            args.output
        ):
            with open(
                args.output,
                "r",
                encoding="utf-8",
            ) as fp:
                data = json.load(
                    fp
                )

            value = int(
                data.get(
                    "metadata",
                    {},
                ).get(
                    "line_count",
                    0,
                )
            )

            if value in (3, 4):
                print(
                    f"[OK] 기존 데이터 기준 자동 감지: {value}-Line"
                )
                return value
    except Exception:
        pass

    data_dir = os.path.abspath(
        args.data_dir
    )

    middle1_path = os.path.join(
        data_dir,
        "middle1_raw.csv",
    )
    middle2_path = os.path.join(
        data_dir,
        "middle2_raw.csv",
    )
    middle_path = os.path.join(
        data_dir,
        "middle_raw.csv",
    )

    if (
        os.path.exists(middle1_path)
        and os.path.exists(middle2_path)
    ):
        print(
            "[OK] middle1_raw.csv / middle2_raw.csv 감지: 4-Line"
        )
        return 4

    if os.path.exists(
        middle_path
    ):
        print(
            "[OK] middle_raw.csv 감지: 3-Line"
        )
        return 3

    return ask_line_count()


# ============================================================
# 15. Interactive Start Menu
# ============================================================

def build_interactive_default_args(parser):
    """
    명령행 인자 없이 실행했을 때 사용할 시작 메뉴.

    python3 track_roi_builder_dense_resume_polygon_v5_interactive_start.py

    1) record
       - line을 대화형으로 선택
       - 기본 topic /odom
       - 기본 record spacing 0.05 m
       - 기본 CLOSED 기록

    2) build
       - 기존 기본값과 동일하게
         build --spacing 0.5 --closed
       - 이후 기존 workflow mode 선택창으로 진입

    3) visualize
       - 기본 track_roi.json 사용

    4) mapping
       - path_in/path_out과 in_dense/out_dense를 최근접 대응
       - in_path_roi_map.csv / out_path_roi_map.csv 생성

    5) path
       - 1: 예선 PATH_YEAH 생성
       - 2: 본선 PATH_IN / PATH_OUT 생성
    """

    while True:
        print()
        print("============================================")
        print("Track ROI Builder - Start Menu")
        print("============================================")
        print("  1 : ROS2 GPS(ublox1/fix) 또는 ODOM 차선 기록 + 재샘플링 + 직선 보간")
        print("  2 : Track ROI / Polygon / Dense 생성")
        print("  3 : 기존 track_roi.json 시각화")
        print("  4 : Path -> Dense ROI mapping CSV 생성")
        print("  5 : Driving Path 만들기")
        print("============================================")

        mode = input(
            "실행 모드 선택 [1/2/3/4/5, 기본 2]: "
        ).strip()

        if mode == "":
            mode = "2"

        if mode == "1":
            print()
            print("============================================")
            print("기록할 차선 선택")
            print("============================================")
            print("  1 : LEFT")
            print("  2 : MIDDLE")
            print("  3 : RIGHT")
            print("  4 : ALL  (LEFT -> MIDDLE -> RIGHT 순차 기록)")
            print("============================================")

            line_select = input(
                "차선 선택 [1/2/3/4, 기본 4]: "
            ).strip()

            if line_select == "":
                line_select = "4"

            line_map = {
                "1": "left",
                "2": "middle",
                "3": "right",
                "4": "all",
            }

            if line_select not in line_map:
                print(
                    "[WARN] 1, 2, 3, 4 중 하나를 입력하십시오. 기본값 4를 사용합니다."
                )
                line_select = "4"

            line_name = line_map[line_select]

            source = input(
                "입력 소스 [fix/odom, 기본 fix]: "
            ).strip().lower()

            if source == "":
                source = "fix"

            if source not in ("fix", "odom"):
                print(
                    "[WARN] 지원하지 않는 입력이라 기본값 fix를 사용합니다."
                )
                source = "fix"

            spacing_text = input(
                "최종 재샘플링 간격 [0.05 m]: "
            ).strip()

            if spacing_text == "":
                record_spacing = 0.05
            else:
                try:
                    record_spacing = float(spacing_text)
                except ValueError:
                    print(
                        "[WARN] 숫자가 아니므로 기본값 0.05 m를 사용합니다."
                    )
                    record_spacing = 0.05

            if record_spacing <= 0.0:
                print(
                    "[WARN] 0보다 커야 하므로 기본값 0.05 m를 사용합니다."
                )
                record_spacing = 0.05

            path_type = input(
                "기록 경로 [closed/open, 기본 closed]: "
            ).strip().lower()

            cli_args = [
                "record",
                "--line",
                line_name,
                "--source",
                source,
                "--record-spacing",
                str(record_spacing),
            ]

            if path_type in (
                "open",
                "o",
            ):
                cli_args.append(
                    "--open-record"
                )

            return parser.parse_args(
                cli_args
            )

        if mode == "2":
            return parser.parse_args(
                [
                    "build",
                    "--spacing",
                    "0.5",
                    "--closed",
                ]
            )

        if mode == "3":
            return parser.parse_args(
                [
                    "visualize",
                ]
            )

        if mode == "4":
            return parser.parse_args(
                [
                    "mapping",
                ]
            )

        if mode == "5":
            print()
            print("============================================")
            print("Driving Path 만들기")
            print("============================================")
            print("  1 : 예선")
            print("  2 : 본선")
            print("============================================")

            race_mode = input(
                "선택 [1/2]: "
            ).strip()

            if race_mode == "1":
                return parser.parse_args(
                    [
                        "path",
                        "--path-mode",
                        "qualifying",
                    ]
                )

            if race_mode == "2":
                print()
                print("============================================")
                print("본선 Path 선택")
                print("============================================")
                print("  1 : IN")
                print("  2 : OUT")
                print("============================================")

                path_side = input(
                    "선택 [1/2]: "
                ).strip()

                if path_side == "1":
                    return parser.parse_args(
                        [
                            "path",
                            "--path-mode",
                            "final-in",
                        ]
                    )

                if path_side == "2":
                    return parser.parse_args(
                        [
                            "path",
                            "--path-mode",
                            "final-out",
                        ]
                    )

                print(
                    "[WARN] 1 또는 2를 입력하십시오."
                )
                continue

            print(
                "[WARN] 1 또는 2를 입력하십시오."
            )
            continue

        print(
            "[WARN] 1, 2, 3, 4, 5 중 하나를 입력하십시오."
        )


# ============================================================
# 16. Main
# ============================================================

def record_single_line_from_args(
    args,
    line_name: str,
    stop_with_escape: bool = False,
):
    """
    지정한 한 라인을 기록하고 *_raw.csv까지 생성한다.
    """
    data_dir = os.path.abspath(
        args.data_dir
    )

    recorded_path = os.path.join(
        data_dir,
        f"{line_name}_recorded.csv",
    )

    raw_output_path = os.path.join(
        data_dir,
        f"{line_name}_raw.csv",
    )

    if args.record_spacing <= 0.0:
        raise ValueError(
            "--record-spacing은 0보다 커야 합니다."
        )

    record_topic = args.topic

    if record_topic is None:
        record_topic = (
            "ublox1/fix"
            if args.source == "fix"
            else "/odom"
        )

    recorder = OdomLineRecorder(
        line_name=line_name,
        output_path=recorded_path,
        topic=record_topic,
        min_distance=args.min_distance,
        source_type=args.source,
        map_offset_x=args.map_offset_x,
        map_offset_y=args.map_offset_y,
    )

    recorder.run(
        stop_with_escape=stop_with_escape
    )

    if recorder.count < 2:
        raise ValueError(
            f"{line_name.upper()} 원본 기록점이 2개 미만입니다. "
            "*_raw.csv를 생성할 수 없습니다."
        )

    process_recorded_line_to_raw(
        line_name=line_name,
        recorded_path=recorded_path,
        raw_output_path=raw_output_path,
        target_spacing=args.record_spacing,
        closed=(not args.open_record),
    )


def record_all_three_lines_from_args(args):
    """
    LEFT -> MIDDLE -> RIGHT를 순서대로 기록한다.

    각 라인:
      Enter : 기록 시작
      Esc   : 현재 라인 기록 종료 및 RAW 생성
    """
    line_order = [
        "left",
        "middle",
        "right",
    ]

    print()
    print("============================================")
    print("3-Line 연속 기록 모드")
    print("============================================")
    print("순서 : LEFT -> MIDDLE -> RIGHT")
    print("Enter: 현재 라인 기록 시작")
    print("Esc  : 현재 라인 기록 종료")
    print("============================================")

    for index, line_name in enumerate(
        line_order,
        start=1,
    ):
        print()
        print(
            f"[{index}/3] {line_name.upper()} 기록 준비"
        )

        while True:
            key = input(
                f"Enter를 누르면 {line_name.upper()} 기록을 시작합니다: "
            )

            if key == "":
                break

            print(
                "[WARN] 시작하려면 다른 문자를 입력하지 말고 Enter만 누르십시오."
            )

        record_single_line_from_args(
            args=args,
            line_name=line_name,
            stop_with_escape=True,
        )

        print()
        print(
            f"[OK] {line_name.upper()} 기록 및 RAW 생성 완료"
        )

        if index < len(line_order):
            next_line = line_order[index]
            print(
                f"다음 라인: {next_line.upper()}"
            )

    print()
    print("============================================")
    print("[OK] LEFT / MIDDLE / RIGHT 전체 기록 완료")
    print("============================================")


def main():
    parser = build_arg_parser()

    # 인자 없이 실행하면 시작 메뉴를 표시한다.
    #
    # 예:
    #   python3 track_roi_builder_dense_resume_polygon_v5_interactive_start.py
    #
    # 기존 CLI 방식도 그대로 지원한다.
    #
    # 예:
    #   python3 ...py record --line left
    #   python3 ...py build --spacing 0.5 --closed
    #   python3 ...py visualize
    if len(sys.argv) == 1:
        args = build_interactive_default_args(
            parser
        )
    else:
        args = parser.parse_args()

    try:
        if args.command == "record":
            if args.line == "all":
                record_all_three_lines_from_args(
                    args
                )
            else:
                record_single_line_from_args(
                    args=args,
                    line_name=args.line,
                    stop_with_escape=True,
                )

        elif args.command == "build":
            if args.spacing <= 0.0:
                raise ValueError(
                    "--spacing은 0보다 커야 합니다."
                )

            if args.tangent_window <= 0.0:
                raise ValueError(
                    "--tangent-window는 0보다 커야 합니다."
                )

            if args.raw_edit_spacing <= 0.0:
                raise ValueError(
                    "--raw-edit-spacing은 0보다 커야 합니다."
                )

            if args.left_offset < 0.0:
                raise ValueError(
                    "--left-offset은 0 이상이어야 합니다."
                )

            if args.right_offset < 0.0:
                raise ValueError(
                    "--right-offset은 0 이상이어야 합니다."
                )

            if args.offset_window < 1:
                raise ValueError(
                    "--offset-window는 1 이상이어야 합니다."
                )

            if args.curve_spacing <= 0.0:
                raise ValueError(
                    "--curve-spacing은 0보다 커야 합니다."
                )

            if args.output_spacing <= 0.0:
                raise ValueError(
                    "--output-spacing은 0보다 커야 합니다."
                )

            if args.roi_plot_step <= 0:
                raise ValueError(
                    "--roi-plot-step은 1 이상이어야 합니다."
                )

            workflow_mode = ask_workflow_mode()

            if workflow_mode == 1:
                build_track_roi(
                    args
                )

            elif workflow_mode == 2:
                run_existing_polygon_boundary_workflow(
                    args
                )

            else:
                line_count = detect_existing_dense_line_count(
                    args
                )

                print(
                    f"[OK] 기존 Dense 작업 모드: {line_count}-Line"
                )

                run_existing_dense_workflow(
                    args=args,
                    line_count=line_count,
                )

        elif args.command == "visualize":
            visualize_from_json(
                args
            )

        elif args.command == "mapping":
            run_path_roi_mapping_mode(
                args
            )

        elif args.command == "path":
            if args.path_spacing <= 0.0:
                raise ValueError(
                    "--path-spacing은 0보다 커야 합니다."
                )

            run_path_builder_mode(
                args
            )

    except KeyboardInterrupt:
        print(
            "\n[CANCEL] 사용자에 의해 중단되었습니다."
        )

        sys.exit(
            130
        )

    except PipelineStepError:
        # 해당 작업 단계에서 이미 [FAIL] + 원인을 출력함.
        sys.exit(
            1
        )

    except Exception as exc:
        print(
            "[FAIL] 프로그램 실행"
        )

        print(
            f"       원인: {exc}"
        )

        sys.exit(
            1
        )


if __name__ == "__main__":
    main()
