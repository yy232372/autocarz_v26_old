EPS = 1.0e-9


class PipelineStepError(RuntimeError):
    """
    각 작업 단계에서 이미 실패 원인을 출력한 뒤
    상위 main에서 중복 에러 메시지가 출력되지 않도록 사용하는 예외.
    """
    pass


def run_silent_step(
    step_name: str,
    function,
    *args,
    **kwargs,
):
    """
    기존 함수 내부의 상세 print는 화면에 표시하지 않고,
    작업 성공/실패만 간단히 출력한다.

    성공:
        [OK] <작업명>

    실패:
        [FAIL] <작업명>
               원인: <실제 예외 메시지>
    """
    try:
        with contextlib.redirect_stdout(
            io.StringIO()
        ):
            result = function(
                *args,
                **kwargs,
            )

        print(
            f"[OK] {step_name}"
        )

        return result

    except Exception as exc:
        print(
            f"[FAIL] {step_name}"
        )

        print(
            f"       원인: {exc}"
        )

        raise PipelineStepError(
            step_name
        ) from None





def ask_workflow_mode() -> int:
    """
    실행 작업 모드를 선택한다.

    1:
        전체 생성
        Track ROI 경계 클릭
        -> Polygon 생성
        -> Polygon 공유 경계 드래그 수정
        -> Dense 생성/편집
        -> 저장

    2:
        기존 track_roi.json 재사용
        초기 Polygon 경계 클릭은 생략
        -> 기존 Polygon 공유 경계 드래그 수정부터 재개
        -> Dense 다시 생성/편집
        -> 저장

        현재 interactive Polygon boundary editor가 구현되어 있는
        3-Line 결과만 지원한다.

    3:
        기존 in_dense.csv / out_dense.csv 재사용
        -> Dense 편집
        -> ROI radius 계산
        -> 저장
    """
    while True:
        print(
            "\n작업 모드를 선택하십시오."
        )
        print(
            "  1 : 전체 생성"
        )
        print(
            "  2 : 기존 Polygon 경계 수정부터 재개"
        )
        print(
            "  3 : 기존 in_dense / out_dense 사용"
        )

        raw = input(
            "선택 [1/2/3]: "
        ).strip()

        if raw == "1":
            return 1

        if raw == "2":
            return 2

        if raw == "3":
            return 3

        print(
            "[WARN] 1, 2, 3 중 하나를 입력하십시오."
        )

